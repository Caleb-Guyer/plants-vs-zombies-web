# Preserve checksum-pinned engine artifacts on Windows checkouts.
dist/game/pvz-portable.js -text
# Generated patch context preserves upstream whitespace as checksum-pinned data.
dist/source/*.patch -text -whitespace
*.wasm binary
*.zip binary

# Preserve checksum-pinned game data, including original XML line endings.
dist/game-assets/** -text

# Preserve every served byte from the frozen release, including shell metadata.
dist/** -text

# Generator source must have stable newlines on Windows and Linux checkouts.
*.mjs text eol=lf
*.py text eol=lf

# Raw browser evidence keeps its original recorder bytes on every platform.
tests/fixtures/performance/captures/*.json -text whitespace=cr-at-eol
tests/fixtures/performance/diagnostics/*.json -text whitespace=cr-at-eol
tests/fixtures/performance/historical/** -text whitespace=cr-at-eol
tests/fixtures/torchbearer-browser/** -text
tests/fixtures/torch1-parent-reference.json -text
tests/fixtures/ambush1-native-bonus-art.json -text
tests/fixtures/ambush1-focused-reference.json -text
