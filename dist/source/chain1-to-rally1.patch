diff --git a/src/Lawn/System/RallyZombie.cpp b/src/Lawn/System/RallyZombie.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ef0f4f66055ee211fbe2a700733e99f4ac22eed7
--- /dev/null
+++ b/src/Lawn/System/RallyZombie.cpp
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "RallyZombie.h"
+#include "../Board.h"
+#include "../Zombie.h"
+#include "../../LawnApp.h"
+#include <cmath>
+
+namespace RallyZombie
+{
+bool IsZombie(const Zombie& zombie) { return zombie.mZombieType == ZOMBIE_RALLY; }
+
+static bool CanWalk(const Zombie& zombie)
+{
+    return !zombie.mDead && zombie.mBodyHealth > 0 && zombie.mHasHead &&
+        !zombie.mMindControlled && !zombie.mBlowingAway && !zombie.mIsEating &&
+        zombie.mIceTrapCounter == 0 && zombie.mButteredCounter == 0 &&
+        zombie.mZombiePhase == PHASE_ZOMBIE_NORMAL &&
+        zombie.mZombieHeight == HEIGHT_ZOMBIE_NORMAL && !zombie.mInPool;
+}
+
+bool IsRallying(const Zombie& zombie)
+{
+    return IsZombie(zombie) && CanWalk(zombie) && zombie.mHasArm && zombie.mHasObject &&
+        zombie.mSummonCounter > 0 && zombie.mSummonCounter <= kCallTicks;
+}
+
+float MovementMultiplier(const Zombie& zombie)
+{
+    if (!zombie.mBoard || !zombie.mApp || !IsMode(zombie.mApp->mGameMode) ||
+        zombie.mFromWave < 0 || !CanWalk(zombie)) return 1.0f;
+    switch (zombie.mZombieType)
+    {
+    case ZOMBIE_NORMAL: case ZOMBIE_TRAFFIC_CONE: case ZOMBIE_PAIL:
+    case ZOMBIE_DOOR: case ZOMBIE_RALLY:
+        break;
+    default:
+        return 1.0f;
+    }
+    for (const Zombie* caller : zombie.mBoard->mZombies)
+    {
+        if (caller == &zombie || caller->mFromWave < 0 || !IsRallying(*caller) ||
+            caller->mPosX < 0 || caller->mPosX > 780) continue;
+        if (std::abs(caller->mRow - zombie.mRow) <= kRadiusRows &&
+            std::abs(caller->mPosX - zombie.mPosX) <= kRadiusX)
+            return kSpeedMultiplier;
+    }
+    return 1.0f;
+}
+
+void Update(Zombie& zombie)
+{
+    if (!IsZombie(zombie) || !CanWalk(zombie) || !zombie.mHasArm || !zombie.mHasObject) return;
+    if (zombie.mSummonCounter <= 0 || zombie.mSummonCounter > kCycleTicks)
+        zombie.mSummonCounter = kCycleTicks;
+    else
+        --zombie.mSummonCounter;
+}
+
+void UpdateBoard(Board& board)
+{
+    if (!IsMode(board.mApp->mGameMode) || board.mApp->mGameScene != SCENE_PLAYING ||
+        board.mPaused || board.HasLevelAwardDropped()) return;
+    // Advance callers as a group before any actor walks. All recipients see
+    // the same call phase, independent of DataArray iteration order.
+    for (Zombie* zombie : board.mZombies) Update(*zombie);
+}
+}
diff --git a/src/Lawn/System/RallyZombie.h b/src/Lawn/System/RallyZombie.h
new file mode 100644
index 0000000000000000000000000000000000000000..37b8b1251ecff58e7f81bcdc7821676628d91468
--- /dev/null
+++ b/src/Lawn/System/RallyZombie.h
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+
+class Board;
+class Zombie;
+
+// A support zombie whose native saved summon counter carries his call cadence.
+// Speed is derived from the live callers; it never overwrites an actor's base
+// velocity, stacks, changes chewing speed or survives its source being disabled.
+namespace RallyZombie
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_RALLY_POINT;
+inline constexpr ChallengeState kState = static_cast<ChallengeState>(110);
+inline constexpr int kWaveCount = 10;
+inline constexpr int kLargestWave = 8;
+inline constexpr int kStartingSun = 250;
+inline constexpr int kOpeningDelay = 1200;
+inline constexpr int kWarmupTicks = 450;
+inline constexpr int kCycleTicks = 700;
+inline constexpr int kCallTicks = 160;
+inline constexpr int kRadiusX = 180;
+inline constexpr int kRadiusRows = 1;
+inline constexpr float kSpeedMultiplier = 1.45f;
+inline constexpr int kBodyHealth = 340;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state) { return IsMode(mode) && state == kState; }
+inline constexpr std::array<SeedType, 6> kSeeds = {
+    SEED_SUNFLOWER, SEED_CABBAGEPULT, SEED_SNOWPEA,
+    SEED_WALLNUT, SEED_CHERRYBOMB, SEED_SQUASH
+};
+struct StartingPlant { SeedType mSeed; int mCol; int mRow; };
+inline constexpr std::array<StartingPlant, 7> kStartingPlants = {{
+    {SEED_CABBAGEPULT,1,0}, {SEED_CABBAGEPULT,1,1}, {SEED_CABBAGEPULT,1,2},
+    {SEED_CABBAGEPULT,1,3}, {SEED_CABBAGEPULT,1,4},
+    {SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,0,3}
+}};
+struct Spawn { ZombieType mType = ZOMBIE_INVALID; int mRow = 0; };
+using Wave = std::array<Spawn, kLargestWave>;
+// Start with an unarmored demonstration. Later calls cover two adjacent lanes
+// and armor protects the caller; lobbed cabbages, frost and timed explosives
+// all remain native counters. There are no fast or instant-kill attackers.
+inline constexpr std::array<Wave, kWaveCount> kWaves = {{
+    {{{ZOMBIE_RALLY,2}, {ZOMBIE_NORMAL,2}, {ZOMBIE_NORMAL,1}}},
+    {{{ZOMBIE_RALLY,3}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,4}, {ZOMBIE_NORMAL,0}}},
+    {{{ZOMBIE_RALLY,1}, {ZOMBIE_TRAFFIC_CONE,1}, {ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,2}}},
+    {{{ZOMBIE_RALLY,3}, {ZOMBIE_NORMAL,2}, {ZOMBIE_TRAFFIC_CONE,3}, {ZOMBIE_NORMAL,4}, {ZOMBIE_NORMAL,1}}},
+    {{{ZOMBIE_RALLY,2}, {ZOMBIE_DOOR,2}, {ZOMBIE_TRAFFIC_CONE,1}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,4}}},
+    {{{ZOMBIE_RALLY,1}, {ZOMBIE_RALLY,3}, {ZOMBIE_TRAFFIC_CONE,0}, {ZOMBIE_NORMAL,1}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,4}}},
+    {{{ZOMBIE_RALLY,2}, {ZOMBIE_PAIL,2}, {ZOMBIE_TRAFFIC_CONE,1}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,4}}},
+    {{{ZOMBIE_RALLY,1}, {ZOMBIE_RALLY,3}, {ZOMBIE_DOOR,1}, {ZOMBIE_TRAFFIC_CONE,2}, {ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,4}}},
+    {{{ZOMBIE_RALLY,2}, {ZOMBIE_DOOR,2}, {ZOMBIE_TRAFFIC_CONE,0}, {ZOMBIE_TRAFFIC_CONE,4}, {ZOMBIE_NORMAL,1}, {ZOMBIE_NORMAL,2}, {ZOMBIE_NORMAL,3}}},
+    {{{ZOMBIE_RALLY,1}, {ZOMBIE_RALLY,3}, {ZOMBIE_PAIL,2}, {ZOMBIE_DOOR,1}, {ZOMBIE_TRAFFIC_CONE,3}, {ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,2}, {ZOMBIE_NORMAL,4}}}
+}};
+constexpr int ZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kWaveCount) return 0;
+    int count = 0;
+    for (const Spawn& spawn : kWaves[wave]) if (spawn.mType != ZOMBIE_INVALID) ++count;
+    return count;
+}
+constexpr int RowForSpawn(int wave, int ordinal)
+{
+    return wave >= 0 && wave < kWaveCount && ordinal >= 0 && ordinal < ZombieCount(wave)
+        ? kWaves[wave][ordinal].mRow : -1;
+}
+constexpr int ComposeWave(int wave, ZombieType* output, int capacity)
+{
+    if (wave < 0 || wave >= kWaveCount || !output || capacity <= ZombieCount(wave)) return -1;
+    for (int i = 0; i < capacity; ++i) output[i] = ZOMBIE_INVALID;
+    int count = 0;
+    for (const Spawn& spawn : kWaves[wave])
+        if (spawn.mType != ZOMBIE_INVALID) output[count++] = spawn.mType;
+    return count;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestWave);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int i = 0; i < kWaveCount; ++i) ComposeWave(i, output[i], static_cast<int>(Slots));
+    return kWaveCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_RALLY));
+    for (auto& allowed : output) allowed = false;
+    for (const Wave& wave : kWaves) for (const Spawn& spawn : wave)
+        if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+template<class Bank>
+void FillSeedBank(Bank& bank)
+{
+    bank.mNumPackets = static_cast<int>(kSeeds.size());
+    for (int i = 0; i < bank.mNumPackets; ++i) bank.mSeedPackets[i].SetPacketType(kSeeds[i]);
+    bank.RefreshAllPackets();
+}
+bool IsZombie(const Zombie& zombie);
+bool IsRallying(const Zombie& zombie);
+float MovementMultiplier(const Zombie& zombie);
+void Update(Zombie& zombie);
+void UpdateBoard(Board& board);
+static_assert(static_cast<int>(kMode) == 80);
+static_assert(static_cast<int>(ZOMBIE_RALLY) == 33);
+static_assert(ZombieCount(kWaveCount - 1) == kLargestWave);
+}
