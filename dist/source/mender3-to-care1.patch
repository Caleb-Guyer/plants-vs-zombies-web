+int Board::CountIntensiveCareCrew()
+{
+    int count = 0;
+    for (Plant* plant : mPlants)
+        if (plant->mBoard == this && plant->mIsOnBoard && !plant->mDead &&
+            !plant->mSquished && plant->mPlantHealth > 0 && IntensiveCare::IsCrewSeed(plant->mSeedType))
+            ++count;
+    return count;
+}
+
+bool Board::CanPlantIntensiveCarePatient(int theGridX, int theGridY, SeedType theSeedType)
+{
+    if (!mChallenge || !IntensiveCare::IsCurrentRules(mApp->mGameMode, mChallenge->mChallengeState) ||
+        mApp->mGameScene != SCENE_PLAYING || mPaused || mTimeStopCounter > 0 || mLevelComplete ||
+        HasLevelAwardDropped() || !IntensiveCare::IsBedCell(theGridX, theGridY) ||
+        !IntensiveCare::IsCrewSeed(theSeedType) || CountIntensiveCareCrew() >= IntensiveCare::kCrewLimit ||
+        mCursorObject->mCursorType != CURSOR_TYPE_PLANT_FROM_BANK ||
+        mCursorObject->mType != theSeedType || mCursorObject->mImitaterType != SEED_NONE ||
+        mCursorObject->mSeedBankIndex < 0 || mCursorObject->mSeedBankIndex >= mSeedBank->mNumPackets ||
+        mSeedBank->mSeedPackets[mCursorObject->mSeedBankIndex].mPacketType != theSeedType)
+        return false;
+    PlantsOnLawn plants;
+    GetPlantsOnLawn(theGridX, theGridY, &plants);
+    return plants.mUnderPlant && !plants.mUnderPlant->mDead &&
+        plants.mUnderPlant->mSeedType == SEED_FLOWERPOT && !plants.mNormalPlant &&
+        !plants.mPumpkinPlant && !plants.mFlyingPlant && !GetGraveStoneAt(theGridX, theGridY) &&
+        !GetCraterAt(theGridX, theGridY) && !GetScaryPotAt(theGridX, theGridY) &&
+        !IsPoolSquare(theGridX, theGridY) && !IsIceAt(theGridX, theGridY);
+}
+
+bool Board::CanMoveIntensiveCarePlant(Plant* thePlant, int theGridX, int theGridY)
+{
+    if (!mChallenge || !IntensiveCare::IsCurrentRules(mApp->mGameMode, mChallenge->mChallengeState) ||
+        mApp->mGameScene != SCENE_PLAYING || mPaused || mTimeStopCounter > 0 || mLevelComplete ||
+        HasLevelAwardDropped() || mChallenge->mChallengeStateCounter > 0 ||
+        !thePlant || thePlant->mBoard != this || !thePlant->mIsOnBoard || thePlant->mDead ||
+        thePlant->mSquished || thePlant->mPlantHealth <= 0 || thePlant->mOnBungeeState != NOT_ON_BUNGEE ||
+        !IntensiveCare::IsCrewSeed(thePlant->mSeedType) ||
+        (!IntensiveCare::IsBedCell(theGridX, theGridY) && !IntensiveCare::CanDeployAt(theGridX, theGridY)) ||
+        (thePlant->mPlantCol == theGridX && thePlant->mRow == theGridY)) return false;
+    PlantsOnLawn plants;
+    GetPlantsOnLawn(theGridX, theGridY, &plants);
+    if (plants.mNormalPlant || plants.mPumpkinPlant || plants.mFlyingPlant ||
+        GetGraveStoneAt(theGridX, theGridY) || GetCraterAt(theGridX, theGridY) ||
+        GetScaryPotAt(theGridX, theGridY) || IsPoolSquare(theGridX, theGridY) ||
+        IsIceAt(theGridX, theGridY) || mGridSquareType[theGridX][theGridY] != GRIDSQUARE_GRASS)
+        return false;
+    if (IntensiveCare::IsBedCell(theGridX, theGridY))
+        return plants.mUnderPlant && !plants.mUnderPlant->mDead && plants.mUnderPlant->mSeedType == SEED_FLOWERPOT;
+    return !plants.mUnderPlant;
+}
+
+bool Board::MoveIntensiveCarePlant(Plant* thePlant, int theGridX, int theGridY)
+{
+    if (!CanMoveIntensiveCarePlant(thePlant, theGridX, theGridY)) return false;
+    const int oldX = thePlant->mX;
+    const int oldY = thePlant->mY;
+    thePlant->mX = GridToPixelX(theGridX, theGridY);
+    thePlant->mY = GridToPixelY(theGridX, theGridY);
+    thePlant->mPlantCol = theGridX;
+    thePlant->mRow = theGridY;
+    thePlant->mStartRow = theGridY;
+    thePlant->mRenderOrder = thePlant->CalcRenderOrder();
+    if (PvzpParticleSystem* particle = mApp->ParticleTryToGet(thePlant->mParticleID))
+    {
+        if (particle->mEmitterList.mSize)
+        {
+            PvzpParticleEmitter* emitter = particle->mParticleHolder->mEmitters.DataArrayGet(
+                static_cast<unsigned int>(particle->mEmitterList.GetHead()->mValue));
+            particle->SystemMove(emitter->mSystemCenter.x + thePlant->mX - oldX,
+                emitter->mSystemCenter.y + thePlant->mY - oldY);
+        }
+    }
+    mChallenge->mChallengeStateCounter = IntensiveCare::kMoveCooldown;
+    DoPlantingEffects(theGridX, theGridY, thePlant);
+    return true;
+}
+
+bool Board::MouseDownIntensiveCare(int x, int y, int theClickCount)
+{
+    if (!mChallenge || !IntensiveCare::IsCurrentRules(mApp->mGameMode, mChallenge->mChallengeState) ||
+        mApp->mGameScene != SCENE_PLAYING || mPaused || mTimeStopCounter > 0 ||
+        mLevelComplete || HasLevelAwardDropped() || IsPlantInCursor()) return false;
+    if (theClickCount < 0)
+    {
+        ClearCursor();
+        mApp->PlayFoley(FOLEY_DROP);
+        return true;
+    }
+    if (GetShovelButtonRect().Contains(x, y))
+    {
+        ClearCursor();
+        mCursorObject->mCursorType = CURSOR_TYPE_GLOVE;
+        mApp->PlayFoley(FOLEY_DROP);
+        return true;
+    }
+    if (y < 80) return false;
+    Plant* selected = mPlants.DataArrayTryToGet(mCursorObject->mGlovePlantID);
+    if (selected && (selected->mDead || selected->mSquished || selected->mPlantHealth <= 0))
+    {
+        ClearCursor();
+        selected = nullptr;
+    }
+    const int col = PixelToGridX(x, y);
+    const int row = PixelToGridY(x, y);
+    if (selected)
+    {
+        if (selected->mPlantCol == col && selected->mRow == row)
+        {
+            ClearCursor();
+            mApp->PlayFoley(FOLEY_DROP);
+        }
+        else if (MoveIntensiveCarePlant(selected, col, row))
+            ClearCursor();
+        else
+            mApp->PlayFoley(FOLEY_DROP);
+        return true;
+    }
+    Plant* plant = ToolHitTest(x, y);
+    if (plant && !plant->mDead && !plant->mSquished && plant->mPlantHealth > 0 &&
+        IntensiveCare::IsCrewSeed(plant->mSeedType))
+    {
+        mCursorObject->mCursorType = CURSOR_TYPE_GLOVE;
+        mCursorObject->mGlovePlantID = static_cast<PlantID>(mPlants.DataArrayGetID(plant));
+        mCursorObject->mType = plant->mSeedType;
+        mCursorObject->mImitaterType = plant->mImitaterType;
+        plant->mHighlighted = true;
+        mApp->PlaySample(SOUND_TAP);
+    }
+    return true;
+}
+
+void Board::UpdateIntensiveCare()
+{
+    if (!mChallenge || !IntensiveCare::IsCurrentRules(mApp->mGameMode, mChallenge->mChallengeState)) return;
+    Plant* selected = mPlants.DataArrayTryToGet(mCursorObject->mGlovePlantID);
+    if (mCursorObject->mGlovePlantID != PLANTID_NULL &&
+        (!selected || selected->mDead || selected->mSquished || selected->mPlantHealth <= 0 ||
+         mLevelComplete || HasLevelAwardDropped()))
+    {
+        ClearCursor();
+        selected = nullptr;
+    }
+    if (mApp->mGameScene != SCENE_PLAYING || mPaused || mTimeStopCounter > 0 ||
+        mLevelComplete || HasLevelAwardDropped()) return;
+    if (mChallenge->mChallengeStateCounter > 0) --mChallenge->mChallengeStateCounter;
+    if (selected) selected->mHighlighted = true;
+    if (mMainCounter % IntensiveCare::kFatigueInterval != 0) return;
+    bool fighting = false;
+    for (Zombie* zombie : mZombies)
+        if (zombie->IsOnBoard() && !zombie->IsDeadOrDying() && !zombie->mMindControlled)
+        {
+            fighting = true;
+            break;
+        }
+    if (!fighting) return;
+    for (Plant* plant : mPlants)
+    {
+        if (!plant->mIsOnBoard || plant->mDead || plant->mSquished || plant->mPlantHealth <= 0 ||
+            !IntensiveCare::IsCrewSeed(plant->mSeedType) ||
+            !IntensiveCare::CanDeployAt(plant->mPlantCol, plant->mRow)) continue;
+        plant->mPlantHealth = IntensiveCare::FatiguedHealth(plant->mPlantHealth);
+        if (plant->mPlantHealth <= IntensiveCare::kWarningHealth && mMainCounter % 100 == 0)
+            plant->mEatenFlashCountdown = std::max(plant->mEatenFlashCountdown, 30);
+    }
+}
