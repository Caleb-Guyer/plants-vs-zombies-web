+	picture.SetLinearBlend(true);
+	picture.SetColor(Color::Black);
+	picture.FillRect(0, 0, 80, 65);
+	picture.DrawImage(Sexy::IMAGE_BACKGROUND5, Rect(0, 0, 80, 65), Rect(154, 72, 480, 390));
+	if (Sexy::IMAGE_PLANTSHADOW)
