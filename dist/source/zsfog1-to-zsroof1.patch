+	}
+	if (!Sexy::IMAGE_BACKGROUND5) return nullptr;
+	auto pot = cache->MakeCachedPlantFrame(SEED_FLOWERPOT, VARIATION_NORMAL);
+	auto cabbage = cache->MakeCachedPlantFrame(SEED_CABBAGEPULT, VARIATION_NORMAL);
