+// Fire Drill completion opts into the new enemy. Keep the published opening,
+// population counts, heavy attackers and water lanes unchanged.
+constexpr Formation WithTorchbearers(Formation formation,int flags,int wave,bool unlocked)
+{
+    if(!unlocked || flags<9 || (wave!=2 && wave!=6 && wave!=8)) return formation;
+    int remaining=wave==8 ? 2 : 1;
+    const int count=ZombieCount(formation);
+    for(int step=0;step<count && remaining>0;++step)
+    {
+        Spawn& spawn=formation[(step+flags+wave)%count];
+        if(spawn.mRow==2 || spawn.mRow==3) continue;
+        if(spawn.mType!=ZOMBIE_NORMAL && spawn.mType!=ZOMBIE_TRAFFIC_CONE &&
+           spawn.mType!=ZOMBIE_PAIL && spawn.mType!=ZOMBIE_NEWSPAPER) continue;
+        spawn.mType=ZOMBIE_TORCHBEARER;
+        --remaining;
+    }
+    return formation;
+}
