diff --git a/src/Lawn/System/ZomBotanyBowling.cpp b/src/Lawn/System/ZomBotanyBowling.cpp
new file mode 100644
index 0000000..1dc4a1e
--- /dev/null
+++ b/src/Lawn/System/ZomBotanyBowling.cpp
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "ZomBotanyBowling.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../SeedPacket.h"
+#include "../Zombie.h"
+#include <algorithm>
+#include <array>
+
+namespace ZomBotanyBowling
+{
+namespace
+{
+// Each rank enters behind the previous one. Pockets in adjacent rows reward
+// a bank shot, while a giant nut can travel down a file of armored heads.
+struct Pin {
+    ZombieType head = ZOMBIE_INVALID;
+    int row = 0;
+    int rank = 0;
+};
+constexpr auto pea = ZOMBIE_PEA_HEAD, wall = ZOMBIE_WALLNUT_HEAD, fire = ZOMBIE_JALAPENO_HEAD;
+constexpr auto gatling = ZOMBIE_GATLING_HEAD, tall = ZOMBIE_TALLNUT_HEAD;
+constexpr std::array heads = {pea, wall, fire, gatling, tall};
+using Formation = std::array<Pin, 8>;
+constexpr std::array<Formation, kWaveCount> waves = {{
+    {{{pea,2,0}}},
+    {{{pea,0,0}, {pea,1,1}}},
+    {{{pea,4,0}, {pea,3,1}}},
+    {{{pea,2,0}, {pea,1,1}, {pea,3,1}}},
+    {{{wall,0,0}, {pea,0,1}, {pea,1,1}}},
+    {{{wall,4,0}, {pea,3,1}, {pea,4,2}}},
+    {{{pea,1,0}, {wall,2,1}, {pea,3,2}}},
+    {{{pea,3,0}, {fire,2,1}, {pea,1,2}}},
+    {{{wall,1,0}, {pea,0,1}, {pea,2,1}, {pea,3,2}}},
+    {{{wall,2,0}, {pea,1,1}, {pea,3,1}, {fire,2,2}, {pea,0,2}, {pea,4,2}}},
+    {{{gatling,3,0}, {pea,2,1}, {pea,4,1}}},
+    {{{wall,0,0}, {gatling,0,1}, {wall,3,0}, {pea,4,1}}},
+    {{{pea,4,0}, {fire,3,1}, {wall,2,2}, {pea,1,2}}},
+    {{{wall,2,0}, {gatling,2,1}, {pea,1,1}, {pea,3,1}}},
+    {{{tall,4,0}, {gatling,4,1}, {pea,3,1}, {pea,2,2}}},
+    {{{wall,1,0}, {pea,0,1}, {fire,2,1}, {gatling,1,2}, {pea,3,2}}},
+    {{{tall,0,0}, {pea,0,1}, {gatling,0,2}, {wall,3,0}, {pea,4,1}}},
+    {{{pea,2,0}, {wall,1,1}, {wall,3,1}, {fire,2,2}, {gatling,4,2}}},
+    {{{wall,4,0}, {gatling,4,1}, {fire,1,0}, {pea,0,1}, {pea,2,1}}},
+    {{{tall,2,0}, {wall,1,1}, {wall,3,1}, {gatling,2,2}, {pea,0,2}, {pea,4,2}, {fire,1,2}}}
+}};
+
+bool IsNut(SeedType seed)
+{
+    return seed == SEED_WALLNUT || seed == SEED_EXPLODE_O_NUT || seed == SEED_GIANT_WALLNUT;
+}
+}
+
+bool IsHead(ZombieType type)
+{
+    return std::find(heads.begin(), heads.end(), type) != heads.end();
+}
+
+void ConfigureWaves(Board& board)
+{
+    for (auto& wave : board.mZombiesInWave)
+        std::fill(std::begin(wave), std::end(wave), ZOMBIE_INVALID);
+    board.mNumWaves = kWaveCount;
+    for (int wave = 0; wave < kWaveCount; ++wave)
+        for (std::size_t i = 0; i < waves[wave].size(); ++i)
+            board.mZombiesInWave[wave][i] = waves[wave][i].head;
+}
+
+void SpawnWave(Board& board)
+{
+    float leadX = 0.0f;
+    for (const Pin& pin : waves[board.mCurrentWave])
+    {
+        if (pin.head == ZOMBIE_INVALID) break;
+        Zombie* zombie = board.AddZombieInRow(pin.head, pin.row, board.mCurrentWave);
+        if (!zombie) continue;
+        if (leadX == 0.0f) leadX = zombie->mPosX;
+        zombie->mPosX = leadX + 90.0f * pin.rank;
+        zombie->mX = static_cast<int>(zombie->mPosX);
+    }
+}
+
+void Preload()
+{
+    for (ZombieType head : heads) Zombie::PreloadZombieResources(head);
+    for (SeedType nut : {SEED_WALLNUT, SEED_EXPLODE_O_NUT, SEED_GIANT_WALLNUT}) Plant::PreloadPlantResources(nut);
+}
+
+bool ValidSave(const Board& board)
+{
+    if (board.mBackground != BACKGROUND_1_DAY || !board.mChallenge || !board.mSeedBank ||
+        board.mNumWaves != kWaveCount || board.mCurrentWave < 0 || board.mCurrentWave > kWaveCount ||
+        board.mChallenge->mChallengeState != STATECHALLENGE_NORMAL || !board.mChallenge->mShowBowlingLine ||
+        board.mSeedBank->mNumPackets != 10 || board.mChallenge->mChallengeScore < 0)
+        return false;
+    for (int wave = 0; wave < kWaveCount; ++wave)
+        for (std::size_t i = 0; i <= waves[wave].size(); ++i) {
+            const ZombieType head = i < waves[wave].size() ? waves[wave][i].head : ZOMBIE_INVALID;
+            if (board.mZombiesInWave[wave][i] != head) return false;
+            if (head == ZOMBIE_INVALID) break;
+        }
+    for (int i = 0; i < board.mSeedBank->mNumPackets; ++i) {
+        const auto seed = board.mSeedBank->mSeedPackets[i].mPacketType;
+        if (seed != SEED_NONE && !IsNut(seed)) return false;
+    }
+    for (const Plant* plant : board.mPlants)
+        if (!plant->mDead && !IsNut(plant->mSeedType)) return false;
+    for (const Zombie* zombie : board.mZombies)
+        if (!zombie->mDead && !IsHead(zombie->mZombieType)) return false;
+    return true;
+}
+}
