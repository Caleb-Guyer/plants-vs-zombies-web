+Image* ChallengeScreen::GetZomBotanyBowlingImage()
+{
+	if (mZomBotanyBowlingImage) return mZomBotanyBowlingImage.get();
+	auto* cache = mApp->mReanimatorCache.get();
+	if (!cache || !Sexy::IMAGE_WALLNUT_BOWLINGSTRIPE) return nullptr;
+	const std::string group = "DelayLoad_Background1";
+	if (std::find(mLoadedResourceNames.begin(), mLoadedResourceNames.end(), group) == mLoadedResourceNames.end())
+	{
+		if (!PvzpLoadResources(group.c_str())) return nullptr;
+		mLoadedResourceNames.push_back(group);
+	}
+	auto* peaHead = cache->GetVasebreakerPlantHeadImage(ZOMBIE_PEA_HEAD);
+	if (!Sexy::IMAGE_BACKGROUND1 || !peaHead) return nullptr;
+
+	// Freeze the same rolling Wall-nut track that PlantInit uses on the bowling lawn.
+	auto nut = cache->MakeBlankMemoryImage(200, 190);
+	Graphics nutGraphics(nut.get());
+	nutGraphics.SetLinearBlend(true);
+	Reanimation roll;
+	roll.ReanimationInitializeType(45, 45, REANIM_WALLNUT);
+	roll.SetFramesForLayer("_ground");
+	roll.mAnimTime = .16f;
+	roll.Draw(&nutGraphics);
+
+	auto image = cache->MakeBlankMemoryImage(80, 65);
+	Graphics picture(image.get());
+	picture.SetLinearBlend(true);
+	picture.SetColor(Color::Black);
+	picture.FillRect(0, 0, 80, 65);
+	// The stripe starts at board (268,77). Preserve its position in this quarter-scale crop.
+	const Rect crop(268 + BOARD_OFFSET - 64, 45, 320, 260);
+	picture.DrawImage(Sexy::IMAGE_BACKGROUND1, Rect(0, 0, 80, 65), crop);
+	PvzpDrawImageScaledF(&picture, Sexy::IMAGE_WALLNUT_BOWLINGSTRIPE, 16, 8, .25f, .25f);
+	if (Sexy::IMAGE_PLANTSHADOW)
+	{
+		picture.DrawImage(Sexy::IMAGE_PLANTSHADOW, 44, 54, 27, 5);
+		picture.DrawImage(Sexy::IMAGE_PLANTSHADOW, 6, 58, 34, 6);
+	}
+	DrawFittedCardSprite(picture, *peaHead, 57, 58, 44, 54);
+	DrawFittedCardSprite(picture, *nut, 23, 60, 37, 36);
+
+	mZomBotanyBowlingImage = std::move(image);
+	return mZomBotanyBowlingImage.get();
+}
