+void SurfacePoolAmbush(Board& board)
+{
+    const int stage = board.mChallenge->mSurvivalStage;
+    // The original final-wave timer and RiseFromGrave provide the seaweed,
+    // waterline, swim transition and saveable countdown. Ice blocks the rise.
+    if (!board.mIceTrapCounter)
+    {
+        const int first = Rand(2);
+        const int lanes = stage < 2 ? 1 : 2;
+        for (int i = 0; i < lanes; ++i)
+        {
+            const int row = 2 + (first + i) % 2;
+            const int col = RandRangeInt(7 - stage / 2, 8);
+            if (Zombie* swimmer = board.AddZombieInRow(ZOMBIE_SEA_HEAD, row, board.mCurrentWave))
+                swimmer->RiseFromGrave(col, row);
+        }
+    }
+    // If ice stopped the swimmers after the last land zombie died, there is
+    // no remaining zombie death to finish this round.
+    if (board.AreEnemyZombiesOnScreen()) return;
+    if (board.IsSurvivalStageWithRepick())
+    {
+        board.mLevelAwardSpawned = true;
+        board.mApp->mBoardResult = BOARDRESULT_WON;
+        board.FadeOutLevel();
+    }
+    else board.mChallenge->SpawnLevelAward(4, 2);
+}
