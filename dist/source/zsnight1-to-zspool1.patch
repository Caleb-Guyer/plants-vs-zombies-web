+Image* ChallengeScreen::GetZombotanySurvivalPoolImage()
+{
+	if (mZombotanySurvivalPoolImage) return mZombotanySurvivalPoolImage.get();
+	auto* cache = mApp->mReanimatorCache.get();
+	if (!cache || !Sexy::IMAGE_POOL) return nullptr;
