+	auto swimmer = cache->MakeBlankMemoryImage(200, 210);
+	Graphics native(swimmer.get());
+	native.SetLinearBlend(true);
+	Reanimation body;
+	body.ReanimationInitializeType(40, 40, REANIM_ZOMBIE);
+	body.SetFramesForLayer("anim_swim");
+	body.mAnimTime = .5f;
+	Zombie::SetupReanimLayers(&body, ZOMBIE_DUCKY_TUBE);
+	Zombotany45Art::PrepareBodyRig(body);
+	// At full pool depth the original carrier clips 80 pixels below its origin.
+	// The rubber ring, wake and hands are drawn above that waterline.
+	native.ClipRect(0, 0, swimmer->GetWidth(), 40 + 80);
+	for (const char* track : {"Zombie_duckytube", "Zombie_outerarm_hand", "Zombie_innerarm3",
+		"Zombie_whitewater", "Zombie_whitewater2"})
+		if (body.TrackExists(track)) body.GetTrackInstanceByName(track)->mIgnoreClipRect = true;
+	body.Draw(&native);
+	Zombotany45Art::DrawCachedHead(&native, body, ZOMBIE_SEA_HEAD);
