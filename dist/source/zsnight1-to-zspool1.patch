+	{
+		if (!PvzpLoadResources(group.c_str())) return nullptr;
+		mLoadedResourceNames.push_back(group);
+	}
+	if (!Sexy::IMAGE_BACKGROUND3) return nullptr;
+	auto image = cache->MakeBlankMemoryImage(80, 65);
+	Graphics picture(image.get());
+	picture.SetLinearBlend(true);
+	picture.SetColor(Color::Black);
+	picture.FillRect(0, 0, 80, 65);
+	// Crop at one third scale, keeping the original pool edge and water aligned.
+	const Rect crop(480, 272, 240, 195);
+	const int waterY = (278 - crop.mY) / 3;
+	picture.DrawImage(Sexy::IMAGE_BACKGROUND3, Rect(0, 0, 80, 65), crop);
+	picture.DrawImage(Sexy::IMAGE_POOL, Rect(0, waterY, 80, 65 - waterY),
+		Rect(crop.mX - (34 + BOARD_OFFSET), 0, crop.mWidth, (65 - waterY) * 3));
+
+	auto lily = cache->MakeCachedPlantFrame(SEED_LILYPAD, VARIATION_NORMAL);
