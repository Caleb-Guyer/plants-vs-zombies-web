+namespace
+{
+// Reanimation's matrix draw path does not use Graphics::SetScale. Transform
+// the native rig together for this draw, then restore every matrix exactly.
+// No update, projectile launch or save operation can observe the visual pose.
+class CareFatigueDraw
+{
+    struct Part { Reanimation* mReanim; SexyTransform2D mMatrix; };
+    std::array<Part, 32> mParts;
+    size_t mCount = 0;
+    LawnApp& mApp;
+    const CareFatigue::Pose& mPose;
+    float mPivotX;
+    float mPivotY;
+
+    void AddAttachment(AttachmentID id, int depth)
+    {
+        if (id == AttachmentID::ATTACHMENTID_NULL || depth > 8 || !gEffectSystem || !gEffectSystem->mAttachmentHolder) return;
+        Attachment* attachment = gEffectSystem->mAttachmentHolder->mAttachments.DataArrayTryToGet(id);
+        if (!attachment) return;
+        for (int i = 0; i < attachment->mNumEffects; ++i)
+        {
+            const AttachEffect& effect = attachment->mEffectArray[i];
+            if (effect.mEffectType == EffectType::EFFECT_REANIM)
+                Add(mApp.ReanimationTryToGet(static_cast<ReanimationID>(effect.mEffectID)), depth + 1);
+            else if (effect.mEffectType == EffectType::EFFECT_ATTACHMENT)
+                AddAttachment(static_cast<AttachmentID>(effect.mEffectID), depth + 1);
+        }
+    }
+
+    void Add(Reanimation* reanim, int depth)
+    {
+        if (!reanim || depth > 8 || mCount == mParts.size()) return;
+        for (size_t i = 0; i < mCount; ++i) if (mParts[i].mReanim == reanim) return;
+        mParts[mCount++] = {reanim, reanim->mOverlayMatrix};
+        reanim->mOverlayMatrix = CareFatigue::Transform(mPose, mPivotX, mPivotY, reanim->mOverlayMatrix);
+        for (int i = 0; i < reanim->mDefinition->mTracks.count; ++i)
+            AddAttachment(reanim->mTrackInstances[i].mAttachmentID, depth + 1);
+    }
+
+public:
+    CareFatigueDraw(LawnApp& app, Reanimation& body, const CareFatigue::Pose& pose, float baseY) :
+        mApp(app), mPose(pose), mPivotX(40.0f), mPivotY(baseY + 76.0f)
+    {
+        Add(&body, 0);
+    }
+    ~CareFatigueDraw()
+    {
+        for (size_t i = 0; i < mCount; ++i) mParts[i].mReanim->mOverlayMatrix = mParts[i].mMatrix;
+    }
+};
+
+void DrawCareFatigue(Graphics* g, Plant& plant, Reanimation& body, float baseY)
+{
+    if (!plant.mBoard || !plant.mIsOnBoard || !IntensiveCare::IsMode(plant.mApp->mGameMode) ||
+        !IntensiveCare::IsCrewSeed(plant.mSeedType) || plant.mDead || plant.mSquished ||
+        plant.mIsAsleep || plant.mOnBungeeState != NOT_ON_BUNGEE)
+    {
+        body.Draw(g);
+        return;
+    }
+    const CareFatigue::Pose pose = CareFatigue::GetPose(plant.mPlantHealth, plant.mShootingCounter,
+        plant.mBoard->mMainCounter, plant.mRow, plant.mPlantCol);
+    if (!pose.mActive)
+    {
+        body.Draw(g);
+        return;
+    }
+    CareFatigueDraw rig(*plant.mApp, body, pose, baseY);
+    Graphics shaded(*g);
+    const int shade = static_cast<int>(255.0f * pose.mShade);
+    const Color color = g->GetColorizeImages() ? g->GetColor() : Color::White;
+    shaded.SetColor(Color(color.mRed * shade / 255, color.mGreen * shade / 255,
+        color.mBlue * shade / 255, color.mAlpha));
+    shaded.SetColorizeImages(true);
+    body.Draw(&shaded);
+}
+}
