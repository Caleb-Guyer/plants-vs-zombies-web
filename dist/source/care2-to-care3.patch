+void RetireLegacyHealingParticles(Board& board)
+{
+    if (!board.mApp || !board.mApp->mEffectSystem || !board.mApp->mEffectSystem->mParticleHolder)
+        return;
+    // Called once after loading a board. Menu trophy effects were discarded
+    // when the board was created; these unowned sparkles are old healing pulses.
+    // Preserve a pending finite pulse's saved lifetime rather than restarting it.
+    for (PvzpParticleSystem* sparkle : board.mApp->mEffectSystem->mParticleHolder->mParticleSystems)
+    {
+        if (sparkle->mDead || sparkle->mIsAttachment || sparkle->mEffectType != PARTICLE_TROPHY_SPARKLE)
+            continue;
+        for (auto* node = sparkle->mEmitterList.mHead; node; node = node->mNext)
+        {
+            PvzpParticleEmitter* emitter = sparkle->mParticleHolder->mEmitters.DataArrayGet(
+                static_cast<unsigned int>(node->mValue));
+            if (!emitter->mDead && emitter->mEmitterCrossFadeCountDown == 0)
+                emitter->mEmitterCrossFadeCountDown = kHealingFrames;
+        }
+    }
+}
