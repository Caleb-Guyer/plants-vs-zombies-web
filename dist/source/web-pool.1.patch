+						(((((dest & aGMask) * oma) + aGRoundAdd) >> 8) & aGMask) +
+						(((((dest & aBMask) * oma) + aBRoundAdd) >> 8) & aBMask);
+
+					aCurY++;
+					aDestPixels += aRowAdd;
+				}
+			}
+		}
+	}
+}
