-		mNativeAlphaData.reset(anAlphaData);
-	}
-	else
-	{
-		uint32_t* aSrcPtr = mColorTable.get();
-
-		uint32_t* anAlphaData = new uint32_t[256];
-
-		for (int i = 0; i < 256; i++)
-		{
-			uint32_t val = *(aSrcPtr++);
-
-			int anAlpha = val >> 24;
-
-			uint32_t r = ((val & 0xFF0000) * (anAlpha+1)) >> 8;
