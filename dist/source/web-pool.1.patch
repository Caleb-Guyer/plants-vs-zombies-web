+bool Board::IsFinalSurvivalStage()
+{
+	if (!mApp->IsSurvivalMode())
+		return false;
+
+	int aFlags = GetNumWavesPerSurvivalStage() * (mChallenge->mSurvivalStage + 1) / GetNumWavesPerFlag();
