+int Board::GetSeedBankExtraWidth()
+{
+	int aNumPackets = mSeedBank->mNumPackets;
+	return aNumPackets <= 6 ? 0 : aNumPackets == 7 ? 60 : aNumPackets == 8 ? 76 : aNumPackets == 9 ? 112 : 153;
+}
