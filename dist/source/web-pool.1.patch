+void Board::DrawShovel(Graphics* g)
+{
+    if (PoolPanic::IsMode(mApp->mGameMode)) return;
+    if (GarlicRun::IsMode(mApp->mGameMode) || LightsOut::IsMode(mApp->mGameMode) || GardenShuffle::IsMode(mApp->mGameMode) || IntensiveCare::IsMode(mApp->mGameMode))
+    {
+        Rect rect = GetShovelButtonRect();
+        const bool aCareTool = IntensiveCare::IsMode(mApp->mGameMode);
+        const bool aFittedTool = aCareTool || LightsOut::IsMode(mApp->mGameMode) || GarlicRun::IsMode(mApp->mGameMode);
+        Graphics aCareGraphics(*g);
+        if (aCareTool && mApp->mGameScene != GameScenes::SCENE_PLAYING)
+        {
+            // Match SeedBank::Draw while the intro camera pans the lawn.
+            aCareGraphics.mTransX -= mX;
+            aCareGraphics.mTransY -= mY;
+        }
+        Graphics* aToolGraphics = aCareTool ? &aCareGraphics : g;
+        if (aCareTool)
+            aToolGraphics->DrawImage(IMAGE_SHOVELBANK, rect,
+                Rect(0, 0, IMAGE_SHOVELBANK->GetWidth(), IMAGE_SHOVELBANK->GetHeight()));
+        else
+            aToolGraphics->DrawImage(IMAGE_SHOVELBANK, rect.mX, rect.mY);
+        if (mChallenge->mChallengeStateCounter > 0)
+        {
+            aToolGraphics->SetColorizeImages(true);
+            aToolGraphics->SetColor(Color(140, 140, 140));
+        }
+        if (aFittedTool && rect.mWidth > 4 && rect.mHeight > 4)
+        {
+            // Fit the complete original icon inside the same frame used by
+            // hit-testing; its native 80px canvas must not overhang the belt.
+            const int aPadding = 2;
+            const float aScale = std::min(
+                (rect.mWidth - aPadding * 2) / static_cast<float>(IMAGE_ZEN_GARDENGLOVE->GetWidth()),
+                (rect.mHeight - aPadding * 2) / static_cast<float>(IMAGE_ZEN_GARDENGLOVE->GetHeight()));
+            const int aWidth = FloatRoundToInt(IMAGE_ZEN_GARDENGLOVE->GetWidth() * aScale);
+            const int aHeight = FloatRoundToInt(IMAGE_ZEN_GARDENGLOVE->GetHeight() * aScale);
+            const Rect aIconRect(rect.mX + (rect.mWidth - aWidth) / 2,
+                rect.mY + (rect.mHeight - aHeight) / 2, aWidth, aHeight);
+            aToolGraphics->DrawImage(IMAGE_ZEN_GARDENGLOVE, aIconRect,
+                Rect(0, 0, IMAGE_ZEN_GARDENGLOVE->GetWidth(), IMAGE_ZEN_GARDENGLOVE->GetHeight()));
+        }
+        else if (!aFittedTool)
+            aToolGraphics->DrawImage(IMAGE_ZEN_GARDENGLOVE, rect.mX - 6, rect.mY - 4);
+        aToolGraphics->SetColorizeImages(false);
+        return;
+    }
+	if (mApp->mGameMode != GameMode::GAMEMODE_CHALLENGE_ZEN_GARDEN && mApp->mGameMode != GameMode::GAMEMODE_TREE_OF_WISDOM)
+	{
+		if (mShowShovel)
+		{
+			Rect aShovelRect = GetShovelButtonRect();
+			g->DrawImage(Sexy::IMAGE_SHOVELBANK, aShovelRect.mX, aShovelRect.mY);
+
+			if (mCursorObject->mCursorType != CursorType::CURSOR_TYPE_SHOVEL)
+			{
+				if (mChallenge->mChallengeState == (ChallengeState)15)
+				{
+					g->SetColorizeImages(true);
+					g->SetColor(GetFlashingColor(mMainCounter, 75));
+				}
+				g->DrawImage(Sexy::IMAGE_SHOVEL, aShovelRect.mX - 7, aShovelRect.mY - 3);
+				g->SetColorizeImages(false);
+			}
+		}
+	}
+
+	if (mApp->mGameMode == GameMode::GAMEMODE_CHALLENGE_ZEN_GARDEN || mApp->mGameMode == GameMode::GAMEMODE_TREE_OF_WISDOM)
+	{
+		DrawZenButtons(g);
+	}
+}
