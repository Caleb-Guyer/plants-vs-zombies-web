+void ConfigureAttackAnimation(Plant& plant);
+Sexy::Image* GetBonusImage(GameMode mode);
+void DrawAttackPulse(Sexy::Graphics* graphics, const Plant& plant, float offsetY);
+void DrawSprite(Sexy::Graphics* graphics, float x, float y, float scaleX, float scaleY);
+BodyExpression GetPlantBodyExpression(const Plant& plant, Reanimation& carrier);
+void DrawRig(Sexy::Graphics* graphics, Reanimation& carrier, BodyExpression expression = BodyExpression::Auto, const PartMotion& motion = {});
+void DrawPlantRig(Sexy::Graphics* graphics, const Plant& plant, Reanimation& carrier);
+
+inline constexpr SeedType kSeed = SEED_LANTERNSHROOM;
+inline constexpr int kCost = 75;
+inline constexpr int kRecharge = 750;
+inline constexpr int kPulseInterval = 400;
+inline constexpr int kSlowDuration = 150;
+inline constexpr int kRadius = 150;
+inline constexpr int kPulseFrames = 100;
+inline constexpr int kRecoilTicks = 30;
+inline constexpr int kWindupTicks = 40;
+inline constexpr int kReadyCountdown = kWindupTicks + 1;
+inline constexpr float kIdlePeriodSeconds = 2.2f;
+
+enum class AttackPhase { Idle, Windup, Release };
+struct AttackPose
+{
+    float scaleX = 1.0f;
+    float scaleY = 1.0f;
+    float offsetX = 0.0f;
+    float offsetY = 0.0f;
+};
+constexpr AttackPhase GetAttackPhase(int cooldown, int glow)
+{
+    // The plume outlives the recoil; breathing resumes while the mist fades.
+    if (glow > kPulseFrames - kRecoilTicks) return AttackPhase::Release;
+    if (cooldown > 0 && cooldown <= kWindupTicks) return AttackPhase::Windup;
+    return AttackPhase::Idle;
+}
+constexpr float Ease(float value) { return value * value * (3.0f - 2.0f * value); }
+constexpr AttackPose GetAttackPose(int cooldown, int glow)
+{
+    AttackPose pose;
+    if (GetAttackPhase(cooldown, glow) == AttackPhase::Windup)
+    {
+        const float amount = Ease((kWindupTicks - cooldown) / static_cast<float>(kWindupTicks));
+        pose.scaleX = 1.0f + 0.08f * amount;
+        pose.scaleY = 1.0f - 0.17f * amount;
+    }
+    else if (GetAttackPhase(cooldown, glow) == AttackPhase::Release)
+    {
+        const float progress = std::clamp(kPulseFrames - glow, 0, kRecoilTicks) / static_cast<float>(kRecoilTicks);
+        if (progress < 1.0f / 3.0f)
+        {
+            const float amount = Ease(progress * 3.0f);
+            pose.scaleX = 1.08f - 0.10f * amount;
+            pose.scaleY = 0.83f + 0.21f * amount;
+        }
+        else
+        {
+            const float amount = Ease((progress - 1.0f / 3.0f) * 1.5f);
+            pose.scaleX = 0.98f + 0.02f * amount;
+            pose.scaleY = 1.04f - 0.04f * amount;
+        }
+    }
+    pose.offsetX = 40.0f * (1.0f - pose.scaleX);
+    pose.offsetY = 72.0f * (1.0f - pose.scaleY);
+    return pose;
+}
+
+inline AttackPose GetIdlePose(float animTime)
+{
+    AttackPose pose;
+    const float breath = 0.5f - 0.5f * std::cos(animTime * 6.28318530718f);
+    pose.scaleX = 1.0f + 0.045f * breath;
+    pose.scaleY = 1.0f - 0.065f * breath;
+    // Squash around the body's ground contact instead of bobbing off the lawn.
+    pose.offsetX = 40.0f * (1.0f - pose.scaleX);
+    pose.offsetY = 72.0f * (1.0f - pose.scaleY);
+    return pose;
+}
+
+inline AttackPose GetPlantPose(int cooldown, int glow, float animTime)
+{
+    return GetAttackPhase(cooldown, glow) == AttackPhase::Idle ? GetIdlePose(animTime) : GetAttackPose(cooldown, glow);
+}
+
+inline PartMotion GetIdlePartMotion(float animTime)
+{
+    PartMotion motion;
+    const float phase = animTime * 6.28318530718f;
+    // A springy mushroom bob, with the cap settling into the body as it
+    // compresses. Rotate the connected layers together around the planted base.
+    motion.capY = 0.8f * (1.0f - std::cos(phase));
+    motion.bodyAngle = 0.070f * std::sin(phase);
+    return motion;
+}
+
+constexpr PartMotion GetPartMotion(int cooldown, int glow)
+{
+    PartMotion motion;
+    if (GetAttackPhase(cooldown, glow) == AttackPhase::Windup)
+    {
+        const float amount = Ease((kWindupTicks - cooldown) / static_cast<float>(kWindupTicks));
+        motion.capY = 1.2f * amount;
+    }
+    else if (GetAttackPhase(cooldown, glow) == AttackPhase::Release)
+    {
+        const float progress = std::clamp(kPulseFrames - glow, 0, kRecoilTicks) / static_cast<float>(kRecoilTicks);
+        if (progress < 0.4f)
+        {
+            const float amount = Ease(progress / 0.4f);
+            motion.capY = 1.2f + 0.8f * amount;
+        }
+        else
+        {
+            const float amount = 1.0f - Ease((progress - 0.4f) / 0.6f);
+            motion.capY = 2.0f * amount;
+        }
+    }
+    return motion;
+}
+
+constexpr bool AdvancePulse(int& cooldown, int& glow, bool hasTarget)
+{
+    if (glow > 0) --glow;
+    // Let the cooldown expire on an empty lawn, but reserve the wind-up for an
+    // actual target. Recheck each tick so a departing target cancels the shot.
+    if (!hasTarget && cooldown <= kReadyCountdown)
+    {
+        cooldown = kReadyCountdown;
+        return false;
+    }
+    if (cooldown > 0) --cooldown;
+    if (cooldown != 0) return false;
+    cooldown = kPulseInterval;
+    glow = kPulseFrames;
+    return true;
+}
+
+struct FrostTuft
+{
+    float distance = 0.0f;
+    float scale = 0.0f;
+    int alpha = 0;
+    int cel = 0;
+};
+
+constexpr FrostTuft GetFrostTuft(int glow, int index)
+{
+    FrostTuft tuft;
+    if (index < 0 || index >= 12 || glow <= 0) return tuft;
+    const int age = kPulseFrames - std::clamp(glow, 0, kPulseFrames);
+    const int delay = (index % 3) * 6;
+    const int localAge = age - delay;
+    const int life = kPulseFrames - delay;
+    if (localAge <= 0 || localAge >= life) return tuft;
+    const float travel = Ease(std::clamp(localAge / 55.0f, 0.0f, 1.0f));
+    const float fadeIn = std::clamp(localAge / 6.0f, 0.0f, 1.0f);
+    const float fadeOut = 1.0f - Ease(std::clamp((localAge - 45.0f) / (life - 45.0f), 0.0f, 1.0f));
+    tuft.distance = 12.0f + (kRadius - 12.0f) * travel;
+    tuft.scale = 0.35f + 0.25f * Ease(std::clamp(localAge / 55.0f, 0.0f, 1.0f));
+    tuft.alpha = static_cast<int>(160.0f * fadeIn * fadeOut);
+    tuft.cel = std::min(5, localAge / 16);
+    return tuft;
+}
+constexpr bool InRange(float dx, float dy)
+{
+    return dx * dx + dy * dy <= static_cast<float>(kRadius * kRadius);
+}
+static_assert(static_cast<int>(kSeed) == 75);
+}
diff --git a/src/Lawn/System/LightsOut.cpp b/src/Lawn/System/LightsOut.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0e48911f6fe2b2872ca5b792325608d61bb1c50a
--- /dev/null
+++ b/src/Lawn/System/LightsOut.cpp
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "LightsOut.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../CursorObject.h"
+#include "../../LawnApp.h"
+#include "PvzpLib/PvzpParticle.h"
+
+namespace LightsOut
+{
+Plant* GetPlantern(Board& board)
+{
+    for (Plant* plant:board.mPlants)
+        if (plant->mSeedType==SEED_PLANTERN && plant->mIsOnBoard && !plant->mDead &&
+            !plant->mSquished && plant->mPlantHealth>0 &&
+            plant->mOnBungeeState==NOT_ON_BUNGEE) return plant;
+    return nullptr;
+}
+const Plant* GetPlantern(const Board& board) { return GetPlantern(const_cast<Board&>(board)); }
+bool IsLit(const Board& board,int col,int row)
+{
+    const Plant* lamp=GetPlantern(board);
+    return lamp && IsCellLit(lamp->mPlantCol,lamp->mRow,col,row);
+}
+bool CanAttack(const Plant& plant)
+{
+    if (!plant.mApp || !IsMode(plant.mApp->mGameMode) || !plant.mBoard || !plant.mIsOnBoard) return true;
+    if (plant.mSeedType==SEED_PLANTERN || plant.mSeedType==SEED_WALLNUT) return true;
+    return IsLit(*plant.mBoard,plant.mPlantCol,plant.mRow);
+}
+void Populate(Board& board)
+{
+    for (const auto& entry:kStartingPlants) board.AddPlant(entry.mCol,entry.mRow,entry.mSeed,SEED_NONE);
+    board.mShowShovel=false;
+    board.mFogOffset=0;
+    board.mFogBlownCountDown=0;
+    for (auto& column:board.mGridCelFog) for (int& fog:column) fog=kFogOpacity;
+    board.UpdateFog();
+}
+void Update(Board& board)
+{
+    if (!board.mChallenge || !IsCurrentRules(board.mApp->mGameMode,board.mChallenge->mChallengeState)) return;
+    Plant* selected=board.mPlants.DataArrayTryToGet(board.mCursorObject->mGlovePlantID);
+    if (board.mCursorObject->mGlovePlantID!=PLANTID_NULL &&
+        (!selected || selected!=GetPlantern(board) || board.mLevelComplete || board.HasLevelAwardDropped()))
+    {
+        board.ClearCursor();
+        selected=nullptr;
+    }
+    if (board.mApp->mGameScene!=SCENE_PLAYING || board.mPaused || board.mTimeStopCounter>0 ||
+        board.mLevelComplete || board.HasLevelAwardDropped()) return;
+    if (board.mChallenge->mChallengeStateCounter>0) --board.mChallenge->mChallengeStateCounter;
+    if (selected) selected->mHighlighted=true;
+}
+bool MovePlantern(Board& board,Plant* plant,int col,int row)
+{
+    if (!board.mChallenge || !IsCurrentRules(board.mApp->mGameMode,board.mChallenge->mChallengeState) ||
+        board.mApp->mGameScene!=SCENE_PLAYING || board.mPaused || board.mTimeStopCounter>0 ||
+        board.mLevelComplete || board.HasLevelAwardDropped() || board.mChallenge->mChallengeStateCounter>0 ||
+        !plant || plant!=GetPlantern(board) || col!=kRailCol || row<0 || row>=kRows ||
+        (plant->mPlantCol==col && plant->mRow==row) || board.GetTopPlantAt(col,row,TOPPLANT_ANY) ||
+        board.CanPlantAt(col,row,SEED_PLANTERN)!=PLANTING_OK) return false;
+    const int oldX=plant->mX,oldY=plant->mY;
+    plant->mX=board.GridToPixelX(col,row);
+    plant->mY=board.GridToPixelY(col,row);
+    plant->mPlantCol=col;plant->mRow=row;plant->mStartRow=row;
+    plant->mRenderOrder=plant->CalcRenderOrder();
+    if (PvzpParticleSystem* particle=board.mApp->ParticleTryToGet(plant->mParticleID))
+        if (particle->mEmitterList.mSize)
+        {
+            PvzpParticleEmitter* emitter=particle->mParticleHolder->mEmitters.DataArrayGet(
+                static_cast<unsigned int>(particle->mEmitterList.GetHead()->mValue));
+            particle->SystemMove(emitter->mSystemCenter.x+plant->mX-oldX,emitter->mSystemCenter.y+plant->mY-oldY);
+        }
+    board.mChallenge->mChallengeStateCounter=kMoveCooldown;
+    board.DoPlantingEffects(col,row,plant);
+    board.UpdateFog();
+    return true;
+}
+}
diff --git a/src/Lawn/System/LightsOut.h b/src/Lawn/System/LightsOut.h
new file mode 100644
index 0000000000000000000000000000000000000000..ae5eacfe74dcd3ac569e24e508e9818941b05f45
--- /dev/null
+++ b/src/Lawn/System/LightsOut.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+
+class Board;
+class Plant;
+
+namespace LightsOut
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_LIGHTS_OUT;
+inline constexpr ChallengeState kState = static_cast<ChallengeState>(114);
+inline constexpr int kRows = 5;
+inline constexpr int kRailCol = 2;
+inline constexpr int kLightRadius = 2;
+inline constexpr int kMoveCooldown = 75;
+inline constexpr int kOpeningDelay = 1800;
+inline constexpr int kWaveCount = 8;
+inline constexpr int kLargestWave = 6;
+inline constexpr int kFogOpacity = 132;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state) { return IsMode(mode) && state == kState; }
+constexpr bool IsCellLit(int lampCol, int lampRow, int col, int row)
+{
+    const int dx = lampCol > col ? lampCol - col : col - lampCol;
+    const int dy = lampRow > row ? lampRow - row : row - lampRow;
+    return col >= 0 && col < 9 && row >= 0 && row < kRows && dx + dy <= kLightRadius;
+}
+struct StartingPlant { SeedType mSeed; int mCol; int mRow; };
+inline constexpr std::array<StartingPlant, 16> kStartingPlants = {{
+    {SEED_SNOWPEA,0,0}, {SEED_REPEATER,1,0}, {SEED_WALLNUT,4,0},
+    {SEED_SNOWPEA,0,1}, {SEED_REPEATER,1,1}, {SEED_WALLNUT,4,1},
+    {SEED_SNOWPEA,0,2}, {SEED_REPEATER,1,2}, {SEED_WALLNUT,4,2},
+    {SEED_SNOWPEA,0,3}, {SEED_REPEATER,1,3}, {SEED_WALLNUT,4,3},
+    {SEED_SNOWPEA,0,4}, {SEED_REPEATER,1,4}, {SEED_WALLNUT,4,4},
+    {SEED_PLANTERN,kRailCol,2}
+}};
+struct Spawn { ZombieType mType = ZOMBIE_INVALID; int mRow = 0; };
+using Wave = std::array<Spawn,kLargestWave>;
+// The first lone walker teaches the bright center lane; the next pair asks for
+// the first relocation. Later simultaneous lanes make the lamp a shared resource.
+inline constexpr std::array<Wave,kWaveCount> kWaves = {{
+    {{{ZOMBIE_NORMAL,2}}},
+    {{{ZOMBIE_NORMAL,4},{ZOMBIE_NORMAL,4}}},
+    {{{ZOMBIE_NORMAL,0},{ZOMBIE_TRAFFIC_CONE,0},{ZOMBIE_NORMAL,1}}},
+    {{{ZOMBIE_TRAFFIC_CONE,4},{ZOMBIE_NORMAL,3},{ZOMBIE_NORMAL,4}}},
+    {{{ZOMBIE_TRAFFIC_CONE,1},{ZOMBIE_NORMAL,3},{ZOMBIE_TRAFFIC_CONE,3}}},
+    {{{ZOMBIE_TRAFFIC_CONE,4},{ZOMBIE_NORMAL,0},{ZOMBIE_TRAFFIC_CONE,0},{ZOMBIE_NORMAL,2}}},
+    {{{ZOMBIE_TRAFFIC_CONE,0},{ZOMBIE_TRAFFIC_CONE,4},{ZOMBIE_NORMAL,1},{ZOMBIE_TRAFFIC_CONE,3}}},
+    {{{ZOMBIE_FLAG,2},{ZOMBIE_TRAFFIC_CONE,0},{ZOMBIE_NORMAL,0},{ZOMBIE_TRAFFIC_CONE,4},{ZOMBIE_NORMAL,4},{ZOMBIE_NORMAL,2}}}
+}};
+constexpr int ZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kWaveCount) return 0;
+    int count=0;
+    for (const auto& spawn:kWaves[wave]) if (spawn.mType!=ZOMBIE_INVALID) ++count;
+    return count;
+}
+constexpr int RowForSpawn(int wave,int ordinal)
+{
+    return wave>=0 && wave<kWaveCount && ordinal>=0 && ordinal<ZombieCount(wave) ? kWaves[wave][ordinal].mRow : -1;
+}
+template<std::size_t Waves,std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves>=kWaveCount && Slots>kLargestWave);
+    for (auto& wave:output) for (auto& zombie:wave) zombie=ZOMBIE_INVALID;
+    for (int wave=0;wave<kWaveCount;++wave)
+        for (int ordinal=0;ordinal<ZombieCount(wave);++ordinal) output[wave][ordinal]=kWaves[wave][ordinal].mType;
+    return kWaveCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count>static_cast<std::size_t>(ZOMBIE_DOOR));
+    for (auto& allowed:output) allowed=false;
+    for (const auto& wave:kWaves) for (const auto& spawn:wave)
+        if (spawn.mType!=ZOMBIE_INVALID) output[spawn.mType]=true;
+}
+Plant* GetPlantern(Board& board);
+const Plant* GetPlantern(const Board& board);
+bool IsLit(const Board& board,int col,int row);
+bool CanAttack(const Plant& plant);
+void Populate(Board& board);
+void Update(Board& board);
+bool MovePlantern(Board& board,Plant* plant,int col,int row);
+static_assert(static_cast<int>(kMode)==82);
+}
diff --git a/src/Lawn/System/LightsOutPresentation.cpp b/src/Lawn/System/LightsOutPresentation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0f106c531cd496b41000c853a47da7d8c42a40bb
--- /dev/null
+++ b/src/Lawn/System/LightsOutPresentation.cpp
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "LightsOutPresentation.h"
+#include "../../LawnApp.h"
+#include "../../Resources.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "graphics/Graphics.h"
+#include "graphics/MemoryImage.h"
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+namespace LightsOutPresentation
+{
+namespace
+{
+std::unique_ptr<Sexy::MemoryImage> sCard;
+
+std::unique_ptr<Sexy::MemoryImage> Blank(int width, int height)
+{
+    std::vector<uint32_t> pixels(width * height, 0);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+Sexy::Rect VisibleBounds(Sexy::MemoryImage& image)
+{
+    int left = image.GetWidth(), top = image.GetHeight(), right = -1, bottom = -1;
+    const uint32_t* pixels = image.GetBits();
+    for (int y = 0; y < image.GetHeight(); ++y)
+        for (int x = 0; x < image.GetWidth(); ++x)
+            if ((pixels[y * image.GetWidth() + x] >> 24) > 8)
+            {
+                left = std::min(left, x); top = std::min(top, y);
+                right = std::max(right, x); bottom = std::max(bottom, y);
+            }
+    return right < left ? Sexy::Rect() : Sexy::Rect(left, top, right - left + 1, bottom - top + 1);
+}
+}
+
+Sexy::Image* GetBonusImage()
+{
+    if (sCard) return sCard.get();
+    if (!PvzpLoadResources("DelayLoad_Background2") || !PvzpLoadResources("DelayLoad_Background4") ||
+        !Sexy::IMAGE_BACKGROUND2 || !Sexy::IMAGE_FOG_SOFTWARE)
+        return nullptr;
+
+    auto portrait = Blank(180, 180);
+    Sexy::Graphics native(portrait.get());
+    native.SetLinearBlend(true);
+    Reanimation plantern;
+    plantern.ReanimationInitializeType(40.0f, 35.0f, REANIM_PLANTERN);
+    plantern.SetFramesForLayer("anim_idle");
+    plantern.Draw(&native);
+    const Sexy::Rect bounds = VisibleBounds(*portrait);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return nullptr;
+
+    auto card = Blank(80, 65);
+    Sexy::Graphics picture(card.get());
+    picture.SetLinearBlend(true);
+    picture.ClipRect(0, 0, 80, 65);
+    picture.DrawImage(Sexy::IMAGE_BACKGROUND2, Sexy::Rect(0, 0, 80, 65), Sexy::Rect(400, 140, 480, 390));
+
+    // Two original mist cels frame the light. They remain behind the native
+    // plant so the complete Plantern silhouette and face stay readable.
+    Sexy::Image* fog = Sexy::IMAGE_FOG_SOFTWARE;
+    const Sexy::Rect fogCel(0, 0, fog->GetCelWidth(), fog->GetCelHeight());
+    picture.SetColorizeImages(true);
+    picture.SetColor(Sexy::Color(255, 255, 255, 150));
+    const float fogScale = 0.6f;
+    const int fogWidth = static_cast<int>(fogCel.mWidth * fogScale);
+    const int fogHeight = static_cast<int>(fogCel.mHeight * fogScale);
+    picture.DrawImage(fog, Sexy::Rect(-26, -14, fogWidth, fogHeight), fogCel);
+    picture.DrawImage(fog, Sexy::Rect(58, -9, fogWidth, fogHeight), fogCel);
+    picture.SetColorizeImages(false);
+
+    const float scale = std::min(68.0f / bounds.mWidth, 57.0f / bounds.mHeight);
+    PvzpDrawImageScaledF(&picture, portrait.get(),
+        40.0f - (bounds.mX + bounds.mWidth * 0.5f) * scale,
+        32.5f - (bounds.mY + bounds.mHeight * 0.5f) * scale, scale, scale);
+    sCard = std::move(card);
+    return sCard.get();
+}
+
+void DisposeImage() { sCard.reset(); }
+}
