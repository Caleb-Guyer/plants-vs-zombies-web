+void Board::SpawnZombieWave()
+{
+	mChallenge->SpawnZombieWave();
+	if (mApp->IsBungeeBlitzLevel())
+	{
+		BungeeDropGrid aBungeeDropGrid;
+		SetupBungeeDrop(&aBungeeDropGrid);
+		for (int i = 0; i < MAX_ZOMBIES_IN_WAVE; i++)
+		{
+			ZombieType aZombieType = mZombiesInWave[mCurrentWave][i];
+			if (aZombieType == ZombieType::ZOMBIE_INVALID)
+				break;
+
+			if (aZombieType == ZombieType::ZOMBIE_BUNGEE || aZombieType == ZombieType::ZOMBIE_ZAMBONI)
+			{
+				AddZombie(aZombieType, mCurrentWave);
+			}
+			else
+			{
+				BungeeDropZombie(&aBungeeDropGrid, aZombieType);
+			}
+		}
+	}
+    else if (RallyZombie::IsMode(mApp->mGameMode))
+    {
+        for (int i = 0; i < MAX_ZOMBIES_IN_WAVE; ++i)
+        {
+            const ZombieType type = mZombiesInWave[mCurrentWave][i];
+            if (type == ZOMBIE_INVALID) break;
+            const int row = RallyZombie::RowForSpawn(mCurrentWave, i);
+            if (row >= 0) AddZombieInRow(type, row, mCurrentWave);
+        }
+    }
+    else if (SeedSwap::IsMode(mApp->mGameMode))
+    {
+        for (int i = 0; i < MAX_ZOMBIES_IN_WAVE; ++i)
+        {
+            const ZombieType type = mZombiesInWave[mCurrentWave][i];
+            if (type == ZOMBIE_INVALID) break;
+            const int row = SeedSwap::RowForSpawn(mCurrentWave, i);
+            if (row >= 0) AddZombieInRow(type, row, mCurrentWave);
+        }
+    }
+    else if (IntensiveCare::IsMode(mApp->mGameMode))
+    {
+        for (int i = 0; i < MAX_ZOMBIES_IN_WAVE; ++i)
+        {
+            const ZombieType type = mZombiesInWave[mCurrentWave][i];
+            if (type == ZOMBIE_INVALID) break;
+            const int row = IntensiveCare::RowForSpawn(mCurrentWave, i);
+            if (row >= 0) AddZombieInRow(type, row, mCurrentWave);
+        }
+    }
+    else if (LightsOut::IsMode(mApp->mGameMode))
+    {
+        for (int i=0; i<MAX_ZOMBIES_IN_WAVE; ++i)
+        {
+            const ZombieType type=mZombiesInWave[mCurrentWave][i];
+            if (type==ZOMBIE_INVALID) break;
+            const int row=LightsOut::RowForSpawn(mCurrentWave,i);
+            if (row>=0) AddZombieInRow(type,row,mCurrentWave);
+        }
+    }
+    else if (GardenShuffle::IsMode(mApp->mGameMode))
+    {
+        // Authored lane pairs make relocation the challenge; native walking
+        // gives ample visible approach time instead of instant lane attacks.
+        for (int i = 0; i < MAX_ZOMBIES_IN_WAVE; ++i)
+        {
+            const ZombieType type = mZombiesInWave[mCurrentWave][i];
+            if (type == ZOMBIE_INVALID) break;
+            const int row = GardenShuffle::RowForSpawn(mCurrentWave, i);
+            if (row >= 0) AddZombieInRow(type, row, mCurrentWave);
+        }
+    }
+	else
+	{
+		PVZP_ASSERT(mCurrentWave >= 0 && mCurrentWave < MAX_ZOMBIE_WAVES && mCurrentWave < mNumWaves);
+		for (int i = 0; i < MAX_ZOMBIES_IN_WAVE; i++)
+		{
+			ZombieType aZombieType = mZombiesInWave[mCurrentWave][i];
+			if (aZombieType == ZombieType::ZOMBIE_INVALID)
+				break;
+
+			if (aZombieType == ZombieType::ZOMBIE_BOBSLED && !CanAddBobSled())
+			{
+				for (int i = 0; i < MAX_ZOMBIE_FOLLOWERS; i++)
+				{
+					AddZombie(ZombieType::ZOMBIE_NORMAL, mCurrentWave);  // spawn 4 normal zombies instead of the bobsled team
+				}
+			}
+			else
+			{
+				AddZombie(aZombieType, mCurrentWave);
+			}
+		}
+	}
+
+	if (mCurrentWave == mNumWaves - 1 && !mApp->IsContinuousChallenge() && !LightsOut::IsMode(mApp->mGameMode) && !GardenShuffle::IsMode(mApp->mGameMode) && !SeedSwap::IsMode(mApp->mGameMode) && !IntensiveCare::IsMode(mApp->mGameMode) &&
+        !(NightShift::IsMode(mApp->mGameMode) && BonusChallenge::IsCurrentRules(mApp->mGameMode, mChallenge->mChallengeState)))
+	{
+		mRiseFromGraveCounter = 200;
+	}
+	if (IsFlagWave(mCurrentWave))
+	{
+		mFlagRaiseCounter = FLAG_RAISE_TIME;
+	}
+	mCurrentWave++;
+	mTotalSpawnedWaves++;
+}
