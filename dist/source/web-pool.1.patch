+		Graphics aScreenSpace(*g);
+		aScreenSpace.mTransX -= mX;
+		aScreenSpace.mTransY -= mY;
+		mApp->DrawCrazyDave(&aScreenSpace);
+	}
+
+	if (mAdvice->mMessageStyle != MessageStyle::MESSAGE_STYLE_SLOT_MACHINE &&
+        !((IntensiveCare::IsMode(mApp->mGameMode) || ChainReaction::IsMode(mApp->mGameMode) || GarlicRun::IsMode(mApp->mGameMode)) && mPaused))
+	{
+		if (ChainReaction::IsMode(mApp->mGameMode) && mAdvice->mMessageStyle == MessageStyle::MESSAGE_STYLE_HINT_FAST)
+		{
+			Graphics aAdviceGraphics(*g);
+			aAdviceGraphics.Translate(0, -64);
+			mAdvice->Draw(&aAdviceGraphics);
+		}
+		else
+		{
+			mAdvice->Draw(g);
+		}
+	}
+
+	if (mTimeStopCounter == 0 && mCursorObject->BeginDraw(g))
+	{
+		mCursorObject->Draw(g);
+		mCursorObject->EndDraw(g);
+	}
+
+	mToolTip->Draw(g);
+	DrawDebugText(g);
+	DrawDebugObjectRects(g);
