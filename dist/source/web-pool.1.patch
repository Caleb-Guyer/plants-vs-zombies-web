@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "DeckPresets.h"
+#include "PlayerInfo.h"
+#include "../../LawnApp.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "misc/Buffer.h"
+#include <format>
+
+static std::string DeckFile(LawnApp* app)
+{
+    return GetAppDataPath(std::format("userdata/qol-decks-{}.txt", app->mPlayerInfo->mId));
+}
+
+bool DeckPresets::Load(LawnApp* app)
+{
+    if (!app || !app->mPlayerInfo) return false;
+    Sexy::Buffer buffer;
+    if (!app->ReadBufferFromFile(DeckFile(app), &buffer)) return true;
+    if (buffer.GetDataLen() < 0 || buffer.GetDataLen() > 8192) return false;
+    return Decode(std::string(reinterpret_cast<const char*>(buffer.GetDataPtr()), buffer.GetDataLen()));
+}
+
+bool DeckPresets::Save(LawnApp* app) const
+{
+    if (!app || !app->mPlayerInfo) return false;
+    const std::string text = Encode();
+    DeckPresets validated;
+    if (!validated.Decode(text)) return false;
+    MkDir(GetAppDataPath("userdata"));
+    return app->WriteBytesToFile(DeckFile(app), text.data(), static_cast<unsigned long>(text.size()));
+}
diff --git a/src/Lawn/System/DeckPresets.h b/src/Lawn/System/DeckPresets.h
new file mode 100644
index 0000000000000000000000000000000000000000..d038b99f47447a2afff893da7b1baf1e42395785
--- /dev/null
+++ b/src/Lawn/System/DeckPresets.h
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#ifndef PVZ_DECK_PRESETS_H
+#define PVZ_DECK_PRESETS_H
+
+#include <array>
+#include <iomanip>
+#include <sstream>
+#include <string>
+#include <vector>
+
+class LawnApp;
+
+struct DeckPresetSeed
+{
+    int mSeed = -1;
+    int mImitater = -1;
+    bool operator==(const DeckPresetSeed&) const = default;
+};
+
+struct DeckPreset
+{
+    std::string mName;
+    std::vector<DeckPresetSeed> mSeeds;
+};
+
+struct DeckSelectionPlan
+{
+    std::vector<DeckPresetSeed> mSeeds;
+    int mUnavailable = 0;
+    int mOverflow = 0;
+};
+
+template<class Available>
+DeckSelectionPlan PlanDeckSelection(const std::vector<DeckPresetSeed>& desired,
+    const std::vector<DeckPresetSeed>& forced, int capacity, Available canUse)
+{
+    DeckSelectionPlan plan;
+    capacity = capacity < 0 ? 0 : capacity > 10 ? 10 : capacity;
+    for (const auto& seed : forced)
+        if (static_cast<int>(plan.mSeeds.size()) < capacity) plan.mSeeds.push_back(seed);
+    for (const auto& seed : desired)
+    {
+        bool duplicate = false;
+        for (const auto& selected : plan.mSeeds) if (selected.mSeed == seed.mSeed) duplicate = true;
+        if (duplicate) continue;
+        if (!canUse(seed)) { ++plan.mUnavailable; continue; }
+        if (static_cast<int>(plan.mSeeds.size()) >= capacity) { ++plan.mOverflow; continue; }
+        plan.mSeeds.push_back(seed);
+    }
+    return plan;
+}
+
+// Pure versioned model: no native profile, board, or unlock data is changed.
+class DeckPresets
+{
+public:
+    static constexpr int SLOT_COUNT = 8;
+    static constexpr int MAX_NAME = 18;
+    std::array<DeckPreset, SLOT_COUNT> mDecks;
+
+    DeckPresets()
+    {
+        const char* names[] = {"Day", "Night", "Pool", "Roof", "Deck 5", "Deck 6", "Deck 7", "Deck 8"};
+        for (int i = 0; i < SLOT_COUNT; ++i) mDecks[i].mName = names[i];
+    }
+
+    static std::string CleanName(std::string name)
+    {
+        std::string result;
+        for (unsigned char ch : name)
+        {
+            if (ch >= 32 && ch < 127 && result.size() < MAX_NAME) result += static_cast<char>(ch);
+        }
+        while (!result.empty() && result.front() == ' ') result.erase(result.begin());
+        while (!result.empty() && result.back() == ' ') result.pop_back();
+        return result;
+    }
+
+    static bool ValidSeed(const DeckPresetSeed& seed)
+    {
+        return ((seed.mSeed >= 0 && seed.mSeed < 49) || seed.mSeed == 75 || seed.mSeed == 76) &&
+            (seed.mSeed == 48 ? seed.mImitater >= 0 && seed.mImitater < 40 : seed.mImitater == -1);
+    }
+
+    static bool ValidSeeds(const std::vector<DeckPresetSeed>& seeds)
+    {
+        if (seeds.size() > 10) return false;
+        std::array<bool, 51> used{};
+        for (const auto& seed : seeds)
+        {
+            if (!ValidSeed(seed)) return false;
+            const int index = seed.mSeed == 75 ? 49 : seed.mSeed == 76 ? 50 : seed.mSeed;
+            if (used[index]) return false;
+            used[index] = true;
+        }
+        return true;
+    }
+
+    std::string Encode() const
+    {
+        std::ostringstream stream;
+        stream << "PVZDECKS 1\n" << SLOT_COUNT << '\n';
+        for (const auto& deck : mDecks)
+        {
+            stream << std::quoted(deck.mName) << ' ' << deck.mSeeds.size();
+            for (const auto& seed : deck.mSeeds) stream << ' ' << seed.mSeed << ' ' << seed.mImitater;
+            stream << '\n';
+        }
+        return stream.str();
+    }
+
+    bool Decode(const std::string& text)
+    {
+        if (text.size() > 8192) return false;
+        std::istringstream stream(text);
+        std::string magic;
+        int version = 0, slots = 0;
+        if (!(stream >> magic >> version >> slots) || magic != "PVZDECKS" || version != 1 || slots != SLOT_COUNT) return false;
+        DeckPresets parsed;
+        for (auto& deck : parsed.mDecks)
+        {
+            int count = -1;
+            if (!(stream >> std::quoted(deck.mName) >> count) || count < 0 || count > 10 ||
+                deck.mName.empty() || deck.mName != CleanName(deck.mName)) return false;
+            for (int i = 0; i < count; ++i)
+            {
+                DeckPresetSeed seed;
+                if (!(stream >> seed.mSeed >> seed.mImitater)) return false;
+                deck.mSeeds.push_back(seed);
+            }
+            if (!ValidSeeds(deck.mSeeds)) return false;
+        }
+        stream >> std::ws;
+        if (!stream.eof()) return false;
+        *this = parsed;
+        return true;
+    }
+
+    bool Load(LawnApp* app);
+    bool Save(LawnApp* app) const;
+};
+
+#endif
diff --git a/src/Lawn/System/GardenShuffle.h b/src/Lawn/System/GardenShuffle.h
new file mode 100644
index 0000000000000000000000000000000000000000..7a2a34f45a84db4377399496153d49de79e0a9fa
--- /dev/null
+++ b/src/Lawn/System/GardenShuffle.h
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+
+// A small, fixed garden faces authored lanes. Combat plants are moved in place,
+// never rebuilt: their native IDs, health and attack clocks survive a move.
+namespace GardenShuffle
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_GARDEN_SHUFFLE;
+inline constexpr ChallengeState kState = static_cast<ChallengeState>(103);
+inline constexpr int kMoveCooldown = 100;
+inline constexpr int kOpeningDelay = 1800;
+inline constexpr int kWaveCount = 10;
+inline constexpr int kLargestWave = 6;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state) { return IsMode(mode) && state == kState; }
+constexpr bool CanMoveSeed(SeedType seed)
+{
+    return seed == SEED_REPEATER || seed == SEED_SNOWPEA || seed == SEED_WALLNUT;
+}
+
+struct StartingPlant
+{
+    SeedType mSeed;
+    int mCol;
+    int mRow;
+};
+inline constexpr std::array<StartingPlant, 6> kStartingPlants = {{
+    {SEED_REPEATER, 1, 1}, {SEED_REPEATER, 2, 1},
+    {SEED_REPEATER, 1, 3}, {SEED_SNOWPEA, 1, 2},
+    {SEED_WALLNUT, 5, 1}, {SEED_WALLNUT, 5, 3}
+}};
+
+struct Spawn
+{
+    ZombieType mType = ZOMBIE_INVALID;
+    int mRow = 0;
+};
+using Wave = std::array<Spawn, kLargestWave>;
+
+// Early pairs allow time to learn the glove. Later waves rotate among three
+// lanes; the final flag adds a third lane rather than an unseen speed spike.
+inline constexpr std::array<Wave, kWaveCount> kWaves = {{
+    {{{ZOMBIE_NORMAL,1}, {ZOMBIE_NORMAL,3}}},
+    {{{ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,4}, {ZOMBIE_NORMAL,0}}},
+    {{{ZOMBIE_NORMAL,2}, {ZOMBIE_TRAFFIC_CONE,2}, {ZOMBIE_NORMAL,4}}},
+    {{{ZOMBIE_NORMAL,0}, {ZOMBIE_TRAFFIC_CONE,3}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,0}}},
+    {{{ZOMBIE_NORMAL,1}, {ZOMBIE_TRAFFIC_CONE,4}, {ZOMBIE_NORMAL,4}, {ZOMBIE_NORMAL,1}}},
+    {{{ZOMBIE_DOOR,2}, {ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,2}, {ZOMBIE_TRAFFIC_CONE,0}}},
+    {{{ZOMBIE_NORMAL,3}, {ZOMBIE_POLEVAULTER,1}, {ZOMBIE_NORMAL,1}, {ZOMBIE_TRAFFIC_CONE,3}}},
+    {{{ZOMBIE_PAIL,4}, {ZOMBIE_NORMAL,2}, {ZOMBIE_NORMAL,4}, {ZOMBIE_TRAFFIC_CONE,2}, {ZOMBIE_NORMAL,0}}},
+    {{{ZOMBIE_DOOR,0}, {ZOMBIE_TRAFFIC_CONE,3}, {ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,1}}},
+    {{{ZOMBIE_FLAG,2}, {ZOMBIE_TRAFFIC_CONE,0}, {ZOMBIE_NORMAL,0}, {ZOMBIE_TRAFFIC_CONE,4}, {ZOMBIE_NORMAL,4}, {ZOMBIE_NORMAL,2}}}
+}};
+
+constexpr int ZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kWaveCount) return 0;
+    int count = 0;
+    for (const Spawn& spawn : kWaves[wave]) if (spawn.mType != ZOMBIE_INVALID) ++count;
+    return count;
+}
+constexpr int RowForSpawn(int wave, int ordinal)
+{
+    return wave >= 0 && wave < kWaveCount && ordinal >= 0 && ordinal < ZombieCount(wave)
+        ? kWaves[wave][ordinal].mRow : -1;
+}
+constexpr int ComposeWave(int wave, ZombieType* output, int capacity)
+{
+    if (wave < 0 || wave >= kWaveCount || !output || capacity <= ZombieCount(wave)) return -1;
+    for (int i = 0; i < capacity; ++i) output[i] = ZOMBIE_INVALID;
+    int count = 0;
+    for (const Spawn& spawn : kWaves[wave])
+        if (spawn.mType != ZOMBIE_INVALID) output[count++] = spawn.mType;
+    return count;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestWave);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int i = 0; i < kWaveCount; ++i) ComposeWave(i, output[i], static_cast<int>(Slots));
+    return kWaveCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_DOOR));
+    for (auto& allowed : output) allowed = false;
+    for (const Wave& wave : kWaves)
+        for (const Spawn& spawn : wave)
+            if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+
+static_assert(static_cast<int>(kMode) == 76);
+static_assert(ZombieCount(0) == 2 && ZombieCount(kWaveCount - 1) == kLargestWave);
+}
diff --git a/src/Lawn/System/GarlicRun.cpp b/src/Lawn/System/GarlicRun.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3c8d44bf0eeccaab6e16e4e0452ecc037bf63db3
--- /dev/null
+++ b/src/Lawn/System/GarlicRun.cpp
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "GarlicRun.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include "../SeedPacket.h"
+#include "../CursorObject.h"
+#include "../Coin.h"
+#include "../GridItem.h"
+#include "../Widget/GameButton.h"
+#include "../../LawnApp.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "../../PvzpLib/PvzpParticle.h"
+#include <algorithm>
+#include <format>
+
+namespace GarlicRun
+{
+bool IsPlanning(const Board& board)
+{
+    return board.mApp && board.mChallenge && IsPlanning(board.mApp->mGameMode, board.mChallenge->mChallengeState);
+}
+bool CanMove(const Plant& plant)
+{
+    return plant.mBoard && plant.mSeedType == SEED_GARLIC && plant.mIsOnBoard &&
+        !plant.mDead && !plant.mSquished && plant.mPlantHealth > 0 && plant.mOnBungeeState == NOT_ON_BUNGEE;
+}
+bool HoldsZombie(Zombie& zombie)
+{
+    return zombie.mBoard && IsPlanning(*zombie.mBoard) && zombie.IsOnBoard() && !zombie.IsDeadOrDying();
+}
+std::string LevelLabel(int stage)
+{
+    return std::format("Garlic Run - {}/{}", std::clamp(stage + 1, 1, kBoardCount), kBoardCount);
+}
+void RestoreButton(Board& board)
+{
+    if (!board.mStoreButton) return;
+    GameButton* button = board.mStoreButton.get();
+    const bool planning = IsPlanning(board);
+    button->mParentWidget = &board;
+    button->mBtnNoDraw = !planning;
+    button->mDisabled = !planning;
+    button->SetLabel("[LETS_ROCK_BUTTON]");
+    button->Resize(224, 12, 210, 46);
+}
+void Populate(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    const int stage = std::clamp(challenge.mSurvivalStage, 0, kBoardCount - 1);
+    challenge.mSurvivalStage = stage;
+    challenge.mChallengeState = kPlanning;
+    challenge.mChallengeStateCounter = 0;
+    board.mCurrentWave = 0;
+    board.mZombieCountDown = board.mZombieCountDownStart = 100000;
+    board.mShowShovel = false;
+    board.mSunMoney = 0;
+    board.mSeedBank->mNumPackets = 0;
+    board.ClearCursor();
+    for (int row : {1, 3})
+    {
+        for (int col : {2, 3, 4}) board.AddPlant(col, row, SEED_SPIKEWEED, SEED_NONE);
+        // Keep the native unarmed pose and 1500-tick fuse. Only preparation
+        // pauses that fuse; Let's Rock starts ordinary mine behavior.
+        board.AddPlant(1, row, SEED_POTATOMINE, SEED_NONE);
+    }
+    for (const Cell& cell : kBoards[stage].mGarlic)
+        if (cell.mCol >= 0) board.AddPlant(cell.mCol, cell.mRow, SEED_GARLIC, SEED_NONE);
+    for (const Spawn& spawn : kBoards[stage].mZombies)
+    {
+        if (spawn.mType == ZOMBIE_INVALID) continue;
+        Zombie* zombie = board.AddZombieInRow(spawn.mType, spawn.mRow, 0);
+        zombie->mPosX = static_cast<float>(spawn.mX);
+        zombie->mX = spawn.mX;
+        if (Reanimation* body = board.mApp->ReanimationTryToGet(zombie->mBodyReanimID))
+        {
+            if (body->TrackExists("anim_idle")) zombie->PlayZombieReanim("anim_idle", REANIM_LOOP, 0, 12.0f);
+            else body->mAnimRate = 0.0f;
+        }
+        zombie->UpdateReanim();
+    }
+    // Native intro camera finishes before the preparation control is shown.
+    board.mStoreButton->mBtnNoDraw = true;
+    board.mStoreButton->mDisabled = true;
+}
+void ResetStage(Board& board, int stage)
+{
+    for (Zombie* zombie : board.mZombies) if (!zombie->mDead) zombie->DieNoLoot();
+    for (Plant* plant : board.mPlants) if (!plant->mDead) plant->Die();
+    for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+    for (GridItem* item : board.mGridItems) if (!item->mDead) item->GridItemDie();
+    board.mChallenge->mSurvivalStage = std::clamp(stage, 0, kBoardCount - 1);
+    Populate(board);
+}
+void Commit(Board& board)
+{
+    if (!IsPlanning(board) || board.mApp->mGameScene != SCENE_PLAYING || board.mPaused ||
+        board.mTimeStopCounter > 0 || board.HasLevelAwardDropped()) return;
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    board.mChallenge->mChallengeState = kActive;
+    board.mStoreButton->mBtnNoDraw = true;
+    board.mStoreButton->mDisabled = true;
+    for (Zombie* zombie : board.mZombies)
+        if (!zombie->mDead && !zombie->IsDeadOrDying()) zombie->StartWalkAnim(0);
+}
+void Update(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (!IsCurrentRules(board.mApp->mGameMode, challenge.mChallengeState)) return;
+    Plant* selected = board.mPlants.DataArrayTryToGet(board.mCursorObject->mGlovePlantID);
+    if (board.mCursorObject->mGlovePlantID != PLANTID_NULL &&
+        (!selected || !CanMove(*selected) || !CanMoveInState(challenge.mChallengeState) ||
+            board.mLevelComplete || board.HasLevelAwardDropped()))
+    {
+        board.ClearCursor();
+        selected = nullptr;
+    }
+    if (board.mApp->mGameScene != SCENE_PLAYING || board.mPaused || board.mTimeStopCounter > 0 ||
+        board.mLevelComplete || board.HasLevelAwardDropped()) return;
+    board.mShowShovel = false;
+    if (CanMoveInState(challenge.mChallengeState) && challenge.mChallengeStateCounter > 0)
+        --challenge.mChallengeStateCounter;
+    if (selected) selected->mHighlighted = true;
+    if (challenge.mChallengeState == kPlanning)
+    {
+        if (board.mStoreButton->mBtnNoDraw) RestoreButton(board);
+        return;
+    }
+    if (challenge.mChallengeState == kTransition)
+    {
+        if (--challenge.mChallengeStateCounter > 0) return;
+        challenge.PuzzleNextStageClear();
+        for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+        Populate(board);
+        return;
+    }
+    if (challenge.mChallengeState != kActive || board.AreEnemyZombiesOnScreen()) return;
+    board.ClearCursor();
+    if (challenge.mSurvivalStage == kBoardCount - 1)
+    {
+        challenge.mChallengeState = kFinished;
+        challenge.SpawnLevelAward(4, 2);
+    }
+    else
+    {
+        challenge.mChallengeState = kTransition;
+        challenge.mChallengeStateCounter = kTransitionTicks;
+    }
+}
+bool MoveGarlic(Board& board, Plant* plant, int col, int row)
+{
+    if (!board.mChallenge || !IsCurrentRules(board.mApp->mGameMode, board.mChallenge->mChallengeState) ||
+        !CanMoveInState(board.mChallenge->mChallengeState) || board.mApp->mGameScene != SCENE_PLAYING ||
+        board.mPaused || board.mTimeStopCounter > 0 || board.mLevelComplete || board.HasLevelAwardDropped() ||
+        board.mChallenge->mChallengeStateCounter > 0 || !plant || plant->mBoard != &board || !CanMove(*plant) ||
+        col < 0 || col >= 9 || row < 0 || row >= 5 || (plant->mPlantCol == col && plant->mRow == row) ||
+        board.GetTopPlantAt(col, row, TOPPLANT_ANY) || board.CanPlantAt(col, row, SEED_GARLIC) != PLANTING_OK) return false;
+    const int oldX = plant->mX, oldY = plant->mY;
+    plant->mX = board.GridToPixelX(col, row);
+    plant->mY = board.GridToPixelY(col, row);
+    plant->mPlantCol = col;
+    plant->mRow = plant->mStartRow = row;
+    plant->mRenderOrder = plant->CalcRenderOrder();
+    if (PvzpParticleSystem* particle = board.mApp->ParticleTryToGet(plant->mParticleID))
+        if (particle->mEmitterList.mSize)
+        {
+            PvzpParticleEmitter* emitter = particle->mParticleHolder->mEmitters.DataArrayGet(
+                static_cast<unsigned int>(particle->mEmitterList.GetHead()->mValue));
+            particle->SystemMove(emitter->mSystemCenter.x + plant->mX - oldX, emitter->mSystemCenter.y + plant->mY - oldY);
+        }
+    board.mChallenge->mChallengeStateCounter = kMoveCooldown;
+    board.DoPlantingEffects(col, row, plant);
+    return true;
+}
+}
diff --git a/src/Lawn/System/GarlicRun.h b/src/Lawn/System/GarlicRun.h
new file mode 100644
index 0000000000000000000000000000000000000000..07f06876727b2506caa056d9696aa0a0d8684cbd
--- /dev/null
+++ b/src/Lawn/System/GarlicRun.h
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+#include <string>
+
+class Board;
+class Plant;
+class Zombie;
+
+// A finite routing puzzle using the original Garlic, Spikeweed and Potato Mine
+// mechanics. Existing native board/actor fields carry every saved state.
+namespace GarlicRun
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_GARLIC_RUN;
+inline constexpr ChallengeState kPlanning = static_cast<ChallengeState>(115);
+inline constexpr ChallengeState kActive = static_cast<ChallengeState>(116);
+inline constexpr ChallengeState kTransition = static_cast<ChallengeState>(117);
+inline constexpr ChallengeState kFinished = static_cast<ChallengeState>(118);
+inline constexpr int kBoardCount = 5;
+inline constexpr int kTransitionTicks = 180;
+inline constexpr int kMoveCooldown = 75;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{
+    return IsMode(mode) && state >= kPlanning && state <= kFinished;
+}
+constexpr bool IsPlanning(GameMode mode, ChallengeState state) { return IsMode(mode) && state == kPlanning; }
+constexpr bool CanMoveInState(ChallengeState state) { return state == kPlanning || state == kActive; }
+
+struct Cell { int mCol = -1; int mRow = -1; };
+struct Spawn { ZombieType mType = ZOMBIE_INVALID; int mRow = 0; int mX = 0; };
+struct Puzzle { std::array<Cell, 2> mGarlic; std::array<Spawn, 6> mZombies; };
+// Never use the top lawn row: native zombie heads remain below the header.
+// Interior diversions keep their native random direction; BOTH destinations
+// have a trap corridor, while the bottom edge has only one legal diversion.
+inline constexpr std::array<Puzzle, kBoardCount> kBoards = {{
+    {{{{6,2}, {-1,-1}}}, {{{ZOMBIE_NORMAL,4,620}, {ZOMBIE_TRAFFIC_CONE,4,940}}}},
+    {{{{6,4}, {-1,-1}}}, {{{ZOMBIE_NORMAL,2,620}, {ZOMBIE_TRAFFIC_CONE,2,940}}}},
+    {{{{6,2}, {-1,-1}}}, {{{ZOMBIE_NORMAL,2,620}, {ZOMBIE_NORMAL,4,900}, {ZOMBIE_TRAFFIC_CONE,2,1180}}}},
+    {{{{6,1}, {6,3}}}, {{{ZOMBIE_NORMAL,2,620}, {ZOMBIE_NORMAL,4,620},
+        {ZOMBIE_NORMAL,2,940}, {ZOMBIE_TRAFFIC_CONE,4,940}}}},
+    {{{{6,1}, {6,3}}}, {{{ZOMBIE_TRAFFIC_CONE,2,620}, {ZOMBIE_NORMAL,4,620},
+        {ZOMBIE_NORMAL,2,900}, {ZOMBIE_NORMAL,4,900}, {ZOMBIE_NORMAL,2,1180}, {ZOMBIE_NORMAL,4,1180}}}}
+}};
+constexpr int ZombieCount(int stage)
+{
+    if (stage < 0 || stage >= kBoardCount) return 0;
+    int count = 0;
+    for (const Spawn& spawn : kBoards[stage].mZombies) if (spawn.mType != ZOMBIE_INVALID) ++count;
+    return count;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kBoardCount);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    return kBoardCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    for (auto& allowed : output) allowed = false;
+    for (const Puzzle& puzzle : kBoards) for (const Spawn& spawn : puzzle.mZombies)
+        if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+bool IsPlanning(const Board& board);
+bool CanMove(const Plant& plant);
+bool HoldsZombie(Zombie& zombie);
+void Populate(Board& board);
+void ResetStage(Board& board, int stage);
+void RestoreButton(Board& board);
+void Commit(Board& board);
+void Update(Board& board);
+bool MoveGarlic(Board& board, Plant* plant, int col, int row);
+std::string LevelLabel(int stage);
+static_assert(static_cast<int>(kMode) == 83);
+}
diff --git a/src/Lawn/System/GarlicRunPresentation.cpp b/src/Lawn/System/GarlicRunPresentation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..50e255c182e1f10c99dd6ad796f4b8e7686f912c
--- /dev/null
+++ b/src/Lawn/System/GarlicRunPresentation.cpp
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "GarlicRunPresentation.h"
+#include "../../LawnApp.h"
+#include "../../Resources.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "graphics/Graphics.h"
+#include "graphics/MemoryImage.h"
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+namespace GarlicRunPresentation
+{
+namespace
+{
+std::unique_ptr<Sexy::MemoryImage> sCard;
+
+std::unique_ptr<Sexy::MemoryImage> Blank(int width, int height)
+{
+    std::vector<uint32_t> pixels(width * height, 0);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+Sexy::Rect VisibleBounds(Sexy::MemoryImage& image)
+{
+    int left = image.GetWidth(), top = image.GetHeight(), right = -1, bottom = -1;
+    const uint32_t* pixels = image.GetBits();
+    for (int y = 0; y < image.GetHeight(); ++y)
+        for (int x = 0; x < image.GetWidth(); ++x)
+            if ((pixels[y * image.GetWidth() + x] >> 24) > 8)
+            {
+                left = std::min(left, x); top = std::min(top, y);
+                right = std::max(right, x); bottom = std::max(bottom, y);
+            }
+    return right < left ? Sexy::Rect() : Sexy::Rect(left, top, right - left + 1, bottom - top + 1);
+}
+
+void DrawPlant(Sexy::Graphics& graphics, ReanimationType type, const char* layer,
+    const Sexy::Rect& destination)
+{
+    auto sprite = Blank(180, 180);
+    Sexy::Graphics native(sprite.get());
+    native.SetLinearBlend(true);
+    Reanimation plant;
+    plant.ReanimationInitializeType(40.0f, 35.0f, type);
+    plant.SetFramesForLayer(layer);
+    plant.Draw(&native);
+    const Sexy::Rect bounds = VisibleBounds(*sprite);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return;
+    const float scale = std::min(static_cast<float>(destination.mWidth) / bounds.mWidth,
+        static_cast<float>(destination.mHeight) / bounds.mHeight);
+    PvzpDrawImageScaledF(&graphics, sprite.get(),
+        destination.mX + (destination.mWidth - bounds.mWidth * scale) * 0.5f - bounds.mX * scale,
+        destination.mY + (destination.mHeight - bounds.mHeight * scale) * 0.5f - bounds.mY * scale,
+        scale, scale);
+}
+}
+
+Sexy::Image* GetBonusImage()
+{
+    if (sCard) return sCard.get();
+    if (!PvzpLoadResources("DelayLoad_Background1") || !Sexy::IMAGE_BACKGROUND1) return nullptr;
+
+    // The complete Garlic remains the centered hero. The original ground
+    // traps form a small route below it, without inventing new artwork.
+    auto portrait = Blank(180, 150);
+    Sexy::Graphics native(portrait.get());
+    native.SetLinearBlend(true);
+    DrawPlant(native, REANIM_SPIKEWEED, "anim_idle", Sexy::Rect(30, 98, 120, 26));
+    DrawPlant(native, REANIM_POTATOMINE, "anim_armed", Sexy::Rect(118, 85, 32, 30));
+    DrawPlant(native, REANIM_GARLIC, "anim_idle", Sexy::Rect(50, 10, 80, 90));
+    const Sexy::Rect bounds = VisibleBounds(*portrait);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return nullptr;
+
+    auto card = Blank(80, 65);
+    Sexy::Graphics picture(card.get());
+    picture.SetLinearBlend(true);
+    picture.ClipRect(0, 0, 80, 65);
+    picture.DrawImage(Sexy::IMAGE_BACKGROUND1, Sexy::Rect(0, 0, 80, 65), Sexy::Rect(400, 140, 480, 390));
+    const float scale = std::min(68.0f / bounds.mWidth, 57.0f / bounds.mHeight);
+    PvzpDrawImageScaledF(&picture, portrait.get(),
+        40.0f - (bounds.mX + bounds.mWidth * 0.5f) * scale,
+        32.5f - (bounds.mY + bounds.mHeight * 0.5f) * scale, scale, scale);
+    sCard = std::move(card);
+    return sCard.get();
+}
+
+void DisposeImage() { sCard.reset(); }
+}
