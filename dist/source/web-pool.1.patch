+// Uses only existing saved Plant counters and native zombie chill handling.
+void UpdateLanternShroom(Plant& plant)
+{
+    if (plant.mSeedType != LanternShroom::kSeed || !plant.mBoard || !plant.mApp ||
+        !plant.IsInPlay() || plant.mApp->mGameScene != SCENE_PLAYING || plant.mDead ||
+        plant.mPlantHealth < 0 || plant.mIsAsleep || plant.mSquished ||
+        plant.mOnBungeeState != NOT_ON_BUNGEE)
+        return;
+    const auto canTarget = [&plant](Zombie* zombie)
+    {
+        if (!zombie->IsOnBoard() || zombie->IsDeadOrDying() || zombie->mMindControlled ||
+            zombie->IsFlying() || !zombie->CanBeChilled() || !zombie->CanBeFrozen())
+            return false;
+        const Rect bounds = zombie->GetZombieRect();
+        const float dx = bounds.mX + bounds.mWidth * 0.5f - (plant.mX + 40.0f);
+        const float dy = bounds.mY + bounds.mHeight * 0.5f - (plant.mY + 40.0f);
+        return LanternShroom::InRange(dx, dy);
+    };
+    bool hasTarget = false;
+    // Target presence cannot affect the long recharge portion of the cycle.
+    // Only scan when a shot can begin or a wind-up needs to be revalidated.
+    if (plant.mStateCountdown <= LanternShroom::kReadyCountdown)
+        for (Zombie* zombie : plant.mBoard->mZombies)
+            if (canTarget(zombie))
+            {
+                hasTarget = true;
+                break;
+            }
+    if (!LanternShroom::AdvancePulse(plant.mStateCountdown, plant.mDoSpecialCountdown, hasTarget))
+        return;
+
+    for (Zombie* zombie : plant.mBoard->mZombies)
+    {
+        if (!canTarget(zombie))
+            continue;
+        const int previousChill = zombie->mChilledCounter;
+        zombie->ApplyChill(false);
+        zombie->mChilledCounter = std::max(previousChill, LanternShroom::kSlowDuration);
+    }
+}
