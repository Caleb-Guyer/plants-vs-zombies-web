-
-	int srcX, srcY;
-	float dstX, dstY;
-	int w, h;
-	float u1, v1, u2, v2;
-	float uvb[4];
-
-	srcY = srcTop; dstY = theY;
-	while (srcY < srcBottom)
-	{
-		srcX = srcLeft; dstX = theX;
-		while (srcX < srcRight)
-		{
-			w = srcRight - srcX; h = srcBottom - srcY;
-			GLuint &tex = GetTexture(srcX, srcY, w, h, u1, v1, u2, v2, uvb);
-			float x = dstX, y = dstY;
