+
+// Stable content identity and native data for the first optional challenge.
+// The mode owns an unused record in the existing 100-entry profile array;
+// it never changes a saved object layout or an original challenge definition.
+namespace BonusChallenge
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_CONE_ZONE;
+inline constexpr std::string_view kId = "cone-zone";
+inline constexpr int kRevision = 1;
+inline constexpr int kStartingSun = 150;
+inline constexpr int kWaveCount = 20;
+inline constexpr int kLargestWave = 16;
+inline constexpr std::array<SeedType, 6> kSeeds = {
+    SEED_SUNFLOWER, SEED_PEASHOOTER, SEED_WALLNUT,
+    SEED_POTATOMINE, SEED_SNOWPEA, SEED_CHERRYBOMB
+};
+inline constexpr std::array<ZombieType, 4> kPreviewZombies = {
+    ZOMBIE_NORMAL, ZOMBIE_TRAFFIC_CONE, ZOMBIE_POLEVAULTER, ZOMBIE_PAIL
+};
+
+struct Wave
+{
+    int mNormal;
+    int mCones;
+    int mPoles;
+    int mBuckets;
+};
+
+// A gentle first three waves leave time for sun production. Coneheads become
+// the main threat; occasional poles and buckets reward layered defenses.
+inline constexpr std::array<Wave, kWaveCount> kWaves = {{
+    {1, 0, 0, 0}, {2, 0, 0, 0}, {3, 0, 0, 0}, {2, 1, 0, 0},
+    {2, 2, 0, 0}, {2, 3, 0, 0}, {2, 3, 1, 0}, {2, 4, 0, 0},
+    {2, 4, 0, 1}, {4, 5, 1, 1}, {2, 4, 0, 1}, {2, 5, 1, 0},
+    {2, 4, 0, 2}, {2, 5, 1, 1}, {2, 5, 0, 2}, {2, 6, 1, 1},
+    {2, 6, 0, 2}, {2, 5, 2, 2}, {2, 6, 0, 3}, {3, 7, 2, 3}
+}};
+
+constexpr bool IsMode(GameMode mode) { return PoolPanic::IsMode(mode) || CobCannonCommand::IsMode(mode) || BungeeBusiness::IsMode(mode) || GarlicRun::IsMode(mode) || LightsOut::IsMode(mode) || mode == kMode || NightShift::IsMode(mode) || LanternGlow::IsMode(mode) || GardenShuffle::IsMode(mode) || SeedSwap::IsMode(mode) || IntensiveCare::IsMode(mode) || ChainReaction::IsMode(mode) || RallyZombie::IsMode(mode) || RallyRaid::IsMode(mode); }
+constexpr bool IsFlagWave(int wave) { return wave >= 0 && wave < kWaveCount && (wave + 1) % 10 == 0; }
+constexpr int ZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kWaveCount) return 0;
+    const Wave& entry = kWaves[wave];
+    return entry.mNormal + entry.mCones + entry.mPoles + entry.mBuckets + (IsFlagWave(wave) ? 1 : 0);
+}
+
+// Fail before touching output when a caller lacks room for the terminator.
+constexpr int ComposeWave(int wave, ZombieType* output, int capacity)
+{
+    if (wave < 0 || wave >= kWaveCount || !output || capacity <= ZombieCount(wave)) return -1;
+    for (int i = 0; i < capacity; ++i) output[i] = ZOMBIE_INVALID;
+    const Wave& entry = kWaves[wave];
+    int count = 0;
+    if (IsFlagWave(wave)) output[count++] = ZOMBIE_FLAG;
+    for (int i = 0; i < entry.mNormal; ++i) output[count++] = ZOMBIE_NORMAL;
+    for (int i = 0; i < entry.mCones; ++i) output[count++] = ZOMBIE_TRAFFIC_CONE;
+    for (int i = 0; i < entry.mPoles; ++i) output[count++] = ZOMBIE_POLEVAULTER;
+    for (int i = 0; i < entry.mBuckets; ++i) output[count++] = ZOMBIE_PAIL;
+    return count;
+}
+
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestWave);
+    for (auto& wave : output)
+        for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int i = 0; i < kWaveCount; ++i) ComposeWave(i, output[i], static_cast<int>(Slots));
+    return kWaveCount;
+}
+
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_PAIL));
+    for (auto& allowed : output) allowed = false;
+    for (ZombieType zombie : kPreviewZombies) output[zombie] = true;
+}
+
+template<class Bank>
+void FillSeedBank(Bank& bank)
+{
+    bank.mNumPackets = static_cast<int>(kSeeds.size());
+    for (int i = 0; i < bank.mNumPackets; ++i) bank.mSeedPackets[i].SetPacketType(kSeeds[i]);
+}
+
+// Shared routing keeps the original Cone Zone data and helpers unchanged.
+constexpr int StartingSun(GameMode mode) { return PoolPanic::IsMode(mode) ? 0 : CobCannonCommand::IsMode(mode) ? 0 : BungeeBusiness::IsMode(mode) ? BungeeBusiness::kBoards[0].mSun : GarlicRun::IsMode(mode) ? 0 : LightsOut::IsMode(mode) ? 0 : RallyRaid::IsMode(mode) ? RallyRaid::kBoards[0].mSun : RallyZombie::IsMode(mode) ? RallyZombie::kStartingSun : ChainReaction::IsMode(mode) ? 0 : IntensiveCare::IsMode(mode) ? 0 : SeedSwap::IsMode(mode) ? 0 : GardenShuffle::IsMode(mode) ? 0 : LanternGlow::IsMode(mode) ? LanternGlow::kStartingSun : NightShift::IsMode(mode) ? NightShift::kStartingSun : kStartingSun; }
+constexpr int SeedCount(GameMode mode) { return PoolPanic::IsMode(mode) ? PoolPanic::kBankSize : CobCannonCommand::IsMode(mode) ? 0 : BungeeBusiness::IsMode(mode) ? BungeeBusiness::kSeedCount : GarlicRun::IsMode(mode) ? 0 : LightsOut::IsMode(mode) ? 0 : RallyRaid::IsMode(mode) ? RallyRaid::kSeedCount : RallyZombie::IsMode(mode) ? static_cast<int>(RallyZombie::kSeeds.size()) : ChainReaction::IsMode(mode) ? ChainReaction::kSeedCount : IntensiveCare::IsMode(mode) ? IntensiveCare::kSeedCount : SeedSwap::IsMode(mode) ? 0 : GardenShuffle::IsMode(mode) ? 0 : static_cast<int>(LanternGlow::IsMode(mode) ? LanternGlow::kSeeds.size() : NightShift::IsMode(mode) ? NightShift::kSeeds.size() : kSeeds.size()); }
+
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(GameMode mode, ZombieType (&output)[Waves][Slots])
+{
+    if (PoolPanic::IsMode(mode)) return PoolPanic::PopulateWaves(output);
+    if (CobCannonCommand::IsMode(mode)) return CobCannonCommand::PopulateWaves(output);
+    if (BungeeBusiness::IsMode(mode)) return BungeeBusiness::PopulateWaves(output);
+    if (GarlicRun::IsMode(mode)) return GarlicRun::PopulateWaves(output);
+    if (LightsOut::IsMode(mode)) return LightsOut::PopulateWaves(output);
+    if (RallyRaid::IsMode(mode)) return RallyRaid::PopulateWaves(output);
+    if (RallyZombie::IsMode(mode)) return RallyZombie::PopulateWaves(output);
+    if (ChainReaction::IsMode(mode)) return ChainReaction::PopulateWaves(output);
+    if (IntensiveCare::IsMode(mode)) return IntensiveCare::PopulateWaves(output);
+    if (SeedSwap::IsMode(mode)) return SeedSwap::PopulateWaves(output);
+    if (GardenShuffle::IsMode(mode)) return GardenShuffle::PopulateWaves(output);
+    return LanternGlow::IsMode(mode) ? LanternGlow::PopulateWaves(output) : NightShift::IsMode(mode) ? NightShift::PopulateWaves(output) : PopulateWaves(output);
+}
+
+template<std::size_t Count>
+void PopulateAllowedZombies(GameMode mode, bool (&output)[Count])
+{
+    if (PoolPanic::IsMode(mode)) PoolPanic::PopulateAllowedZombies(output);
+    else if (CobCannonCommand::IsMode(mode)) CobCannonCommand::PopulateAllowedZombies(output);
+    else if (BungeeBusiness::IsMode(mode)) BungeeBusiness::PopulateAllowedZombies(output);
+    else if (GarlicRun::IsMode(mode)) GarlicRun::PopulateAllowedZombies(output);
+    else if (LightsOut::IsMode(mode)) LightsOut::PopulateAllowedZombies(output);
+    else if (RallyRaid::IsMode(mode)) RallyRaid::PopulateAllowedZombies(output);
+    else if (RallyZombie::IsMode(mode)) RallyZombie::PopulateAllowedZombies(output);
+    else if (ChainReaction::IsMode(mode)) ChainReaction::PopulateAllowedZombies(output);
+    else if (IntensiveCare::IsMode(mode)) IntensiveCare::PopulateAllowedZombies(output);
+    else if (SeedSwap::IsMode(mode)) SeedSwap::PopulateAllowedZombies(output);
+    else if (GardenShuffle::IsMode(mode)) GardenShuffle::PopulateAllowedZombies(output);
+    else if (LanternGlow::IsMode(mode)) LanternGlow::PopulateAllowedZombies(output);
+    else if (NightShift::IsMode(mode)) NightShift::PopulateAllowedZombies(output);
+    else PopulateAllowedZombies(output);
+}
+
+template<class Bank>
+void FillSeedBank(GameMode mode, Bank& bank)
+{
+    if (PoolPanic::IsMode(mode)) PoolPanic::FillSeedBank(bank);
+    else if (CobCannonCommand::IsMode(mode)) bank.mNumPackets = 0;
+    else if (BungeeBusiness::IsMode(mode)) BungeeBusiness::FillSeedBank(bank);
+    else if (GarlicRun::IsMode(mode)) bank.mNumPackets = 0;
+    else if (LightsOut::IsMode(mode)) bank.mNumPackets = 0;
+    else if (RallyRaid::IsMode(mode)) RallyRaid::FillSeedBank(bank);
+    else if (RallyZombie::IsMode(mode)) RallyZombie::FillSeedBank(bank);
+    else if (ChainReaction::IsMode(mode)) ChainReaction::FillSeedBank(bank);
+    else if (IntensiveCare::IsMode(mode)) IntensiveCare::FillSeedBank(bank);
+    else if (SeedSwap::IsMode(mode)) bank.mNumPackets = 0;
+    else if (GardenShuffle::IsMode(mode)) bank.mNumPackets = 0;
+    else if (LanternGlow::IsMode(mode)) LanternGlow::FillSeedBank(bank);
+    else if (NightShift::IsMode(mode)) NightShift::FillSeedBank(bank);
+    else FillSeedBank(bank);
+}
+
+static_assert(static_cast<int>(kMode) == 73);
+// Revision 2 lives in existing serialized Challenge state. Old checkpoints use
+// STATECHALLENGE_NORMAL and retain their original bank, waves and mechanics.
+inline constexpr ChallengeState kArcadeState = static_cast<ChallengeState>(100);
+inline constexpr ChallengeState kColdSetupState = static_cast<ChallengeState>(101);
+inline constexpr ChallengeState kColdDefendState = static_cast<ChallengeState>(102);
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{
+    if (PoolPanic::IsMode(mode)) return PoolPanic::IsCurrentRules(mode, state);
+    if (CobCannonCommand::IsMode(mode)) return CobCannonCommand::IsCurrentRules(mode, state);
+    if (BungeeBusiness::IsMode(mode)) return BungeeBusiness::IsCurrentRules(mode, state);
+    if (GarlicRun::IsMode(mode)) return GarlicRun::IsCurrentRules(mode, state);
+    if (LightsOut::IsMode(mode)) return LightsOut::IsCurrentRules(mode, state);
+    if (RallyRaid::IsMode(mode)) return RallyRaid::IsCurrentRules(mode, state);
+    if (RallyZombie::IsMode(mode)) return RallyZombie::IsCurrentRules(mode, state);
+    if (ChainReaction::IsMode(mode)) return ChainReaction::IsCurrentRules(mode, state);
+    if (IntensiveCare::IsMode(mode)) return IntensiveCare::IsCurrentRules(mode, state);
+    if (SeedSwap::IsMode(mode)) return SeedSwap::IsCurrentRules(mode, state);
+    if (GardenShuffle::IsMode(mode)) return GardenShuffle::IsCurrentRules(mode, state);
+    return (mode == kMode || NightShift::IsMode(mode)) ? state == kArcadeState :
+        LanternGlow::IsMode(mode) && (state == kColdSetupState || state == kColdDefendState);
+}
+constexpr bool IsConveyor(GameMode mode, ChallengeState state)
+{
+    return PoolPanic::IsCurrentRules(mode, state) || ChainReaction::IsCurrentRules(mode, state) || IntensiveCare::IsCurrentRules(mode, state) ||
+        ((mode == kMode || NightShift::IsMode(mode)) && state == kArcadeState);
+}
+constexpr bool IsBowling(GameMode mode, ChallengeState state) { return mode == kMode && state == kArcadeState; }
+constexpr bool IsSetup(GameMode mode, ChallengeState state) { return LanternGlow::IsMode(mode) && state == kColdSetupState; }
+constexpr bool IsDefending(GameMode mode, ChallengeState state) { return LanternGlow::IsMode(mode) && state == kColdDefendState; }
+constexpr int WaveCount(GameMode mode, ChallengeState state)
+{
+    if (PoolPanic::IsMode(mode)) return PoolPanic::kWaveCount;
+    if (CobCannonCommand::IsMode(mode)) return CobCannonCommand::kWaveCount;
+    if (BungeeBusiness::IsMode(mode)) return BungeeBusiness::kBoardCount;
+    if (GarlicRun::IsMode(mode)) return GarlicRun::kBoardCount;
+    if (LightsOut::IsMode(mode)) return LightsOut::kWaveCount;
+    if (RallyRaid::IsMode(mode)) return RallyRaid::kBoardCount;
+    if (RallyZombie::IsMode(mode)) return RallyZombie::kWaveCount;
+    if (ChainReaction::IsMode(mode)) return ChainReaction::kBoardCount;
+    if (IntensiveCare::IsMode(mode)) return IntensiveCare::kWaveCount;
+    if (SeedSwap::IsMode(mode)) return SeedSwap::kWaveCount;
+    if (GardenShuffle::IsMode(mode)) return GardenShuffle::kWaveCount;
+    return IsCurrentRules(mode, state) ? (LanternGlow::IsMode(mode) ? LanternGlow::kPuzzleWaveCount : 10) : kWaveCount;
+}
+constexpr int StartingSun(GameMode mode, ChallengeState state)
+{
+    if (BungeeBusiness::IsMode(mode)) return BungeeBusiness::kBoards[0].mSun;
+    if (RallyRaid::IsMode(mode)) return RallyRaid::kBoards[0].mSun;
+    if (RallyZombie::IsMode(mode)) return RallyZombie::kStartingSun;
+    return IsCurrentRules(mode, state) ? (LanternGlow::IsMode(mode) ? LanternGlow::kPuzzleStartingSun : 0) : StartingSun(mode);
+}
+constexpr int SeedCount(GameMode mode, ChallengeState state)
+{
+    return IsConveyor(mode, state) ? 10 : SeedCount(mode);
+}
+// Cone Zone keeps each original zombie's movement, shield and special behavior.
+// Their extra cone uses the native cone helmet damage and 370-point armor.
+inline constexpr int kConeHelmHealth = 370;
+constexpr bool IsConeHeadType(ZombieType type)
+{
+    return type == ZOMBIE_TRAFFIC_CONE || type == ZOMBIE_FLAG || type == ZOMBIE_DOOR ||
+        type == ZOMBIE_NEWSPAPER || type == ZOMBIE_POLEVAULTER || type == ZOMBIE_LADDER ||
+        type == ZOMBIE_JACK_IN_THE_BOX || type == ZOMBIE_FOOTBALL;
+}
+constexpr bool UsesAttachedCone(ZombieType type)
+{
+    return IsConeHeadType(type) && type != ZOMBIE_TRAFFIC_CONE && type != ZOMBIE_FLAG && type != ZOMBIE_DOOR;
+}
+inline constexpr std::array<SeedType, 5> kBowlingOpeningSeeds = {
+    SEED_WALLNUT, SEED_WALLNUT, SEED_EXPLODE_O_NUT, SEED_WALLNUT, SEED_GIANT_WALLNUT
+};
+constexpr SeedType BowlingSeedForDelivery(int ordinal, SeedType weightedPick)
+{
+    return ordinal >= 0 && ordinal < static_cast<int>(kBowlingOpeningSeeds.size()) ? kBowlingOpeningSeeds[ordinal] :
+        ordinal >= 0 && ordinal % 8 == 7 ? SEED_GIANT_WALLNUT : weightedPick;
+}
+inline constexpr std::array<ZombieType, 8> kMiniPreviewZombies = {
+    ZOMBIE_TRAFFIC_CONE, ZOMBIE_DOOR, ZOMBIE_NEWSPAPER, ZOMBIE_POLEVAULTER,
+    ZOMBIE_LADDER, ZOMBIE_JACK_IN_THE_BOX, ZOMBIE_FOOTBALL, ZOMBIE_FLAG
+};
+struct MiniWave
+{
+    int mCones;
+    int mDoors;
+    int mNewspapers;
+    int mPoles;
+    int mLadders;
+    int mJacks;
+    int mFootball;
+};
+inline constexpr int kMiniWaveCount = 10;
+inline constexpr int kMiniLargestWave = 15;
+inline constexpr std::array<MiniWave, kMiniWaveCount> kMiniWaves = {{
+    {2,0,0,0,0,0,0}, {3,1,0,0,0,0,0}, {3,1,1,0,0,0,0}, {3,1,1,1,0,0,0},
+    {3,2,1,1,0,0,0}, {3,2,1,1,1,0,0}, {3,2,1,1,1,1,0}, {3,2,2,1,1,1,1},
+    {4,3,2,1,1,1,1}, {5,3,2,1,1,1,1}
+}};
+constexpr bool MiniFlagWave(int wave) { return wave == kMiniWaveCount - 1; }
+constexpr int MiniZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kMiniWaveCount) return 0;
+    const MiniWave& entry = kMiniWaves[wave];
+    return entry.mCones + entry.mDoors + entry.mNewspapers + entry.mPoles + entry.mLadders +
+        entry.mJacks + entry.mFootball + (MiniFlagWave(wave) ? 1 : 0);
+}
+constexpr int ComposeMiniWave(int wave, ZombieType* output, int capacity)
+{
+    if (wave < 0 || wave >= kMiniWaveCount || !output || capacity <= MiniZombieCount(wave)) return -1;
+    for (int i = 0; i < capacity; ++i) output[i] = ZOMBIE_INVALID;
+    const MiniWave& entry = kMiniWaves[wave];
+    int n = 0;
+    if (MiniFlagWave(wave)) output[n++] = ZOMBIE_FLAG;
+    for (int i = 0; i < entry.mCones; ++i) output[n++] = ZOMBIE_TRAFFIC_CONE;
+    for (int i = 0; i < entry.mDoors; ++i) output[n++] = ZOMBIE_DOOR;
+    for (int i = 0; i < entry.mNewspapers; ++i) output[n++] = ZOMBIE_NEWSPAPER;
+    for (int i = 0; i < entry.mPoles; ++i) output[n++] = ZOMBIE_POLEVAULTER;
+    for (int i = 0; i < entry.mLadders; ++i) output[n++] = ZOMBIE_LADDER;
+    for (int i = 0; i < entry.mJacks; ++i) output[n++] = ZOMBIE_JACK_IN_THE_BOX;
+    for (int i = 0; i < entry.mFootball; ++i) output[n++] = ZOMBIE_FOOTBALL;
+    return n;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulateMiniWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kMiniWaveCount && Slots > kMiniLargestWave);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int i = 0; i < kMiniWaveCount; ++i) ComposeMiniWave(i, output[i], static_cast<int>(Slots));
+    return kMiniWaveCount;
+}
+
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(GameMode mode, ChallengeState state, ZombieType (&output)[Waves][Slots])
+{
+    if (PoolPanic::IsMode(mode)) return PoolPanic::PopulateWaves(output);
+    if (CobCannonCommand::IsMode(mode)) return CobCannonCommand::PopulateWaves(output);
+    if (BungeeBusiness::IsMode(mode)) return BungeeBusiness::PopulateWaves(output);
+    if (GarlicRun::IsMode(mode)) return GarlicRun::PopulateWaves(output);
+    if (LightsOut::IsMode(mode)) return LightsOut::PopulateWaves(output);
+    if (RallyRaid::IsMode(mode)) return RallyRaid::PopulateWaves(output);
+    if (RallyZombie::IsMode(mode)) return RallyZombie::PopulateWaves(output);
+    if (ChainReaction::IsMode(mode)) return ChainReaction::PopulateWaves(output);
+    if (IntensiveCare::IsMode(mode)) return IntensiveCare::PopulateWaves(output);
+    if (SeedSwap::IsMode(mode)) return SeedSwap::PopulateWaves(output);
+    if (GardenShuffle::IsMode(mode)) return GardenShuffle::PopulateWaves(output);
+    if (!IsCurrentRules(mode, state)) return PopulateWaves(mode, output);
+    if (LanternGlow::IsMode(mode)) return LanternGlow::PopulatePuzzleWaves(output);
+    if (NightShift::IsMode(mode)) return NightShift::PopulateMiniWaves(output);
+    return PopulateMiniWaves(output);
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(GameMode mode, ChallengeState state, bool (&output)[Count])
+{
+    if (!IsBowling(mode, state)) { PopulateAllowedZombies(mode, output); return; }
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_JACK_IN_THE_BOX));
+    for (auto& allowed : output) allowed = false;
+    for (ZombieType zombie : kMiniPreviewZombies) output[zombie] = true;
+}
+template<class Bank>
+void FillSeedBank(GameMode mode, ChallengeState state, Bank& bank)
+{
+    if (PoolPanic::IsMode(mode)) { PoolPanic::FillSeedBank(bank); return; }
+    if (BungeeBusiness::IsMode(mode)) { BungeeBusiness::FillSeedBank(bank); return; }
+    if (GarlicRun::IsMode(mode)) { bank.mNumPackets = 0; return; }
+    if (LightsOut::IsMode(mode)) { bank.mNumPackets = 0; return; }
+    if (RallyRaid::IsMode(mode)) { RallyRaid::FillSeedBank(bank); return; }
+    if (RallyZombie::IsMode(mode)) { RallyZombie::FillSeedBank(bank); return; }
+    if (ChainReaction::IsMode(mode)) { ChainReaction::FillSeedBank(bank); return; }
+    if (IntensiveCare::IsMode(mode)) { IntensiveCare::FillSeedBank(bank); return; }
+    if (SeedSwap::IsMode(mode)) { bank.mNumPackets = 0; return; }
+    if (GardenShuffle::IsMode(mode)) { bank.mNumPackets = 0; return; }
+    if (!IsCurrentRules(mode, state)) { FillSeedBank(mode, bank); return; }
+    bank.mNumPackets = SeedCount(mode, state);
+    if (IsConveyor(mode, state)) return;
+    for (int i = 0; i < bank.mNumPackets; ++i) bank.mSeedPackets[i].SetPacketType(LanternGlow::kPuzzleSeeds[i]);
+    bank.RefreshAllPackets();
+}
+static_assert(MiniZombieCount(kMiniWaveCount - 1) == kMiniLargestWave);
+
+static_assert(ZombieCount(kWaveCount - 1) == kLargestWave);
+}
diff --git a/src/Lawn/System/BungeeBusiness.cpp b/src/Lawn/System/BungeeBusiness.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..477da010f818bbcbcce4f29e883813dd64357b73
--- /dev/null
+++ b/src/Lawn/System/BungeeBusiness.cpp
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "BungeeBusiness.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include "../Coin.h"
+#include "../GridItem.h"
+#include "../Projectile.h"
+#include "../SeedPacket.h"
+#include "../../LawnApp.h"
+#include <algorithm>
+#include <format>
+
+namespace BungeeBusiness
+{
+namespace
+{
+int TargetBit(const Board& board, int col, int row)
+{
+    const int stage = std::clamp(board.mChallenge->mSurvivalStage, 0, kBoardCount - 1);
+    int index = 0;
+    for (const Defender& defender : kBoards[stage].mPlants)
+    {
+        if (defender.mSeed != SEED_SUNFLOWER) continue;
+        if (defender.mCol == col && defender.mRow == row) return 1 << index;
+        ++index;
+    }
+    return 0;
+}
+void Fail(Board& board)
+{
+    board.mChallenge->mChallengeState = kFailed;
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    board.ZombiesWon(nullptr);
+}
+}
+
+std::string LevelLabel(int stage)
+{
+    return std::format("Bungee Business - {}/{}", std::clamp(stage + 1, 1, kBoardCount), kBoardCount);
+}
+
+void Populate(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    const int stage = std::clamp(challenge.mSurvivalStage, 0, kBoardCount - 1);
+    challenge.mSurvivalStage = stage;
+    challenge.mChallengeState = kActive;
+    challenge.mChallengeStateCounter = 0;
+    challenge.mChallengeScore = 0;
+    // This existing saved field is the unique authored-target completion mask.
+    challenge.mScaryPotterPots = 0;
+    board.mSunMoney = kBoards[stage].mSun;
+    board.mCurrentWave = 0;
+    board.mProgressMeterWidth = 0;
+    board.mZombieCountDown = board.mZombieCountDownStart = 100000;
+    board.mNextSurvivalStageCounter = 0;
+    board.mShowShovel = false;
+    board.mBonusLawnMowersRemaining = 0;
+    board.ClearCursor();
+    FillSeedBank(*board.mSeedBank);
+    for (const Defender& defender : kBoards[stage].mPlants)
+    {
+        if (defender.mSeed == SEED_NONE) continue;
+        Plant* plant = board.NewPlant(defender.mCol, defender.mRow, defender.mSeed, SEED_NONE);
+        board.mChallenge->IZombieSetupPlant(plant);
+    }
+}
+
+void ResetStage(Board& board, int stage)
+{
+    for (Zombie* zombie : board.mZombies) if (!zombie->mDead) zombie->DieNoLoot();
+    for (Plant* plant : board.mPlants) if (!plant->mDead) plant->Die();
+    for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+    for (GridItem* item : board.mGridItems) if (!item->mDead) item->GridItemDie();
+    for (Projectile* projectile : board.mProjectiles) if (!projectile->mDead) projectile->Die();
+    board.mChallenge->mSurvivalStage = std::clamp(stage, 0, kBoardCount - 1);
+    board.mLevelAwardSpawned = false;
+    Populate(board);
+}
+
+bool CanDeploy(Board& board, int col, int row, SeedType seed)
+{
+    if (!board.mChallenge || board.mChallenge->mChallengeState != kActive ||
+        board.mLevelComplete || board.HasLevelAwardDropped() ||
+        col < 0 || col >= 9 || row < 0 || row >= 5 ||
+        std::find(kSeeds.begin(), kSeeds.end(), seed) == kSeeds.end()) return false;
+    if (seed != SEED_ZOMBIE_BUNGEE) return col >= kDeploymentColumn;
+    if (col >= kDeploymentColumn || board.BungeeIsTargetingCell(col, row)) return false;
+    Plant* plant = board.GetTopPlantAt(col, row, TOPPLANT_BUNGEE_ORDER);
+    return plant && !plant->mDead && !plant->NotOnGround();
+}
+
+void OnBungeeExit(Zombie& zombie)
+{
+    Board* board = zombie.mBoard;
+    if (!board || !board->mChallenge || !IsMode(board->mApp->mGameMode) ||
+        board->mChallenge->mChallengeState != kActive || zombie.mDead || zombie.IsDeadOrDying() ||
+        zombie.mZombieType != ZOMBIE_BUNGEE || zombie.mZombiePhase != PHASE_BUNGEE_RISING ||
+        zombie.mAltitude < 600.0f || zombie.mRelatedZombieID != ZOMBIEID_NULL) return;
+    Plant* plant = board->mPlants.DataArrayTryToGet(zombie.mTargetPlantID);
+    if (!plant || plant->mDead || plant->mSquished || plant->mPlantHealth <= 0 || plant->mSeedType != SEED_SUNFLOWER ||
+        plant->mPlantCol != zombie.mTargetCol || plant->mRow != zombie.mRow ||
+        plant->mOnBungeeState != RISING_WITH_BUNGEE) return;
+    const int bit = TargetBit(*board, plant->mPlantCol, plant->mRow);
+    if (bit == 0 || (board->mChallenge->mScaryPotterPots & bit) != 0) return;
+    board->mChallenge->mScaryPotterPots |= bit;
+    ++board->mChallenge->mChallengeScore;
+}
+
+void Update(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (!IsCurrentRules(board.mApp->mGameMode, challenge.mChallengeState) || board.mPaused ||
+        board.mApp->mGameScene != SCENE_PLAYING || board.HasLevelAwardDropped()) return;
+    board.mShowShovel = false;
+    if (challenge.mChallengeState == kTransition)
+    {
+        if (--challenge.mChallengeStateCounter > 0) return;
+        challenge.PuzzleNextStageClear();
+        for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+        for (Projectile* projectile : board.mProjectiles) if (!projectile->mDead) projectile->Die();
+        Populate(board);
+        return;
+    }
+    if (challenge.mChallengeState != kActive) return;
+    const int stage = std::clamp(challenge.mSurvivalStage, 0, kBoardCount - 1);
+    int remaining = 0;
+    for (const Defender& target : kBoards[stage].mPlants)
+    {
+        if (target.mSeed != SEED_SUNFLOWER) continue;
+        const int bit = TargetBit(board, target.mCol, target.mRow);
+        if ((challenge.mScaryPotterPots & bit) != 0) continue;
+        bool present = false;
+        // A rising plant is still a live target until its carrier leaves.
+        for (Plant* plant : board.mPlants)
+            if (!plant->mDead && !plant->mSquished && plant->mPlantHealth > 0 && plant->mSeedType == SEED_SUNFLOWER &&
+                plant->mPlantCol == target.mCol && plant->mRow == target.mRow) present = true;
+        if (!present) { Fail(board); return; }
+        ++remaining;
+    }
+    if (remaining == 0 && challenge.mChallengeScore == TargetCount(stage))
+    {
+        board.ClearCursor();
+        board.ClearAdviceImmediately();
+        if (stage == kBoardCount - 1)
+        {
+            challenge.mChallengeState = kFinished;
+            challenge.SpawnLevelAward(2, 2);
+        }
+        else
+        {
+            challenge.mChallengeState = kTransition;
+            challenge.mChallengeStateCounter = kTransitionTicks;
+        }
+        return;
+    }
+    if (board.mSunMoney + board.CountSunBeingCollected() >= kBungeeCost) return;
+    for (Zombie* zombie : board.mZombies) if (!zombie->mDead) return;
+    Fail(board);
+}
+}
diff --git a/src/Lawn/System/BungeeBusiness.h b/src/Lawn/System/BungeeBusiness.h
new file mode 100644
index 0000000000000000000000000000000000000000..ea40c4e72e84cba081bd376a06457a0b310576f0
--- /dev/null
+++ b/src/Lawn/System/BungeeBusiness.h
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+#include <initializer_list>
+#include <string>
+
+class Board;
+class Zombie;
+
+// Native I, Zombie input and combat with a finite heist objective. All progress
+// occupies existing serialized Challenge fields; original mode layouts stay exact.
+namespace BungeeBusiness
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_BUNGEE_BUSINESS;
+inline constexpr ChallengeState kActive = static_cast<ChallengeState>(119);
+inline constexpr ChallengeState kTransition = static_cast<ChallengeState>(120);
+inline constexpr ChallengeState kFinished = static_cast<ChallengeState>(121);
+inline constexpr ChallengeState kFailed = static_cast<ChallengeState>(122);
+inline constexpr int kBoardCount = 5;
+inline constexpr int kSeedCount = 5;
+inline constexpr int kDeploymentColumn = 5;
+inline constexpr int kBungeeCost = 125;
+inline constexpr int kTransitionTicks = 120;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{ return IsMode(mode) && state >= kActive && state <= kFailed; }
+inline constexpr std::array<SeedType, kSeedCount> kSeeds = {
+    SEED_ZOMBIE_NORMAL, SEED_ZOMBIE_TRAFFIC_CONE, SEED_ZOMBIE_POLEVAULTER,
+    SEED_ZOMBIE_PAIL, SEED_ZOMBIE_BUNGEE
+};
+struct Defender { SeedType mSeed = SEED_NONE; int mCol = 0; int mRow = 0; };
+struct Puzzle { int mSun; std::array<Defender, 9> mPlants; };
+// Ground crews work in lanes separate from the Sunflowers. Clear the native
+// Umbrella-leaf coverage, then spend the remaining budget on targeted Bungees.
+inline constexpr std::array<Puzzle, kBoardCount> kBoards = {{
+    {225, {{{SEED_SUNFLOWER,0,1}, {SEED_UMBRELLA,1,2}}}},
+    {375, {{{SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,0,3},
+            {SEED_UMBRELLA,1,2}, {SEED_PEASHOOTER,0,2}}}},
+    {450, {{{SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,0,3},
+            {SEED_UMBRELLA,1,0}, {SEED_UMBRELLA,1,4},
+            {SEED_PEASHOOTER,0,0}, {SEED_PEASHOOTER,0,4}}}},
+    {375, {{{SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,0,3},
+            {SEED_UMBRELLA,1,2}, {SEED_WALLNUT,3,2}, {SEED_PEASHOOTER,0,2}}}},
+    {625, {{{SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,3,1}, {SEED_SUNFLOWER,0,3},
+            {SEED_UMBRELLA,1,0}, {SEED_UMBRELLA,3,2}, {SEED_UMBRELLA,1,4},
+            {SEED_PEASHOOTER,0,0}, {SEED_PEASHOOTER,0,2}, {SEED_PEASHOOTER,0,4}}}}
+}};
+constexpr int PlantCount(int stage)
+{
+    if (stage < 0 || stage >= kBoardCount) return 0;
+    int count = 0;
+    for (const Defender& plant : kBoards[stage].mPlants) count += plant.mSeed != SEED_NONE;
+    return count;
+}
+constexpr int TargetCount(int stage)
+{
+    if (stage < 0 || stage >= kBoardCount) return 0;
+    int count = 0;
+    for (const Defender& plant : kBoards[stage].mPlants) count += plant.mSeed == SEED_SUNFLOWER;
+    return count;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kBoardCount);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    return kBoardCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    for (auto& allowed : output) allowed = false;
+    for (ZombieType type : {ZOMBIE_NORMAL, ZOMBIE_TRAFFIC_CONE, ZOMBIE_POLEVAULTER, ZOMBIE_PAIL, ZOMBIE_BUNGEE}) output[type] = true;
+}
+template<class Bank> void FillSeedBank(Bank& bank)
+{
+    bank.mNumPackets = kSeedCount;
+    for (int i = 0; i < kSeedCount; ++i) bank.mSeedPackets[i].SetPacketType(kSeeds[i]);
+    bank.RefreshAllPackets();
+}
+void Populate(Board& board);
+void ResetStage(Board& board, int stage);
+void Update(Board& board);
+bool CanDeploy(Board& board, int col, int row, SeedType seed);
+void OnBungeeExit(Zombie& zombie);
+std::string LevelLabel(int stage);
+static_assert(static_cast<int>(kMode) == 84);
+static_assert(TargetCount(0) + TargetCount(1) + TargetCount(2) + TargetCount(3) + TargetCount(4) == 10);
+}
diff --git a/src/Lawn/System/BungeeBusinessPresentation.cpp b/src/Lawn/System/BungeeBusinessPresentation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..66867b783f5e7d252b11c5962d74ad9b8a8de1ad
--- /dev/null
+++ b/src/Lawn/System/BungeeBusinessPresentation.cpp
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "BungeeBusinessPresentation.h"
+#include "../../LawnApp.h"
+#include "../../Resources.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "graphics/Graphics.h"
+#include "graphics/MemoryImage.h"
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+namespace BungeeBusinessPresentation
+{
+namespace
+{
+std::unique_ptr<Sexy::MemoryImage> sCard;
+
+std::unique_ptr<Sexy::MemoryImage> Blank(int width, int height)
+{
+    std::vector<uint32_t> pixels(width * height, 0);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+Sexy::Rect VisibleBounds(Sexy::MemoryImage& image)
+{
+    int left = image.GetWidth(), top = image.GetHeight(), right = -1, bottom = -1;
+    const uint32_t* pixels = image.GetBits();
+    for (int y = 0; y < image.GetHeight(); ++y)
+        for (int x = 0; x < image.GetWidth(); ++x)
+            if ((pixels[y * image.GetWidth() + x] >> 24) > 8)
+            {
+                left = std::min(left, x); top = std::min(top, y);
+                right = std::max(right, x); bottom = std::max(bottom, y);
+            }
+    return right < left ? Sexy::Rect() : Sexy::Rect(left, top, right - left + 1, bottom - top + 1);
+}
+}
+
+Sexy::Image* GetBonusImage()
+{
+    if (sCard) return sCard.get();
+    if (!PvzpLoadResources("DelayLoad_Background1") || !Sexy::IMAGE_BACKGROUND1) return nullptr;
+
+    auto portrait = Blank(220, 220);
+    Sexy::Graphics native(portrait.get());
+    native.SetLinearBlend(true);
+
+    // Preserve the original carrying geometry, pose and occlusion. Native
+    // UpdateReanim places a Bungee body at (-3,-8) relative to its cell origin;
+    // DrawBungeeReanim draws the carried plant at (0,30), then its forearms.
+    constexpr float originX = 70.0f, originY = 25.0f;
+    constexpr int arms = 2;
+    Reanimation body;
+    body.ReanimationInitializeType(originX - 3.0f, originY - 8.0f, REANIM_BUNGEE);
+    body.SetFramesForLayer("anim_raise");
+    body.mLoopType = REANIM_PLAY_ONCE_AND_HOLD;
+    body.mAnimTime = 1.0f;
+    body.SetTruncateDisappearingFrames(nullptr, false);
+    for (const char* prefix : {"Zombie_bungi_rightarm_lower2", "Zombie_bungi_rightarm_hand2",
+            "Zombie_bungi_leftarm_lower2", "Zombie_bungi_leftarm_hand2"})
+        body.AssignRenderGroupToPrefix(prefix, arms);
+    body.Draw(&native);
+
+    Reanimation flower;
+    flower.ReanimationInitializeType(originX, originY + 30.0f, REANIM_SUNFLOWER);
+    flower.SetFramesForLayer("anim_idle");
+    flower.Draw(&native);
+    body.DrawRenderGroup(&native, arms);
+
+    // The protection leaf is a small supporting figure. The held plant stays
+    // registered to the Bungee and is never independently fitted into its grip.
+    Reanimation umbrella;
+    umbrella.ReanimationInitializeType(145.0f, 115.0f, REANIM_UMBRELLALEAF);
+    umbrella.SetFramesForLayer("anim_idle");
+    umbrella.OverrideScale(0.5f, 0.5f);
+    umbrella.Draw(&native);
+
+    const Sexy::Rect bounds = VisibleBounds(*portrait);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return nullptr;
+    auto card = Blank(80, 65);
+    Sexy::Graphics picture(card.get());
+    picture.SetLinearBlend(true);
+    picture.ClipRect(0, 0, 80, 65);
+    picture.DrawImage(Sexy::IMAGE_BACKGROUND1, Sexy::Rect(0, 0, 80, 65), Sexy::Rect(400, 140, 480, 390));
+    const float scale = std::min(68.0f / bounds.mWidth, 57.0f / bounds.mHeight);
+    PvzpDrawImageScaledF(&picture, portrait.get(),
+        40.0f - (bounds.mX + bounds.mWidth * 0.5f) * scale,
+        32.5f - (bounds.mY + bounds.mHeight * 0.5f) * scale, scale, scale);
+    sCard = std::move(card);
+    return sCard.get();
+}
+
+void DisposeImage() { sCard.reset(); }
+}
