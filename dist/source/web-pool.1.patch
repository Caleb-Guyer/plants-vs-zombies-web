diff --git a/src/Lawn/System/CareFatigue.h b/src/Lawn/System/CareFatigue.h
new file mode 100644
index 0000000000000000000000000000000000000000..d570b956b21a488c147a82514fddf760603839aa
--- /dev/null
+++ b/src/Lawn/System/CareFatigue.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "IntensiveCare.h"
+#include <cmath>
+#include <cstdint>
+
+// A rendering pose, never a plant state. Native attack, health, targeting,
+// attachment clocks and save data remain the authority for the actual plant.
+namespace CareFatigue
+{
+inline constexpr int kTiredHealth = 180;
+
+struct Pose
+{
+    float mLean = 0.0f;
+    float mScaleY = 1.0f;
+    float mShade = 1.0f;
+    bool mActive = false;
+};
+
+inline Pose GetPose(int health, int shootingCounter, uint32_t counter, int row, int col)
+{
+    if (health > kTiredHealth || health <= 0) return {};
+    const float phase = static_cast<float>((counter + row * 73 + col * 41) % 600) * 0.010471976f;
+    const float breath = (1.0f + std::sin(phase)) * 0.5f;
+    if (health <= IntensiveCare::kExhaustedHealth)
+    {
+        // A low resting silhouette and slow breathing stay legible at lawn
+        // scale without borrowing the sleeping mushrooms' floating Zs.
+        return {0.56f + breath * 0.018f, 0.60f + breath * 0.018f, 0.86f, true};
+    }
+
+    const float tired = static_cast<float>(kTiredHealth - health) /
+        static_cast<float>(kTiredHealth - IntensiveCare::kExhaustedHealth);
+    const float amount = 0.18f + tired * 0.82f;
+    // Let native attack poses reach the unchanged projectile launch point.
+    // The droop is strongest between attacks, when the plant catches its breath.
+    const float idle = shootingCounter > 0 ? 0.0f : 1.0f;
+    return {(0.10f + breath * 0.08f) * amount * idle,
+        1.0f - (0.12f + breath * 0.04f) * amount * idle,
+        1.0f - 0.045f * amount, true};
+}
+
+template<class Matrix>
+Matrix Transform(const Pose& pose, float pivotX, float pivotY, const Matrix& original)
+{
+    const float c = std::cos(pose.mLean);
+    const float s = std::sin(pose.mLean);
+    Matrix result = original;
+    // Clockwise lean and a shorter stalk, hinged at the planted base. Compose
+    // with every native part's existing matrix, including attached blink art.
+    result.m00 = c * original.m00 - s * pose.mScaleY * original.m10;
+    result.m01 = c * original.m01 - s * pose.mScaleY * original.m11;
+    result.m02 = pivotX + c * (original.m02 - pivotX) - s * pose.mScaleY * (original.m12 - pivotY);
+    result.m10 = s * original.m00 + c * pose.mScaleY * original.m10;
+    result.m11 = s * original.m01 + c * pose.mScaleY * original.m11;
+    result.m12 = pivotY + s * (original.m02 - pivotX) + c * pose.mScaleY * (original.m12 - pivotY);
+    return result;
+}
+}
diff --git a/src/Lawn/System/ChainReaction.cpp b/src/Lawn/System/ChainReaction.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f32eb7b4bc132d3a75306601d271d48f9a6d5fd0
--- /dev/null
+++ b/src/Lawn/System/ChainReaction.cpp
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "ChainReaction.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include "../SeedPacket.h"
+#include "../Coin.h"
+#include "../GridItem.h"
+#include "../Widget/GameButton.h"
+#include "../../LawnApp.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "../../PvzpLib/PvzpParticle.h"
+#include "../../PvzpLib/PvzpFoley.h"
+#include "../../Resources.h"
+#include <algorithm>
+
+namespace ChainReaction
+{
+bool IsPlanning(const Board& board)
+{
+    return board.mApp && board.mChallenge && IsPlanning(board.mApp->mGameMode, board.mChallenge->mChallengeState);
+}
+
+bool CanPlant(const Board& board, SeedType seed) { return IsPlanning(board) && IsExplosive(seed); }
+
+bool HoldsZombie(Zombie& zombie)
+{
+    return zombie.mBoard && IsPlanning(*zombie.mBoard) && zombie.IsOnBoard() && !zombie.IsDeadOrDying();
+}
+
+void PreparePlant(Plant& plant)
+{
+    if (!plant.mBoard || !IsPlanning(*plant.mBoard) || !IsExplosive(plant.mSeedType)) return;
+    Reanimation* body = plant.mApp->ReanimationTryToGet(plant.mBodyReanimID);
+    if (!body) return;
+    if (plant.mSeedType == SEED_POTATOMINE)
+    {
+        // The native preview/IZombie armed pose avoids a preparation wait.
+        plant.mState = STATE_POTATO_ARMED;
+        plant.mStateCountdown = 0;
+        body->SetFramesForLayer("anim_armed");
+        body->mLoopType = REANIM_LOOP;
+        body->mAnimRate = 12.0f;
+    }
+    else
+    {
+        // Use the original idle art while the native fuse waits for Let's Rock.
+        body->mAnimTime = 0.0f;
+        body->SetFramesForLayer("anim_idle");
+        body->mLoopType = REANIM_LOOP;
+    }
+}
+
+void Populate(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    const int stage = std::clamp(challenge.mSurvivalStage, 0, kBoardCount - 1);
+    challenge.mSurvivalStage = stage;
+    challenge.mChallengeState = kPlanning;
+    challenge.mChallengeStateCounter = 0;
+    board.mCurrentWave = 0;
+    board.mZombieCountDown = 100000;
+    board.mZombieCountDownStart = 100000;
+    board.mShowShovel = false;
+    board.mSunMoney = 0;
+    board.ClearCursor();
+    FillSeedBank(*board.mSeedBank);
+    for (SeedType seed : kBoards[stage].mSeeds)
+        if (seed != SEED_NONE) board.mSeedBank->AddSeed(seed, true);
+    for (const Spawn& spawn : kBoards[stage].mZombies)
+    {
+        if (spawn.mType == ZOMBIE_INVALID) continue;
+        Zombie* zombie = board.AddZombieInRow(spawn.mType, spawn.mRow, 0);
+        // Offset the native collision rectangle into the intended lawn cell.
+        zombie->mPosX = static_cast<float>(board.GridToPixelX(spawn.mCol, spawn.mRow) - 17 + spawn.mOffsetX);
+        zombie->mX = static_cast<int>(zombie->mPosX);
+        if (Reanimation* body = board.mApp->ReanimationTryToGet(zombie->mBodyReanimID))
+        {
+            if (body->TrackExists("anim_idle")) zombie->PlayZombieReanim("anim_idle", REANIM_LOOP, 0, 12.0f);
+            else body->mAnimRate = 0.0f;
+        }
+        zombie->UpdateReanim();
+    }
+    // The native intro camera may still be moving. Show the planning control
+    // from the first normal Update, as Last Stand does, rather than over it.
+    board.mStoreButton->mBtnNoDraw = true;
+    board.mStoreButton->mDisabled = true;
+}
+
+void RestoreButton(Board& board)
+{
+    if (!board.mStoreButton) return;
+    GameButton* button = board.mStoreButton.get();
+    const bool planning = IsPlanning(board);
+    button->mParentWidget = &board;
+    button->mBtnNoDraw = !planning;
+    button->mDisabled = !planning;
+    button->SetLabel("[LETS_ROCK_BUTTON]");
+    button->Resize(300, 548, 210, 46);
+}
+
+void ResetStage(Board& board, int stage)
+{
+    // Called only on a newly created replacement board after native Retry or
+    // Restart. Discard its first-board actors, then populate the captured stage.
+    for (Zombie* zombie : board.mZombies) if (!zombie->mDead) zombie->DieNoLoot();
+    for (Plant* plant : board.mPlants) if (!plant->mDead) plant->Die();
+    for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+    for (GridItem* item : board.mGridItems) if (!item->mDead) item->GridItemDie();
+    board.mChallenge->mSurvivalStage = std::clamp(stage, 0, kBoardCount - 1);
+    Populate(board);
+}
+
+void Commit(Board& board)
+{
+    if (!IsPlanning(board) || board.mApp->mGameScene != SCENE_PLAYING || board.mPaused || board.HasLevelAwardDropped()) return;
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    board.mChallenge->mChallengeState = kResolving;
+    board.mChallenge->mChallengeStateCounter = 0;
+    board.mStoreButton->mBtnNoDraw = true;
+    board.mStoreButton->mDisabled = true;
+    for (Plant* plant : board.mPlants)
+        if (!plant->mDead && (plant->mSeedType == SEED_CHERRYBOMB || plant->mSeedType == SEED_JALAPENO))
+            if (Reanimation* body = board.mApp->ReanimationTryToGet(plant->mBodyReanimID))
+            {
+                board.mApp->PlayFoley(FOLEY_REVERSE_EXPLOSION);
+                body->SetFramesForLayer("anim_explode");
+                body->mLoopType = REANIM_PLAY_ONCE_AND_HOLD;
+                body->mAnimTime = 0.0f;
+                body->mLastFrameTime = 0.0f;
+                body->mLoopCount = 0;
+            }
+    for (Zombie* zombie : board.mZombies)
+        if (!zombie->mDead && !zombie->IsDeadOrDying()) zombie->StartWalkAnim(0);
+}
+
+void Update(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (!IsCurrentRules(board.mApp->mGameMode, challenge.mChallengeState) || board.mPaused ||
+        board.mApp->mGameScene != SCENE_PLAYING || board.HasLevelAwardDropped()) return;
+    board.mShowShovel = false;
+    if (challenge.mChallengeState == kPlanning)
+    {
+        if (board.mStoreButton->mBtnNoDraw) RestoreButton(board);
+        return;
+    }
+    if (challenge.mChallengeState == kTransition)
+    {
+        if (--challenge.mChallengeStateCounter > 0) return;
+        challenge.PuzzleNextStageClear();
+        for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+        Populate(board);
+        return;
+    }
+    if (challenge.mChallengeState != kResolving) return;
+    ++challenge.mChallengeStateCounter;
+    if (!board.AreEnemyZombiesOnScreen())
+    {
+        if (challenge.mSurvivalStage == kBoardCount - 1)
+        {
+            challenge.mChallengeState = kFinished;
+            challenge.SpawnLevelAward(4, 2);
+        }
+        else
+        {
+            challenge.mChallengeState = kTransition;
+            challenge.mChallengeStateCounter = kTransitionTicks;
+        }
+        return;
+    }
+    bool pending = false;
+    for (Plant* plant : board.mPlants)
+        if (!plant->mDead && plant->mPlantHealth > 0 && IsExplosive(plant->mSeedType) &&
+            plant->mState != STATE_DOINGSPECIAL)
+            pending = true;
+    // Do not fail an armed mine waiting for a real zombie to approach it.
+    if (!pending && challenge.mChallengeStateCounter > 120) board.ZombiesWon(nullptr);
+}
+}
diff --git a/src/Lawn/System/ChainReaction.h b/src/Lawn/System/ChainReaction.h
new file mode 100644
index 0000000000000000000000000000000000000000..81ceeb0786dd66dd83a71ab93be102d9b274c087
--- /dev/null
+++ b/src/Lawn/System/ChainReaction.h
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+
+class Board;
+class Plant;
+class Zombie;
+
+// A five-board placement puzzle. Native saved board, challenge, packet and
+// actor fields carry preparation, finite inventory, fuses and stage progress.
+namespace ChainReaction
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_CHAIN_REACTION;
+inline constexpr ChallengeState kPlanning = static_cast<ChallengeState>(106);
+inline constexpr ChallengeState kResolving = static_cast<ChallengeState>(107);
+inline constexpr ChallengeState kTransition = static_cast<ChallengeState>(108);
+inline constexpr ChallengeState kFinished = static_cast<ChallengeState>(109);
+inline constexpr int kBoardCount = 5;
+inline constexpr int kTransitionTicks = 180;
+inline constexpr int kSeedCount = 10;
+
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{
+    return IsMode(mode) && state >= kPlanning && state <= kFinished;
+}
+constexpr bool IsPlanning(GameMode mode, ChallengeState state) { return IsMode(mode) && state == kPlanning; }
+constexpr bool IsExplosive(SeedType seed)
+{
+    return seed == SEED_CHERRYBOMB || seed == SEED_JALAPENO || seed == SEED_POTATOMINE;
+}
+
+struct Spawn { ZombieType mType = ZOMBIE_INVALID; int mCol = 0; int mRow = 0; int mOffsetX = 0; };
+struct Puzzle
+{
+    std::array<SeedType, 3> mSeeds;
+    std::array<Spawn, 12> mZombies;
+};
+// Layouts are deliberately spatial: a compact blast, one complete lane, an
+// isolated mine lane, two separate blast shapes, then all three tools together.
+// Reserve the top lawn row so native zombie heads stay below the conveyor HUD.
+inline constexpr std::array<Puzzle, kBoardCount> kBoards = {{
+    {{SEED_CHERRYBOMB, SEED_NONE, SEED_NONE}, {{
+        {ZOMBIE_NORMAL,5,1}, {ZOMBIE_TRAFFIC_CONE,5,2}, {ZOMBIE_NORMAL,5,3}}}},
+    {{SEED_JALAPENO, SEED_NONE, SEED_NONE}, {{
+        {ZOMBIE_NORMAL,2,2}, {ZOMBIE_TRAFFIC_CONE,4,2}, {ZOMBIE_PAIL,6,2}, {ZOMBIE_DOOR,8,2}}}},
+    {{SEED_POTATOMINE, SEED_CHERRYBOMB, SEED_NONE}, {{
+        {ZOMBIE_NORMAL,3,1}, {ZOMBIE_TRAFFIC_CONE,3,1,6},
+        {ZOMBIE_NORMAL,6,2}, {ZOMBIE_PAIL,6,3}, {ZOMBIE_NORMAL,6,4}}}},
+    {{SEED_JALAPENO, SEED_CHERRYBOMB, SEED_NONE}, {{
+        {ZOMBIE_TRAFFIC_CONE,2,1}, {ZOMBIE_NORMAL,5,1}, {ZOMBIE_DOOR,8,1},
+        {ZOMBIE_NORMAL,6,2}, {ZOMBIE_PAIL,6,3}, {ZOMBIE_TRAFFIC_CONE,6,4}}}},
+    {{SEED_CHERRYBOMB, SEED_JALAPENO, SEED_POTATOMINE}, {{
+        {ZOMBIE_NORMAL,2,1}, {ZOMBIE_PAIL,5,1}, {ZOMBIE_DOOR,8,1},
+        {ZOMBIE_TRAFFIC_CONE,7,2}, {ZOMBIE_PAIL,7,3}, {ZOMBIE_NORMAL,7,4},
+        {ZOMBIE_NORMAL,3,4}, {ZOMBIE_TRAFFIC_CONE,3,4,6}}}}
+}};
+
+constexpr int ZombieCount(int stage)
+{
+    if (stage < 0 || stage >= kBoardCount) return 0;
+    int count = 0;
+    for (const Spawn& spawn : kBoards[stage].mZombies) if (spawn.mType != ZOMBIE_INVALID) ++count;
+    return count;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kBoardCount);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    // Real opponents are placed from the saved stage layout, not wave spawns.
+    // Keeping the ordinary wave index below this bound also prevents a native
+    // death callback from awarding the whole challenge after an early board.
+    return kBoardCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    for (auto& allowed : output) allowed = false;
+    for (const Puzzle& board : kBoards) for (const Spawn& spawn : board.mZombies)
+        if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+template<class Bank>
+void FillSeedBank(Bank& bank)
+{
+    bank.mNumPackets = kSeedCount;
+    for (int i = 0; i < bank.mNumPackets; ++i) bank.mSeedPackets[i].mPacketType = SEED_NONE;
+}
+
+void Populate(Board& board);
+void ResetStage(Board& board, int stage);
+void Commit(Board& board);
+void Update(Board& board);
+void PreparePlant(Plant& plant);
+void RestoreButton(Board& board);
+bool IsPlanning(const Board& board);
+bool CanPlant(const Board& board, SeedType seed);
+bool HoldsZombie(Zombie& zombie);
+}
