-				float halfV = 0.5f / piece.mHeight;
-				float uvb[4] = {
-					std::min(halfU, 0.5f),
-					std::min(halfV, 0.5f),
-					std::max(1.0f - halfU, 0.5f),
-					std::max(1.0f - halfV, 0.5f)
-				};
-				VertexList vl = master;
-				for (int k = 0; k < 3; k++)
-				{
-					vl[k].tu -= j;
-					vl[k].tv -= i;
