+
+void MemoryImage::SlowStretchBlt(Image* theImage, const Rect& theDestRect, const FRect& theSrcRect, const Color& theColor, int theDrawMode)
+{
+	if (theDestRect.mWidth <= 0 || theDestRect.mHeight <= 0 || theSrcRect.mWidth <= 0 || theSrcRect.mHeight <= 0)
+		return;
+	// The native white-normal path composites the filtered channels directly.
+	// Routing it through Blt changes its separately truncated /256 products.
+	if (theColor == Color::White && theDrawMode == Graphics::DRAWMODE_NORMAL)
+	{
+		SlowStretchResample(theImage, theDestRect, theSrcRect, true);
+		return;
+	}
+	MemoryImage sampled(mApp);
+	sampled.Create(theDestRect.mWidth, theDestRect.mHeight);
+	sampled.SlowStretchResample(theImage, Rect(0, 0, theDestRect.mWidth, theDestRect.mHeight), theSrcRect, false);
+	sampled.CommitBits();
+	if (auto* source = dynamic_cast<MemoryImage*>(theImage))
+		sampled.SetImageMode(sampled.mHasTrans || source->mHasTrans, sampled.mHasAlpha || source->mHasAlpha);
+	Blt(&sampled, theDestRect.mX, theDestRect.mY, Rect(0, 0, sampled.mWidth, sampled.mHeight), theColor, theDrawMode, false);
+}
