+bool Board::HasValidCobCannonSpot()
+{
+	for (Plant* aPlant : mPlants)
+	{
+		if (aPlant->mDead)
+			continue;
+		if (aPlant->mSeedType == SeedType::SEED_KERNELPULT && IsValidCobCannonSpot(aPlant->mPlantCol, aPlant->mRow))
+		{
+			return true;
+		}
+	}
+	return false;
