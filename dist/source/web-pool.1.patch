+	std::string aCoinLabel = mApp->GetMoneyString(mApp->mPlayerInfo->mCoins);
+	g->DrawString(aCoinLabel, aPosX + 116 - Sexy::FONT_CONTINUUMBOLD14->StringWidth(aCoinLabel), aPosY + 24);
