+static void GfxEnd()
+{
+	if (gVertexMode == (GLenum)-1) return;
+	if (gNumVertices > gPrimitiveStart)
+		gDrawCommands.push_back({gVertexMode, gPrimitiveStart, gNumVertices - gPrimitiveStart, gDrawState});
