+	mGameSpeedPressArmed = false;
+	mGameSpeedButton = std::make_unique<GameButton>(2);
+	mGameSpeedButton->mDrawStoneButton = true;
+	mGameSpeedButton->mParentWidget = theBoard;
+	mGameSpeedButton->SetLabel(mDoubleGameSpeed ? "2x" : "1x");
+	// The ten-packet bank and shovel fill the horizontal space beside Menu.
+	mGameSpeedButton->Resize(681, 32, 117, 46);
+	mGameSpeedButton->mBtnNoDraw = true;
+	mGameSpeedButton->mDisabled = true;
+}
+
