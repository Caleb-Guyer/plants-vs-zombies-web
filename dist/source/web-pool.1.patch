-	}
-	else if (mFogBlownCountDown > 0)
-	{
-		aFogFadeInSpeed = 20;
-	}
-
-	int aLeft = LeftFogColumn();
-	for (int x = aLeft; x < MAX_GRID_SIZE_X; x++)
-	{
-		for (int y = 0; y < MAX_GRID_SIZE_Y + 1; y++)
