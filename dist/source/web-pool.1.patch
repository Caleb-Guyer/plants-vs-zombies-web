diff --git a/src/PvzpLib/PvzpNativeScreenPixel888.inc b/src/PvzpLib/PvzpNativeScreenPixel888.inc
new file mode 100644
index 0000000000000000000000000000000000000000..a5c30bb20d0cc6e752dda7503f6ff25cf4a25bd4
--- /dev/null
+++ b/src/PvzpLib/PvzpNativeScreenPixel888.inc
@@ -0,0 +1,54 @@
+/* Copyright (C) 2026. SPDX-License-Identifier: LGPL-3.0-or-later */
+// Keep unproved inputs and every offscreen call on the frozen6 implementation.
+if (nativeScreenRaster && u <= nativeTextureWidth * 0x10000u && v <= nativeTextureHeight * 0x10000u
+#if defined(MOD_ARGB)
+    && a <= 0xff0000u && r <= 0xff0000u && g <= 0xff0000u && b <= 0xff0000u
+#endif
+    )
+{
+    #include "PvzpLib/PvzpNativeScreenTexel.inc"
+    #if defined(NAME_ADDITIVE) && !defined(TEX_ALPHA) && !defined(MOD_ARGB) && defined(GLOBAL_ARGB) && !defined(LINEAR_BLEND)
+        // The addressed opaque nearest worker ignores stored texture alpha.
+        // Force it before global modulation, including zero/empty texels.
+        alpha = 255;
+    #endif
+    if (alpha > 8)
+    {
+        // Existing tint interpolation/modulation is independently matched.
+        #include "graphics/SWTri/SWTri_TexelARGB.inc"
+        unsigned int result = 0xff000000u;
+        for (int shift = 0; shift < 24; shift += 8)
+        {
+            const unsigned int source = (tex >> shift) & 255;
+            const unsigned int destination = (*pix >> shift) & 255;
+            unsigned int output;
+            #if defined(NAME_ADDITIVE)
+                #if defined(LINEAR_BLEND)
+                    const unsigned int contribution = source;
+                #else
+                    const unsigned int contribution = (source * alpha) >> 8;
+                #endif
+                output = destination + contribution;
+                if (output > 255) output = 255;
+            #else
+                if (alpha >= 240)
+                    output = source;
+                else
+                {
+                    #if defined(LINEAR_BLEND)
+                        const unsigned int contribution = source;
+                    #else
+                        const unsigned int contribution = (source * alpha) >> 8;
+                    #endif
+                    output = contribution + ((destination * (255 - alpha)) >> 8);
+                }
+            #endif
+            result |= output << shift;
+        }
+        *pix = result;
+    }
+}
+else
+{
+    #include "graphics/SWTri/SWTri_Pixel888.inc"
+}
diff --git a/src/PvzpLib/PvzpNativeScreenTexel.inc b/src/PvzpLib/PvzpNativeScreenTexel.inc
new file mode 100644
index 0000000000000000000000000000000000000000..ec72cdedad3b2f295381cd463c85d6b8306b7be9
--- /dev/null
+++ b/src/PvzpLib/PvzpNativeScreenTexel.inc
@@ -0,0 +1,41 @@
+/* Copyright (C) 2026. SPDX-License-Identifier: LGPL-3.0-or-later */
+// Addressed original RGB888 sampler; caller proves complete dimensions/UVs.
+unsigned int tex;
+#if !defined(LINEAR_BLEND)
+{
+    const unsigned int position = (v >> 16) * nativeTextureWidth + (u >> 16);
+    tex = position < tex_endpos ? pTexture[position] : 0;
+}
+#else
+{
+    const int qx = static_cast<int>(u) - 0x8000;
+    const int qy = static_cast<int>(v) - 0x8000;
+    const int bx = qx > 0 ? qx & ~0xffff : 0;
+    const int by = qy > 0 ? qy & ~0xffff : 0;
+    const unsigned int dx = qx > 0 && static_cast<unsigned int>(bx >> 16) < nativeTextureWidth - 1 ? 1 : 0;
+    const unsigned int dy = qy > 0 && static_cast<unsigned int>(by >> 16) < nativeTextureHeight - 1 ? nativeTextureWidth : 0;
+    const unsigned int position = static_cast<unsigned int>(by >> 16) * nativeTextureWidth + static_cast<unsigned int>(bx >> 16);
+    const unsigned int pixels[4] = {pTexture[position], pTexture[position + dx],
+        pTexture[position + dy], pTexture[position + dx + dy]};
+    const unsigned int fx = (static_cast<unsigned int>(qx - bx) & 0xfffe) + 1;
+    const unsigned int fy = (static_cast<unsigned int>(qy - by) & 0xfffe) + 1;
+    const unsigned int weights[4] = {((0x10000u - fx) * (0x10000u - fy)) >> 16,
+        (fx * (0x10000u - fy)) >> 16, ((0x10000u - fx) * fy) >> 16, (fx * fy) >> 16};
+    unsigned int alphas[4];
+    unsigned int totalAlpha = 0;
+    for (int i = 0; i < 4; ++i)
+    {
+        alphas[i] = ((pixels[i] >> 24) * weights[i]) >> 16;
+        totalAlpha += alphas[i];
+    }
+    tex = (totalAlpha & 255) << 24;
+    for (int shift = 0; shift < 24; shift += 8)
+    {
+        unsigned int sum = 0;
+        for (int i = 0; i < 4; ++i)
+            sum += ((pixels[i] >> shift) & 255) * alphas[i];
+        tex |= ((sum >> 8) & 255) << shift;
+    }
+}
+#endif
+unsigned int alpha = tex >> 24;
