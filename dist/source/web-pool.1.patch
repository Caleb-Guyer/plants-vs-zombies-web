-				if (aDistX + aDistY == 5)
-				{
-					continue;
-				}
-			}
-			else if (aDistX + aDistY > theSize)
-			{
-				continue;
-			}
-
-			mGridCelFog[x][y] = std::max(mGridCelFog[x][y] - aFogFadeOutSpeed, 0);
