diff --git a/artwork/mender-bloom/render.py b/artwork/mender-bloom/render.py
new file mode 100644
index 0000000000000000000000000000000000000000..4d5f5c6d93fc7f3353da5153099fb5ec0f36ca82
--- /dev/null
+++ b/artwork/mender-bloom/render.py
@@ -0,0 +1,128 @@
+"""Pack a distinct generated blossom head over unchanged original stem/leaves.
+
+No network or image-generation call occurs here. The recorded generated head
+is normalized once; only registered eye-region RGB comes from its closed pose.
+The native stem recipe and its exact output pixels remain those of Mender.2.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+from PIL import Image, __version__ as PILLOW_VERSION
+
+ROOT = Path(__file__).resolve().parent
+VERSION = '0.2.6-web-mender.3'
+STEM_RGBA = 'd306df9ab8d66cf3d7854bb599341525550b0f665cc529d2d708ad3cc18da2c1'
+STEM_PNG = 'e23f660180de218dca4ca7692f005b67115d7998e0303a7b1a68b4e9a78b2f02'
+
+def sha(raw): return hashlib.sha256(raw).hexdigest()
+
+def read_image(name):
+    with Image.open(ROOT / name) as image:
+        return image.convert('RGBA')
+
+def place(out, image, x, y, scale_x, scale_y, oversample):
+    size = (round(image.width * scale_x * oversample), round(image.height * scale_y * oversample))
+    image = image.resize(size, Image.Resampling.LANCZOS)
+    out.alpha_composite(image, (round(x * oversample), round(y * oversample)))
+
+def clean(image, threshold):
+    image = image.copy()
+    image.putdata([(r,g,b,a) if a > threshold else (0,0,0,0)
+                   for r,g,b,a in image.get_flattened_data()])
+    return image
+
+def normalize_head(image, recipe):
+    head = recipe['head']
+    assert image.size == tuple(head['sourceCanvas'])
+    image = clean(image, recipe['discardAlphaAtMost'])
+    image = image.crop(tuple(head['crop'])).resize(tuple(head['size']), Image.Resampling.LANCZOS)
+    canvas = Image.new('RGBA', tuple(recipe['canvas']))
+    canvas.alpha_composite(image, tuple(head['offset']))
+    return clean(canvas, recipe['discardAlphaAtMost'])
+
+def compose(recipe):
+    sample = recipe['oversample']
+    size = tuple(value * sample for value in recipe['canvas'])
+    stem = Image.new('RGBA', size)
+    dx,dy = recipe['stem']['translation']
+    for part in recipe['stem']['tracks']:
+        place(stem, read_image('native/' + part['source']), part['x'] + dx, part['y'] + dy,
+              part['sx'], part['sy'], sample)
+    stem = clean(stem.resize(tuple(recipe['canvas']), Image.Resampling.LANCZOS), recipe['discardAlphaAtMost'])
+    assert sha(stem.tobytes()) == STEM_RGBA, 'Original stem/leaf pixels changed'
+    head = normalize_head(read_image(recipe['head']['source']), recipe)
+    closed_head = normalize_head(read_image(recipe['head']['closedSource']), recipe)
+    head_blink = head.copy()
+    for left,top,right,bottom in recipe['eyeRegions']:
+        for y in range(top,bottom):
+            for x in range(left,right):
+                original = head.getpixel((x,y))
+                assert original[3] > 240
+                head_blink.putpixel((x,y), closed_head.getpixel((x,y))[:3] + (original[3],))
+    canonical = Image.alpha_composite(stem,head)
+    blink = Image.alpha_composite(stem,head_blink)
+    assert blink.getchannel('A').tobytes() == canonical.getchannel('A').tobytes()
+    return {'canonical':canonical,'head':head,'stem':stem,'head-blink':head_blink,'blink':blink}
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output',type=Path,required=True)
+    parser.add_argument('--header',type=Path,required=True)
+    args = parser.parse_args()
+    recipe_raw = (ROOT/'extraction.json').read_bytes()
+    recipe = json.loads(recipe_raw)
+    generation_raw = (ROOT/'generation.json').read_bytes()
+    native_raw = (ROOT/'native-provenance.json').read_bytes()
+    native = json.loads(native_raw)
+    active_names = {'native/' + item['source'] for item in recipe['stem']['tracks']} | {'native/SunFlower.reanim'}
+    assert len(active_names) == 9
+    active = [part for part in native['sourceInputs'] if part['path'] in active_names]
+    historical = [part for part in native['sourceInputs'] if part['path'] not in active_names]
+    assert len(active) == 9 and len(historical) == 4
+    for part in native['sourceInputs']:
+        assert sha((ROOT/part['path']).read_bytes()) == part['sha256'], part['path']
+    master_raw = (ROOT/recipe['head']['source']).read_bytes()
+    closed_raw = (ROOT/recipe['head']['closedSource']).read_bytes()
+    images = compose(recipe)
+    args.output.mkdir(parents=True,exist_ok=True)
+    records = {}
+    for name,image in images.items():
+        path = args.output/(name+'.png')
+        image.save(path,compress_level=9)
+        records[name] = {'pngSha256':sha(path.read_bytes()),'rgbaSha256':sha(image.tobytes()),
+                         'visibleBounds':image.getbbox(),'width':image.width,'height':image.height}
+    assert records['stem']['pngSha256'] == STEM_PNG, 'Original stem PNG encoding changed'
+    header = ['// Generated by artwork/mender-bloom/render.py from a distinct blossom head and original stem parts. Straight-alpha ARGB.',
+              '#pragma once','#include <cstdint>','namespace MenderBloomArt {',
+              'inline constexpr int kWidth = 80;','inline constexpr int kHeight = 80;']
+    for name,image in [('kArgb',images['canonical']),('kHeadArgb',images['head']),('kStemArgb',images['stem']),('kHeadBlinkArgb',images['head-blink'])]:
+        raw = image.tobytes()
+        values = [(raw[i+3]<<24)|(raw[i]<<16)|(raw[i+1]<<8)|raw[i+2] for i in range(0,len(raw),4)]
+        header.append('inline constexpr uint32_t '+name+'[] = {')
+        for start in range(0,len(values),10): header.append('    '+', '.join(f'0x{pixel:08x}u' for pixel in values[start:start+10])+',')
+        header.append('};')
+    header.append('}')
+    args.header.parent.mkdir(parents=True,exist_ok=True)
+    args.header.write_text('\n'.join(header)+'\n',encoding='utf-8',newline='\n')
+    provenance = {'schema':3,'version':VERSION,'displayName':'Mender-bloom',
+        'imageGenerationUsed':True,'historicalImageGenerationUsed':True,
+        'historicalGeneratedArtworkActive':False,'historicalNativeHeadActive':False,
+        'standaloneChallengeIllustrations':False,
+        'method':'Distinct generated cupped-blossom head and expression over unchanged original stem and leaves',
+        'pillowVersion':PILLOW_VERSION,'sourceInputs':active,'historicalNativeInputs':historical,
+        'assetBundleId':native['assetBundleId'],'nativeInputsSha256':sha(native_raw),
+        'sourceMasterSha256':sha(master_raw),'sourceClosedSha256':sha(closed_raw),
+        'generatedHead':{'masterPath':recipe['head']['source'],'closedPath':recipe['head']['closedSource'],
+                         'masterSha256':sha(master_raw),'closedSha256':sha(closed_raw)},
+        'unchangedStem':{'parentVersion':'0.2.6-web-mender.2','pngSha256':STEM_PNG,'rgbaSha256':STEM_RGBA},
+        'generationSha256':sha(generation_raw),'extractionSha256':sha(recipe_raw),
+        'historicalGenerationSha256':sha((ROOT/'generation-history.json').read_bytes()),
+        'historicalNativeGenerationSha256':sha((ROOT/'generation-mender2-history.json').read_bytes()),
+        'generatorSha256':sha(Path(__file__).read_bytes()),'headerSha256':sha(args.header.read_bytes()),
+        'canonicalRgbaSha256':sha(images['canonical'].tobytes()),'parts':records}
+    for name,data in [('generation.json',generation_raw),('extraction.json',recipe_raw),('provenance.json',(json.dumps(provenance,indent=2)+'\n').encode('utf-8'))]:
+        (args.output/name).write_bytes(data)
+    print(json.dumps(provenance,indent=2))
+
+if __name__ == '__main__': main()
