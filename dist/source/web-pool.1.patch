+Rect Board::GetShovelButtonRect()
+{
+    if (LightsOut::IsMode(mApp->mGameMode) || GarlicRun::IsMode(mApp->mGameMode)) return Rect(456, 0, Sexy::IMAGE_SHOVELBANK->GetWidth(), Sexy::IMAGE_SHOVELBANK->GetHeight());
+	const bool aCareTool = IntensiveCare::IsMode(mApp->mGameMode);
+	Rect aRect(aCareTool ? 0 : GetSeedBankExtraWidth() + 456, 0,
+        Sexy::IMAGE_SHOVELBANK->GetWidth(), Sexy::IMAGE_SHOVELBANK->GetHeight());
+	if (aCareTool)
+	{
+		// The backdrop is drawn in seed-bank space, including its native slide.
+		// Keep the complete tool frame clear of both it and the menu/speed bank.
+		const int aBankX = mSeedBank ? mSeedBank->mX : SEED_BANK_OFFSET_X_END;
+		const int aMenuX = mMenuButton && mMenuButton->mX > 0 ? mMenuButton->mX : 681;
+		const int aBackdropWidth = Sexy::IMAGE_CONVEYORBELT_BACKDROP ?
+            Sexy::IMAGE_CONVEYORBELT_BACKDROP->GetWidth() : 516;
+		aRect.mX = aBankX + 83 + aBackdropWidth + 6;
+		const int aNativeWidth = aRect.mWidth;
+		aRect.mWidth = std::min(aNativeWidth, std::max(1, aMenuX - 2 - aRect.mX));
+		aRect.mHeight = (aRect.mHeight * aRect.mWidth + aNativeWidth / 2) / aNativeWidth;
+	}
+	else if (mApp->IsSlotMachineLevel() || mApp->IsSquirrelLevel())
+	{
+		aRect.mX = 600;
+	}
+	return aRect;
+}
+
+void Board::GetZenButtonRect(GameObjectType theObjectType, Rect& theRect)
+{
+	// theRect must be pre-initialized with the shovel button rect; this function only adjusts its X
+
+	theRect.mX = 30;
+	if (mApp->mGameMode == GameMode::GAMEMODE_TREE_OF_WISDOM)
+	{
+		return;
+	}
+
+	bool usable = true;
+	for (int anObject = GameObjectType::OBJECT_TYPE_WATERING_CAN; anObject <= GameObjectType::OBJECT_TYPE_WHEELBARROW; anObject++)
+	{
+		if (!CanUseGameObject((GameObjectType)anObject))
+		{
+			usable = false;
+			break;
+		}
+	}
+	if (usable)
+	{
+		theRect.mX = 0;
+	}
+
+	int aShovelWidth = Sexy::IMAGE_SHOVELBANK->GetWidth();
+	for (int anObject = GameObjectType::OBJECT_TYPE_WATERING_CAN; anObject < theObjectType; anObject++)
+	{
+		if (CanUseGameObject((GameObjectType)anObject))
+		{
+			theRect.mX += aShovelWidth;
+		}
+	}
+	//return theRect;
+}
