-	if (img->mColorTable == nullptr)
-	{
-		uint32_t *srcRow = (uint32_t*)img->GetBits() + offy * img->GetWidth() + offx;
-		uint32_t *dstRow = dst;
-		for (int y = 0; y < h; y++)
-		{
-			uint32_t *s = srcRow, *d = dstRow;
-			for (int x = 0; x < w; x++)
-				*d++ = ArgbToRgba(*s++);
-			if (padR) *d = *(d - 1);
-			srcRow += img->GetWidth();
-			dstRow += pitch;
-		}
-	}
-	else
-	{
-		uint8_t  *srcRow = (uint8_t*)img->mColorIndices.get() + offy * img->GetWidth() + offx;
-		uint32_t *dstRow = dst;
-		uint32_t *pal = (uint32_t*)img->mColorTable.get();
