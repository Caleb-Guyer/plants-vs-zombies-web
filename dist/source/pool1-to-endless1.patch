diff --git a/src/Lawn/System/PoolPanicEndless.cpp b/src/Lawn/System/PoolPanicEndless.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f507b35455dafeb73a60d8388eebf69297668f1c
--- /dev/null
+++ b/src/Lawn/System/PoolPanicEndless.cpp
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "PoolPanicEndless.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include "../SeedPacket.h"
