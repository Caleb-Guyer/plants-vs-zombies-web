+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#endif
+
+namespace PoolPanicEndless
+{
+namespace
+{
+void RestoreEmptyPads(Board& board)
+{
+    for (const Cell& cell : kLilyPads)
+        if (!board.GetTopPlantAt(cell.mCol,cell.mRow,TOPPLANT_ANY))
+            board.AddPlant(cell.mCol,cell.mRow,SEED_LILYPAD,SEED_NONE);
+}
+void UpdateSupply(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    board.mSeedBank->UpdateConveyorBelt();
+    if (challenge.mChallengeScore >= kPacketQuota ||
+        board.mSeedBank->GetNumSeedsOnConveyorBelt() >= board.mSeedBank->mNumPackets) return;
+    if (challenge.mConveyorBeltCounter > 0) --challenge.mConveyorBeltCounter;
+    if (challenge.mConveyorBeltCounter != 0) return;
+    const SeedType seed = SeedForSupply(challenge.mSurvivalStage,challenge.mChallengeScore);
+    board.mSeedBank->AddSeed(seed);
+    challenge.mLastConveyorSeedType = seed;
+    ++challenge.mChallengeScore;
+    challenge.mConveyorBeltCounter = kSupplyInterval;
+}
+void CompleteFlag(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    if (challenge.mSurvivalStage < INT_MAX) ++challenge.mSurvivalStage;
+    challenge.mChallengeState = kBetween;
+    challenge.mChallengeStateCounter = kBetweenDelay;
+    // Accepted native packets carry unchanged. Only this completed flag's
+    // unissued quota expires; the next flag starts a new delivery allowance.
+    challenge.mChallengeScore = 0;
+    challenge.mConveyorBeltCounter = kSupplyInterval;
+    board.mCurrentWave = 0;
+    board.mProgressMeterWidth = 0;
+    board.mZombieCountDown = board.mZombieCountDownStart = kBetweenDelay;
+    RestoreEmptyPads(board);
+    board.SurvivalSaveScore();
+    board.SaveGame(GetSavedGameName(kMode,board.mApp->mPlayerInfo->mId));
+#ifdef __EMSCRIPTEN__
+    // Use the existing serialized browser persistence queue after BOTH native
+    // files were written. Its helper owns promise/error handling; Node lacks it.
+    EM_ASM({
+        if (typeof globalThis.syncSavesInBackground === 'function')
+            globalThis.syncSavesInBackground();
+    });
+#endif
+}
+}
+void Populate(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    challenge.mChallengeState = kActive;
+    challenge.mChallengeStateCounter = kOpeningDelay;
+    challenge.mSurvivalStage = 0;
+    challenge.mChallengeScore = 0;
+    challenge.mConveyorBeltCounter = kSupplyInterval;
+    challenge.mChallengeGridX = Sexy::Rand(8);
+    board.mCurrentWave = board.mTotalSpawnedWaves = 0;
+    board.mZombieCountDown = board.mZombieCountDownStart = kOpeningDelay;
+    board.mZombieHealthToNextWave = -1;
+    board.mSunMoney = 0;
+    board.mShowShovel = false;
+    board.ClearCursor();
+    FillSeedBank(*board.mSeedBank);
+    for (int i = 0; i < kOpeningPackets; ++i)
+    {
+        const SeedType seed = SeedForSupply(0,challenge.mChallengeScore);
+        board.mSeedBank->AddSeed(seed,true);
+        challenge.mLastConveyorSeedType = seed;
+        ++challenge.mChallengeScore;
+    }
+    RestoreEmptyPads(board);
+}
+void Update(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (!IsCurrentRules(board.mApp->mGameMode,challenge.mChallengeState) ||
+        board.mApp->mGameScene != SCENE_PLAYING || board.mPaused || board.mTimeStopCounter > 0 ||
+        board.mLevelComplete || board.HasLevelAwardDropped()) return;
+    board.mShowShovel = false;
+    UpdateSupply(board);
+    if (challenge.mChallengeState == kBetween)
+    {
+        if (challenge.mChallengeStateCounter > 0) --challenge.mChallengeStateCounter;
+        board.mZombieCountDown = challenge.mChallengeStateCounter;
+        if (challenge.mChallengeStateCounter == 0)
+        {
+            challenge.mChallengeState = kActive;
+            challenge.mChallengeStateCounter = kResumeDelay;
+            board.mZombieCountDown = board.mZombieCountDownStart = kResumeDelay;
+        }
+        return;
+    }
+    const int wave = std::clamp(board.mCurrentWave,0,kWaveCount);
+    if (wave < kWaveCount)
+    {
+        if (challenge.mChallengeStateCounter > 0) --challenge.mChallengeStateCounter;
+        board.mZombieCountDown = challenge.mChallengeStateCounter;
+        if (challenge.mChallengeStateCounter == 0)
+        {
+            for (const Spawn& spawn : WaveFor(challenge.mSurvivalStage,wave,challenge.mChallengeGridX))
+            {
+                if (spawn.mType == ZOMBIE_INVALID) continue;
+                Zombie* zombie = board.AddZombieInRow(spawn.mType,spawn.mRow,wave);
+                zombie->mPosX = static_cast<float>(spawn.mX);
+                zombie->mX = spawn.mX;
+                zombie->UpdateReanim();
+            }
+            board.mCurrentWave = wave + 1;
+            if (board.mTotalSpawnedWaves < INT_MAX) ++board.mTotalSpawnedWaves;
+            if (wave == kWaveCount-1) board.mFlagRaiseCounter = 100;
+            challenge.mChallengeStateCounter = FormationInterval(challenge.mSurvivalStage);
+            board.mZombieCountDown = board.mZombieCountDownStart = challenge.mChallengeStateCounter;
+        }
+        return;
+    }
+    if (!board.AreEnemyZombiesOnScreen()) CompleteFlag(board);
+}
+}
diff --git a/src/Lawn/System/PoolPanicEndless.h b/src/Lawn/System/PoolPanicEndless.h
new file mode 100644
index 0000000000000000000000000000000000000000..02bf5f01399385a0a5c334b049118adf3351323b
--- /dev/null
+++ b/src/Lawn/System/PoolPanicEndless.h
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+#include <string_view>
+
+class Board;
+
+// Separate from finite Pool Panic. All progress uses existing saved counters;
+// native plants, packets, zombies, mowers and effects retain their own states.
+namespace PoolPanicEndless
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_POOL_PANIC_ENDLESS;
+inline constexpr ChallengeState kActive = static_cast<ChallengeState>(127);
+inline constexpr ChallengeState kBetween = static_cast<ChallengeState>(128);
+inline constexpr int kWaveCount = 10;
+inline constexpr int kLargestFormation = 8;
+inline constexpr int kBankSize = 10;
+inline constexpr int kOpeningPackets = 4;
+inline constexpr int kPacketQuota = 48;
+inline constexpr int kSupplyInterval = 200;
+inline constexpr int kOpeningDelay = 1600;
+inline constexpr int kBetweenDelay = 1200;
+inline constexpr int kResumeDelay = 400;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{ return IsMode(mode) && (state == kActive || state == kBetween); }
+inline constexpr std::array<SeedType,8> kSupplyCycle = {
+    SEED_SQUASH, SEED_TANGLEKELP, SEED_CHERRYBOMB, SEED_TANGLEKELP,
+    SEED_SQUASH, SEED_JALAPENO, SEED_CHERRYBOMB, SEED_TANGLEKELP
+};
+constexpr SeedType SeedForSupply(int flags, int ordinal)
+{
+    if (ordinal < 0 || ordinal >= kPacketQuota) return SEED_NONE;
+    const int rotation = flags > 0 ? (flags % 8) * 3 : 0;
+    return kSupplyCycle[(ordinal + rotation) % kSupplyCycle.size()];
+}
+constexpr int FormationInterval(int flags)
+{ return flags >= 4 ? 800 : 1000 - (flags > 0 ? flags : 0) * 50; }
+struct Cell { int mCol; int mRow; };
+inline constexpr std::array<Cell,8> kLilyPads = {{{0,2},{1,2},{2,2},{3,2},{0,3},{1,3},{2,3},{3,3}}};
+struct Spawn { ZombieType mType = ZOMBIE_INVALID; int mRow = 0; int mX = 0; };
+using Formation = std::array<Spawn,kLargestFormation>;
+// Independently authored opening flags. N normal, C cone, B bucket, S screen
+// door, R football, H snorkel and F dolphin; digits are canonical native rows.
+inline constexpr std::array<std::array<std::string_view,kWaveCount>,3> kOpeningFlags = {{
+    {{"N0 N2","N5 C3","C0 N1 N2","N4 C5 C3","C0 C1 N2 C3","C4 C5 C2 N3",
+      "B0 N1 C2 C3","N4 B5 C2 C3","C0 C1 N2 C3 F3","N4 C5 C2 F2 B3"}},
+    {{"C0 N5 N2","N1 C4 C3","B0 C1 C2 N3","C4 B5 N2 C3","S0 C1 C2 H3 N5",
+      "C0 S4 C5 H2 C3","B0 N1 C2 F2 B3","C4 B5 B2 F3 C3","R0 C1 C4 C2 H2 F3","C1 C4 R5 F2 B3 H3"}},
+    {{"B0 N5 C2 H3","C1 B4 H2 N3","S0 C1 C2 F2 B3","C4 S5 B2 H3 F3","B0 R1 C5 C2 B3 H3",
+      "C0 R4 B5 H2 C3 F3","S0 B1 N4 B2 F2 H3","N1 B4 S5 H2 B3 F3","R0 C1 B4 S5 C2 H2 F3","C0 S1 C4 R5 F2 B3 H3"}}
+}};
+constexpr ZombieType TypeFor(char type)
+{
+    switch (type)
+    {
+    case 'N': return ZOMBIE_NORMAL;
+    case 'C': return ZOMBIE_TRAFFIC_CONE;
+    case 'B': return ZOMBIE_PAIL;
+    case 'S': return ZOMBIE_DOOR;
+    case 'R': return ZOMBIE_FOOTBALL;
+    case 'H': return ZOMBIE_SNORKEL;
+    case 'F': return ZOMBIE_DOLPHIN_RIDER;
+    default: return ZOMBIE_INVALID;
+    }
+}
+constexpr Formation ParseWave(std::string_view text)
+{
+    Formation result{};
+    int count = 0;
+    for (std::size_t i = 0; i + 1 < text.size() && count < kLargestFormation; i += 3)
+    {
+        result[count] = {TypeFor(text[i]),text[i+1]-'0',800+(count%3)*40};
+        ++count;
+    }
+    return result;
+}
+constexpr int ZombieCount(const Formation& formation)
+{
+    int count = 0;
+    for (const Spawn& spawn : formation) count += spawn.mType != ZOMBIE_INVALID;
+    return count;
+}
+constexpr int TransformRow(int row, int flags, int variation, int wave)
+{
+    if (row == 2 || row == 3) return 2 + (row-2 + variation/4 + flags%2 + wave) % 2;
+    constexpr int land[4] = {0,1,4,5};
+    const int index = row < 2 ? row : row-2;
+    return land[(index + variation%4 + flags%4) % 4];
+}
+constexpr Formation WaveFor(int flags, int wave, int variation)
+{
+    Formation result{};
+    if (flags < 0 || wave < 0 || wave >= kWaveCount || variation < 0 || variation >= 8) return result;
+    if (flags < 3) result = ParseWave(kOpeningFlags[flags][wave]);
+    else
+    {
+        // Later flags rotate the authored grouping, cap density, and introduce
+        // native special abilities instead of increasing enemy statistics.
+        const Formation source = ParseWave(kOpeningFlags[2][(wave+(flags%5)*2)%kWaveCount]);
+        const int sourceCount = ZombieCount(source);
+        const int count = ZombieCount(ParseWave(kOpeningFlags[0][wave])) + 3;
+        for (int i = 0; i < count; ++i)
+        {
+            result[i] = source[i%sourceCount];
+            result[i].mX = 800+(i%3)*40;
+            const int key = (flags%16 + wave*3 + i*5) % 16;
+            const bool water = result[i].mRow == 2 || result[i].mRow == 3;
+            if (water)
+            {
+                constexpr ZombieType types[5] = {ZOMBIE_NORMAL,ZOMBIE_TRAFFIC_CONE,ZOMBIE_PAIL,ZOMBIE_SNORKEL,ZOMBIE_DOLPHIN_RIDER};
+                result[i].mType = types[(key+flags%5)%5];
+            }
+            else if (flags >= 6 && key == 0) result[i].mType = ZOMBIE_GARGANTUAR;
+            else if (flags >= 5 && key == 2) result[i].mType = ZOMBIE_LADDER;
+            else if (flags >= 4 && key == 1) result[i].mType = ZOMBIE_JACK_IN_THE_BOX;
+            else if (key%5 == 0) result[i].mType = ZOMBIE_FOOTBALL;
+            else if (key%7 == 0) result[i].mType = ZOMBIE_NEWSPAPER;
+        }
+    }
+    for (Spawn& spawn : result) if (spawn.mType != ZOMBIE_INVALID)
+        spawn.mRow = TransformRow(spawn.mRow,flags,variation,wave);
+    return result;
+}
+constexpr int ZombiesPerFlag(int flags)
+{
+    int count = 0;
+    for (int wave = 0; wave < kWaveCount; ++wave) count += ZombieCount(WaveFor(flags,wave,0));
+    return count;
+}
+template<std::size_t Waves,std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestFormation);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int wave = 0; wave < kWaveCount; ++wave)
+    {
+        const Formation formation = WaveFor(0,wave,0);
+        for (int i = 0; i < ZombieCount(formation); ++i) output[wave][i] = formation[i].mType;
+    }
+    return kWaveCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_DOLPHIN_RIDER));
+    for (auto& allowed : output) allowed = false;
+    for (int wave = 0; wave < kWaveCount; ++wave) for (const Spawn& spawn : WaveFor(0,wave,0))
+        if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+template<class Bank>
+void FillSeedBank(Bank& bank) { bank.mNumPackets = kBankSize; }
+void Populate(Board& board);
+void Update(Board& board);
+static_assert(static_cast<int>(kMode) == 87);
+static_assert(ZombiesPerFlag(0)==36 && ZombiesPerFlag(1)==46 && ZombiesPerFlag(2)==56 && ZombiesPerFlag(3)==66);
+}
diff --git a/src/Lawn/System/PoolPanicEndlessPresentation.cpp b/src/Lawn/System/PoolPanicEndlessPresentation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fb05c44eaf15589848930aae7501fb7faecc47d1
--- /dev/null
+++ b/src/Lawn/System/PoolPanicEndlessPresentation.cpp
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "PoolPanicEndlessPresentation.h"
+#include "../../GameConstants.h"
+#include "../../LawnApp.h"
+#include "../../Resources.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "../../PvzpLib/PvzpStringFile.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "graphics/Graphics.h"
+#include "graphics/Font.h"
+#include "graphics/MemoryImage.h"
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace PoolPanicEndlessPresentation
+{
+namespace
+{
+std::unique_ptr<Sexy::MemoryImage> sCard;
+std::unique_ptr<Sexy::MemoryImage> sBestLabel;
+uint32_t sBestRecord = 0;
+std::string sBestText;
+const Sexy::_Font* sBestFront = nullptr;
+const Sexy::_Font* sBestOutline = nullptr;
+
+std::unique_ptr<Sexy::MemoryImage> Blank(int width, int height)
+{
+    std::vector<uint32_t> pixels(width * height, 0);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+Sexy::Rect VisibleBounds(Sexy::MemoryImage& image)
+{
+    int left = image.GetWidth(), top = image.GetHeight(), right = -1, bottom = -1;
+    const uint32_t* pixels = image.GetBits();
+    for (int y = 0; y < image.GetHeight(); ++y)
+        for (int x = 0; x < image.GetWidth(); ++x)
+            if ((pixels[y * image.GetWidth() + x] >> 24) > 8)
+            {
+                left = std::min(left, x); top = std::min(top, y);
+                right = std::max(right, x); bottom = std::max(bottom, y);
+            }
+    return right < left ? Sexy::Rect() : Sexy::Rect(left, top, right - left + 1, bottom - top + 1);
+}
+}
+
+Sexy::Image* GetBonusImage()
+{
+    if (sCard) return sCard.get();
+    if (!PvzpLoadResources("LoadingImages") || !PvzpLoadResources("DelayLoad_Background3") ||
+        !Sexy::IMAGE_BACKGROUND3 || !Sexy::IMAGE_POOL) return nullptr;
+
+    // Keep the original riding zombie and dolphin in their complete native
+    // assembly. No independently moved limbs, redrawn parts or extra badges.
+    auto portrait = Blank(300, 220);
+    Sexy::Graphics native(portrait.get());
+    native.SetLinearBlend(true);
+    Reanimation rider;
+    rider.ReanimationInitializeType(60.0f, 35.0f, REANIM_ZOMBIE_DOLPHINRIDER);
+    rider.SetFramesForLayer("anim_ride");
+    rider.Draw(&native);
+    const Sexy::Rect bounds = VisibleBounds(*portrait);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return nullptr;
+
+    auto card = Blank(80, 65);
+    Sexy::Graphics picture(card.get());
+    picture.SetLinearBlend(true);
+    picture.ClipRect(0, 0, 80, 65);
+    // The backdrop has a white pool opening. Match the original software pool
+    // composition before cropping: PoolEffect draws water at (34,278), while
+    // Board::DrawBackdrop places the background at (-BOARD_OFFSET,0).
+    auto landscape = Blank(Sexy::IMAGE_BACKGROUND3->GetWidth(), Sexy::IMAGE_BACKGROUND3->GetHeight());
+    Sexy::Graphics ground(landscape.get());
+    ground.DrawImage(Sexy::IMAGE_BACKGROUND3, 0, 0);
+    ground.DrawImage(Sexy::IMAGE_POOL, 34 + BOARD_OFFSET, 278);
+    picture.DrawImage(landscape.get(), Sexy::Rect(0, 0, 80, 65), Sexy::Rect(400, 225, 480, 240));
+    const float scale = std::min(68.0f / bounds.mWidth, 57.0f / bounds.mHeight);
+    PvzpDrawImageScaledF(&picture, portrait.get(),
+        40.0f - (bounds.mX + bounds.mWidth * 0.5f) * scale,
+        32.5f - (bounds.mY + bounds.mHeight * 0.5f) * scale, scale, scale);
+    sCard = std::move(card);
+    return sCard.get();
+}
+
+bool DrawFittedBestRecord(Sexy::Graphics* graphics, uint32_t record, std::string_view nativeText, int x, int y)
+{
+    Sexy::_Font* front = Sexy::FONT_CONTINUUMBOLD14;
+    Sexy::_Font* outline = Sexy::FONT_CONTINUUMBOLD14OUTLINE;
+    if (!record || !front || !outline) return false;
+    std::string text(nativeText);
+    const bool unsignedRecord = record > static_cast<uint32_t>(std::numeric_limits<int>::max());
+    if (unsignedRecord)
+        text = PvzpReplaceString("[LONGEST_STREAK]", "{STREAK}", std::to_string(record));
+    if (sBestLabel && record == sBestRecord && text == sBestText && front == sBestFront && outline == sBestOutline)
+    {
+        graphics->DrawImage(sBestLabel.get(), x + 13, y + 4);
+        return true;
+    }
+
+    int widest = 0, lines = 0;
+    size_t start = 0;
+    for (size_t i = 0; i <= text.size(); ++i)
+        if (i == text.size() || text[i] == '\n')
+        {
+            const std::string_view line(text.data() + start, i - start);
+            widest = std::max({widest, front->StringWidth(line), outline->StringWidth(line)});
+            ++lines;
+            start = i + 1;
+        }
+    // Keep every normally fitting native label on the original draw path,
+    // including its exact font pixels, colors and positions.
+    if (widest <= 96 && !unsignedRecord) return false;
+
+    const int padding = 8;
+    const int width = widest + padding * 2 + 2;
+    const int height = std::max(front->GetLineSpacing(), outline->GetLineSpacing()) * lines +
+        std::max(front->GetHeight(), outline->GetHeight()) + padding * 2;
+    auto nativeLabel = Blank(width, height);
+    Sexy::Graphics ink(nativeLabel.get());
+    ink.SetLinearBlend(true);
+    const Sexy::Rect wrap(padding, padding, widest + 2, height - padding * 2);
+    PvzpDrawStringWrapped(&ink, text, wrap, outline, Sexy::Color::White, DS_ALIGN_CENTER);
+    PvzpDrawStringWrapped(&ink, text, wrap, front, Sexy::Color(255, 0, 0), DS_ALIGN_CENTER);
+    const Sexy::Rect bounds = VisibleBounds(*nativeLabel);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return false;
+
+    auto fitted = Blank(80, 65);
+    Sexy::Graphics picture(fitted.get());
+    picture.SetLinearBlend(true);
+    picture.ClipRect(0, 0, 80, 65);
+    const float scale = std::min({1.0f, 76.0f / bounds.mWidth, 57.0f / bounds.mHeight});
+    PvzpDrawImageScaledF(&picture, nativeLabel.get(),
+        40.0f - (bounds.mX + bounds.mWidth * 0.5f) * scale,
+        32.5f - (bounds.mY + bounds.mHeight * 0.5f) * scale, scale, scale);
+    sBestLabel = std::move(fitted);
+    sBestRecord = record;
+    sBestText = std::move(text);
+    sBestFront = front;
+    sBestOutline = outline;
+    graphics->DrawImage(sBestLabel.get(), x + 13, y + 4);
+    return true;
+}
+
+void DisposeImage()
+{
+    sCard.reset();
+    sBestLabel.reset();
+    sBestRecord = 0;
+    sBestText.clear();
+    sBestFront = sBestOutline = nullptr;
+}
+}
