diff --git a/src/Lawn/System/VaseAmbush.cpp b/src/Lawn/System/VaseAmbush.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c66de00a4415015d9e05c6fda1bc88bcb68c47cf
--- /dev/null
+++ b/src/Lawn/System/VaseAmbush.cpp
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "VaseAmbush.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include "../GridItem.h"
+#include "../Coin.h"
+#include "../SeedPacket.h"
+#include "../Projectile.h"
+#include "../../LawnApp.h"
+#include "../../PvzpLib/Reanimator.h"
+#include <algorithm>
+
+namespace VaseAmbush
+{
+namespace
+{
+void ClearMallet(Board& board)
+{
+    Challenge& challenge=*board.mChallenge;
+    if(Reanimation* hammer=board.mApp->ReanimationTryToGet(challenge.mReanimChallenge))hammer->ReanimationDie();
+    challenge.mReanimChallenge=REANIMATIONID_NULL;
+    challenge.mChallengeGridX=challenge.mChallengeGridY=0;
+}
+}
+void PreloadResources()
+{
+    ReanimatorEnsureDefinitionLoaded(REANIM_HAMMER,true);
+    for(const Puzzle& puzzle:kBoards)
+    {
+        for(const Defender& plant:puzzle.mPlants)if(plant.mSeed!=SEED_NONE)Plant::PreloadPlantResources(plant.mSeed);
+        for(const Vase& vase:puzzle.mVases)if(vase.mType!=ZOMBIE_INVALID)Zombie::PreloadZombieResources(vase.mType);
+    }
+}
+void Populate(Board& board)
+{
+    Challenge& challenge=*board.mChallenge;
+    const int stage=std::clamp(challenge.mSurvivalStage,0,kBoardCount-1);
+    ClearMallet(board);
+    challenge.mSurvivalStage=stage;
+    challenge.mChallengeState=kActive;
+    challenge.mChallengeStateCounter=challenge.mChallengeScore=0;
+    challenge.mScaryPotterPots=VaseCount(stage);
+    board.mSunMoney=0;
+    board.mCurrentWave=board.mTotalSpawnedWaves=0;
+    board.mProgressMeterWidth=0;
+    board.mZombieCountDown=board.mZombieCountDownStart=100000;
+    board.mNextSurvivalStageCounter=0;
+    board.mShowShovel=false;
+    board.mBonusLawnMowersRemaining=0;
+    board.ClearCursor();
+    board.mSeedBank->mNumPackets=0;
+    for(int row=0;row<5;++row)
+    {
+        GridItem* brain=board.mGridItems.DataArrayAlloc();
+        brain->mGridItemType=GRIDITEM_IZOMBIE_BRAIN;
+        brain->mGridX=0;brain->mGridY=row;
+        brain->mRenderOrder=Board::MakeRenderOrder(RENDER_LAYER_PLANT,row,0);
+        brain->mGridItemCounter=70;
+        brain->mPosX=board.GridToPixelX(0,row)-40;
+        brain->mPosY=board.GridToPixelY(0,row)+40;
+    }
+    for(const Defender& defender:kBoards[stage].mPlants)
+    {
+        if(defender.mSeed==SEED_NONE)continue;
+        Plant* plant=board.NewPlant(defender.mCol,defender.mRow,defender.mSeed,SEED_NONE);
+        plant->SetSleeping(false);
+        challenge.IZombieSetupPlant(plant);
+    }
+    for(const Vase& entry:kBoards[stage].mVases)
+    {
+        if(entry.mType==ZOMBIE_INVALID)continue;
+        GridItem* vase=board.mGridItems.DataArrayAlloc();
+        vase->mGridItemType=GRIDITEM_SCARY_POT;
+        vase->mGridItemState=GRIDITEM_STATE_SCARY_POT_ZOMBIE;
+        vase->mGridX=entry.mCol;vase->mGridY=entry.mRow;
+        vase->mScaryPotType=SCARYPOT_ZOMBIE;
+        vase->mZombieType=entry.mType;
+        vase->mRenderOrder=Board::MakeRenderOrder(RENDER_LAYER_PLANT,entry.mRow,1);
+        // Use the original Plantern window and cached zombie, not extra labels.
+        vase->mTransparentCounter=50;
+    }
+}
+void ResetStage(Board& board,int stage)
+{
+    ClearMallet(board);
+    for(Zombie* zombie:board.mZombies)if(!zombie->mDead)zombie->DieNoLoot();
+    for(Plant* plant:board.mPlants)if(!plant->mDead)plant->Die();
+    for(Coin* coin:board.mCoins)if(!coin->mDead)coin->Die();
+    for(GridItem* item:board.mGridItems)if(!item->mDead)item->GridItemDie();
+    for(Projectile* projectile:board.mProjectiles)if(!projectile->mDead)projectile->Die();
+    board.mChallenge->mSurvivalStage=std::clamp(stage,0,kBoardCount-1);
+    board.mLevelAwardSpawned=false;
+    Populate(board);
+}
+bool CanBreak(Board& board)
+{
+    return board.mApp && board.mChallenge && IsMode(board.mApp->mGameMode) &&
+        board.mChallenge->mChallengeState==kActive && !board.mPaused &&
+        board.mApp->mGameScene==SCENE_PLAYING && !board.mLevelComplete &&
+        !board.HasLevelAwardDropped() && board.mApp->GetDialog(DIALOG_GAME_OVER)==nullptr &&
+        board.mApp->GetDialog(DIALOG_CONTINUE)==nullptr &&
+        board.mChallenge->mReanimChallenge==REANIMATIONID_NULL;
+}
+void MalletPot(Board& board,GridItem* pot)
+{
+    if(!CanBreak(board) || !pot || pot->mDead || pot->mBoard!=&board || pot->mGridItemType!=GRIDITEM_SCARY_POT)return;
+    // Native hammer, target coordinates, animation rate, sound and shatter.
+    board.mChallenge->ScaryPotterMalletPot(pot);
+    board.mChallenge->mChallengeState=kActive;
+}
+void OnBrainsCleared(Board& board,int row)
+{
+    Challenge& challenge=*board.mChallenge;
+    if(challenge.mChallengeState!=kActive || board.HasLevelAwardDropped())return;
+    ClearMallet(board);
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    if(challenge.mSurvivalStage==kBoardCount-1)
+    {
+        challenge.mChallengeState=kFinished;
+        challenge.SpawnLevelAward(0,row);
+    }
+    else
+    {
+        challenge.mChallengeState=kTransition;
+        challenge.mChallengeStateCounter=kTransitionTicks;
+    }
+}
+void Update(Board& board)
+{
+    Challenge& challenge=*board.mChallenge;
+    if(!IsCurrentRules(board.mApp->mGameMode,challenge.mChallengeState) || board.mPaused ||
+        board.mTimeStopCounter>0 || board.mApp->mGameScene!=SCENE_PLAYING ||
+        board.mLevelComplete || board.HasLevelAwardDropped())return;
+    board.mShowShovel=false;
+    if(challenge.mChallengeState==kTransition)
+    {
+        if(--challenge.mChallengeStateCounter>0)return;
+        ClearMallet(board);
+        challenge.PuzzleNextStageClear();
+        for(Coin* coin:board.mCoins)if(!coin->mDead)coin->Die();
+        for(Projectile* projectile:board.mProjectiles)if(!projectile->mDead)projectile->Die();
+        Populate(board);
+        return;
+    }
+    if(challenge.mChallengeState!=kActive)return;
+    // Native mallet animation is serialized through the existing saved ID.
+    if(Reanimation* hammer=board.mApp->ReanimationTryToGet(challenge.mReanimChallenge))
+    {
+        if(hammer->mLoopCount>0)
+        {
+            GridItem* vase=board.GetGridItemAt(GRIDITEM_SCARY_POT,challenge.mChallengeGridX,challenge.mChallengeGridY);
+            if(vase && !vase->mDead)challenge.ScaryPotterOpenPot(vase);
+            ClearMallet(board);
+        }
+    }
+    else if(challenge.mReanimChallenge!=REANIMATIONID_NULL)ClearMallet(board);
+    challenge.mScaryPotterPots=challenge.ScaryPotterCountPots();
+    // Native I, Zombie handles idle-walker speed and the settled loss timing,
+    // including Chomper/Squash and mine effects. Unopened army vases gate that
+    // original defeat check, so thinking time cannot spend the player's army.
+    challenge.IZombieUpdate();
+}
+}
diff --git a/src/Lawn/System/VaseAmbush.h b/src/Lawn/System/VaseAmbush.h
new file mode 100644
index 0000000000000000000000000000000000000000..4f830af8a5afcd49d5e7fcee49f4fc2f24c1513b
--- /dev/null
+++ b/src/Lawn/System/VaseAmbush.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include "../../ConstEnums.h"
+#include <array>
+
+class Board;
+class GridItem;
+
+// A finite I, Zombie army, released through the original Vasebreaker hammer.
+// All progress uses existing saved Challenge and GridItem fields.
+namespace VaseAmbush
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_VASE_AMBUSH;
+inline constexpr ChallengeState kActive = static_cast<ChallengeState>(132);
+inline constexpr ChallengeState kTransition = static_cast<ChallengeState>(133);
+inline constexpr ChallengeState kFinished = static_cast<ChallengeState>(134);
+inline constexpr ChallengeState kFailed = static_cast<ChallengeState>(135);
+inline constexpr int kBoardCount = 5;
+inline constexpr int kTransitionTicks = 120;
+inline constexpr int kMaxPlants = 15;
+inline constexpr int kMaxVases = 15;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{ return IsMode(mode) && state >= kActive && state <= kFailed; }
+struct Defender { SeedType mSeed=SEED_NONE; int mCol=0; int mRow=0; };
+struct Vase { ZombieType mType=ZOMBIE_INVALID; int mCol=0; int mRow=0; };
+struct Puzzle { std::array<Defender,kMaxPlants> mPlants; std::array<Vase,kMaxVases> mVases; };
+
+inline constexpr std::array<Puzzle,kBoardCount> kBoards = {{
+    // A protected advance: far-back cones can walk ahead of the nearer walkers.
+    {{{{SEED_PEASHOOTER,1,0},{SEED_PEASHOOTER,1,1},{SEED_PEASHOOTER,1,2},{SEED_PEASHOOTER,1,3},{SEED_PEASHOOTER,1,4}}},
+     {{{ZOMBIE_TRAFFIC_CONE,8,0},{ZOMBIE_TRAFFIC_CONE,8,1},{ZOMBIE_TRAFFIC_CONE,8,2},{ZOMBIE_TRAFFIC_CONE,8,3},{ZOMBIE_TRAFFIC_CONE,8,4},{ZOMBIE_NORMAL,6,0},{ZOMBIE_NORMAL,6,1},{ZOMBIE_NORMAL,6,2},{ZOMBIE_NORMAL,6,3},{ZOMBIE_NORMAL,6,4}}}},
+    // Cold rows flank an easier center; the outside lanes need a shorter protected push.
+    {{{{SEED_REPEATER,1,1},{SEED_REPEATER,1,3},{SEED_SNOWPEA,2,1},{SEED_SNOWPEA,2,2},{SEED_SNOWPEA,2,3},{SEED_PEASHOOTER,1,0},{SEED_PEASHOOTER,1,2},{SEED_PEASHOOTER,1,4},{SEED_PEASHOOTER,3,0},{SEED_PEASHOOTER,3,1},{SEED_PEASHOOTER,3,3},{SEED_PEASHOOTER,3,4}}},
+     {{{ZOMBIE_PAIL,8,0},{ZOMBIE_PAIL,8,1},{ZOMBIE_PAIL,8,2},{ZOMBIE_PAIL,8,3},{ZOMBIE_PAIL,8,4},{ZOMBIE_NORMAL,7,0},{ZOMBIE_TRAFFIC_CONE,7,1},{ZOMBIE_TRAFFIC_CONE,7,2},{ZOMBIE_TRAFFIC_CONE,7,3},{ZOMBIE_NORMAL,7,4},{ZOMBIE_NORMAL,6,0},{ZOMBIE_DOOR,6,1},{ZOMBIE_NORMAL,6,2},{ZOMBIE_DOOR,6,3},{ZOMBIE_NORMAL,6,4}}}},
+    // Three Chompers need bait; two awake Fume-shrooms cover the intervening lanes.
+    {{{{SEED_REPEATER,1,0},{SEED_REPEATER,1,2},{SEED_REPEATER,1,4},{SEED_SPIKEWEED,2,0},{SEED_SPIKEWEED,2,2},{SEED_SPIKEWEED,2,4},{SEED_CHOMPER,3,0},{SEED_CHOMPER,3,2},{SEED_CHOMPER,3,4},{SEED_PEASHOOTER,1,1},{SEED_PEASHOOTER,1,3},{SEED_FUMESHROOM,3,1},{SEED_FUMESHROOM,3,3}}},
+     {{{ZOMBIE_PAIL,8,0},{ZOMBIE_PAIL,8,2},{ZOMBIE_PAIL,8,4},{ZOMBIE_PAIL,8,1},{ZOMBIE_PAIL,8,3},{ZOMBIE_TRAFFIC_CONE,7,0},{ZOMBIE_TRAFFIC_CONE,7,2},{ZOMBIE_TRAFFIC_CONE,7,4},{ZOMBIE_TRAFFIC_CONE,6,0},{ZOMBIE_NORMAL,6,1},{ZOMBIE_TRAFFIC_CONE,6,2},{ZOMBIE_NORMAL,6,3},{ZOMBIE_TRAFFIC_CONE,6,4}}}},
+    // Two mines and two magnets ask which valuable armor the front doors should spend.
+    {{{{SEED_PEASHOOTER,1,0},{SEED_PEASHOOTER,1,2},{SEED_PEASHOOTER,1,4},{SEED_POTATOMINE,3,1},{SEED_POTATOMINE,3,3},{SEED_SNOWPEA,2,1},{SEED_SNOWPEA,2,3},{SEED_MAGNETSHROOM,3,0},{SEED_MAGNETSHROOM,3,4},{SEED_SPIKEWEED,3,2}}},
+     {{{ZOMBIE_PAIL,8,0},{ZOMBIE_PAIL,8,1},{ZOMBIE_PAIL,8,2},{ZOMBIE_PAIL,8,3},{ZOMBIE_PAIL,8,4},{ZOMBIE_TRAFFIC_CONE,7,0},{ZOMBIE_TRAFFIC_CONE,7,1},{ZOMBIE_TRAFFIC_CONE,7,2},{ZOMBIE_TRAFFIC_CONE,7,3},{ZOMBIE_TRAFFIC_CONE,7,4},{ZOMBIE_DOOR,6,0},{ZOMBIE_DOOR,6,1},{ZOMBIE_DOOR,6,2},{ZOMBIE_DOOR,6,3},{ZOMBIE_DOOR,6,4}}}},
+    // Shared Threepeater fire, magnets and a Chomper combine the earlier ideas.
+    {{{{SEED_PEASHOOTER,1,0},{SEED_THREEPEATER,1,1},{SEED_MAGNETSHROOM,3,1},{SEED_CHOMPER,3,2},{SEED_PEASHOOTER,1,3},{SEED_MAGNETSHROOM,3,3},{SEED_PEASHOOTER,1,4},{SEED_PEASHOOTER,2,4}}},
+     {{{ZOMBIE_TRAFFIC_CONE,8,0},{ZOMBIE_TRAFFIC_CONE,8,1},{ZOMBIE_TRAFFIC_CONE,8,2},{ZOMBIE_TRAFFIC_CONE,8,3},{ZOMBIE_TRAFFIC_CONE,8,4},{ZOMBIE_TRAFFIC_CONE,7,0},{ZOMBIE_DOOR,7,1},{ZOMBIE_TRAFFIC_CONE,7,2},{ZOMBIE_DOOR,7,3},{ZOMBIE_TRAFFIC_CONE,7,4},{ZOMBIE_TRAFFIC_CONE,6,0},{ZOMBIE_TRAFFIC_CONE,6,1},{ZOMBIE_TRAFFIC_CONE,6,2},{ZOMBIE_TRAFFIC_CONE,6,3},{ZOMBIE_TRAFFIC_CONE,6,4}}}}
+}};
+constexpr int PlantCount(int stage)
+{
+    if(stage<0 || stage>=kBoardCount) return 0;
+    int count=0;for(const Defender& entry:kBoards[stage].mPlants) count+=entry.mSeed!=SEED_NONE;
+    return count;
+}
+constexpr int VaseCount(int stage)
+{
+    if(stage<0 || stage>=kBoardCount) return 0;
+    int count=0;for(const Vase& entry:kBoards[stage].mVases) count+=entry.mType!=ZOMBIE_INVALID;
+    return count;
+}
+template<std::size_t Waves,std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    for(auto& wave:output)for(auto& zombie:wave)zombie=ZOMBIE_INVALID;
+    return kBoardCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    for(auto& allowed:output)allowed=false;
+    for(ZombieType type:{ZOMBIE_NORMAL,ZOMBIE_TRAFFIC_CONE,ZOMBIE_PAIL,ZOMBIE_DOOR})output[type]=true;
+}
+void PreloadResources();
+void Populate(Board& board);
+void ResetStage(Board& board,int stage);
+void Update(Board& board);
+bool CanBreak(Board& board);
+void MalletPot(Board& board,GridItem* pot);
+void OnBrainsCleared(Board& board,int row);
+static_assert(static_cast<int>(kMode)==89 && VaseCount(0)==10 && VaseCount(4)==15);
+}
diff --git a/src/Lawn/System/VaseAmbushPresentation.cpp b/src/Lawn/System/VaseAmbushPresentation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..998ad96b4e9879b0945d7ab44f51a5ab2371f3f1
--- /dev/null
+++ b/src/Lawn/System/VaseAmbushPresentation.cpp
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "VaseAmbushPresentation.h"
+#include "VaseAmbush.h"
+#include "ReanimationLawn.h"
+#include "../../LawnApp.h"
+#include "../../Resources.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "graphics/Graphics.h"
+#include "graphics/MemoryImage.h"
+#include <algorithm>
+#include <format>
+#include <memory>
+#include <vector>
+
+namespace VaseAmbushPresentation
+{
+namespace
+{
+std::unique_ptr<Sexy::MemoryImage> sCard;
+
+std::unique_ptr<Sexy::MemoryImage> Blank(int width, int height)
+{
+    std::vector<uint32_t> pixels(width * height, 0);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+Sexy::Rect VisibleBounds(Sexy::MemoryImage& image)
+{
+    int left = image.GetWidth(), top = image.GetHeight(), right = -1, bottom = -1;
+    const uint32_t* pixels = image.GetBits();
+    for (int y = 0; y < image.GetHeight(); ++y)
+        for (int x = 0; x < image.GetWidth(); ++x)
+            if ((pixels[y * image.GetWidth() + x] >> 24) > 8)
+            {
+                left = std::min(left, x); top = std::min(top, y);
+                right = std::max(right, x); bottom = std::max(bottom, y);
+            }
+    return right < left ? Sexy::Rect() : Sexy::Rect(left, top, right - left + 1, bottom - top + 1);
+}
+}
+
+std::string LevelLabel(int stage)
+{
+    return std::format("Vase Ambush - {}/{}", std::clamp(stage + 1, 1, VaseAmbush::kBoardCount), VaseAmbush::kBoardCount);
+}
+
+Sexy::Image* GetBonusImage()
+{
+    if (sCard) return sCard.get();
+    if (!gLawnApp || !gLawnApp->mReanimatorCache || !PvzpLoadResources("LoadingImages") ||
+        !PvzpLoadResources("DelayLoad_Background1") || !Sexy::IMAGE_BACKGROUND1 ||
+        !Sexy::IMAGE_SCARY_POT || !Sexy::IMAGE_BRAIN) return nullptr;
+
+    // Reuse the original Plantern-revealed zombie vase composition. Its back,
+    // cached zombie and translucent front have the native DrawScaryPot offsets.
+    // The vase remains the dominant silhouette inside the original 80x65 card.
+    auto portrait = Blank(80, 105);
+    Sexy::Graphics native(portrait.get());
+    native.SetLinearBlend(true);
+    native.DrawImageCel(Sexy::IMAGE_SCARY_POT, 0, 0, 2, 0);
+    Sexy::Graphics inside(native);
+    inside.mScaleX = 0.4f;
+    inside.mScaleY = 0.4f;
+    gLawnApp->mReanimatorCache->DrawCachedZombie(&inside, 6.0f, 19.0f, ZOMBIE_TRAFFIC_CONE);
+    native.SetColorizeImages(true);
+    native.SetColor(Sexy::Color(255, 255, 255, 58));
+    native.DrawImageCel(Sexy::IMAGE_SCARY_POT, 0, 0, 2, 1);
+    native.SetColorizeImages(false);
+    const Sexy::Rect bounds = VisibleBounds(*portrait);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return nullptr;
+
+    auto* brain = dynamic_cast<Sexy::MemoryImage*>(Sexy::IMAGE_BRAIN);
+    const Sexy::Rect brainBounds = brain ? VisibleBounds(*brain) :
+        Sexy::Rect(0, 0, Sexy::IMAGE_BRAIN->GetWidth(), Sexy::IMAGE_BRAIN->GetHeight());
+    if (brainBounds.mWidth <= 0 || brainBounds.mHeight <= 0) return nullptr;
+    auto card = Blank(80, 65);
+    Sexy::Graphics picture(card.get());
+    picture.SetLinearBlend(true);
+    picture.ClipRect(0, 0, 80, 65);
+    picture.DrawImage(Sexy::IMAGE_BACKGROUND1, Sexy::Rect(0, 0, 80, 65), Sexy::Rect(400, 140, 480, 390));
+    const float scale = std::min(47.0f / bounds.mWidth, 56.0f / bounds.mHeight);
+    const float brainScale = std::min(20.0f / brainBounds.mWidth, 18.0f / brainBounds.mHeight);
+    const float brainWidth = brainBounds.mWidth * brainScale;
+    const float left = 40.0f - (brainWidth + 3.0f + bounds.mWidth * scale) * 0.5f;
+    PvzpDrawImageScaledF(&picture, portrait.get(),
+        left + brainWidth + 3.0f - bounds.mX * scale,
+        32.0f - (bounds.mY + bounds.mHeight * 0.5f) * scale, scale, scale);
+    PvzpDrawImageScaledF(&picture, Sexy::IMAGE_BRAIN,
+        left - brainBounds.mX * brainScale,
+        60.0f - (brainBounds.mY + brainBounds.mHeight) * brainScale, brainScale, brainScale);
+    sCard = std::move(card);
+    return sCard.get();
+}
+
+void DisposeImage() { sCard.reset(); }
+}
