diff --git a/src/Lawn/System/ScrapYard.cpp b/src/Lawn/System/ScrapYard.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3bf2dff0edd9467ae54d596ab24c6d4eda446b37
--- /dev/null
+++ b/src/Lawn/System/ScrapYard.cpp
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "ScrapYard.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Coin.h"
+#include "../Plant.h"
+#include "../SeedPacket.h"
+#include "../Zombie.h"
+#include "../../LawnApp.h"
+#include <algorithm>
+#include <climits>
+
+namespace ScrapYard
+{
+void PreloadResources()
+{
+    Plant::PreloadPlantResources(SEED_PEASHOOTER);
+    for (SeedType seed : kSeeds) Plant::PreloadPlantResources(seed);
+    constexpr ZombieType types[] = {ZOMBIE_PAIL,ZOMBIE_DOOR,ZOMBIE_FOOTBALL,
+        ZOMBIE_LADDER,ZOMBIE_POGO,ZOMBIE_JACK_IN_THE_BOX};
+    for (ZombieType type : types) Zombie::PreloadZombieResources(type);
+}
+
+void Populate(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    challenge.mChallengeState = kActive;
+    challenge.mChallengeStateCounter = kOpeningDelay;
+    challenge.mSurvivalStage = 0;
+    challenge.mChallengeScore = 0;
+    challenge.mChallengeGridY = kRulesVersion;
+    board.mCurrentWave = board.mTotalSpawnedWaves = 0;
+    board.mZombieCountDown = board.mZombieCountDownStart = kOpeningDelay;
+    board.mZombieHealthToNextWave = -1;
+    board.mSunMoney = kStartingSun;
+    board.mShowShovel = true;
+    board.ClearCursor();
+    FillSeedBank(*board.mSeedBank);
+    for (const StartingPlant& plant : kStartingPlants)
+        board.AddPlant(plant.mCol,plant.mRow,plant.mSeed,SEED_NONE);
+}
+
+bool CanRewardPull(const Plant& plant)
+{
+    Board* board = plant.mBoard;
+    return board && board->mApp && IsMode(board->mApp->mGameMode) && board->mChallenge &&
+        board->mChallenge->mChallengeState == kActive && board->mChallenge->mChallengeGridY == kRulesVersion &&
+        board->mApp->mGameScene == SCENE_PLAYING && !board->mPaused && board->mTimeStopCounter == 0 &&
+        !board->mLevelComplete && !board->HasLevelAwardDropped() && plant.mSeedType == SEED_MAGNETSHROOM &&
+        plant.mIsOnBoard && !plant.mDead && !plant.mSquished && !plant.mIsAsleep && plant.mPlantHealth > 0;
+}
+
+bool CanRewardPull(const Plant& plant, Zombie& zombie)
+{
+    if (!CanRewardPull(plant) || zombie.mBoard != plant.mBoard || zombie.mDead ||
+        !zombie.mHasHead || zombie.mMindControlled || zombie.IsDeadOrDying()) return false;
+    // Snapshot the native source before its removal. The source's saved flags
+    // are cleared by the original pull, so neither a second attempt nor Continue
+    // can pay again for an already removed item.
+    return ((zombie.mHelmType == HELMTYPE_PAIL || zombie.mHelmType == HELMTYPE_FOOTBALL) && zombie.mHelmHealth > 0) ||
+        ((zombie.mShieldType == SHIELDTYPE_DOOR || zombie.mShieldType == SHIELDTYPE_LADDER) && zombie.mShieldHealth > 0) ||
+        (zombie.mZombieType == ZOMBIE_POGO && zombie.mHasObject) ||
+        zombie.mZombiePhase == PHASE_JACK_IN_THE_BOX_RUNNING ||
+        (zombie.mZombieType == ZOMBIE_DIGGER && zombie.mHasObject);
+}
+
+void RewardPull(Plant& plant)
+{
+    if (!CanRewardPull(plant)) return;
+    Board& board = *plant.mBoard;
+    if (board.mChallenge->mChallengeScore < INT_MAX) ++board.mChallenge->mChallengeScore;
+    for (int i = 0; i < kCoinsPerPull; ++i)
+        board.AddCoin(plant.mX + 8 + i*20,plant.mY,COIN_SUN,COIN_MOTION_FROM_PLANT);
+}
+
+void Update(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (!IsCurrentRules(board.mApp->mGameMode,challenge.mChallengeState) || challenge.mChallengeState != kActive ||
+        board.mApp->mGameScene != SCENE_PLAYING || board.mPaused || board.mTimeStopCounter > 0 ||
+        board.mLevelComplete || board.HasLevelAwardDropped()) return;
+    board.mShowShovel = true;
+    const int next = std::clamp(challenge.mSurvivalStage,0,kWaveCount);
+    if (next < kWaveCount)
+    {
+        if (challenge.mChallengeStateCounter > 0) --challenge.mChallengeStateCounter;
+        // Removing armor is income, not a cleared formation. Keep the full
+        // interval so successful recycling never accelerates the next assault.
+        board.mZombieCountDown = challenge.mChallengeStateCounter;
+        if (challenge.mChallengeStateCounter != 0) return;
+        board.NextWaveComing();
+        for (const Spawn& spawn : kFormations[next])
+        {
+            if (spawn.mType == ZOMBIE_INVALID) continue;
+            Zombie* zombie = board.AddZombieInRow(spawn.mType,spawn.mRow,next);
+            zombie->mPosX = static_cast<float>(spawn.mX);
+            zombie->mX = spawn.mX;
+            zombie->UpdateReanim();
+        }
+        challenge.mSurvivalStage = next + 1;
+        board.mCurrentWave = board.mTotalSpawnedWaves = next + 1;
+        board.mZombieHealthWaveStart = board.TotalZombiesHealthInWave(next);
+        board.mZombieHealthToNextWave = -1;
+        challenge.mChallengeStateCounter = kFormationInterval;
+        board.mZombieCountDown = board.mZombieCountDownStart = kFormationInterval;
+        return;
+    }
+    if (board.AreEnemyZombiesOnScreen()) return;
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    challenge.mChallengeState = kFinished;
+    challenge.SpawnLevelAward(4,2);
+}
+}
diff --git a/src/Lawn/System/ScrapYard.h b/src/Lawn/System/ScrapYard.h
new file mode 100644
index 0000000000000000000000000000000000000000..cd49d738a73f5f181363bb88546ac76269572758
--- /dev/null
+++ b/src/Lawn/System/ScrapYard.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+
+class Board;
+class Plant;
+class Zombie;
+
+// Native metal removal funds a finite night defense. All progress, packets,
+// pulled items and loose sun use the existing native saved object fields.
+namespace ScrapYard
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_SCRAP_YARD;
+inline constexpr ChallengeState kActive = static_cast<ChallengeState>(130);
+inline constexpr ChallengeState kState = kActive;
+inline constexpr ChallengeState kFinished = static_cast<ChallengeState>(131);
+inline constexpr int kRulesVersion = 1;
+inline constexpr int kStartingSun = 800;
+inline constexpr int kWaveCount = 6;
+inline constexpr int kLargestFormation = 8;
+inline constexpr int kOpeningDelay = 1800;
+// Leave room for two native recycling cycles and deliberate explosive timing.
+inline constexpr int kFormationInterval = 3500;
+inline constexpr int kCoinsPerPull = 2;
+inline constexpr int kSunPerPull = 50;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{ return IsMode(mode) && (state == kActive || state == kFinished); }
+inline constexpr std::array<SeedType,5> kSeeds = {
+    SEED_MAGNETSHROOM, SEED_WALLNUT, SEED_CHERRYBOMB, SEED_JALAPENO, SEED_SQUASH
+};
+struct StartingPlant { SeedType mSeed; int mCol; int mRow; };
+// Alternating lanes finish stripped bodies. The two unsupported lanes can
+// share a central Cherry Bomb while the player manages their recycling tools.
+inline constexpr std::array<StartingPlant,13> kStartingPlants = {{{SEED_PEASHOOTER,1,0},
+    {SEED_PEASHOOTER,1,2},{SEED_PEASHOOTER,1,4},{SEED_MAGNETSHROOM,3,0},
+    {SEED_MAGNETSHROOM,3,1},{SEED_MAGNETSHROOM,3,2},{SEED_MAGNETSHROOM,3,3},
+    {SEED_MAGNETSHROOM,3,4},{SEED_WALLNUT,5,0},{SEED_WALLNUT,5,1},
+    {SEED_WALLNUT,5,2},{SEED_WALLNUT,5,3},{SEED_WALLNUT,5,4}}};
+struct Spawn { ZombieType mType = ZOMBIE_INVALID; int mRow = 0; int mX = 0; };
+using Formation = std::array<Spawn,kLargestFormation>;
+// Slow, valuable metal comes first. Later tools create distinct native threats:
+// fast helmets, climbable ladders, pogo sticks and boxes that can be disarmed.
+inline constexpr std::array<Formation,kWaveCount> kFormations = {{
+    {{{ZOMBIE_PAIL,0,800},{ZOMBIE_PAIL,1,800},{ZOMBIE_PAIL,2,840},{ZOMBIE_PAIL,3,800},{ZOMBIE_PAIL,4,800}}},
+    {{{ZOMBIE_DOOR,0,800},{ZOMBIE_DOOR,1,840},{ZOMBIE_DOOR,2,800},{ZOMBIE_DOOR,3,840},{ZOMBIE_DOOR,4,800}}},
+    {{{ZOMBIE_PAIL,0,800},{ZOMBIE_LADDER,1,840},{ZOMBIE_DOOR,2,800},{ZOMBIE_DOOR,2,880},{ZOMBIE_LADDER,3,840},{ZOMBIE_PAIL,4,800}}},
+    {{{ZOMBIE_PAIL,0,840},{ZOMBIE_PAIL,1,800},{ZOMBIE_POGO,1,880},{ZOMBIE_DOOR,2,800},
+       {ZOMBIE_PAIL,3,800},{ZOMBIE_DOOR,3,880},{ZOMBIE_FOOTBALL,4,840}}},
+    {{{ZOMBIE_LADDER,0,800},{ZOMBIE_JACK_IN_THE_BOX,1,840},{ZOMBIE_PAIL,2,800},{ZOMBIE_DOOR,2,880},
+       {ZOMBIE_DOOR,3,840},{ZOMBIE_LADDER,4,800},{ZOMBIE_PAIL,4,880}}},
+    {{{ZOMBIE_FOOTBALL,0,840},{ZOMBIE_LADDER,1,800},{ZOMBIE_POGO,1,880},{ZOMBIE_JACK_IN_THE_BOX,2,800},
+       {ZOMBIE_DOOR,2,880},{ZOMBIE_LADDER,3,800},{ZOMBIE_PAIL,3,880},{ZOMBIE_DOOR,4,840}}}
+}};
+constexpr int ZombieCount(int formation)
+{
+    if (formation < 0 || formation >= kWaveCount) return 0;
+    int count = 0;
+    for (const Spawn& spawn : kFormations[formation]) count += spawn.mType != ZOMBIE_INVALID;
+    return count;
+}
+template<std::size_t Waves,std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestFormation);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int wave = 0; wave < kWaveCount; ++wave)
+        for (int i = 0; i < ZombieCount(wave); ++i) output[wave][i] = kFormations[wave][i].mType;
+    return kWaveCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_LADDER));
+    for (auto& allowed : output) allowed = false;
+    for (const Formation& formation : kFormations) for (const Spawn& spawn : formation)
+        if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+template<class Bank>
+void FillSeedBank(Bank& bank)
+{
+    bank.mNumPackets = static_cast<int>(kSeeds.size());
+    for (int i = 0; i < bank.mNumPackets; ++i) bank.mSeedPackets[i].SetPacketType(kSeeds[i]);
+}
+void PreloadResources();
+void Populate(Board& board);
+void Update(Board& board);
+bool CanRewardPull(const Plant& plant);
+bool CanRewardPull(const Plant& plant, Zombie& zombie);
+void RewardPull(Plant& plant);
+static_assert(static_cast<int>(kMode) == 88);
+static_assert(ZombieCount(0)+ZombieCount(1)+ZombieCount(2)+ZombieCount(3)+ZombieCount(4)+ZombieCount(5)==38);
+}
