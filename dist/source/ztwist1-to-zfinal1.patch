@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include "../../ConstEnums.h"
+
+class Board;
+
+namespace ZomBotanyFinale
+{
+constexpr GameMode kStars = GAMEMODE_CHALLENGE_SHOOTING_STARS;
+constexpr GameMode kPortals = GAMEMODE_CHALLENGE_PORTAL_PANIC;
+constexpr GameMode kColumns = GAMEMODE_CHALLENGE_COLUMN_CLIMB;
+constexpr GameMode kStand = GAMEMODE_CHALLENGE_ZOMBOTANY_LAST_STAND;
+constexpr bool Contains(GameMode mode) { return mode >= kStars && mode <= kStand; }
+constexpr bool UsesStars(GameMode mode) { return mode == kStars || mode == GAMEMODE_CHALLENGE_SEEING_STARS; }
+constexpr bool UsesPortals(GameMode mode) { return mode == kPortals || mode == GAMEMODE_CHALLENGE_PORTAL_COMBAT; }
+constexpr bool UsesColumns(GameMode mode) { return mode == kColumns || mode == GAMEMODE_CHALLENGE_COLUMN; }
+constexpr bool UsesLastStand(GameMode mode) { return mode == kStand || mode == GAMEMODE_CHALLENGE_LAST_STAND; }
+SeedType StarTile(int col, int row);
+void PopulateWaves(Board& board);
+void PopulateRoster(Board& board);
+ZombieType HeadForSpawn(const Board& board, ZombieType type, int row = -1);
+bool ValidSave(const Board& board);
+bool Won(Board& board);
+}
