+Image* ChallengeScreen::GetFinaleImage(GameMode mode)
+{
+    auto& image = mFinaleImages[mode - ZomBotanyFinale::kStars];
+    if (image) return image.get();
+    auto* cache = mApp->mReanimatorCache.get();
+    if (!cache) return nullptr;
+    const int scene = mode == ZomBotanyFinale::kStars ? 1 : mode == ZomBotanyFinale::kPortals ? 2 :
+                      mode == ZomBotanyFinale::kColumns ? 5 : 3;
+    const std::string group = "DelayLoad_Background" + std::to_string(scene);
+    if (std::find(mLoadedResourceNames.begin(), mLoadedResourceNames.end(), group) == mLoadedResourceNames.end())
+    {
+        if (!PvzpLoadResources(group.c_str())) return nullptr;
+        mLoadedResourceNames.push_back(group);
+    }
+    Image* background = scene == 1 ? Sexy::IMAGE_BACKGROUND1 : scene == 2 ? Sexy::IMAGE_BACKGROUND2 :
+                        scene == 5 ? Sexy::IMAGE_BACKGROUND5 : Sexy::IMAGE_BACKGROUND3;
+    if (!background) return nullptr;
+    auto card = cache->MakeBlankMemoryImage(80, 65);
+    Graphics art(card.get());
+    art.SetLinearBlend(true);
+    art.ClipRect(0, 0, 80, 65);
+    const Rect crop = scene == 5 ? Rect(200, 70, 360, 292) : scene == 3 ? Rect(470, 200, 320, 260) :
+                      scene == 2 ? Rect(545, 48, 290, 236) : Rect(450, 128, 300, 244);
+    art.DrawImage(background, Rect(0, 0, 80, 65), crop);
+    if (mode == ZomBotanyFinale::kStars)
+    {
+        auto star = cache->MakeCachedPlantFrame(SEED_STARFRUIT, VARIATION_NORMAL);
+        auto* head = cache->GetVasebreakerPlantHeadImage(ZOMBIE_PEA_HEAD);
+        if (!star || !head || !Sexy::IMAGE_PROJECTILE_STAR) return nullptr;
+        DrawFittedCardSprite(art, *head, 63, 58, 35, 51);
+        DrawFittedCardSprite(art, *star, 23, 62, 40, 39);
+        for (int i = 0; i < 3; ++i)
+            art.DrawImage(Sexy::IMAGE_PROJECTILE_STAR, 26 + 10 * i, 26 - 7 * i, 7 + i, 7 + i);
+    }
+    else if (mode == ZomBotanyFinale::kPortals)
+    {
+        auto* head = cache->GetVasebreakerPlantHeadImage(ZOMBIE_GATLING_HEAD);
+        if (!head) return nullptr;
+        auto portal = [&](ReanimationType type, float x, float y, float width, float height) {
+            auto frame = cache->MakeBlankMemoryImage(220, 240);
+            Graphics native(frame.get());
+            Reanimation ring;
+            ring.ReanimationInitializeType(40, 25, type);
+            ring.SetFramesForLayer("anim_appear");
+            ring.mAnimTime = .98f;
+            ring.Draw(&native);
+            DrawFittedCardSprite(art, *frame, x, y, width, height);
+        };
+        portal(REANIM_PORTAL_SQUARE, 13, 37, 22, 31);
+        portal(REANIM_PORTAL_CIRCLE, 56, 61, 46, 58);
+        DrawFittedCardSprite(art, *head, 42, 64, 36, 49);
+    }
+    else if (mode == ZomBotanyFinale::kColumns)
+    {
+        auto pot = cache->MakeCachedPlantFrame(SEED_FLOWERPOT, VARIATION_NORMAL);
+        auto melon = cache->MakeCachedPlantFrame(SEED_MELONPULT, VARIATION_NORMAL);
+        auto head = cache->MakeCachedZombieFrame(ZOMBIE_KERNEL_HEAD);
+        if (!pot || !melon || !head) return nullptr;
+        for (int n = 0; n < 3; ++n)
+        {
+            const int x = 27 - 5 * n, foot = 28 + 17 * n;
+            DrawFittedCardSprite(art, *pot, x, foot, 19 + 3 * n, 13 + n);
+            DrawFittedCardSprite(art, *melon, x, foot - 6, 22 + 4 * n, 23 + 2 * n);
+        }
+        DrawFittedCardSprite(art, *head, 59, 62, 37, 54);
+    }
+    else
+    {
+        if (!Sexy::IMAGE_POOL) return nullptr;
+        art.DrawImage(Sexy::IMAGE_POOL, Rect(0, 20, 80, 45), Rect(256, 0, 320, 180));
+        auto lily = cache->MakeCachedPlantFrame(SEED_LILYPAD, VARIATION_NORMAL);
+        auto wood = cache->MakeCachedPlantFrame(SEED_TORCHWOOD, VARIATION_NORMAL);
+        auto* pepper = cache->GetVasebreakerPlantHeadImage(ZOMBIE_JALAPENO_HEAD);
+        if (!lily || !wood || !pepper) return nullptr;
+        DrawFittedCardSprite(art, *pepper, 61, 42, 31, 41);
+        DrawFittedCardSprite(art, *lily, 24, 63, 39, 16);
+        DrawFittedCardSprite(art, *wood, 24, 57, 36, 47);
+    }
+    image = std::move(card);
+    return image.get();
+}
