diff --git a/src/Lawn/System/ZomBotanyFinale.cpp b/src/Lawn/System/ZomBotanyFinale.cpp
new file mode 100644
index 0000000..377f18b
--- /dev/null
+++ b/src/Lawn/System/ZomBotanyFinale.cpp
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "ZomBotanyFinale.h"
+#include "../../LawnApp.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include <algorithm>
+#include <array>
+#include <span>
+
+namespace ZomBotanyFinale
+{
+namespace
+{
+constexpr auto pea = ZOMBIE_PEA_HEAD, puff = ZOMBIE_PUFF_HEAD, fume = ZOMBIE_FUME_HEAD;
+constexpr auto wall = ZOMBIE_WALLNUT_HEAD, tall = ZOMBIE_TALLNUT_HEAD, gatling = ZOMBIE_GATLING_HEAD;
+constexpr auto cabbage = ZOMBIE_CABBAGE_HEAD, kernel = ZOMBIE_KERNEL_HEAD, melon = ZOMBIE_MELON_HEAD;
+constexpr auto squash = ZOMBIE_SQUASH_HEAD, sea = ZOMBIE_SEA_HEAD, pepper = ZOMBIE_JALAPENO_HEAD;
+struct Wave
+{
+    std::array<ZombieType, 5> heads;
+    constexpr Wave(ZombieType a, ZombieType b = ZOMBIE_INVALID, ZombieType c = ZOMBIE_INVALID,
+                   ZombieType d = ZOMBIE_INVALID, ZombieType e = ZOMBIE_INVALID) : heads{a, b, c, d, e} {}
+};
+// The pattern lawn repeats its last wave until the last star is planted.
+constexpr Wave stars[] = {
+    {puff}, {puff}, {pea}, {puff, puff}, {pea, puff}, {wall}, {puff, pea}, {puff, squash},
+    {pea, puff}, {wall, pea, puff}, {puff, puff}, {squash, pea}, {pea, wall}, {puff, pea, squash},
+    {wall, pea, puff}, {pea, puff, pea}, {squash, puff}, {wall, pea, puff}, {puff, squash, pea}, {pea, wall, puff}
+};
+constexpr Wave portals[] = {
+    {puff}, {puff}, {pea}, {pea, puff}, {puff, puff}, {wall}, {pea, puff}, {fume, puff}, {pea, pea},
+    {wall, fume, pea}, {pea, puff}, {fume, fume}, {wall, pea}, {puff, gatling}, {pea, fume, puff},
+    {wall, pea, puff}, {gatling, fume}, {wall, fume, pea}, {pea, puff, fume}, {wall, gatling, fume, puff}
+};
+constexpr Wave columns[] = {
+    {cabbage}, {cabbage, cabbage}, {kernel, cabbage}, {cabbage, wall}, {kernel, kernel}, {wall, cabbage, cabbage},
+    {kernel, cabbage, wall}, {melon, cabbage}, {wall, kernel, cabbage}, {wall, melon, kernel, cabbage},
+    {kernel, cabbage, cabbage}, {tall, cabbage, kernel}, {melon, cabbage, kernel}, {tall, kernel, wall},
+    {melon, wall, cabbage, kernel}, {kernel, melon, kernel}, {tall, melon, cabbage}, {wall, kernel, melon, cabbage},
+    {tall, kernel, cabbage, kernel}, {tall, melon, kernel, wall, cabbage}
+};
+// A flag introduces a counter to the last formation: swimmers, armor,
+// artillery behind the armor, then lane-clearing Jalapeño-heads.
+constexpr Wave flags[][10] = {
+    {{puff}, {pea}, {sea}, {puff, puff}, {sea, pea}, {wall}, {pea, sea}, {puff, sea}, {pea, puff}, {wall, pea, sea}},
+    {{sea, puff}, {pea, pea}, {sea, sea}, {wall, puff}, {cabbage, sea}, {pea, cabbage}, {sea, wall},
+     {cabbage, sea}, {wall, pea, sea}, {wall, cabbage, sea, pea}},
+    {{cabbage, pea}, {sea, sea}, {wall, kernel}, {pea, squash}, {cabbage, sea, sea}, {gatling, puff},
+     {wall, sea, kernel}, {squash, sea}, {kernel, pea, sea}, {tall, gatling, sea, sea}},
+    {{wall, cabbage, sea}, {sea, sea, kernel}, {squash, pea}, {tall, kernel}, {pepper, sea, pea},
+     {gatling, wall}, {sea, sea, melon}, {cabbage, squash, sea}, {wall, gatling, sea}, {tall, melon, kernel, sea}},
+    {{sea, sea, pea}, {wall, gatling, sea}, {kernel, squash, sea}, {pepper, cabbage, sea}, {tall, kernel, melon},
+     {gatling, sea, sea}, {pepper, wall, pea}, {tall, melon, sea, sea}, {kernel, sea, pepper}, {tall, gatling, melon, sea, sea}}
+};
+std::span<const Wave> Formation(const Board& board)
+{
+    switch (board.mApp->mGameMode)
+    {
+    case kStars: return stars;
+    case kPortals: return portals;
+    case kColumns: return columns;
+    case kStand: return flags[std::clamp(board.mChallenge->mSurvivalStage, 0, 4)];
+    default: return {};
+    }
+}
+}
+
+SeedType StarTile(int col, int row)
+{
+    constexpr const char* sky[] = {"......*..", ".*...*.*.", "..*.*...*", "...*.*.*.", "......*.."};
+    return row >= 0 && row < 5 && col >= 0 && col < 9 && sky[row][col] == '*' ? SEED_STARFRUIT : SEED_NONE;
+}
+
+void PopulateWaves(Board& board)
+{
+    for (auto& row : board.mZombiesInWave) std::fill(std::begin(row), std::end(row), ZOMBIE_INVALID);
+    const auto formation = Formation(board);
+    board.mNumWaves = static_cast<int>(formation.size());
+    for (int i = 0; i < board.mNumWaves; ++i)
+        std::copy(formation[i].heads.begin(), formation[i].heads.end(), board.mZombiesInWave[i]);
+}
+
+void PopulateRoster(Board& board)
+{
+    std::fill(std::begin(board.mZombieAllowed), std::end(board.mZombieAllowed), false);
+    for (const Wave& wave : Formation(board))
+        for (ZombieType type : wave.heads)
+            if (type != ZOMBIE_INVALID) board.mZombieAllowed[type] = true;
+}
+
+ZombieType HeadForSpawn(const Board& board, ZombieType type, int row)
+{
+    if (!Contains(board.mApp->mGameMode) || type < ZOMBIE_NORMAL || type >= NUM_ZOMBIE_TYPES) return type;
+    if (board.mApp->mGameMode == kStand && (row == 2 || row == 3)) return sea;
+    if (Zombie::IsZombotany(type) && board.mZombieAllowed[type] && (row < 0 || type != sea)) return type;
+    return Formation(board).front().heads.front() == sea ? pea : Formation(board).front().heads.front();
+}
+
+bool ValidSave(const Board& board)
+{
+    if (!board.mChallenge || !board.mSeedBank) return false;
+    const auto mode = board.mApp->mGameMode;
+    const auto terrain = mode == kStars ? BACKGROUND_1_DAY : mode == kPortals ? BACKGROUND_2_NIGHT :
+                         mode == kColumns ? BACKGROUND_5_ROOF : BACKGROUND_3_POOL;
+    if (board.mBackground != terrain || board.mChallenge->mSurvivalStage < 0 ||
+        board.mChallenge->mSurvivalStage > (mode == kStand ? 4 : 0)) return false;
+    if (board.mNumWaves != static_cast<int>(Formation(board).size()) ||
+        board.mCurrentWave < 0 || board.mCurrentWave > board.mNumWaves) return false;
+    for (int i = 0; i < board.mNumWaves; ++i)
+        for (ZombieType type : board.mZombiesInWave[i])
+        {
+            if (type == ZOMBIE_INVALID) break;
+            if (type < ZOMBIE_NORMAL || type >= NUM_ZOMBIE_TYPES || HeadForSpawn(board, type) != type) return false;
+        }
+    for (auto* zombie : board.mZombies)
+        if (!zombie->mDead && zombie->IsOnBoard() && !Zombie::IsZombotany(zombie->mZombieType)) return false;
+    return true;
+}
+
+bool Won(Board& board)
+{
+    if (!board.mLevelAwardSpawned) return false;
+    const auto mode = board.mApp->mGameMode;
+    // Completing the stencil drops the prize. Its credit survives a plant being eaten
+    // between the drop and the player's click on the trophy.
+    if (mode == kStars) return true;
+    return board.mCurrentWave == board.mNumWaves && (mode != kStand || board.IsLastStandFinalStage());
+}
+}
