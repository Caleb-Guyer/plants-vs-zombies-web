diff --git a/src/Lawn/System/SpareChange.cpp b/src/Lawn/System/SpareChange.cpp
new file mode 100644
index 0000000..0b0d322
--- /dev/null
+++ b/src/Lawn/System/SpareChange.cpp
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "SpareChange.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../CursorObject.h"
+#include "../Plant.h"
+#include "../SeedPacket.h"
+#include "../Zombie.h"
+#include "../../LawnApp.h"
+#include "widget/WidgetManager.h"
+#include <array>
+#include <algorithm>
+
+namespace SpareChange
+{
+namespace
+{
+struct Pin { int row; int x; ZombieType type = ZOMBIE_NORMAL; };
+struct Frame { int count; std::array<Pin, 4> pins; };
+// A diagonal roll covers 150 pixels between lane centers. These are zombie
+// origins, so a straight shot and a bank use the same native collision boxes.
+constexpr std::array<Frame, kFrames> frames = {{
+    {3, {{{2, 365}, {1, 507}, {0, 649}}}},                   // Staircase
+    {3, {{{2, 360}, {1, 502}, {3, 502}}}},                   // Split
+    {3, {{{3, 368}, {4, 510}, {3, 652}}}},                   // Bank off the bottom
+    {3, {{{3, 370}, {2, 512, ZOMBIE_DOOR}, {1, 654}}}},      // Behind the door
+    {4, {{{1, 336}, {2, 478, ZOMBIE_DOOR}, {3, 484}, {2, 626, ZOMBIE_DOOR}}}} // Double doors
+}};
+constexpr int resultDelay = 100;
+
+int Direction(int row, int centerY, int pointerY)
+{
+    if (row == 0) return 1;
+    if (row == 4) return -1;
+    return pointerY < centerY ? -1 : 1;
+}
+
+void Result(Board& board, ChallengeState state)
+{
+    auto& game = *board.mChallenge;
+    game.mChallengeState = state;
+    game.mChallengeStateCounter = resultDelay;
+    board.ClearCursor();
+}
+}
+
+void ConfigureWaves(Board& board)
+{
+    board.mNumWaves = kFrames;
+    for (int frame = 0; frame < kFrames; ++frame) {
+        const auto& formation = frames[frame];
+        auto& wave = board.mZombiesInWave[frame];
+        std::fill(std::begin(wave), std::end(wave), ZOMBIE_INVALID);
+        for (int i = 0; i < formation.count; ++i) wave[i] = formation.pins[i].type;
+    }
+}
+
+void StartFrame(Board& board, int frame)
+{
+    auto& game = *board.mChallenge;
+    auto& bank = *board.mSeedBank;
+    board.ClearCursor();
+    for (auto* zombie : board.mZombies)
+        if (!zombie->mDead && zombie->IsOnBoard()) zombie->DieNoLoot();
+    for (auto* nut : board.mPlants)
+        if (!nut->mDead) nut->Die();
+    for (auto effect : {PARTICLE_ZOMBIE_HEAD, PARTICLE_ZOMBIE_ARM, PARTICLE_ZOMBIE_DOOR})
+        board.RemoveParticleByType(effect);
+    while (bank.GetNumSeedsOnConveyorBelt() > 0) bank.RemoveSeed(0);
+    board.mCurrentWave = frame + 1;
+    board.mTotalSpawnedWaves = board.mCurrentWave;
+    game.mChallengeState = STATECHALLENGE_NORMAL;
+    game.mChallengeScore = 0; // Successful launches in this frame.
+    game.mChallengeStateCounter = 0;
+    game.mShowBowlingLine = true;
+    const auto& formation = frames[frame];
+    for (int i = 0; i < formation.count; ++i) {
+        const Pin& pin = formation.pins[i];
+        auto* zombie = board.AddZombieInRow(pin.type, pin.row, frame);
+        if (zombie) {
+            zombie->mPosX = float(pin.x + 24);
+            zombie->mX = int(zombie->mPosX);
+        }
+    }
+    bank.AddSeed(SEED_WALLNUT, true);
+    bank.AddSeed(SEED_WALLNUT, true);
+}
+
+bool CanRoll(const Board& board)
+{
+    return board.mChallenge->mChallengeState == STATECHALLENGE_NORMAL &&
+           board.mChallenge->mChallengeScore < 2 && !board.mLevelAwardSpawned;
+}
+
+void Launch(Plant& nut, int pointerY)
+{
+    auto& board = *nut.mBoard;
+    nut.mTargetX = Direction(nut.mRow, board.GridToPixelY(nut.mPlantCol, nut.mRow) + 50, pointerY);
+    ++board.mChallenge->mChallengeScore;
+    board.mChallenge->mChallengeState = STATECHALLENGE_BOWLING_ROLLING;
+}
+
+PlantState Bank(const Plant& nut)
+{
+    if (nut.mRow == 0) return STATE_BOWLING_DOWN;
+    if (nut.mRow == 4) return STATE_BOWLING_UP;
+    if (nut.mState == STATE_BOWLING_UP || nut.mState == STATE_BOWLING_DOWN) return nut.mState;
+    return nut.mTargetX < 0 ? STATE_BOWLING_UP : STATE_BOWLING_DOWN;
+}
+
+void Update(Board& board)
+{
+    auto& game = *board.mChallenge;
+    if (board.mLevelAwardSpawned) return;
+    board.mSeedBank->UpdateConveyorBelt();
+    if (game.mChallengeState == STATECHALLENGE_NORMAL) return;
+    if (game.mChallengeState == STATECHALLENGE_BOWLING_ROLLING) {
+        bool standing = false;
+        for (auto* zombie : board.mZombies)
+            if (!zombie->mDead && zombie->IsOnBoard() && zombie->mHasHead && !zombie->IsDeadOrDying())
+                standing = true;
+        if (!standing) {
+            Result(board, game.mChallengeScore == 1 ? STATECHALLENGE_BOWLING_STRIKE : STATECHALLENGE_BOWLING_SPARE);
+            return;
+        }
+        for (auto* nut : board.mPlants) if (!nut->mDead) return;
+        if (game.mChallengeScore == 2) Result(board, STATECHALLENGE_BOWLING_RETRY);
+        else game.mChallengeState = STATECHALLENGE_NORMAL;
+        return;
+    }
+    if (--game.mChallengeStateCounter > 0) return;
+    if (game.mChallengeState == STATECHALLENGE_BOWLING_RETRY) StartFrame(board, board.mCurrentWave - 1);
+    else if (board.mCurrentWave < kFrames) StartFrame(board, board.mCurrentWave);
+    else game.SpawnLevelAward(4, 2);
+}
+
+void DrawAim(Board& board, Sexy::Graphics& graphics)
+{
+    if (board.mPaused || board.mApp->mGameScene != SCENE_PLAYING || !CanRoll(board) ||
+        board.mCursorObject->mCursorType != CURSOR_TYPE_PLANT_FROM_BANK) return;
+    const int x = board.mApp->mWidgetManager->mLastMouseX - board.mX;
+    const int y = board.mApp->mWidgetManager->mLastMouseY - board.mY;
+    const int col = board.PixelToGridX(x, y), row = board.PixelToGridY(x, y);
+    if (col < 0 || col > 2 || row < 0 || row > 4) return;
+    const int centerY = board.GridToPixelY(col, row) + 50;
+    if (y >= centerY + 50) return;
+    const int d = Direction(row, centerY, y);
+    Sexy::Graphics chalk(graphics);
+    auto arrow = [&](int offset) {
+        const int cy = centerY + offset;
+        chalk.DrawLineAA(278, cy, 286, cy);
+        chalk.DrawLineAA(286, cy, 298, cy + 10*d);
+        chalk.DrawLineAA(298, cy + 10*d, 291, cy + 9*d);
+        chalk.DrawLineAA(298, cy + 10*d, 297, cy + 3*d);
+    };
+    chalk.SetColor(Sexy::Color(56, 65, 31, 180)); arrow(2);
+    chalk.SetColor(Sexy::Color(255, 244, 199)); arrow(0); arrow(1);
+}
+
+std::string Label(const Board& board)
+{
+    const auto state = board.mChallenge->mChallengeState;
+    if (state == STATECHALLENGE_BOWLING_STRIKE) return "Strike!";
+    if (state == STATECHALLENGE_BOWLING_SPARE) return "Spare!";
+    if (state == STATECHALLENGE_BOWLING_RETRY) return "Try that frame again!";
+    return "Spare Change  " + std::to_string(std::max(board.mCurrentWave, 1)) + "/5";
+}
+
+bool ValidSave(const Board& board)
+{
+    const auto& game = *board.mChallenge;
+    if (board.mNumWaves != kFrames || board.mCurrentWave < 1 || board.mCurrentWave > kFrames ||
+        game.mChallengeScore < 0 || game.mChallengeScore > 2 || !game.mShowBowlingLine) return false;
+    switch (game.mChallengeState) {
+    case STATECHALLENGE_NORMAL: return game.mChallengeScore < 2;
+    case STATECHALLENGE_BOWLING_ROLLING: return game.mChallengeScore > 0;
+    case STATECHALLENGE_BOWLING_STRIKE: return game.mChallengeScore == 1;
+    case STATECHALLENGE_BOWLING_SPARE:
+    case STATECHALLENGE_BOWLING_RETRY: return game.mChallengeScore == 2;
+    default: return false;
+    }
+}
+}
