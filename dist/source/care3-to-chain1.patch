+void DrawNativePortraitPlant(Sexy::Graphics& graphics, ReanimationType type,
+    const char* layer, const Sexy::Rect& destination)
+{
+    auto image = MakeBlankImage(180, 180);
+    Sexy::Graphics nativeGraphics(image.get());
+    nativeGraphics.SetLinearBlend(true);
+    Reanimation native;
+    native.ReanimationInitializeType(40.0f, 35.0f, type);
+    native.SetFramesForLayer(layer);
+    native.Draw(&nativeGraphics);
+    const Sexy::Rect bounds = GetVisibleBounds(*image);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return;
+    const float scale = std::min(static_cast<float>(destination.mWidth) / bounds.mWidth,
+        static_cast<float>(destination.mHeight) / bounds.mHeight);
+    const float x = destination.mX + (destination.mWidth - bounds.mWidth * scale) * 0.5f - bounds.mX * scale;
+    const float y = destination.mY + (destination.mHeight - bounds.mHeight * scale) * 0.5f - bounds.mY * scale;
+    PvzpDrawImageScaledF(&graphics, image.get(), x, y, scale, scale);
+}
+
+std::unique_ptr<Sexy::MemoryImage> MakeChainReactionPortrait()
+{
+    auto image = MakeBlankImage(120, 120);
+    Sexy::Graphics graphics(image.get());
+    graphics.SetLinearBlend(true);
+    // The original explosives share one composition. Their complete native
+    // silhouettes are fitted and then centered inside the standard card window.
+    DrawNativePortraitPlant(graphics, REANIM_CHERRYBOMB, "anim_idle", Sexy::Rect(30, 9, 65, 79));
+    DrawNativePortraitPlant(graphics, REANIM_JALAPENO, "anim_idle", Sexy::Rect(84, 35, 27, 60));
+    DrawNativePortraitPlant(graphics, REANIM_POTATOMINE, "anim_armed", Sexy::Rect(9, 76, 51, 33));
+    return image;
+}
