diff --git a/src/Lawn/System/PoolPanic.cpp b/src/Lawn/System/PoolPanic.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d574263224a73fbffbc992d7971b9d6c62212a87
--- /dev/null
+++ b/src/Lawn/System/PoolPanic.cpp
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "PoolPanic.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include "../SeedPacket.h"
+#include "../../LawnApp.h"
+#include <algorithm>
+
+namespace PoolPanic
+{
+void Populate(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    challenge.mChallengeState = kActive;
+    challenge.mChallengeStateCounter = kOpeningDelay;
+    challenge.mSurvivalStage = 0;
+    challenge.mChallengeScore = 0;
+    challenge.mConveyorBeltCounter = kSupplyInterval;
+    board.mCurrentWave = board.mTotalSpawnedWaves = 0;
+    board.mZombieCountDown = board.mZombieCountDownStart = kOpeningDelay;
+    board.mZombieHealthToNextWave = -1;
+    board.mSunMoney = 0;
+    board.mShowShovel = false;
+    board.ClearCursor();
+    FillSeedBank(*board.mSeedBank);
+    for (int i = 0; i < kOpeningPackets; ++i)
+    {
+        const SeedType seed = SeedForSupply(challenge.mChallengeScore);
+        board.mSeedBank->AddSeed(seed,true);
+        challenge.mLastConveyorSeedType = seed;
+        ++challenge.mChallengeScore;
+    }
+    for (const Cell& cell : kLilyPads) board.AddPlant(cell.mCol,cell.mRow,SEED_LILYPAD,SEED_NONE);
+}
+
+void Update(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (!IsCurrentRules(board.mApp->mGameMode,challenge.mChallengeState) ||
+        challenge.mChallengeState != kActive || board.mApp->mGameScene != SCENE_PLAYING ||
+        board.mPaused || board.mTimeStopCounter > 0 || board.mLevelComplete || board.HasLevelAwardDropped()) return;
+    board.mShowShovel = false;
+    // Movement remains native at capacity. An unaccepted delivery never spends
+    // its saved ordinal or delay, so a full bank cannot silently lose supplies.
+    board.mSeedBank->UpdateConveyorBelt();
+    if (challenge.mChallengeScore < kPacketCount &&
+        board.mSeedBank->GetNumSeedsOnConveyorBelt() < board.mSeedBank->mNumPackets)
+    {
+        if (challenge.mConveyorBeltCounter > 0) --challenge.mConveyorBeltCounter;
+        if (challenge.mConveyorBeltCounter == 0)
+        {
+            const SeedType seed = SeedForSupply(challenge.mChallengeScore);
+            board.mSeedBank->AddSeed(seed);
+            challenge.mLastConveyorSeedType = seed;
+            ++challenge.mChallengeScore;
+            challenge.mConveyorBeltCounter = kSupplyInterval;
+        }
+    }
+    const int next = std::clamp(challenge.mSurvivalStage,0,kWaveCount);
+    if (next < kWaveCount)
+    {
+        if (challenge.mChallengeStateCounter > 0) --challenge.mChallengeStateCounter;
+        board.mZombieCountDown = challenge.mChallengeStateCounter;
+        if (challenge.mChallengeStateCounter == 0)
+        {
+            for (const Spawn& spawn : kFormations[next])
+            {
+                if (spawn.mType == ZOMBIE_INVALID) continue;
+                Zombie* zombie = board.AddZombieInRow(spawn.mType,spawn.mRow,next);
+                zombie->mPosX = static_cast<float>(spawn.mX);
+                zombie->mX = spawn.mX;
+                zombie->UpdateReanim();
+            }
+            challenge.mSurvivalStage = next + 1;
+            board.mCurrentWave = board.mTotalSpawnedWaves = next + 1;
+            challenge.mChallengeStateCounter = kFormationInterval;
+            board.mZombieCountDown = board.mZombieCountDownStart = kFormationInterval;
+        }
+        return;
+    }
+    if (board.AreEnemyZombiesOnScreen()) return;
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    challenge.mChallengeState = kFinished;
+    challenge.SpawnLevelAward(4,2);
+}
+}
diff --git a/src/Lawn/System/PoolPanic.h b/src/Lawn/System/PoolPanic.h
new file mode 100644
index 0000000000000000000000000000000000000000..3d2d8c8296ebe69357a9ade0df6ef4f503090b70
--- /dev/null
+++ b/src/Lawn/System/PoolPanic.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+
+class Board;
+
+// A finite native pool conveyor battle. Existing Challenge counters persist
+// formation/delivery progress; the original bank owns every waiting packet.
+namespace PoolPanic
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_POOL_PANIC;
+inline constexpr ChallengeState kActive = static_cast<ChallengeState>(125);
+inline constexpr ChallengeState kFinished = static_cast<ChallengeState>(126);
+inline constexpr int kWaveCount = 8;
+inline constexpr int kOpeningDelay = 1600;
+inline constexpr int kFormationInterval = 1200;
+inline constexpr int kLargestFormation = 8;
+inline constexpr int kBankSize = 10;
+inline constexpr int kOpeningPackets = 4;
+inline constexpr int kPacketCount = 56;
+inline constexpr int kSupplyInterval = 200;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{ return IsMode(mode) && (state == kActive || state == kFinished); }
+inline constexpr std::array<SeedType,8> kSupplyCycle = {
+    SEED_SQUASH, SEED_TANGLEKELP, SEED_CHERRYBOMB, SEED_TANGLEKELP,
+    SEED_SQUASH, SEED_JALAPENO, SEED_CHERRYBOMB, SEED_TANGLEKELP
+};
+constexpr SeedType SeedForSupply(int ordinal)
+{
+    return ordinal >= 0 && ordinal < kPacketCount ? kSupplyCycle[ordinal % kSupplyCycle.size()] : SEED_NONE;
+}
+struct Cell { int mCol; int mRow; };
+inline constexpr std::array<Cell,8> kLilyPads = {{{0,2},{1,2},{2,2},{3,2},{0,3},{1,3},{2,3},{3,3}}};
+struct Spawn { ZombieType mType = ZOMBIE_INVALID; int mRow = 0; int mX = 0; };
+using Formation = std::array<Spawn,kLargestFormation>;
+inline constexpr std::array<Formation,kWaveCount> kFormations = {{
+    {{{ZOMBIE_NORMAL,0,800},{ZOMBIE_NORMAL,5,800},{ZOMBIE_NORMAL,2,800},{ZOMBIE_NORMAL,3,800}}},
+    {{{ZOMBIE_TRAFFIC_CONE,1,800},{ZOMBIE_TRAFFIC_CONE,4,800},{ZOMBIE_TRAFFIC_CONE,2,800},{ZOMBIE_TRAFFIC_CONE,3,800}}},
+    {{{ZOMBIE_NORMAL,0,800},{ZOMBIE_TRAFFIC_CONE,0,840},{ZOMBIE_NORMAL,1,800},{ZOMBIE_TRAFFIC_CONE,1,840},{ZOMBIE_NORMAL,2,800},{ZOMBIE_NORMAL,3,800}}},
+    {{{ZOMBIE_NORMAL,4,800},{ZOMBIE_TRAFFIC_CONE,4,840},{ZOMBIE_NORMAL,5,800},{ZOMBIE_TRAFFIC_CONE,5,840},{ZOMBIE_TRAFFIC_CONE,2,800},{ZOMBIE_TRAFFIC_CONE,3,800}}},
+    {{{ZOMBIE_PAIL,0,800},{ZOMBIE_NORMAL,1,800},{ZOMBIE_PAIL,4,800},{ZOMBIE_NORMAL,5,800},{ZOMBIE_PAIL,2,800},{ZOMBIE_PAIL,3,800}}},
+    {{{ZOMBIE_TRAFFIC_CONE,0,800},{ZOMBIE_TRAFFIC_CONE,1,800},{ZOMBIE_TRAFFIC_CONE,4,800},{ZOMBIE_TRAFFIC_CONE,5,800},{ZOMBIE_DOLPHIN_RIDER,2,800},{ZOMBIE_DOLPHIN_RIDER,3,800}}},
+    {{{ZOMBIE_DOOR,0,800},{ZOMBIE_PAIL,1,840},{ZOMBIE_DOOR,4,800},{ZOMBIE_PAIL,5,840},{ZOMBIE_NORMAL,2,800},{ZOMBIE_TRAFFIC_CONE,2,840},{ZOMBIE_NORMAL,3,800},{ZOMBIE_TRAFFIC_CONE,3,840}}},
+    {{{ZOMBIE_FOOTBALL,0,800},{ZOMBIE_TRAFFIC_CONE,1,840},{ZOMBIE_FOOTBALL,4,800},{ZOMBIE_TRAFFIC_CONE,5,840},{ZOMBIE_PAIL,2,800},{ZOMBIE_DOLPHIN_RIDER,2,880},{ZOMBIE_PAIL,3,800},{ZOMBIE_DOLPHIN_RIDER,3,880}}}
+}};
+constexpr int ZombieCount(int formation)
+{
+    if (formation < 0 || formation >= kWaveCount) return 0;
+    int count = 0;
+    for (const Spawn& spawn : kFormations[formation]) count += spawn.mType != ZOMBIE_INVALID;
+    return count;
+}
+constexpr int WaterZombieCount()
+{
+    int count = 0;
+    for (const Formation& formation : kFormations) for (const Spawn& spawn : formation)
+        count += spawn.mType != ZOMBIE_INVALID && (spawn.mRow == 2 || spawn.mRow == 3);
+    return count;
+}
+template<std::size_t Waves,std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestFormation);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int wave = 0; wave < kWaveCount; ++wave)
+        for (int i = 0; i < ZombieCount(wave); ++i) output[wave][i] = kFormations[wave][i].mType;
+    return kWaveCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_DOLPHIN_RIDER));
+    for (auto& allowed : output) allowed = false;
+    for (const Formation& formation : kFormations) for (const Spawn& spawn : formation)
+        if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+template<class Bank>
+void FillSeedBank(Bank& bank) { bank.mNumPackets = kBankSize; }
+void Populate(Board& board);
+void Update(Board& board);
+static_assert(static_cast<int>(kMode) == 86);
+static_assert(ZombieCount(0)+ZombieCount(1)+ZombieCount(2)+ZombieCount(3)+ZombieCount(4)+ZombieCount(5)+ZombieCount(6)+ZombieCount(7)==48);
+static_assert(WaterZombieCount()==20);
+}
diff --git a/src/Lawn/System/PoolPanicPresentation.cpp b/src/Lawn/System/PoolPanicPresentation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..97852a0888a90e448f65751b4c73034c0f7c64fc
--- /dev/null
+++ b/src/Lawn/System/PoolPanicPresentation.cpp
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "PoolPanicPresentation.h"
+#include "../../GameConstants.h"
+#include "../../LawnApp.h"
+#include "../../Resources.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "graphics/Graphics.h"
+#include "graphics/MemoryImage.h"
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+namespace PoolPanicPresentation
+{
+namespace
+{
+std::unique_ptr<Sexy::MemoryImage> sCard;
+
+std::unique_ptr<Sexy::MemoryImage> Blank(int width, int height)
+{
+    std::vector<uint32_t> pixels(width * height, 0);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+Sexy::Rect VisibleBounds(Sexy::MemoryImage& image)
+{
+    int left = image.GetWidth(), top = image.GetHeight(), right = -1, bottom = -1;
+    const uint32_t* pixels = image.GetBits();
+    for (int y = 0; y < image.GetHeight(); ++y)
+        for (int x = 0; x < image.GetWidth(); ++x)
+            if ((pixels[y * image.GetWidth() + x] >> 24) > 8)
+            {
+                left = std::min(left, x); top = std::min(top, y);
+                right = std::max(right, x); bottom = std::max(bottom, y);
+            }
+    return right < left ? Sexy::Rect() : Sexy::Rect(left, top, right - left + 1, bottom - top + 1);
+}
+}
+
+Sexy::Image* GetBonusImage()
+{
+    if (sCard) return sCard.get();
+    if (!PvzpLoadResources("LoadingImages") || !PvzpLoadResources("DelayLoad_Background3") ||
+        !Sexy::IMAGE_BACKGROUND3 || !Sexy::IMAGE_POOL) return nullptr;
+
+    // Original plant rigs retain their complete parts and native proportions.
+    // Kelp uses its original packet/Almanac aquarium pose so its face and arms
+    // are recognizable beside a Squash resting on the native Lily Pad.
+    auto portrait = Blank(240, 180);
+    Sexy::Graphics native(portrait.get());
+    native.SetLinearBlend(true);
+    Reanimation pad;
+    pad.ReanimationInitializeType(40.0f, 70.0f, REANIM_LILYPAD);
+    pad.SetFramesForLayer("anim_idle");
+    pad.Draw(&native);
+    Reanimation squash;
+    squash.ReanimationInitializeType(40.0f, 45.0f, REANIM_SQUASH);
+    squash.SetFramesForLayer("anim_idle");
+    squash.Draw(&native);
+    Reanimation kelp;
+    kelp.ReanimationInitializeType(115.0f, 45.0f, REANIM_TANGLEKELP);
+    kelp.SetFramesForLayer("anim_idle_aquarium");
+    kelp.AssignRenderGroupToTrack("anim_waterline", RENDER_GROUP_HIDDEN);
+    kelp.Draw(&native);
+    const Sexy::Rect bounds = VisibleBounds(*portrait);
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return nullptr;
+
+    auto card = Blank(80, 65);
+    Sexy::Graphics picture(card.get());
+    picture.SetLinearBlend(true);
+    picture.ClipRect(0, 0, 80, 65);
+    // The backdrop has a white pool opening. Match the original software pool
+    // composition before cropping: PoolEffect draws water at (34,278), while
+    // Board::DrawBackdrop places the background at (-BOARD_OFFSET,0).
+    auto landscape = Blank(Sexy::IMAGE_BACKGROUND3->GetWidth(), Sexy::IMAGE_BACKGROUND3->GetHeight());
+    Sexy::Graphics ground(landscape.get());
+    ground.DrawImage(Sexy::IMAGE_BACKGROUND3, 0, 0);
+    ground.DrawImage(Sexy::IMAGE_POOL, 34 + BOARD_OFFSET, 278);
+    picture.DrawImage(landscape.get(), Sexy::Rect(0, 0, 80, 65), Sexy::Rect(400, 225, 480, 240));
+    const float scale = std::min(68.0f / bounds.mWidth, 57.0f / bounds.mHeight);
+    PvzpDrawImageScaledF(&picture, portrait.get(),
+        40.0f - (bounds.mX + bounds.mWidth * 0.5f) * scale,
+        32.5f - (bounds.mY + bounds.mHeight * 0.5f) * scale, scale, scale);
+    sCard = std::move(card);
+    return sCard.get();
+}
+
+void DisposeImage() { sCard.reset(); }
+}
