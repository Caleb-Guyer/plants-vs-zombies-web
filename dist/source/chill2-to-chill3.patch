+"""Editable path design for Chill-shroom. Writes its canonical JSON recipe."""
+import json
+from pathlib import Path
+
+
+def shape(path, fill=None, stroke=None, width=1):
+    value = {'path': path}
+    if fill:
+        value['fill'] = fill
+    if stroke:
+        value.update(stroke=stroke, width=width)
+    return value
+
+
+def pill(x, y, w, h, color):
+    r = w/2
+    return shape([['M', x+r, y], ['C', x+w, y, x+w, y+1, x+w, y+h/2],
+                  ['C', x+w, y+h, x+w, y+h, x+r, y+h],
+                  ['C', x, y+h, x, y+h-1, x, y+h/2],
+                  ['C', x, y, x, y, x+r, y], ['Z']], color)
+
+
+outline = '#30433e'
+cap = [
+    shape([['M', 3, 34], ['C', 9, 29, 9, 24, 14, 19],
+           ['C', 24, 6, 39, 2, 55, 3], ['C', 73, 1, 87, 12, 92, 24],
+           ['C', 95, 29, 99, 31, 100, 35], ['C', 101, 39, 88, 43, 72, 44],
+           ['C', 49, 47, 21, 43, 9, 40], ['C', 3, 39, 1, 37, 3, 34], ['Z']],
+          '#527b89', '#253e46', 2.4),
+    # Broad softly uneven dome and restrained upper-left lighting.
+    shape([['M', 4, 34], ['C', 12, 26, 12, 19, 22, 13],
+           ['C', 37, 0, 61, 1, 73, 8], ['C', 85, 14, 91, 25, 94, 32],
+           ['C', 74, 37, 45, 36, 26, 36], ['C', 17, 37, 8, 38, 4, 34], ['Z']], '#80b4be'),
+    shape([['M', 13, 27], ['C', 20, 12, 39, 5, 54, 6],
+           ['C', 37, 8, 25, 17, 20, 28], ['C', 16, 31, 12, 31, 13, 27], ['Z']], '#a0cbd0'),
+    shape([['M', 73, 10], ['C', 85, 16, 88, 26, 94, 32],
+           ['C', 81, 36, 60, 37, 41, 35], ['C', 64, 34, 77, 28, 77, 21],
+           ['C', 78, 17, 75, 12, 73, 10], ['Z']], '#68a0af'),
+    # Three large irregular pale frost patches instead of crystal spikes.
+    shape([['M', 28, 13], ['C', 25, 12, 25, 17, 22, 19],
+           ['C', 19, 23, 22, 27, 27, 27], ['C', 30, 27, 31, 24, 36, 25],
+           ['C', 42, 26, 44, 23, 41, 19], ['C', 40, 16, 34, 16, 33, 13],
+           ['C', 32, 11, 30, 11, 28, 13], ['Z']], '#dce8d8'),
