+           ['C', 75, 16, 70, 16, 69, 13], ['C', 67, 10, 62, 10, 58, 10], ['Z']], '#d1e4d5'),
+    shape([['M', 67, 28], ['C', 64, 29, 66, 32, 69, 32],
