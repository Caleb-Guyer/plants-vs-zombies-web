+           ['C', 79, 26, 77, 28, 73, 27], ['C', 71, 27, 69, 27, 67, 28], ['Z']], '#c5dbd1'),
+    # The drooping rim has a dark underside and three broad gill strokes.
+    shape([['M', 9, 37], ['C', 35, 41, 71, 41, 95, 36]], None, '#37545f', 2.2),
