+std::unique_ptr<Sexy::MemoryImage> MakePartImage(const uint32_t* argb, int width, int height)
+{
+    std::vector<uint32_t> pixels(argb, argb + width * height);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+const std::array<std::unique_ptr<Sexy::MemoryImage>, 5>& GetPartImages()
+{
+    SpriteCache& cache = CachedSprite();
+    if (!cache.parts[0])
+    {
+        cache.parts[0] = MakePartImage(ChillShroomArt::kCapArgb, ChillShroomArt::kCapWidth, ChillShroomArt::kCapHeight);
+        cache.parts[1] = MakePartImage(ChillShroomArt::kBodyArgb, ChillShroomArt::kBodyWidth, ChillShroomArt::kBodyHeight);
+        cache.parts[2] = MakePartImage(ChillShroomArt::kBaseArgb, ChillShroomArt::kBaseWidth, ChillShroomArt::kBaseHeight);
+        cache.parts[3] = MakePartImage(ChillShroomArt::kBlink1Argb, ChillShroomArt::kBlink1Width, ChillShroomArt::kBlink1Height);
+        cache.parts[4] = MakePartImage(ChillShroomArt::kBlink2Argb, ChillShroomArt::kBlink2Width, ChillShroomArt::kBlink2Height);
+    }
+    return cache.parts;
+}
+
+int FindImageTrack(const Reanimation& reanimation, const char* name)
+{
+    for (int index = 0; index < reanimation.mDefinition->mTracks.count; ++index)
+    {
+        const ReanimatorTrack& track = reanimation.mDefinition->mTracks.tracks[index];
+        if (std::strcmp(track.mName, name) != 0) continue;
+        for (int frame = 0; frame < track.mTransforms.count; ++frame)
+            if (track.mTransforms.mTransforms[frame].mImage) return index;
+    }
+    return -1;
+}
+
+const std::array<int, 5>& GetPartTrackIndices(const Reanimation& reanimation)
+{
+    SpriteCache& cache = CachedSprite();
+    if (cache.definition != reanimation.mDefinition)
+    {
+        static constexpr const char* names[5] = {"IceShroom_head", "anim_face", "IceShroom_base", "anim_sleep", "anim_blink"};
+        for (int index = 0; index < 5; ++index)
+            cache.trackIndices[index] = FindImageTrack(reanimation, names[index]);
+        cache.definition = reanimation.mDefinition;
+    }
+    return cache.trackIndices;
 }
 
