+std::vector<unsigned char> DecodeBase64(const char* text)
+{
+    std::vector<unsigned char> bytes;
+    bytes.reserve(std::strlen(text) * 3 / 4);
+    unsigned int value = 0;
+    int bits = -8;
+    for (const unsigned char* current = reinterpret_cast<const unsigned char*>(text); *current; ++current)
+    {
+        const unsigned char c = *current;
+        if (c == '=') break;
+        if (c == '\r' || c == '\n') continue;
+        const int digit = c >= 'A' && c <= 'Z' ? c - 'A' : c >= 'a' && c <= 'z' ? c - 'a' + 26 :
+            c >= '0' && c <= '9' ? c - '0' + 52 : c == '+' ? 62 : c == '/' ? 63 : -1;
+        if (digit < 0) return {};
+        value = (value << 6) | static_cast<unsigned int>(digit);
+        bits += 6;
+        if (bits >= 0)
+        {
+            bytes.push_back(static_cast<unsigned char>((value >> bits) & 255U));
+            bits -= 8;
+        }
+    }
+    return bytes;
+}
+
+std::unique_ptr<Sexy::GLImage> DecodeImage(const char* encoded, int width, int height, bool trimTransparent = false, int contentHeight = 0)
+{
+    const auto bytes = DecodeBase64(encoded);
+    if (bytes.empty()) return nullptr;
+    png_image input{};
+    input.version = PNG_IMAGE_VERSION;
+    if (!png_image_begin_read_from_memory(&input, bytes.data(), bytes.size())) return nullptr;
+    input.format = PNG_FORMAT_RGBA;
+    std::vector<unsigned char> rgba(PNG_IMAGE_SIZE(input));
+    if (!png_image_finish_read(&input, nullptr, rgba.data(), 0, nullptr))
+    {
+        png_image_free(&input);
+        return nullptr;
+    }
+    int left = 0, top = 0, right = static_cast<int>(input.width) - 1, bottom = static_cast<int>(input.height) - 1;
+    if (trimTransparent)
+    {
+        left = static_cast<int>(input.width); top = static_cast<int>(input.height); right = bottom = -1;
+        for (int y = 0; y < static_cast<int>(input.height); ++y)
+            for (int x = 0; x < static_cast<int>(input.width); ++x)
+                if (rgba[(y * input.width + x) * 4 + 3] > 8)
+                {
+                    left = std::min(left, x); top = std::min(top, y);
+                    right = std::max(right, x); bottom = std::max(bottom, y);
+                }
+        if (right < left || bottom < top) { png_image_free(&input); return nullptr; }
+    }
+    const int sourceWidth = right - left + 1, sourceHeight = bottom - top + 1;
+    const int drawnHeight = contentHeight > 0 ? std::min(contentHeight, height) : height;
+    std::vector<uint32_t> pixels(width * height, 0);
+    for (int y = 0; y < drawnHeight; ++y)
+        for (int x = 0; x < width; ++x)
+        {
+            unsigned int alpha = 0, red = 0, green = 0, blue = 0;
+            for (int sy = 0; sy < 4; ++sy)
+                for (int sx = 0; sx < 4; ++sx)
+                {
+                    const int sourceX = std::min(right, left +
+                        static_cast<int>((x + (sx + 0.5f) * 0.25f) * sourceWidth / width));
+                    const int sourceY = std::min(bottom, top +
+                        static_cast<int>((y + (sy + 0.5f) * 0.25f) * sourceHeight / drawnHeight));
+                    const auto* sample = &rgba[(sourceY * input.width + sourceX) * 4];
+                    const unsigned int a = sample[3];
+                    alpha += a; red += sample[0] * a; green += sample[1] * a; blue += sample[2] * a;
+                }
+            if (alpha)
+                pixels[y * width + x] = ((alpha / 16) << 24) | ((red / alpha) << 16) | ((green / alpha) << 8) | (blue / alpha);
+        }
+    png_image_free(&input);
+    auto image = std::make_unique<Sexy::GLImage>(gLawnApp->mGLInterface.get());
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
