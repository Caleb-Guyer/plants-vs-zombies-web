+template<class Visitor>
+void VisitStage(const Board& board, Visitor visit)
+{
+    const int stage = std::clamp(board.mChallenge->mSurvivalStage, 0, kStageCount - 1);
+    const auto visitWaves = [&](const auto& heads, const auto& waves) {
+        for (int wave = 0; wave < kWavesPerStage; ++wave)
+        {
+            int slot = 0;
+            for (std::size_t i = 0; i < heads.size(); ++i)
+                for (int n = 0; n < waves[wave][i]; ++n) visit(wave, slot++, heads[i]);
+            visit(wave, slot, ZOMBIE_INVALID);
+        }
+    };
+    if (board.mApp->mGameMode == kNightMode) visitWaves(nightHeads, nightStages[stage]);
+    else visitWaves(kHeadTypes, kStages[stage]);
+}
+
+void GrowNightGrave(Board& board, int stage)
+{
+    if (board.GetGraveStonesCount() >= 8) return;
+    // Advance closer to the house over the course. A player who has planted
+    // every eligible square keeps the lawn they built.
+    const int firstColumn = 6 - stage / 2;
+    std::array<PvzpWeightedGridArray, 25> squares{};
+    int count = 0;
+    for (int col = firstColumn; col < MAX_GRID_SIZE_X; ++col)
+        for (int row = 0; row < 5; ++row)
+            if (board.CanAddGraveStoneAt(col, row) && !board.GetTopPlantAt(col, row, TOPPLANT_ANY))
+                squares[count++] = {col, row, col == firstColumn ? 3 : 1};
+    if (!count) return;
+    const auto* square = PvzpPickFromWeightedGridArray(squares.data(), count);
+    board.mChallenge->GraveDangerSpawnGraveAt(square->mX, square->mY);
+}
+
+void RaiseNightMushrooms(Board& board, int stage)
+{
+    // At a flag, up to two different lanes can be flanked. Prefer the
+    // foremost mature grave in each lane. A Grave Buster can interrupt it.
+    std::array<GridItem*, 5> graves{};
+    for (GridItem* grave : board.mGridItems)
+    {
+        if (grave->mDead || grave->mGridItemType != GRIDITEM_GRAVESTONE ||
+            grave->mGridItemCounter < 100 || grave->mGridY < 0 || grave->mGridY >= 5 ||
+            board.GetTopPlantAt(grave->mGridX, grave->mGridY, TOPPLANT_ANY)) continue;
+        auto& front = graves[grave->mGridY];
+        if (!front || grave->mGridX < front->mGridX) front = grave;
+    }
+    const int firstRow = Rand(5);
+    const int maximum = stage >= 2 ? 2 : 1;
+    int raised = 0;
+    for (int i = 0; i < 5 && raised < maximum; ++i)
+    {
+        GridItem* grave = graves[(firstRow + i) % 5];
+        if (!grave) continue;
+        const ZombieType head = stage >= 2 && raised == 0 ? ZOMBIE_FUME_HEAD : ZOMBIE_PUFF_HEAD;
+        if (Zombie* zombie = board.AddZombieInRow(head, grave->mGridY, board.mCurrentWave))
+        {
+            zombie->RiseFromGrave(grave->mGridX, grave->mGridY);
+            ++raised;
+        }
+    }
+}
+}
