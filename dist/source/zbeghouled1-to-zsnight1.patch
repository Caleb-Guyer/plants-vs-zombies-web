+static void DrawFittedCardSprite(Graphics& picture, MemoryImage& sprite, float centerX, float baseline, float maxWidth, float maxHeight)
+{
+	int left = sprite.GetWidth(), top = sprite.GetHeight(), right = -1, bottom = -1;
+	const auto* pixels = sprite.GetBits();
+	for (int y = 0; y < sprite.GetHeight(); ++y) for (int x = 0; x < sprite.GetWidth(); ++x)
+		if ((pixels[y * sprite.GetWidth() + x] >> 24) > 8)
+		{
+			left = std::min(left, x); top = std::min(top, y);
+			right = std::max(right, x); bottom = std::max(bottom, y);
+		}
+	if (right < left || bottom < top) return;
+	const float w = static_cast<float>(right - left + 1), h = static_cast<float>(bottom - top + 1);
+	const float scale = std::min(maxWidth / w, maxHeight / h);
+	PvzpDrawImageScaledF(&picture, &sprite, centerX - (left + w * .5f) * scale,
+		baseline - (top + h) * scale, scale, scale);
+}
+
+Image* ChallengeScreen::GetZombotanySurvivalNightImage()
+{
+	if (mZombotanySurvivalNightImage) return mZombotanySurvivalNightImage.get();
+	auto* cache = mApp->mReanimatorCache.get();
+	if (!cache || !Sexy::IMAGE_TOMBSTONES || !Sexy::IMAGE_TOMBSTONE_MOUNDS) return nullptr;
+	const std::string group = "DelayLoad_Background2";
+	if (std::find(mLoadedResourceNames.begin(), mLoadedResourceNames.end(), group) == mLoadedResourceNames.end())
+	{
+		if (!PvzpLoadResources(group.c_str())) return nullptr;
+		mLoadedResourceNames.push_back(group);
+	}
+	if (!Sexy::IMAGE_BACKGROUND2) return nullptr;
+	auto fumeHead = cache->MakeCachedZombieFrame(ZOMBIE_FUME_HEAD);
+	if (!fumeHead) return nullptr;
+	auto image = cache->MakeBlankMemoryImage(80, 65);
+	Graphics picture(image.get());
+	picture.SetLinearBlend(true);
+	picture.ClipRect(0, 0, 80, 65);
+	picture.DrawImage(Sexy::IMAGE_BACKGROUND2, Rect(0, 0, 80, 65), Rect(535, 40, 320, 260));
+
+	// Graves use the same sprite cells and dirt overlays as GridItem::DrawGraveStone.
+	auto grave = [&](int col, int row, int centerX, int baseline, int width)
+	{
+		const Rect tile = Sexy::IMAGE_TOMBSTONES->GetCelRect(col, row);
+		const int height = width * tile.mHeight / tile.mWidth;
+		const Rect dest(centerX - width / 2, baseline - height, width, height);
+		picture.DrawImage(Sexy::IMAGE_TOMBSTONES, dest, tile);
+		picture.DrawImage(Sexy::IMAGE_TOMBSTONE_MOUNDS, dest, tile);
+	};
+	grave(0, 2, 12, 35, 18);
+	DrawFittedCardSprite(picture, *fumeHead, 55, 63, 45, 59);
+	grave(3, 3, 23, 63, 37);
+	mZombotanySurvivalNightImage = std::move(image);
+	return mZombotanySurvivalNightImage.get();
+}
