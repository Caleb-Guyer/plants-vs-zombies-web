+void ApplyPartOffset(Reanimation& reanimation, int trackIndex, Sexy::Image& image,
+    int originalWidth, int originalHeight, float offsetX, float offsetY)
+{
+    ReanimatorTrackInstance& track = reanimation.mTrackInstances[trackIndex];
+    if (track.mShakeOverride != 0.0f) return;
+    track.mShakeX = track.mShakeY = 0.0f;
+    const float x = (image.GetWidth() - originalWidth) * 0.5f + offsetX;
+    const float y = (image.GetHeight() - originalHeight) * 0.5f + offsetY;
+    if (x == 0.0f && y == 0.0f) return;
+    ReanimatorTransform transform;
+    reanimation.GetCurrentTransform(trackIndex, &transform);
+    if (transform.mFrame < 0.0f) return;
+    SexyMatrix3 native;
+    Reanimation::MatrixFromTransform(transform, native);
+    SexyMatrix3 combined;
+    SexyMatrix3Multiply(combined, reanimation.mOverlayMatrix, native);
+    // Native drawing retains the original atlas pivot. Correct larger part
+    // canvases before applying the cap's small independent follow-through.
+    track.mShakeX = combined.m00 * x + combined.m01 * y;
+    track.mShakeY = combined.m10 * x + combined.m11 * y;
 }
 
