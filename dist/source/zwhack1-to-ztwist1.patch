+void ButterMatch(Board& board, int col, int row, int length, bool horizontal)
+{
+    if (length < 4) return;
+    const int launchCol = horizontal ? col + (length - 1) / 2 : col;
+    const int lastRow = horizontal ? row : row + length - 1;
+    bool launched = false;
+    for (int lane = row; lane <= lastRow; ++lane)
+    {
+        Zombie* front = nullptr;
+        for (Zombie* zombie : board.mZombies)
+        {
+            if (zombie->mDead || zombie->mRow != lane || !zombie->mHasHead ||
+                zombie->mMindControlled || zombie->IsDeadOrDying() ||
+                zombie->mX > BOARD_WIDTH || !zombie->EffectedByDamage(1U)) continue;
+            if (!front || zombie->mPosX < front->mPosX) front = zombie;
+        }
+        if (!front) continue;
+        // A match can be behind an invader. The butter still leaves the matched
+        // plant and may travel left, then uses the normal collision and stun.
+        const int x = board.GridToPixelX(launchCol, lane) + 32;
+        const int y = board.GridToPixelY(launchCol, lane) - 20;
+        auto* butter = board.AddProjectile(x, y, Board::MakeRenderOrder(RENDER_LAYER_PROJECTILE, lane, 0),
