+bool CanAcceptSupply(const SeedBank& bank)
+{
+    const int waiting = WaitingPackets(bank);
+    if (waiting >= bank.mNumPackets) return false;
+    // Native AddSeed's fallback adds 40px to the previous offset. Admission
+    // must wait until that fallback cannot push a new packet off the entry.
+    const int entry = 515-(SEED_PACKET_WIDTH+1)*waiting;
+    return waiting == 0 || bank.mSeedPackets[waiting-1].mOffsetX <= entry;
+}
+int SupplyWeight(Board& board, SeedType seed)
+{
+    int base = 0, waitingLimit = 2, boardLimit = 54;
+    switch (seed)
+    {
+    case SEED_REPEATER: base=26; waitingLimit=3; boardLimit=16; break;
+    case SEED_THREEPEATER: base=20; waitingLimit=3; boardLimit=10; break;
+    case SEED_TALLNUT: base=13; boardLimit=10; break;
+    case SEED_TORCHWOOD: base=10; waitingLimit=1; break;
+    case SEED_SPIKEWEED: base=8; boardLimit=8; break;
+    case SEED_LILYPAD: base=4; waitingLimit=1; boardLimit=14; break;
+    case SEED_SQUASH: base=6; boardLimit=4; break;
+    case SEED_TANGLEKELP: base=4; waitingLimit=1; boardLimit=4; break;
+    case SEED_CHERRYBOMB: base=7; break;
+    case SEED_JALAPENO: base=5; break;
+    default: return 0;
+    }
+    int waiting = 0, planted = 0;
+    std::array<bool,6> torchwoodRows{};
+    for (const SeedPacket& packet : board.mSeedBank->mSeedPackets)
+        waiting += packet.mPacketType == seed;
+    for (const Plant* plant : board.mPlants)
+    {
+        planted += !plant->mDead && plant->mSeedType == seed;
+        if (!plant->mDead && plant->mSeedType == SEED_TORCHWOOD && plant->mRow >= 0 && plant->mRow < 6)
+            torchwoodRows[plant->mRow] = true;
+    }
+    if (waiting >= waitingLimit || planted >= boardLimit) return 0;
+    bool legal = false;
+    if (seed == SEED_TORCHWOOD)
+    {
+        // Fire peas do not gain another multiplier from a second Torchwood.
+        // Reserve pending packets against genuinely unserved, plantable lanes.
+        int demand = 0;
+        for (int row = 0; row < 6; ++row)
+        {
+            if (torchwoodRows[row]) continue;
+            for (int col = 0; col < 9; ++col)
+                if (board.CanPlantAt(col,row,seed) == PLANTING_OK) { ++demand; break; }
+        }
+        if (waiting >= demand) return 0;
+        legal = true;
+    }
+    for (int row = 0; row < 6 && !legal; ++row)
+        for (int col = 0; col < 9 && !legal; ++col)
+            legal = board.CanPlantAt(col,row,seed) == PLANTING_OK;
+    if (!legal) return 0;
+    int weight = std::max(1,base/(1+planted/3));
+    if (waiting > 0) weight = std::max(1,weight/(waiting+1));
+    if (board.mChallenge->mLastConveyorSeedType == seed) weight = std::max(1,weight/2);
+    return weight;
+}
+void MigrateLegacy(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (!IsMode(board.mApp->mGameMode)) return;
+    if (challenge.mChallengeGridY == kRulesVersion) return;
+    const int waiting = WaitingPackets(*board.mSeedBank);
+    bool outsideEntry = false;
+    const int entryX = board.mSeedBank->mSeedPackets[0].mX+515;
+    for (int i = 0; i < waiting; ++i)
+    {
+        const SeedPacket& packet = board.mSeedBank->mSeedPackets[i];
+        outsideEntry |= packet.mX+packet.mOffsetX > entryX;
+    }
+    // Repair only the legacy over-spaced backlog. Every accepted type and
+    // order stays intact, as do all board actors, health, mowers and records.
+    if (outsideEntry)
+        for (int i = 0; i < waiting; ++i) board.mSeedBank->mSeedPackets[i].mOffsetX = 0;
+    const std::uint32_t legacySeed = SeedBits(board.mBoardRandSeed) ^
+        static_cast<std::uint32_t>(challenge.mSurvivalStage)*0x9e3779b9u ^
+        static_cast<std::uint32_t>(challenge.mChallengeScore)*0x85ebca6bu;
+    Sexy::MTRand random(legacySeed);
+    StoreSeed(challenge,static_cast<std::uint32_t>(random.Next()));
+    challenge.mChallengeGridY = kRulesVersion;
+    if (board.mCurrentWave > 0 && board.mZombieHealthToNextWave < 0)
+    {
+        board.mZombieHealthWaveStart = board.TotalZombiesHealthInWave(board.mCurrentWave-1);
+        board.mZombieHealthToNextWave = static_cast<int>(board.mZombieHealthWaveStart*0.55f);
+    }
+}
