+static void DrawCompactSpeedStoneButton(Graphics* g, int x, int y, int theWidth, int theHeight, bool isDown, bool isHighLighted, const std::string& theLabel)
+{
+	Graphics aButtonGraphics(*g);
+	aButtonGraphics.ClipRect(x, y, theWidth, theHeight);
+	g = &aButtonGraphics;
+	Image* aLeftImage = isDown ? Sexy::IMAGE_BUTTON_DOWN_LEFT : Sexy::IMAGE_BUTTON_LEFT;
+	Image* aRightImage = isDown ? Sexy::IMAGE_BUTTON_DOWN_RIGHT : Sexy::IMAGE_BUTTON_RIGHT;
+	const int aLeftWidth = 22;
+	const int aRightWidth = 23;
+	const int aPressOffset = isDown ? 1 : 0;
+	// Preserve the original outer stone caps at native size. The full 71px
+	// pair cannot fit the speed control's share of the original Menu strip.
+	g->DrawImage(aLeftImage, x + aPressOffset, y, Rect(0, 0, aLeftWidth, aLeftImage->mHeight));
+	g->DrawImage(aRightImage, x + aPressOffset + aLeftWidth, y,
+		Rect(aRightImage->mWidth - aRightWidth, 0, aRightWidth, aRightImage->mHeight));
+	g->SetFont(isHighLighted ? Sexy::FONT_DWARVENTODCRAFT18BRIGHTGREENINSET : Sexy::FONT_DWARVENTODCRAFT18GREENINSET);
+	const int aFontX = x + aPressOffset + (theWidth - Sexy::FONT_DWARVENTODCRAFT18GREENINSET->StringWidth(theLabel)) / 2 + 1;
+	const int aFontY = y + aPressOffset + (theHeight - Sexy::FONT_DWARVENTODCRAFT18GREENINSET->GetAscent() / 6 - 1 + Sexy::FONT_DWARVENTODCRAFT18GREENINSET->GetAscent()) / 2 - 4;
+	g->SetColor(Color::White);
+	g->DrawString(theLabel, aFontX, aFontY);
+}
