diff --git a/src/Lawn/System/ZomBotanyWhack.cpp b/src/Lawn/System/ZomBotanyWhack.cpp
new file mode 100644
index 0000000..26289c3
--- /dev/null
+++ b/src/Lawn/System/ZomBotanyWhack.cpp
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "ZomBotanyWhack.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../GridItem.h"
+#include "../Plant.h"
+#include "../SeedPacket.h"
+#include "../Zombie.h"
+#include "../../LawnApp.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "../../PvzpLib/PvzpFoley.h"
+#include <algorithm>
+#include <array>
+
+namespace ZomBotanyWhack
+{
+namespace
+{
+constexpr auto puff = ZOMBIE_PUFF_HEAD, pea = ZOMBIE_PEA_HEAD, wall = ZOMBIE_WALLNUT_HEAD;
+constexpr auto pepper = ZOMBIE_JALAPENO_HEAD, tall = ZOMBIE_TALLNUT_HEAD;
+constexpr std::array heads = {puff, pea, wall, pepper, tall};
+constexpr std::array packets = {SEED_POTATOMINE, SEED_GRAVEBUSTER, SEED_ICESHROOM};
+
+struct Visit {
+    ZombieType first, second = ZOMBIE_INVALID, third = ZOMBIE_INVALID;
+};
+// The first appearance of each shell gets an uncluttered grave. Later pepper
+// pairs reward watching the other graves in the same row before swinging.
+constexpr Visit visits[kWaves - 1][3] = {
+    {{puff}, {pea}, {puff}},
+    {{wall}, {puff}, {pea, puff}},
+    {{pea, puff}, {wall}, {puff, wall}},
+    {{pepper, wall}, {pea}, {puff, pea}},
+    {{wall, pea}, {pepper, wall}, {puff, wall}},
+    {{tall}, {puff, pea}, {pepper, wall}},
+    {{wall, puff}, {pepper, tall}, {pea, pea}},
+    {{tall, pea}, {puff, wall}, {pepper, wall, puff}},
+    {{puff, pea, wall}, {tall, puff}, {pepper, tall}},
+    {{pepper, wall, pea}, {tall, wall}, {puff, pea, puff}},
+    {{tall, puff, pea}, {pepper, tall, wall}, {pea, wall, puff}},
+};
+constexpr std::array finalHeads = {pepper, tall, pea, wall, puff, pepper, tall, wall, pea, puff};
+
+// Draw without replacement from the actual graves. Grave Busters immediately
+// take their tombstone out of play, including during the final wave.
+void Rise(Board& board, const ZombieType* types, int count)
+{
+    std::array<GridItem*, MAX_GRAVE_STONES> graves;
+    std::array<int, 5> rowCounts{};
+    int remaining = 0;
+    for (GridItem* grave : board.mGridItems) {
+        if (grave->mDead || grave->mGridItemType != GRIDITEM_GRAVESTONE ||
+            grave->mGridY < 0 || grave->mGridY >= 5 || remaining == MAX_GRAVE_STONES) continue;
+        Plant* plant = board.GetTopPlantAt(grave->mGridX, grave->mGridY, TOPPLANT_ONLY_NORMAL_POSITION);
+        if (plant && plant->mSeedType == SEED_GRAVEBUSTER) continue;
+        graves[remaining++] = grave;
+        ++rowCounts[grave->mGridY];
+    }
+
+    int pepperRow = -1;
+    for (int i = 0; i < count && remaining > 0 && types[i] != ZOMBIE_INVALID; ++i) {
+        const bool startsPair = types[i] == pepper && i + 1 < count && types[i + 1] != ZOMBIE_INVALID;
+        std::array<int, MAX_GRAVE_STONES> preferred;
+        int choices = 0;
+        for (int g = 0; g < remaining; ++g) {
+            int row = graves[g]->mGridY;
+            if ((startsPair && rowCounts[row] > 1) || (!startsPair && row == pepperRow))
+                preferred[choices++] = g;
+        }
+        const int pick = choices ? preferred[RandRangeInt(0, choices - 1)] : RandRangeInt(0, remaining - 1);
+        GridItem* grave = graves[pick];
+        graves[pick] = graves[--remaining];
+        const int row = grave->mGridY;
+        --rowCounts[row];
+        pepperRow = startsPair ? row : -1;
+        Zombie* zombie = board.AddZombieInRow(types[i], row, board.mCurrentWave);
+        if (!zombie) break;
+        zombie->RiseFromGrave(grave->mGridX, row);
+        zombie->mPhaseCounter = 50;
+        const float pace = 0.9f + 0.085f * board.mCurrentWave;
+        zombie->mVelX = RandRangeFloat(0.75f, pace);
+        zombie->UpdateAnimSpeed();
+    }
+}
+}
+
+bool IsHead(ZombieType type)
+{
+    return std::find(heads.begin(), heads.end(), type) != heads.end();
+}
+
+void ConfigureWaves(Board& board)
+{
+    // Whack's grave clock owns the visits. The normal wave picker must not
+    // budget a flag zombie or put an unrelated zombie in the preview.
+    for (auto& wave : board.mZombiesInWave)
+        std::fill(std::begin(wave), std::end(wave), ZOMBIE_INVALID);
+    board.mNumWaves = kWaves;
+    for (int w = 0; w < kWaves - 1; ++w) {
+        int slot = 0;
+        for (const Visit& v : visits[w])
+            for (const auto type : {v.first, v.second, v.third})
+                if (type != ZOMBIE_INVALID) board.mZombiesInWave[w][slot++] = type;
+    }
+    std::copy(finalHeads.begin(), finalHeads.end(), board.mZombiesInWave[kWaves - 1]);
+}
+
+void SpawnVisit(Board& board)
+{
+    auto& challenge = *board.mChallenge;
+    if (board.mCurrentWave == kWaves) {
+        Rise(board, finalHeads.data(), static_cast<int>(finalHeads.size()));
+        board.mZombieCountDown = 0;
+        challenge.mChallengeStateCounter = 0;
+        return;
+    }
+    const Visit& visit = visits[board.mCurrentWave - 1][challenge.mChallengeScore];
+    std::array types = {visit.first, visit.second, visit.third};
+    Rise(board, types.data(), static_cast<int>(types.size()));
+    challenge.mChallengeScore = (challenge.mChallengeScore + 1) % 3;
+    const int delay = 200 - 6 * board.mCurrentWave;
+    challenge.mChallengeStateCounter = RandRangeInt(delay - 18, delay + 18);
+}
+
+void Preload()
+{
+    for (const auto head : heads) Zombie::PreloadZombieResources(head);
+    for (const auto seed : {SEED_PUFFSHROOM, SEED_PEASHOOTER, SEED_WALLNUT, SEED_TALLNUT, SEED_JALAPENO})
+        Plant::PreloadPlantResources(seed);
+}
+
+void Strike(Zombie& target, int x, int y)
+{
+    Board& board = *target.mBoard;
+    board.mApp->PlayFoley(FOLEY_BONK);
+    board.mApp->AddPvzpParticle(x - 3, y + 9, RENDER_LAYER_ABOVE_UI, PARTICLE_POW);
+    if (target.mHelmHealth > 900) {
+        target.TakeHelmDamage(900, 0);
+        return;
+    }
+    if (target.mZombieType == pepper) {
+        board.mApp->PlayFoley(FOLEY_JALAPENO_IGNITE);
+        board.DoFwoosh(target.mRow);
+        board.ShakeBoard(3, -4);
+        target.BurnRow(target.mRow);
+        // A partially emerged head can be outside the native blast's hit range.
+        if (!target.IsDeadOrDying() && !target.mDead) target.DieWithLoot();
+    } else {
+        target.DieWithLoot();
+    }
+    board.ClearCursor();
+}
+
+bool ValidSave(const Board& board)
+{
+    if (!board.mChallenge || !board.mSeedBank || board.mBackground != BACKGROUND_2_NIGHT ||
+        board.mNumWaves != kWaves || board.mCurrentWave < 0 || board.mCurrentWave > kWaves ||
+        board.mChallenge->mChallengeScore < 0 || board.mChallenge->mChallengeScore > 2 ||
+        board.mChallenge->mChallengeState != STATECHALLENGE_NORMAL || board.mSeedBank->mNumPackets != 3)
+        return false;
+    for (size_t i = 0; i < packets.size(); ++i)
+        if (board.mSeedBank->mSeedPackets[i].mPacketType != packets[i]) return false;
+    for (const Zombie* zombie : board.mZombies)
+        if (!zombie->mDead && (!IsHead(zombie->mZombieType) || zombie->mRow < 0 || zombie->mRow >= 5)) return false;
+    return true;
+}
+}
