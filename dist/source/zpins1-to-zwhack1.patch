+Image* ChallengeScreen::GetWhackASproutImage()
+{
+	if (mWhackASproutImage) return mWhackASproutImage.get();
+	auto* cache = mApp->mReanimatorCache.get();
+	if (!cache || !Sexy::IMAGE_TOMBSTONES || !Sexy::IMAGE_TOMBSTONE_MOUNDS) return nullptr;
+	const std::string group = "DelayLoad_Background2";
+	if (std::find(mLoadedResourceNames.begin(), mLoadedResourceNames.end(), group) == mLoadedResourceNames.end())
+	{
+		if (!PvzpLoadResources(group.c_str())) return nullptr;
+		mLoadedResourceNames.push_back(group);
+	}
+	if (!Sexy::IMAGE_BACKGROUND2) return nullptr;
+
+	auto puff = cache->MakeCachedZombieFrame(ZOMBIE_PUFF_HEAD);
+	if (!puff) return nullptr;
+	auto mallet = cache->MakeBlankMemoryImage(140, 140);
+	Graphics tool(mallet.get());
+	tool.SetLinearBlend(true);
+	ReanimatorEnsureDefinitionLoaded(REANIM_HAMMER, true);
+	Reanimation swing;
+	swing.ReanimationInitializeType(12, 58, REANIM_HAMMER);
+	swing.SetFramesForLayer("anim_whack_zombie");
+	swing.mAnimTime = .4f;
+	swing.Draw(&tool);
+
+	auto card = cache->MakeBlankMemoryImage(80, 65);
+	Graphics picture(card.get());
+	picture.SetLinearBlend(true);
+	picture.SetColor(Color::Black);
+	picture.FillRect(0, 0, 80, 65);
+	picture.DrawImage(Sexy::IMAGE_BACKGROUND2, Rect(0, 0, 80, 65), Rect(484, 28, 240, 195));
+	const Rect stone = Sexy::IMAGE_TOMBSTONES->GetCelRect(0, 3);
+	const Rect grave(1, 31, 34, 32);
+	picture.DrawImage(Sexy::IMAGE_TOMBSTONES, grave, stone);
+	picture.DrawImage(Sexy::IMAGE_TOMBSTONE_MOUNDS, grave, stone);
+	// The grave's disturbed earth hides the lower body while the hammer swings down.
+	Graphics rising(picture);
+	rising.ClipRect(0, 0, 80, 59);
+	DrawFittedCardSprite(rising, *puff, 39, 104, 58, 84);
+	picture.DrawImage(Sexy::IMAGE_TOMBSTONE_MOUNDS, Rect(19, 22, 46, 40), stone);
+	DrawFittedCardSprite(picture, *mallet, 59, 35, 39, 31);
+	mWhackASproutImage = std::move(card);
+	return mWhackASproutImage.get();
+}
