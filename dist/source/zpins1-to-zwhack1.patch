@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include "../../ConstEnums.h"
+
+class Board;
+class Zombie;
+
+namespace ZomBotanyWhack
+{
+constexpr GameMode kMode = GAMEMODE_CHALLENGE_ZOMBOTANY_WHACK;
+constexpr int kRecord = static_cast<int>(kMode) - GAMEMODE_SURVIVAL_NORMAL_STAGE_1;
+constexpr int kWaves = 12;
+constexpr int kWaveTime = 1300;
+static_assert(kRecord == 104);
+
+bool IsHead(ZombieType type);
+void ConfigureWaves(Board& board);
+void SpawnVisit(Board& board);
+void Preload();
+void Strike(Zombie& target, int x, int y);
+bool ValidSave(const Board& board);
+}
