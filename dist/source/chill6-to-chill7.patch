+constexpr FrostTuft GetFrostTuft(int glow, int index)
+{
+    FrostTuft tuft;
+    if (index < 0 || index >= 12 || glow <= 0) return tuft;
+    const int age = kPulseFrames - std::clamp(glow, 0, kPulseFrames);
