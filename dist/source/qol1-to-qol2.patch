+// Capture actual bank order, including the plant copied by Imitater.
+std::vector<DeckPresetSeed> SeedChooserScreen::CurrentDeckPreset()
+{
+    std::vector<DeckPresetSeed> result;
+    for (int i = 0; i < mBoard->mSeedBank->mNumPackets; ++i)
+    {
+        const SeedType type = FindSeedInBank(i);
+        if (type != SEED_NONE)
+            result.push_back({static_cast<int>(type), static_cast<int>(mChosenSeeds[type].mImitaterType)});
+    }
+    return result;
+}
+
+bool SeedChooserScreen::DeckSeedAvailable(const DeckPresetSeed& seed)
+{
+    if (!DeckPresets::ValidSeed(seed)) return false;
+    const SeedType type = static_cast<SeedType>(seed.mSeed);
+    if (!mApp->HasSeedType(type) || SeedNotAllowedToPick(type) || SeedNotAllowedDuringTrial(type)) return false;
+    if (type == SEED_IMITATER)
+    {
+        const SeedType copied = static_cast<SeedType>(seed.mImitater);
+        if (!mApp->HasSeedType(copied) || SeedNotAllowedToPick(copied) || SeedNotAllowedDuringTrial(copied)) return false;
+    }
+    return true;
+}
+
+DeckSelectionPlan SeedChooserScreen::ApplyDeckPreset(const std::vector<DeckPresetSeed>& seeds)
+{
+    DeckSelectionPlan blocked;
+    if (!DeckPresets::ValidSeeds(seeds) || seeds.empty() || mChooseState != CHOOSE_NORMAL ||
+        mBoard->HasConveyorBeltSeedBank() || mSeedsInFlight > 0) return blocked;
+    std::vector<DeckPresetSeed> forced;
+    for (const auto& seed : CurrentDeckPreset())
+        if (mChosenSeeds[seed.mSeed].mCrazyDavePicked ||
+            (mApp->mGameMode == GAMEMODE_CHALLENGE_SEEING_STARS && seed.mSeed == SEED_STARFRUIT)) forced.push_back(seed);
+    const auto plan = PlanDeckSelection(seeds, forced, mBoard->mSeedBank->mNumPackets,
+        [this](const DeckPresetSeed& seed) { return DeckSeedAvailable(seed); });
+    // Use the same selection/removal paths as ordinary clicks, finishing each
+    // flight before the next operation so bank indexes and counts stay valid.
+    for (int i = mSeedsInBank - 1; i >= 0; --i)
+    {
+        const SeedType type = FindSeedInBank(i);
+        if (type == SEED_NONE || mChosenSeeds[type].mCrazyDavePicked ||
+            (mApp->mGameMode == GAMEMODE_CHALLENGE_SEEING_STARS && type == SEED_STARFRUIT)) continue;
+        ClickedSeedInBank(mChosenSeeds[type]);
+        for (int k = 0; k < NUM_SEEDS_IN_CHOOSER; ++k) LandFlyingSeed(mChosenSeeds[k]);
+    }
+    for (const auto& seed : plan.mSeeds)
+    {
+        auto& chosen = mChosenSeeds[seed.mSeed];
+        if (chosen.mSeedState == SEED_IN_BANK) continue;
+        if (seed.mSeed == SEED_IMITATER)
+        {
+            chosen.mSeedState = SEED_IN_CHOOSER;
+            chosen.mImitaterType = static_cast<SeedType>(seed.mImitater);
+            chosen.mX = mImitaterButton->mX; chosen.mY = mImitaterButton->mY;
+        }
+        if (chosen.mSeedState != SEED_IN_CHOOSER) continue;
+        ClickedSeedInChooser(chosen);
+        LandFlyingSeed(chosen);
+    }
+    UpdateImitaterButton();
+    EnableStartButton(mSeedsInBank == mBoard->mSeedBank->mNumPackets);
+    RemoveToolTip();
+    return plan;
+}
