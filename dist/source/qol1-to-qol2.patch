+bool LawnApp::HandleQoLKey(KeyCode theKey)
+{
+	if (!mBoard || mGameScene != GameScenes::SCENE_PLAYING || mBoard->mPaused ||
+		GetDialogCount() > 0 || mSeedChooserScreen || mBoard->mBoardFadeOutCounter >= 0 ||
+		mCrazyDaveState != CrazyDaveState::CRAZY_DAVE_OFF || mBoard->mLevelComplete ||
+		mBoard->mTimeStopCounter > 0 || !mActive || mMinimized)
+		return false;
+	if (mWidgetManager->mKeyDown[KEYCODE_CONTROL] || mWidgetManager->mKeyDown[KEYCODE_MENU] ||
+		mWidgetManager->mKeyDown[KEYCODE_LWIN] || mWidgetManager->mKeyDown[KEYCODE_RWIN])
+		return false;
+	const int aKey = static_cast<int>(theKey);
+	const auto& aSettings = GetQoLSettings();
+	int aAction = -1;
+	for (int i = 0; i < QoLSettings::HOTKEY_COUNT; i++)
+		if (aKey != 0 && aSettings.mHotkeys[i] == aKey) { aAction = i; break; }
+	if (aAction < 0 || aKey < 0 || aKey >= static_cast<int>(mQoLKeysDown.size()))
+		return false;
+	if (mQoLKeysDown[aKey]) return true; // Ignore key-repeat until a real key-up.
+	mQoLKeysDown[aKey] = true;
+	if (aAction == QoLSettings::SPEED_ACTION)
+	{
+		if (IsGameSpeedButtonVisible()) ToggleGameSpeed();
+		return true;
+	}
+	const CursorType aCursor = mBoard->mCursorObject->mCursorType;
+	if (aCursor != CursorType::CURSOR_TYPE_NORMAL && aCursor != CursorType::CURSOR_TYPE_PLANT_FROM_BANK &&
+		aCursor != CursorType::CURSOR_TYPE_SHOVEL)
+		return true;
+	if (aAction == QoLSettings::SHOVEL_ACTION)
+	{
+		if (mBoard->mShowShovel)
+		{
+			mBoard->RefreshSeedPacketFromCursor();
+			if (aCursor != CursorType::CURSOR_TYPE_SHOVEL) mBoard->PickUpTool(GameObjectType::OBJECT_TYPE_SHOVEL);
+			mBoard->UpdateCursor();
+		}
+		return true;
+	}
+	if (aAction >= mBoard->mSeedBank->mNumPackets)
+		return true;
+	const bool aSamePacket = aCursor == CursorType::CURSOR_TYPE_PLANT_FROM_BANK &&
+		mBoard->mCursorObject->mSeedBankIndex == aAction;
+	mBoard->RefreshSeedPacketFromCursor();
+	if (!aSamePacket)
+		mBoard->mSeedBank->mSeedPackets[aAction].MouseDown(0, 0, 1);
+	mBoard->UpdateCursor();
+	return true;
+}
