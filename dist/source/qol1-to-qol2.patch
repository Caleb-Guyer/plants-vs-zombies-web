+#include <emscripten.h>
+#endif
+
+using namespace Sexy;
+
+static int QoLStoneButtonWidth(int theDesiredWidth, int theTextWidth, int theCaps, int theTile)
+{
+	theTile = std::max(1, theTile);
+	int aWidth = theCaps + std::max(0, (theDesiredWidth - theCaps) / theTile) * theTile;
+	while (aWidth < theTextWidth + 12) aWidth += theTile;
+	return aWidth;
+}
+
+
+enum { QOL_AUTO_PAUSE = 30, QOL_REMEMBER_SPEED, QOL_COOLDOWNS,
+	QOL_CONTROLS, QOL_BACKUPS, QOL_DEFAULTS, QOL_BACK };
+
+QoLDialog::QoLDialog(LawnApp* theApp) : LawnDialog(theApp, QOL_DIALOG_ID,
+	true, "Quality of Life", "", "", Dialog::BUTTONS_NONE)
+{
+	auto& aSettings = mApp->GetQoLSettings();
+	mAutoPauseCheckbox = MakeNewCheckbox(QOL_AUTO_PAUSE, this, aSettings.mAutoPause);
+	mRememberSpeedCheckbox = MakeNewCheckbox(QOL_REMEMBER_SPEED, this, aSettings.mRememberSpeed);
+	mCooldownCheckbox = MakeNewCheckbox(QOL_COOLDOWNS, this, aSettings.mShowCooldownNumbers);
+	mControlsButton = MakeButton(QOL_CONTROLS, this, "Keyboard Controls");
+	mBackupsButton = MakeButton(QOL_BACKUPS, this, "Save Backups");
+	mDefaultsButton = MakeButton(QOL_DEFAULTS, this, "Reset Controls");
+	mBackButton = MakeButton(QOL_BACK, this, "Back");
+	for (int i = 0; i < 12; i++)
+		mKeyButtons[i] = MakeButton(i, this, "");
+	mApp->CenterDialog(this, 640, 555);
+	RefreshPage();
+}
+
+QoLDialog::~QoLDialog() = default;
+
+void QoLDialog::AddedToManager(WidgetManager* theManager)
+{
+	LawnDialog::AddedToManager(theManager);
+	for (auto& aButton : mKeyButtons) AddWidget(aButton.get());
+	AddWidget(mControlsButton.get()); AddWidget(mBackupsButton.get());
+	AddWidget(mDefaultsButton.get()); AddWidget(mBackButton.get());
+	AddWidget(mAutoPauseCheckbox.get()); AddWidget(mRememberSpeedCheckbox.get());
+	AddWidget(mCooldownCheckbox.get());
+}
+
+void QoLDialog::RemovedFromManager(WidgetManager* theManager)
+{
+	for (auto& aButton : mKeyButtons) RemoveWidget(aButton.get());
+	RemoveWidget(mControlsButton.get()); RemoveWidget(mBackupsButton.get());
+	RemoveWidget(mDefaultsButton.get()); RemoveWidget(mBackButton.get());
+	RemoveWidget(mAutoPauseCheckbox.get()); RemoveWidget(mRememberSpeedCheckbox.get());
+	RemoveWidget(mCooldownCheckbox.get());
+	LawnDialog::RemovedFromManager(theManager);
+}
+
+void QoLDialog::Resize(int x, int y, int width, int height)
+{
+	LawnDialog::Resize(x, y, width, height);
+	if (!mBackButton) return; // Base construction sizes before child creation.
+	mAutoPauseCheckbox->Resize(466, 130, 46, 45);
+	mRememberSpeedCheckbox->Resize(466, 178, 46, 45);
+	mCooldownCheckbox->Resize(466, 226, 46, 45);
+	const int aCaps = IMAGE_BUTTON_LEFT->mWidth + IMAGE_BUTTON_RIGHT->mWidth;
+	const int aTile = IMAGE_BUTTON_MIDDLE->mWidth;
+	auto aPlace = [&](LawnStoneButton* theButton, int theX, int theY, int theWidth)
+	{
+		const int aText = FONT_DWARVENTODCRAFT18GREENINSET->StringWidth(theButton->mLabel);
+		const int aWidth = QoLStoneButtonWidth(theWidth, aText, aCaps, aTile);
+		theButton->Resize(theX + (theWidth - aWidth) / 2, theY, aWidth, 46);
+	};
+	aPlace(mControlsButton.get(), 112, 292, 416);
+	aPlace(mBackupsButton.get(), 112, 344, 416);
+	for (int i = 0; i < 12; i++)
+		aPlace(mKeyButtons[i].get(), 54 + (i / 6) * 274, 136 + (i % 6) * 47, 252);
+	aPlace(mDefaultsButton.get(), 54, 425, 252);
+	aPlace(mBackButton.get(), mControlsPage ? 328 : 112, 425, mControlsPage ? 252 : 416);
+}
+
+void QoLDialog::RefreshPage()
+{
+	mDialogHeader = mControlsPage ? "Keyboard Controls" : "Quality of Life";
+	mAutoPauseCheckbox->SetVisible(!mControlsPage);
+	mRememberSpeedCheckbox->SetVisible(!mControlsPage);
+	mCooldownCheckbox->SetVisible(!mControlsPage);
+	mControlsButton->SetVisible(!mControlsPage);
+	mBackupsButton->SetVisible(!mControlsPage);
+	mDefaultsButton->SetVisible(mControlsPage);
+	const auto& aSettings = mApp->GetQoLSettings();
+	for (int i = 0; i < 12; i++)
+	{
+		mKeyButtons[i]->SetVisible(mControlsPage);
+		mKeyButtons[i]->SetLabel(mCapturing == i ? "Press a key..." :
+			QoLSettings::ActionName(i) + ": " + QoLSettings::KeyName(aSettings.mHotkeys[i]));
+	}
+	Resize(mX, mY, mWidth, mHeight);
+	MarkDirty();
+}
+
+void QoLDialog::Persist()
+{
+	mStatus = mApp->SaveQoLSettings() ? "" : "Settings could not be saved. Your existing file was kept.";
+	RefreshPage();
+}
+
+void QoLDialog::Draw(Graphics* g)
+{
+	LawnDialog::Draw(g);
+	const Color aColor(224, 187, 98);
+	if (!mControlsPage)
+	{
+		PvzpDrawString(g, "Pause when leaving the game", 100, 157,
+			FONT_DWARVENTODCRAFT18, aColor, DrawStringJustification::DS_ALIGN_LEFT);
+		PvzpDrawString(g, "Remember gameplay speed", 100, 205,
+			FONT_DWARVENTODCRAFT18, aColor, DrawStringJustification::DS_ALIGN_LEFT);
+		PvzpDrawString(g, "Show cooldown numbers", 100, 253,
+			FONT_DWARVENTODCRAFT18, aColor, DrawStringJustification::DS_ALIGN_LEFT);
+	}
+	else
+	{
+		PvzpDrawString(g, "Letters, numbers or arrows. Space and Esc stay unchanged.", mWidth / 2, 121,
+			FONT_DWARVENTODCRAFT12, aColor, DrawStringJustification::DS_ALIGN_CENTER);
+		PvzpDrawString(g, mCapturing >= 0 ? "Press Backspace/Delete to clear, or Esc to cancel." :
+			"Click a control to change its key.", mWidth / 2, 503,
+			FONT_DWARVENTODCRAFT12, aColor, DrawStringJustification::DS_ALIGN_CENTER);
+	}
+	if (!mStatus.empty())
+		PvzpDrawString(g, mStatus, mWidth / 2, mControlsPage ? 526 : 503,
+			FONT_DWARVENTODCRAFT12, aColor, DrawStringJustification::DS_ALIGN_CENTER);
+}
+
+void QoLDialog::CheckboxChecked(int theId, bool checked)
+{
+	auto& aSettings = mApp->GetQoLSettings();
+	if (theId == QOL_AUTO_PAUSE) aSettings.mAutoPause = checked;
+	if (theId == QOL_REMEMBER_SPEED)
+	{
+		aSettings.mRememberSpeed = checked;
+		if (checked) aSettings.mPreferredDoubleSpeed = mApp->mDoubleGameSpeed;
+	}
+	if (theId == QOL_COOLDOWNS) aSettings.mShowCooldownNumbers = checked;
+	mApp->PlaySample(SOUND_BUTTONCLICK);
+	Persist();
+}
+
+void QoLDialog::ButtonDepress(int theId)
+{
+	if (theId >= 0 && theId < 12 && mControlsPage)
+	{
+		mCapturing = theId;
+		mStatus.clear();
+		RefreshPage();
+	}
+	else if (theId == QOL_CONTROLS)
+	{
+		mControlsPage = true; mCapturing = -1; mStatus.clear(); RefreshPage();
+	}
+	else if (theId == QOL_BACKUPS)
+	{
+#ifdef __EMSCRIPTEN__
+		EM_ASM({ if (window.PVZSaveRecovery) window.PVZSaveRecovery.open(); });
+#else
+		mStatus = "Browser save backups are available in the web version."; RefreshPage();
+#endif
+	}
+	else if (theId == QOL_DEFAULTS)
+	{
+		mApp->GetQoLSettings().ResetHotkeys(); mCapturing = -1; Persist();
+	}
+	else if (theId == QOL_BACK)
+	{
+		if (mControlsPage) { mControlsPage = false; mCapturing = -1; mStatus.clear(); RefreshPage(); }
+		else
+		{
+			mApp->KillDialog(QOL_DIALOG_ID);
+			if (auto* aOptions = mApp->GetDialog(Dialogs::DIALOG_NEWOPTIONS))
+				mApp->mWidgetManager->SetFocus(aOptions);
+		}
+	}
+}
+
+void QoLDialog::KeyDown(KeyCode theKey)
+{
+	if (mCapturing >= 0)
+	{
+		if (theKey == KEYCODE_ESCAPE) { mCapturing = -1; mStatus.clear(); RefreshPage(); return; }
+		const int aKey = theKey == KEYCODE_BACK || theKey == KEYCODE_DELETE ? 0 : static_cast<int>(theKey);
+		if (!QoLSettings::IsBindable(aKey))
+			mStatus = "Use a letter, number or arrow key.";
+		else if (!mApp->GetQoLSettings().SetBinding(mCapturing, aKey))
+			mStatus = "That key is already used by another control.";
+		else { mCapturing = -1; Persist(); return; }
+		RefreshPage();
+	}
+	else if (theKey == KEYCODE_ESCAPE) ButtonDepress(QOL_BACK);
+}
