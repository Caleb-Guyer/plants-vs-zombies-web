+	std::array<int, HOTKEY_COUNT> mHotkeys{};
+
+	QoLSettings();
+	void ResetHotkeys();
+	bool SetBinding(int theAction, int theKey);
+	bool Decode(std::string_view theText);
+	std::string Encode() const;
+	static bool IsBindable(int theKey);
+	static std::string KeyName(int theKey);
+	static std::string ActionName(int theAction);
+};
+
+#endif
