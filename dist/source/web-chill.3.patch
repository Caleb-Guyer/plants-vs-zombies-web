+bool LawnApp::HasFinishedAdventure()
+{
+	return mPlayerInfo && mPlayerInfo->mFinishedAdventure > 0;
+}
+
+bool LawnApp::IsFirstTimeAdventureMode()
+{
+	return IsAdventureMode() && !HasFinishedAdventure();
+}
