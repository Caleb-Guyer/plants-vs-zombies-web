-				}
-			}
-		}
-
-		// Spend the remaining zombie points on random zombies
-		while (aZombiePoints > 0 && aZombiePicker.mZombieCount < MAX_ZOMBIES_IN_WAVE)
-		{
-			ZombieType aZombieType = PickZombieType(aZombiePoints, aWave, &aZombiePicker);
