+	//  stealing it away for ourselves
+	if (!mIsOpeningURL)
+	{
+	}
+	else
+	{
+	}
+
+	if (mSoundManager!=nullptr)
+	{
+	}
+
+	mLastTime = SDL_GetTicks();
