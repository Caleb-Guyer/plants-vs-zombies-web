+	mRefreshRate = 60;
+	mMillisecondsPerFrame = 1000 / mRefreshRate;
+	mNextCursorX = mNextCursorY = 0;
+	mCursorX = mCursorY = 0;
+
+	gVertexMode  = (GLenum)-1;
+	gNumVertices = 0;
