+	// Must die before the definition tables and allocators are freed below.
+	mGameSelector.reset();
+	mEffectSystem.reset();
+	mReanimatorCache.reset();
+
+	FilterEffectDisposeForApp();
+	PvzpParticleFreeDefinitions();
+	ReanimatorFreeDefinitions();
