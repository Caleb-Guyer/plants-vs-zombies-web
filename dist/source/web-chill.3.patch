+
+	if (mCrazyDaveState != CrazyDaveState::CRAZY_DAVE_OFF)
+		return false;
+
+	if (mGameMode == GameMode::GAMEMODE_CHALLENGE_ZEN_GARDEN || mGameMode == GameMode::GAMEMODE_TREE_OF_WISDOM)
+		return false;
+
+	return GetDialogCount() <= 0;
