+	DBG_ASSERTE((theColor.mRed >= 0) && (theColor.mRed <= 255));
+	DBG_ASSERTE((theColor.mGreen >= 0) && (theColor.mGreen <= 255));
+	DBG_ASSERTE((theColor.mBlue >= 0) && (theColor.mBlue <= 255));
+	DBG_ASSERTE((theColor.mAlpha >= 0) && (theColor.mAlpha <= 255));
+
+	CommitBits();
