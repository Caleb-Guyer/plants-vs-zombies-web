-		AnimateGarlic();
-	}
-	else if (mSeedType == SeedType::SEED_PUMPKINSHELL)
-	{
-		AnimatePumpkin();
-	}
-
-	UpdateBlink();
-
-	if (mAnimPing)
-	{
-		if (mAnimCounter < mFrameLength * mNumFrames - 1)
-		{
-			mAnimCounter++;
-		}
-		else
-		{
-			mAnimPing = false;
