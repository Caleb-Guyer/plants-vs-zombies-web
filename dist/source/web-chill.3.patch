+	else if (mPlantHealth < mPlantMaxHealth * 2 / 3)
+	{
+		if (aImageOverride != IMAGE_REANIM_GARLIC_BODY2)
+		{
+			aBodyReanim->SetImageOverride("anim_face", IMAGE_REANIM_GARLIC_BODY2);
+		}
+	}
+	else
+	{
+		aBodyReanim->SetImageOverride("anim_face", nullptr);
+	}
+}
