+		uint32_t rc = ((theColor.mRed * theColor.mAlpha) / 255);
+		uint32_t gc = ((theColor.mGreen * theColor.mAlpha) / 255);
+		uint32_t bc = ((theColor.mBlue * theColor.mAlpha) / 255);
+
+		double dv = theEndY - theStartY;
+		double dh = theEndX - theStartX;
