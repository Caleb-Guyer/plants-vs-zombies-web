+void SexyAppBase::PlaySample(intptr_t theSoundNum, int thePan)
+{
+	if (!mSoundManager)
+		return;
+
+	SoundInstance* aSoundInstance = mSoundManager->GetSoundInstance(theSoundNum);
+	if (aSoundInstance != nullptr)
