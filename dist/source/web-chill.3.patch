+		return false;
+	}
+
+	if ((mRecordingDemoBuffer) && IsOnPrimaryThread())
+	{
+		WriteDemoTimingBlock();
+		mDemoBuffer.WriteNumBits(0, 1);
+		mDemoBuffer.WriteNumBits(DEMO_REGISTRY_ERASE, 5);
+		mDemoBuffer.WriteNumBits(1, 1); // success
+	}
+
+	return true;
+}
