-		mBeghouledFlashCountdown--;
-	}
-
-	if (mSquished)
-	{
-		mFrame = 0;
-		return;
-	}
-
-	if (mSeedType == SeedType::SEED_WALLNUT || mSeedType == SeedType::SEED_TALLNUT)
-	{
-		AnimateNuts();
-	}
-	else if (mSeedType == SeedType::SEED_GARLIC)
