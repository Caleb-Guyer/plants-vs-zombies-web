+	}
+
+	if (theZombieType == ZombieType::ZOMBIE_YETI) {
+		if (mApp->IsAdventureMode() && mLevel == 40 && theFromWave >= 0)
+			ReportAchievement::GiveAchievement(mApp, Zombologist, true);
