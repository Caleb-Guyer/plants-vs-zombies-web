+int Board::CountUntriggerLawnMowers()
+{
+	int aCount = 0;
+	for (LawnMower* aLawnMower : mLawnMowers)
+	{
+		if (aLawnMower->mDead)
+			continue;
+		if (aLawnMower->mMowerState != LawnMowerState::MOWER_TRIGGERED && aLawnMower->mMowerState != LawnMowerState::MOWER_SQUISHED)
+		{
+			aCount++;
+		}
+	}
+	return aCount;
