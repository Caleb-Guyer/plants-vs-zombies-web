-		}
-		if (mApp->mGameMode == GameMode::GAMEMODE_CHALLENGE_COLUMN)
-		{
-			if (aWave % 10 == 5)
-			{
-				for (int _i = 0; _i < 10; _i++)
-				{
-					PutZombieInWave(ZombieType::ZOMBIE_LADDER, aWave, &aZombiePicker);
