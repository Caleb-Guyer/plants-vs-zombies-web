 using namespace Sexy;
 
+namespace
+{
+struct ScreenRasterTarget
+{
+    const void* surface = nullptr;
+    unsigned int bytePitch = 0;
+};
+thread_local ScreenRasterTarget gScreenRasterTarget;
+
+class ScopedScreenRasterTarget
+{
+    ScreenRasterTarget mPrevious;
+public:
+    ScopedScreenRasterTarget(const void* surface, unsigned int bytePitch)
+        : mPrevious(gScreenRasterTarget)
+    {
+        gScreenRasterTarget = {surface, bytePitch};
+    }
+    ~ScopedScreenRasterTarget() { gScreenRasterTarget = mPrevious; }
+    ScopedScreenRasterTarget(const ScopedScreenRasterTarget&) = delete;
+    ScopedScreenRasterTarget& operator=(const ScopedScreenRasterTarget&) = delete;
+};
+}
+
+bool Sexy::NativeScreenRasterTargetMatches(const void* surface, unsigned int bytePitch)
+{
+    return surface != nullptr && surface == gScreenRasterTarget.surface &&
+        bytePitch != 0 && bytePitch == gScreenRasterTarget.bytePitch;
+}
+
 SoftwareScreenImage::SoftwareScreenImage(SexyAppBase* app) : MemoryImage(app)
 {
     SetImageMode(false, false);
     mPurgeBits = false;
+}
+
+void SoftwareScreenImage::BltMatrix(Image* image, float x, float y, const SexyMatrix3& matrix,
+    const Rect& clipRect, const Color& color, int drawMode, const Rect& sourceRect, bool blend)
+{
+    ScopedScreenRasterTarget target(GetBits(), static_cast<unsigned int>(mWidth) * 4u);
+    MemoryImage::BltMatrix(image, x, y, matrix, clipRect, color, drawMode, sourceRect, blend);
+}
+
+void SoftwareScreenImage::BltTrianglesTex(Image* texture, const TriVertex vertices[][3], int triangleCount,
+    const Rect& clipRect, const Color& color, int drawMode, float x, float y, bool blend)
+{
+    ScopedScreenRasterTarget target(GetBits(), static_cast<unsigned int>(mWidth) * 4u);
+    MemoryImage::BltTrianglesTex(texture, vertices, triangleCount, clipRect, color, drawMode, x, y, blend);
 }
 
