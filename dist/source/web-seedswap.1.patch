+            #if defined(NAME_ADDITIVE)
+                #if defined(LINEAR_BLEND)
+                    const unsigned int contribution = source;
+                #else
+                    const unsigned int contribution = (source * alpha) >> 8;
+                #endif
+                output = destination + contribution;
+                if (output > 255) output = 255;
+            #else
