+void SexyAppBase::RehupFocus()
+{
+	bool wantHasFocus = mActive && !mMinimized;
+
+	if (wantHasFocus != mHasFocus)
+	{
+		mHasFocus = wantHasFocus;
+
+		if (mHasFocus)
+		{
+			if (mMuteOnLostFocus)
+				Unmute(true);
+
+			mWidgetManager->GotFocus();
+			GotFocus();
+		}
+		else
+		{
+			if (mMuteOnLostFocus)
+				Mute(true);
+
+			mWidgetManager->LostFocus();
+			LostFocus();
+
+			mWidgetManager->DoMouseUps();
+		}
+	}
+}
