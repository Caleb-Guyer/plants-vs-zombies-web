-
-	int srcX, srcY;
-	float dstX, dstY;
-	int w, h;
-	float u1, v1, u2, v2;
-	float uvb[4];
-
-	srcY = srcTop; dstY = theY;
-	while (srcY < srcBottom)
-	{
-		srcX = srcLeft; dstX = theX;
-		while (srcX < srcRight)
-		{
