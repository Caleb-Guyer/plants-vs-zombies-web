+QoLSettings& LawnApp::GetQoLSettings()
+{
+	const uint32_t aProfile = mPlayerInfo ? mPlayerInfo->mId : 0;
+	if (mQoLProfileId != aProfile)
+	{
+		mQoLProfileId = aProfile;
+		mQoLSettings = QoLSettings();
+		mQoLSettingsWritable = true;
+		Buffer aBuffer;
+		const std::string aPath = GetAppDataPath(std::format("userdata/qol-settings-{}.txt", aProfile));
+		if (ReadBufferFromFile(aPath, &aBuffer))
+		{
+			if (aBuffer.GetDataLen() > 4096 || !mQoLSettings.Decode(std::string_view(
+				reinterpret_cast<const char*>(aBuffer.GetDataPtr()), aBuffer.GetDataLen())))
+				mQoLSettingsWritable = false; // Preserve newer/unknown files rather than overwriting them.
+		}
+		mQoLKeysDown.fill(false);
+	}
+	return mQoLSettings;
+}
+
+bool LawnApp::SaveQoLSettings()
+{
+	auto& aSettings = GetQoLSettings();
+	if (!mQoLSettingsWritable)
+		return false;
+	MkDir(GetAppDataPath("userdata"));
+	const std::string aText = aSettings.Encode();
+	Buffer aBuffer;
+	aBuffer.WriteBytes(reinterpret_cast<const uint8_t*>(aText.data()), aText.size());
+	return WriteBufferToFile(GetAppDataPath(std::format("userdata/qol-settings-{}.txt", mQoLProfileId)), &aBuffer);
+}
+
+void LawnApp::DoQoLDialog()
+{
+	if (auto* aExisting = GetDialog(QOL_DIALOG_ID))
+	{
+		mWidgetManager->SetFocus(aExisting);
+		return;
+	}
+	auto* aDialog = new QoLDialog(this);
+	AddDialog(QOL_DIALOG_ID, aDialog);
+	mWidgetManager->SetFocus(aDialog);
+}
+
+void LawnApp::ToggleGameSpeed()
+{
+	mDoubleGameSpeed = !mDoubleGameSpeed;
+	auto& aSettings = GetQoLSettings();
+	if (aSettings.mRememberSpeed)
+	{
+		aSettings.mPreferredDoubleSpeed = mDoubleGameSpeed;
+		SaveQoLSettings();
+	}
+	UpdateGameSpeedButton();
+}
+
+void LawnApp::ReleaseQoLKey(KeyCode theKey)
+{
+	const int aKey = static_cast<int>(theKey);
+	if (aKey >= 0 && aKey < static_cast<int>(mQoLKeysDown.size()))
+		mQoLKeysDown[aKey] = false;
+}
+
+bool LawnApp::HandleQoLKey(KeyCode theKey)
+{
+	if (!mBoard || mGameScene != GameScenes::SCENE_PLAYING || mBoard->mPaused ||
+		GetDialogCount() > 0 || mSeedChooserScreen || mBoard->mBoardFadeOutCounter >= 0 ||
+		mCrazyDaveState != CrazyDaveState::CRAZY_DAVE_OFF || mBoard->mLevelComplete ||
+		mBoard->mTimeStopCounter > 0 || !mActive || mMinimized)
+		return false;
+	if (mWidgetManager->mKeyDown[KEYCODE_CONTROL] || mWidgetManager->mKeyDown[KEYCODE_MENU] ||
+		mWidgetManager->mKeyDown[KEYCODE_LWIN] || mWidgetManager->mKeyDown[KEYCODE_RWIN])
+		return false;
+	const int aKey = static_cast<int>(theKey);
+	const auto& aSettings = GetQoLSettings();
+	int aAction = -1;
+	for (int i = 0; i < QoLSettings::HOTKEY_COUNT; i++)
+		if (aKey != 0 && aSettings.mHotkeys[i] == aKey) { aAction = i; break; }
+	if (aAction < 0 || aKey < 0 || aKey >= static_cast<int>(mQoLKeysDown.size()))
+		return false;
+	if (mQoLKeysDown[aKey]) return true; // Ignore key-repeat until a real key-up.
+	mQoLKeysDown[aKey] = true;
+	if (aAction == QoLSettings::SPEED_ACTION)
+	{
+		if (IsGameSpeedButtonVisible()) ToggleGameSpeed();
+		return true;
+	}
+	const CursorType aCursor = mBoard->mCursorObject->mCursorType;
+	if (aCursor != CursorType::CURSOR_TYPE_NORMAL && aCursor != CursorType::CURSOR_TYPE_PLANT_FROM_BANK &&
+		aCursor != CursorType::CURSOR_TYPE_SHOVEL)
+		return true;
+	if (aAction == QoLSettings::SHOVEL_ACTION)
+	{
+		if (mBoard->mShowShovel)
+		{
+			mBoard->RefreshSeedPacketFromCursor();
+			if (aCursor != CursorType::CURSOR_TYPE_SHOVEL) mBoard->PickUpTool(GameObjectType::OBJECT_TYPE_SHOVEL);
+			mBoard->UpdateCursor();
+		}
+		return true;
+	}
+	if (aAction >= mBoard->mSeedBank->mNumPackets)
+		return true;
+	const bool aSamePacket = aCursor == CursorType::CURSOR_TYPE_PLANT_FROM_BANK &&
+		mBoard->mCursorObject->mSeedBankIndex == aAction;
+	mBoard->RefreshSeedPacketFromCursor();
+	if (!aSamePacket)
+		mBoard->mSeedBank->mSeedPackets[aAction].MouseDown(0, 0, 1);
+	mBoard->UpdateCursor();
+	return true;
+}
+
+void LawnApp::InitializeGameSpeedButton(Board* theBoard)
+{
+	const auto& aSettings = GetQoLSettings();
+	mDoubleGameSpeed = aSettings.mRememberSpeed && aSettings.mPreferredDoubleSpeed;
+	mQoLKeysDown.fill(false);
+	mGameSpeedPressArmed = false;
+	mGameSpeedButton = std::make_unique<GameButton>(2);
+	mGameSpeedButton->mDrawStoneButton = true;
+	mGameSpeedButton->mParentWidget = theBoard;
+	mGameSpeedButton->SetLabel(mDoubleGameSpeed ? "2x" : "1x");
+	// The ten-packet bank and shovel fill the horizontal space beside Menu.
+	mGameSpeedButton->Resize(681, 32, 117, 46);
+	mGameSpeedButton->mBtnNoDraw = true;
+	mGameSpeedButton->mDisabled = true;
+}
+
+bool LawnApp::IsGameSpeedButtonVisible() const
+{
+	return mBoard && mGameSpeedButton &&
+		mGameScene == GameScenes::SCENE_PLAYING && !mSeedChooserScreen &&
+		mGameMode != GameMode::GAMEMODE_CHALLENGE_ZEN_GARDEN &&
+		mGameMode != GameMode::GAMEMODE_TREE_OF_WISDOM &&
+		mGameMode != GameMode::GAMEMODE_UPSELL &&
+		mGameMode != GameMode::GAMEMODE_INTRO &&
+		mCrazyDaveState == CrazyDaveState::CRAZY_DAVE_OFF &&
+		!mBoard->mMenuButton->mBtnNoDraw && mBoard->mMenuButton->mY == -10 &&
+		mBoard->mBoardFadeOutCounter < 0 && !mBoard->mLevelComplete &&
+		!mBoard->mLevelAwardSpawned && !mBoard->mFinalBossKilled &&
+		mBoard->mNextSurvivalStageCounter == 0;
+}
+
+bool LawnApp::IsGameSpeedButtonAt(int x, int y) const
+{
+	return IsGameSpeedButtonVisible() &&
+		Rect(mGameSpeedButton->mX, mGameSpeedButton->mY,
+			mGameSpeedButton->mWidth, mGameSpeedButton->mHeight).Contains(x, y);
+}
+
+bool LawnApp::IsDoubleGameSpeedActive()
+{
+	return mDoubleGameSpeed && IsGameSpeedButtonVisible() &&
+		!mBoard->mPaused && mBoard->mTimeStopCounter == 0 &&
+		GetDialogCount() == 0 && mActive && !mMinimized;
+}
+
+void LawnApp::UpdateGameSpeedButton()
+{
+	if (!mGameSpeedButton)
+		return;
+	mGameSpeedButton->mBtnNoDraw = !IsGameSpeedButtonVisible();
+	mGameSpeedButton->mDisabled = mGameSpeedButton->mBtnNoDraw ||
+		!mBoard->CanInteractWithBoardButtons() || mBoard->mIgnoreMouseUp ||
+		mBoard->mTimeStopCounter > 0;
+	if (mGameSpeedButton->mDisabled)
+		mGameSpeedPressArmed = false;
+	mGameSpeedButton->SetLabel(mDoubleGameSpeed ? "2x" : "1x");
+	mGameSpeedButton->mInverted = mDoubleGameSpeed;
+	mGameSpeedButton->Update();
+}
+
+void LawnApp::SyncQoLKeyReleases()
+{
+	if (!mWidgetManager) return;
+	for (int i = 0; i < static_cast<int>(mQoLKeysDown.size()); i++)
+		if (!mWidgetManager->mKeyDown[i]) mQoLKeysDown[i] = false;
+}
