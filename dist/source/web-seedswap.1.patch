+			G = 2 * dh - dv;
+			DeltaG1 = 2 * ( dh - dv );
+			DeltaG2 = 2 * dh;
+			while (aCurY <= theEndY)
+			{
+				if ( G > 0 )
+				{
+					G += DeltaG1;
+					aCurX += inc;
+					aDestPixels += inc;
+
+					if (aCurX<aMinX || aCurY<aMinY || aCurX>aMaxX || aCurY>aMaxY)
+						break;
+				}
+				else
+					G += DeltaG2;
+
+				dest = *aDestPixels;
+
+				r = aMaxTable[((dest & aRMask) >> aRedShift) + rc];
+				g = aMaxTable[((dest & aGMask) >> aGreenShift) + gc];
+				b = aMaxTable[((dest & aBMask) >> aBlueShift) + bc];
+
+				*aDestPixels =
+					0xFF000000 |
+					(r << aRedShift) |
+					(g << aGreenShift) |
+					(b << aBlueShift);
+
+				aCurY++;
+				aDestPixels += aRowAdd;
+			}
+		}
+	}
+}
+
