+static void GfxEnsureSpace(int theAdditional)
+{
+	if (gVertexMode == (GLenum)-1 || gNumVertices + theAdditional <= MAX_VERTICES) return;
+	GLenum oldMode = gVertexMode;
+	GfxEnd();
+	GfxSubmit();
+	GfxBegin(oldMode);
+}
