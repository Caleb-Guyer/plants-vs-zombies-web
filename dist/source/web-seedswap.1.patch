+Rect Plant::GetPlantRect()
+{
+	Rect aRect;
+	if (mSeedType == SeedType::SEED_TALLNUT)
+	{
+		aRect = Rect(mX + 10, mY, mWidth, mHeight);
+	}
+	else if (mSeedType == SeedType::SEED_PUMPKINSHELL)
+	{
+		aRect = Rect(mX, mY, mWidth - 20, mHeight);
+	}
