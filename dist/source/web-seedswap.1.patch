+void MemoryImage::SlowStretchResample(Image* theImage, const Rect& theDestRect, const FRect& theSrcRect, bool theCompositeNormal)
+{
+	theImage->mDrawn = true;
+
+	// This thing was a pain to write.  I bet i could have gotten something just as good
+	// from some Graphics Gems book.
