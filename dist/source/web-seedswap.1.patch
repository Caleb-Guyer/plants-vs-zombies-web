-
-			for (int i = 0; i < aSize; i++)
-			{
-				uchar anAlpha = (uchar) (*ptr++ >> 24);
-
-				if (anAlpha == 0)
-					mHasTrans = true;
-				else if (anAlpha != 255)
-					mHasAlpha = true;
-			}
-		}
-		else if (mColorTable != nullptr)
-		{
-			mHasTrans = false;
-			mHasAlpha = false;
-
-			int aSize = 256;
-			uint32_t* ptr = mColorTable.get();
-
-			for (int i = 0; i < aSize; i++)
-			{
-				uchar anAlpha = (uchar) (*ptr++ >> 24);
-
-				if (anAlpha == 0)
-					mHasTrans = true;
-				else if (anAlpha != 255)
-					mHasAlpha = true;
-			}
-		}
-		else
-		{
-			mHasTrans = true;
-			mHasAlpha = false;
-		}
-
-		mBitsChanged = false;
-	}
-
-	//if (gDebug)
