 }
+
+SeedType SeedForDelivery(int ordinal, SeedType weighted)
+{
+    constexpr std::array opening = {SEED_WALLNUT, SEED_TALLNUT, SEED_PUMPKINSHELL, SEED_WALLNUT,
+        SEED_EXPLODE_O_NUT, SEED_GIANT_WALLNUT};
+    if (ordinal >= 0 && ordinal < static_cast<int>(opening.size())) return opening[ordinal];
+    switch (ordinal % 10) {
+        case 2: return SEED_TALLNUT;
+        case 5: return SEED_PUMPKINSHELL;
+        case 8: return SEED_GIANT_WALLNUT;
+        default: return weighted;
+    }
+}
+
+void ReleaseFrost(Zombie& iceHead)
+{
+    if (iceHead.mZombieType != ice || !iceHead.IsOnBoard() || !UsesNewRules(*iceHead.mBoard) ||
+        !iceHead.mHasHead || iceHead.mSummonCounter < 0) return;
+    iceHead.mSummonCounter = -1;
+    iceHead.mApp->PlayFoley(FOLEY_FROZEN);
+    const auto bounds = iceHead.GetZombieRect();
+    const int center = bounds.mX + bounds.mWidth / 2;
+    iceHead.mApp->AddPvzpParticle(center, iceHead.mPosY + 52, iceHead.mRenderOrder + 2, PARTICLE_SNOWPEA_SPLAT);
+    for (Plant* nut : iceHead.mBoard->mPlants) {
+        if (nut->mDead || !IsNut(nut->mSeedType) || IsHeavy(nut->mSeedType)) continue;
+        const int dx = nut->mX + 40 - center;
+        const int dy = nut->mY - iceHead.mBoard->GridToPixelY(0, iceHead.mRow);
+        if (dx * dx + dy * dy > frostRadius * frostRadius) continue;
+        if (nut->mDoSpecialCountdown == 0)
+            nut->mApp->AddPvzpParticle(nut->mX + 40, nut->mY + 42, nut->mRenderOrder + 1, PARTICLE_ICE_SPARKLE);
+        nut->mDoSpecialCountdown = frostTicks;
+    }
+}
+
+Plant* InterceptedNut(Zombie& zombie)
+{
+    if (zombie.mTargetPlantID == PLANTID_NULL || !zombie.mBoard || !UsesNewRules(*zombie.mBoard)) return nullptr;
+    auto* nut = zombie.mBoard->mPlants.DataArrayTryToGet(static_cast<unsigned>(zombie.mTargetPlantID));
+    return nut && !nut->mDead && nut->mSeedType == SEED_WALLNUT &&
+        nut->mTargetZombieID == zombie.mBoard->ZombieGetID(&zombie) ? nut : nullptr;
+}
+
+bool HoldRoller(Plant& nut)
+{
+    if (!nut.mIsOnBoard || nut.mDead || !UsesNewRules(*nut.mBoard)) return false;
+    if (nut.mDoSpecialCountdown > 0) {
+        if (Reanimation* body = nut.mApp->ReanimationTryToGet(nut.mBodyReanimID)) {
+            body->mColorOverride = Sexy::Color(140, 195, 255);
+            body->mExtraOverlayColor = Sexy::Color(112, 196, 255, 105);
+            body->mEnableExtraOverlayDraw = true;
+            body->PropogateColorToAttachments();
+        }
+        --nut.mDoSpecialCountdown;
+        return true;
+    }
+    if (nut.mSeedType != SEED_WALLNUT || nut.mTargetZombieID == ZOMBIEID_NULL) return false;
+    Zombie* interceptor = nut.mBoard->ZombieTryToGet(nut.mTargetZombieID);
+    if (interceptor && !interceptor->IsDeadOrDying() && InterceptedNut(*interceptor) == &nut) return true;
+    nut.mTargetZombieID = ZOMBIEID_NULL;
+    return false;
+}
