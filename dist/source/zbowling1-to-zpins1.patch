+
+void DrawTumblingBowler(Graphics* g, Plant& plant, Reanimation& body)
+{
+    // Distances from each sprite's pivot to its outer edge, measured in the
+    // original idle art every 22.5 degrees. A Tall-nut lifts onto its shoulder;
+    // the broad Pumpkin rocks down onto its face and then back onto its rim.
+    static constexpr std::array<int, 16> tallRadius = {59,60,59,51,39,41,49,56,59,55,47,39,39,49,57,61};
+    static constexpr std::array<int, 16> pumpkinRadius = {30,36,41,46,46,46,40,36,30,36,40,44,45,45,41,35};
+    const bool tall = plant.mSeedType == SEED_TALLNUT;
+    const int launchX = plant.mBoard->GridToPixelX(plant.mPlantCol, plant.mStartRow);
+    const float steps = std::max(0, plant.mX - launchX) * 16.0f / (tall ? 210.0f : 203.0f);
+    const int sector = static_cast<int>(steps);
+    const float blend = steps - sector;
+    const auto& radii = tall ? tallRadius : pumpkinRadius;
+    const auto radius = [&](int offset) {
+        return std::lerp(float(radii[(sector + offset) % 16]), float(radii[(sector + offset + 1) % 16]), blend);
+    };
+    const float scale = tall ? 0.65f : 0.81f;
+    constexpr float centerX = 40.0f, groundY = 86.0f;
+    if (IMAGE_PLANTSHADOW)
+    {
+        const int width = int((radius(4) + radius(12)) * scale * 0.90f);
+        g->DrawImage(IMAGE_PLANTSHADOW, int(centerX) - width / 2, int(groundY) - 8, width, 15);
+    }
+    const float pivotX = (tall ? 39.0f : 40.0f) + body.mOverlayMatrix.m02;
+    const float pivotY = (tall ? 22.0f : 43.0f) + body.mOverlayMatrix.m12;
+    SexyTransform2D transform;
+    PvzpScaleRotateTransformMatrix(transform, 0.0f, 0.0f, -steps * (PI / 8.0f), scale, scale);
+    transform.m02 = centerX - transform.m00 * pivotX - transform.m01 * pivotY;
+    transform.m12 = groundY - scale * radius(0) - transform.m10 * pivotX - transform.m11 * pivotY;
+    const BowlingDrawPose bodyPose(&body, transform);
+    const BowlingDrawPose blinkPose(plant.mApp->ReanimationTryToGet(plant.mBlinkReanimID), transform);
+    if (!tall) body.DrawRenderGroup(g, 1); // Native Pumpkin_back sits behind the front shell.
+    body.Draw(g);
+}
