+void SplitPumpkin(Plant& shell)
+{
+    Board& board = *shell.mBoard;
+    for (int direction : {-1, 1}) {
+        const int row = shell.mRow + direction;
+        if (row < 0 || row >= 5 || board.mPlants.mSize >= board.mPlants.mMaxSize) continue;
+        Plant* child = board.NewPlant(shell.mPlantCol, row, SEED_WALLNUT, SEED_NONE);
+        child->mX = shell.mX;
+        child->mY = shell.mY;
+        child->mDoSpecialCountdown = shell.mDoSpecialCountdown;
+        child->mState = direction < 0 ? STATE_BOWLING_UP : STATE_BOWLING_DOWN;
+        child->mRenderOrder = child->CalcRenderOrder();
+    }
+    shell.mApp->AddPvzpParticle(shell.mX + 40, shell.mY + 45, shell.mRenderOrder + 1, PARTICLE_WALLNUT_EAT_LARGE);
+    shell.Die();
+}
+}
