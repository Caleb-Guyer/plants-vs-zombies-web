+float SeedChooserScreen::GetSeedPacketScaleProgress(const ChosenSeed& theChosenSeed)
+{
+	if (theChosenSeed.mSeedType != SEED_LANTERNSHROOM && theChosenSeed.mSeedType != SEED_MENDERBLOOM)
+		return 1.0f;
+	if (theChosenSeed.mSeedState == SEED_IN_CHOOSER)
+		return 0.0f;
+	if (theChosenSeed.mSeedState == SEED_FLYING_TO_CHOOSER)
+		return PvzpAnimateCurveFloat(theChosenSeed.mTimeStartMotion, theChosenSeed.mTimeEndMotion,
+			mSeedChooserAge, 1.0f, 0.0f, CURVE_EASE_IN_OUT);
+	if (theChosenSeed.mSeedState == SEED_FLYING_TO_BANK)
+	{
+		int aChooserX, aChooserY;
+		GetSeedPositionInChooser(theChosenSeed.mSeedType, aChooserX, aChooserY);
+		if (theChosenSeed.mStartX == aChooserX && theChosenSeed.mStartY == aChooserY)
+			return PvzpAnimateCurveFloat(theChosenSeed.mTimeStartMotion, theChosenSeed.mTimeEndMotion,
+				mSeedChooserAge, 0.0f, 1.0f, CURVE_EASE_IN_OUT);
+	}
+	// Sliding an existing bank packet into a vacated bank slot keeps its full size.
+	return 1.0f;
+}
