+Image* Plant::GetImage(SeedType theSeedType)
+{
+	if (theSeedType == SEED_LANTERNSHROOM) return LanternShroom::GetImage();
+	if (theSeedType == SEED_MENDERBLOOM) return MenderBloom::GetImage();
