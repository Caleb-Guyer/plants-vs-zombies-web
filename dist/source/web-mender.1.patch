-			if (aBodyReanim->TrackExists("anim_stem"))
-				aHeadReanim->AttachToAnotherReanimation(aBodyReanim, "anim_stem");
-			else if (aBodyReanim->TrackExists("anim_idle"))
-				aHeadReanim->AttachToAnotherReanimation(aBodyReanim, "anim_idle");
-		}
-		break;
