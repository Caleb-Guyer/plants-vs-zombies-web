+			((p >> 8) & 0xF800) | ((p >> 5) & 0x07E0) | ((p >> 3) & 0x001F));
+	};
+
+	if (img->mColorTable == nullptr)
+	{
+		uint32_t *srcRow = (uint32_t*)img->GetBits() + offy * img->GetWidth() + offx;
