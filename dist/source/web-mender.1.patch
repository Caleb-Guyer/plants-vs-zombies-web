-	{
-		startx = -theSrcRect.mWidth  / 2.0f;
-		starty = -theSrcRect.mHeight / 2.0f;
-	}
-
-	uint32_t aColor = theColor.ToGLColor();
-	glActiveTexture(GL_TEXTURE0);
