+	DialogMap::iterator aDialogItr = mDialogMap.begin();
+	while (aDialogItr != mDialogMap.end())
+	{
+		mWidgetManager->RemoveWidget(aDialogItr->second);
+		delete aDialogItr->second;
+		++aDialogItr;
