+			aBodyReanim->SetImageOverride("Pumpkin_front", IMAGE_REANIM_PUMPKIN_DAMAGE1);
+	}
+	else
+	{
+		aBodyReanim->SetImageOverride("Pumpkin_front", nullptr);
+	}
+}
