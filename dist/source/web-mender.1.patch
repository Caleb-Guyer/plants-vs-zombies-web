+
+	ResetCustomCursorCache();
+
+	for (int aCursorIdx = 0; aCursorIdx < NUM_CURSORS; aCursorIdx++)
+	{
+		if (mSysCursors[aCursorIdx] != nullptr)
+		{
+			SDL_FreeCursor(mSysCursors[aCursorIdx]);
