+void MemoryImage::BitsChanged()
+{
+	mBitsChanged = true;
+	mBitsChangedCount++;
+	mFilePath.clear();
+
+	mNativeAlphaData.reset();
+	mRLAlphaData.reset();
+	mRLAdditiveData.reset();
+
+	// Verify secret value at end to protect against overwrite
+	if (mBits != nullptr)
+	{
+		DBG_ASSERTE(mBits[mWidth*mHeight] == MEMORYCHECK_ID);
+	}
+}
