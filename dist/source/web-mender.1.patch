new file mode 100644
index 0000000000000000000000000000000000000000..7a2a34f45a84db4377399496153d49de79e0a9fa
--- /dev/null
+++ b/src/Lawn/System/GardenShuffle.h
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+
+// A small, fixed garden faces authored lanes. Combat plants are moved in place,
+// never rebuilt: their native IDs, health and attack clocks survive a move.
+namespace GardenShuffle
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_GARDEN_SHUFFLE;
+inline constexpr ChallengeState kState = static_cast<ChallengeState>(103);
+inline constexpr int kMoveCooldown = 100;
+inline constexpr int kOpeningDelay = 1800;
+inline constexpr int kWaveCount = 10;
+inline constexpr int kLargestWave = 6;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state) { return IsMode(mode) && state == kState; }
+constexpr bool CanMoveSeed(SeedType seed)
+{
+    return seed == SEED_REPEATER || seed == SEED_SNOWPEA || seed == SEED_WALLNUT;
+}
+
+struct StartingPlant
+{
+    SeedType mSeed;
+    int mCol;
+    int mRow;
+};
+inline constexpr std::array<StartingPlant, 6> kStartingPlants = {{
+    {SEED_REPEATER, 1, 1}, {SEED_REPEATER, 2, 1},
+    {SEED_REPEATER, 1, 3}, {SEED_SNOWPEA, 1, 2},
+    {SEED_WALLNUT, 5, 1}, {SEED_WALLNUT, 5, 3}
+}};
+
+struct Spawn
+{
+    ZombieType mType = ZOMBIE_INVALID;
+    int mRow = 0;
+};
+using Wave = std::array<Spawn, kLargestWave>;
+
+// Early pairs allow time to learn the glove. Later waves rotate among three
+// lanes; the final flag adds a third lane rather than an unseen speed spike.
+inline constexpr std::array<Wave, kWaveCount> kWaves = {{
+    {{{ZOMBIE_NORMAL,1}, {ZOMBIE_NORMAL,3}}},
+    {{{ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,4}, {ZOMBIE_NORMAL,0}}},
+    {{{ZOMBIE_NORMAL,2}, {ZOMBIE_TRAFFIC_CONE,2}, {ZOMBIE_NORMAL,4}}},
+    {{{ZOMBIE_NORMAL,0}, {ZOMBIE_TRAFFIC_CONE,3}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,0}}},
+    {{{ZOMBIE_NORMAL,1}, {ZOMBIE_TRAFFIC_CONE,4}, {ZOMBIE_NORMAL,4}, {ZOMBIE_NORMAL,1}}},
+    {{{ZOMBIE_DOOR,2}, {ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,2}, {ZOMBIE_TRAFFIC_CONE,0}}},
+    {{{ZOMBIE_NORMAL,3}, {ZOMBIE_POLEVAULTER,1}, {ZOMBIE_NORMAL,1}, {ZOMBIE_TRAFFIC_CONE,3}}},
+    {{{ZOMBIE_PAIL,4}, {ZOMBIE_NORMAL,2}, {ZOMBIE_NORMAL,4}, {ZOMBIE_TRAFFIC_CONE,2}, {ZOMBIE_NORMAL,0}}},
+    {{{ZOMBIE_DOOR,0}, {ZOMBIE_TRAFFIC_CONE,3}, {ZOMBIE_NORMAL,0}, {ZOMBIE_NORMAL,3}, {ZOMBIE_NORMAL,1}}},
+    {{{ZOMBIE_FLAG,2}, {ZOMBIE_TRAFFIC_CONE,0}, {ZOMBIE_NORMAL,0}, {ZOMBIE_TRAFFIC_CONE,4}, {ZOMBIE_NORMAL,4}, {ZOMBIE_NORMAL,2}}}
+}};
+
+constexpr int ZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kWaveCount) return 0;
+    int count = 0;
+    for (const Spawn& spawn : kWaves[wave]) if (spawn.mType != ZOMBIE_INVALID) ++count;
+    return count;
+}
+constexpr int RowForSpawn(int wave, int ordinal)
+{
+    return wave >= 0 && wave < kWaveCount && ordinal >= 0 && ordinal < ZombieCount(wave)
+        ? kWaves[wave][ordinal].mRow : -1;
+}
+constexpr int ComposeWave(int wave, ZombieType* output, int capacity)
+{
+    if (wave < 0 || wave >= kWaveCount || !output || capacity <= ZombieCount(wave)) return -1;
+    for (int i = 0; i < capacity; ++i) output[i] = ZOMBIE_INVALID;
+    int count = 0;
+    for (const Spawn& spawn : kWaves[wave])
+        if (spawn.mType != ZOMBIE_INVALID) output[count++] = spawn.mType;
+    return count;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestWave);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int i = 0; i < kWaveCount; ++i) ComposeWave(i, output[i], static_cast<int>(Slots));
+    return kWaveCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_DOOR));
+    for (auto& allowed : output) allowed = false;
+    for (const Wave& wave : kWaves)
+        for (const Spawn& spawn : wave)
+            if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+
+static_assert(static_cast<int>(kMode) == 76);
+static_assert(ZombieCount(0) == 2 && ZombieCount(kWaveCount - 1) == kLargestWave);
+}
diff --git a/src/Lawn/System/LanternGlow.h b/src/Lawn/System/LanternGlow.h
new file mode 100644
index 0000000000000000000000000000000000000000..8d755ed679bcb2ebc063a51230572563716e402d
--- /dev/null
+++ b/src/Lawn/System/LanternGlow.h
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+#include <string_view>
+
+// Uses the native nighttime lawn, sun economy, graves and mushroom behavior.
+// Mode 75 owns reserved profile record 74 without extending serialized objects.
+namespace LanternGlow
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_LANTERN_GLOW;
+inline constexpr std::string_view kId = "lantern-glow";
+inline constexpr int kRevision = 1;
+inline constexpr int kStartingSun = 150;
+inline constexpr int kWaveCount = 20;
+inline constexpr int kLargestWave = 16;
+inline constexpr std::array<SeedType, 6> kSeeds = {
+    SEED_SUNSHROOM, SEED_PUFFSHROOM, SEED_FUMESHROOM,
+    SEED_LANTERNSHROOM, SEED_GRAVEBUSTER, SEED_DOOMSHROOM
+};
+inline constexpr std::array<ZombieType, 5> kPreviewZombies = {
+    ZOMBIE_NORMAL, ZOMBIE_TRAFFIC_CONE, ZOMBIE_NEWSPAPER, ZOMBIE_POLEVAULTER, ZOMBIE_PAIL
+};
+
+struct Wave
+{
+    int mNormal;
+    int mCones;
+    int mNewspapers;
+    int mPoles;
+    int mBuckets;
+};
+
+// Gentle opening waves leave time to grow sun and place the support mushroom.
+// Newspapers arrive on wave 5, poles on wave 8 and buckets on wave 15.
+inline constexpr std::array<Wave, kWaveCount> kWaves = {{
+    {1, 0, 0, 0, 0}, {2, 0, 0, 0, 0}, {3, 0, 0, 0, 0}, {2, 1, 0, 0, 0},
+    {2, 1, 1, 0, 0}, {3, 1, 1, 0, 0}, {3, 2, 1, 0, 0}, {3, 2, 1, 1, 0},
+    {3, 2, 2, 1, 0}, {4, 3, 2, 1, 0}, {3, 3, 1, 2, 0}, {3, 3, 2, 2, 0},
+    {3, 3, 2, 3, 0}, {3, 3, 2, 3, 0}, {3, 3, 2, 3, 1}, {3, 4, 2, 3, 1},
+    {3, 4, 2, 3, 2}, {3, 3, 3, 3, 2}, {3, 4, 2, 3, 2}, {3, 4, 3, 3, 2}
+}};
+
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsFlagWave(int wave) { return wave >= 0 && wave < kWaveCount && (wave + 1) % 10 == 0; }
+constexpr int ZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kWaveCount) return 0;
+    const Wave& entry = kWaves[wave];
+    return entry.mNormal + entry.mCones + entry.mNewspapers + entry.mPoles + entry.mBuckets + (IsFlagWave(wave) ? 1 : 0);
+}
+
+// Reject invalid input before writing any part of the native wave buffer.
+constexpr int ComposeWave(int wave, ZombieType* output, int capacity)
+{
+    if (wave < 0 || wave >= kWaveCount || !output || capacity <= ZombieCount(wave)) return -1;
+    for (int i = 0; i < capacity; ++i) output[i] = ZOMBIE_INVALID;
+    const Wave& entry = kWaves[wave];
+    int count = 0;
+    if (IsFlagWave(wave)) output[count++] = ZOMBIE_FLAG;
+    for (int i = 0; i < entry.mNormal; ++i) output[count++] = ZOMBIE_NORMAL;
+    for (int i = 0; i < entry.mCones; ++i) output[count++] = ZOMBIE_TRAFFIC_CONE;
+    for (int i = 0; i < entry.mNewspapers; ++i) output[count++] = ZOMBIE_NEWSPAPER;
+    for (int i = 0; i < entry.mPoles; ++i) output[count++] = ZOMBIE_POLEVAULTER;
+    for (int i = 0; i < entry.mBuckets; ++i) output[count++] = ZOMBIE_PAIL;
+    return count;
+}
+
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestWave);
+    for (auto& wave : output)
+        for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int i = 0; i < kWaveCount; ++i) ComposeWave(i, output[i], static_cast<int>(Slots));
+    return kWaveCount;
+}
+
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    static_assert(Count > static_cast<std::size_t>(ZOMBIE_NEWSPAPER));
+    for (auto& allowed : output) allowed = false;
+    for (ZombieType zombie : kPreviewZombies) output[zombie] = true;
+}
+
+template<class Bank>
+void FillSeedBank(Bank& bank)
+{
+    bank.mNumPackets = static_cast<int>(kSeeds.size());
+    for (int i = 0; i < bank.mNumPackets; ++i) bank.mSeedPackets[i].SetPacketType(kSeeds[i]);
+}
+
+static_assert(static_cast<int>(kMode) == 75);
+// Revision 2: a finite-budget placement puzzle followed by four short waves.
+// No free Puff-shrooms or sun producers can trivialize the preparation phase.
+inline constexpr int kPuzzleStartingSun = 1500;
+inline constexpr int kPuzzleWaveCount = 4;
+inline constexpr int kPuzzleLargestWave = 13;
+inline constexpr std::array<SeedType, 6> kPuzzleSeeds = {
+    SEED_LANTERNSHROOM, SEED_FUMESHROOM, SEED_SCAREDYSHROOM,
+    SEED_WALLNUT, SEED_CHERRYBOMB, SEED_SQUASH
+};
+inline constexpr std::array<Wave, kPuzzleWaveCount> kPuzzleWaves = {{
+    {4,0,0,0,0}, {5,2,0,0,0}, {3,3,2,0,0}, {4,4,2,1,1}
+}};
+constexpr bool PuzzleFlagWave(int wave) { return wave == kPuzzleWaveCount - 1; }
+constexpr int PuzzleZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kPuzzleWaveCount) return 0;
+    const Wave& entry = kPuzzleWaves[wave];
+    return entry.mNormal + entry.mCones + entry.mNewspapers + entry.mPoles + entry.mBuckets + (PuzzleFlagWave(wave) ? 1 : 0);
+}
+constexpr int ComposePuzzleWave(int wave, ZombieType* output, int capacity)
+{
+    if (wave < 0 || wave >= kPuzzleWaveCount || !output || capacity <= PuzzleZombieCount(wave)) return -1;
+    for (int i = 0; i < capacity; ++i) output[i] = ZOMBIE_INVALID;
+    const Wave& entry = kPuzzleWaves[wave];
+    int n = 0;
+    if (PuzzleFlagWave(wave)) output[n++] = ZOMBIE_FLAG;
+    for (int i = 0; i < entry.mNormal; ++i) output[n++] = ZOMBIE_NORMAL;
+    for (int i = 0; i < entry.mCones; ++i) output[n++] = ZOMBIE_TRAFFIC_CONE;
+    for (int i = 0; i < entry.mNewspapers; ++i) output[n++] = ZOMBIE_NEWSPAPER;
+    for (int i = 0; i < entry.mPoles; ++i) output[n++] = ZOMBIE_POLEVAULTER;
+    for (int i = 0; i < entry.mBuckets; ++i) output[n++] = ZOMBIE_PAIL;
+    return n;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulatePuzzleWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kPuzzleWaveCount && Slots > kPuzzleLargestWave);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int i = 0; i < kPuzzleWaveCount; ++i) ComposePuzzleWave(i, output[i], static_cast<int>(Slots));
+    return kPuzzleWaveCount;
+}
+static_assert(PuzzleZombieCount(kPuzzleWaveCount - 1) == kPuzzleLargestWave);
+
+static_assert(ZombieCount(kWaveCount - 1) == kLargestWave);
+}
diff --git a/src/Lawn/System/LanternShroom.cpp b/src/Lawn/System/LanternShroom.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..dc0f91d8f5ecfa29b19dc1e5d386968c2706bcc9
--- /dev/null
+++ b/src/Lawn/System/LanternShroom.cpp
@@ -0,0 +1,465 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "LanternShroom.h"
+#include "ChillShroomArt.h"
+#include "../Plant.h"
+#include "../SeedPacket.h"
+#include "../Zombie.h"
+#include "../../LawnApp.h"
+#include "../../Resources.h"
+#include "../../SexyAppFramework/graphics/MemoryImage.h"
+#include "../../SexyAppFramework/graphics/Graphics.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "../../PvzpLib/FilterEffect.h"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cmath>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace LanternShroom
+{
+namespace
+{
+struct SpriteCache
+{
+    std::array<std::unique_ptr<Sexy::MemoryImage>, 6> parts;
+    std::array<std::array<std::unique_ptr<Sexy::MemoryImage>, NUM_FILTER_EFFECTS>, 5> filtered;
+    std::unique_ptr<Sexy::MemoryImage> preview;
+    std::array<std::unique_ptr<Sexy::MemoryImage>, 5> bonus;
+    const ReanimatorDefinition* definition = nullptr;
+    std::array<int, 5> trackIndices = {-1, -1, -1, -1, -1};
+};
+SpriteCache& CachedSprite()
+{
+    static SpriteCache cache;
+    return cache;
+}
+
+std::unique_ptr<Sexy::MemoryImage> MakePartImage(const uint32_t* argb, int width, int height)
+{
+    std::vector<uint32_t> pixels(argb, argb + width * height);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+const std::array<std::unique_ptr<Sexy::MemoryImage>, 6>& GetPartImages()
+{
+    static_assert(ChillShroomArt::kCapWidth == 80 && ChillShroomArt::kCapHeight == 80 &&
+        ChillShroomArt::kBodyWidth == 80 && ChillShroomArt::kBodyHeight == 80 &&
+        ChillShroomArt::kBaseWidth == 80 && ChillShroomArt::kBaseHeight == 80 &&
+        ChillShroomArt::kBlink1Width == 80 && ChillShroomArt::kBlink1Height == 80 &&
+        ChillShroomArt::kBlink2Width == 80 && ChillShroomArt::kBlink2Height == 80,
+        "Chill-shroom parts share one registered canvas");
+    SpriteCache& cache = CachedSprite();
+    if (!cache.parts[0])
+    {
+        cache.parts[0] = MakePartImage(ChillShroomArt::kCapArgb, ChillShroomArt::kCapWidth, ChillShroomArt::kCapHeight);
+        cache.parts[1] = MakePartImage(ChillShroomArt::kBodyArgb, ChillShroomArt::kBodyWidth, ChillShroomArt::kBodyHeight);
+        cache.parts[2] = MakePartImage(ChillShroomArt::kBaseArgb, ChillShroomArt::kBaseWidth, ChillShroomArt::kBaseHeight);
+        cache.parts[3] = MakePartImage(ChillShroomArt::kBlink1Argb, ChillShroomArt::kBlink1Width, ChillShroomArt::kBlink1Height);
+        cache.parts[4] = MakePartImage(ChillShroomArt::kBlink2Argb, ChillShroomArt::kBlink2Width, ChillShroomArt::kBlink2Height);
+        const uint32_t transparent = 0;
+        cache.parts[5] = MakePartImage(&transparent, 1, 1);
+        for (const int part : {0, 1, 3, 4})
+            for (int filter = 0; filter < NUM_FILTER_EFFECTS; ++filter)
+                cache.filtered[part][filter].reset(FilterEffectCreateImage(cache.parts[part].get(), static_cast<FilterEffect>(filter)));
+    }
+    return cache.parts;
+}
+
+int FindImageTrack(const Reanimation& reanimation, const char* name)
+{
+    for (int index = 0; index < reanimation.mDefinition->mTracks.count; ++index)
+    {
+        const ReanimatorTrack& track = reanimation.mDefinition->mTracks.tracks[index];
+        if (std::strcmp(track.mName, name) != 0) continue;
+        for (int frame = 0; frame < track.mTransforms.count; ++frame)
+            if (track.mTransforms.mTransforms[frame].mImage) return index;
+    }
+    return -1;
+}
+
+const std::array<int, 5>& GetPartTrackIndices(const Reanimation& reanimation)
+{
+    SpriteCache& cache = CachedSprite();
+    if (cache.definition != reanimation.mDefinition)
+    {
+        static constexpr const char* names[5] = {"IceShroom_head", "anim_face", "IceShroom_base", "anim_sleep", "anim_blink"};
+        for (int index = 0; index < 5; ++index)
+            cache.trackIndices[index] = FindImageTrack(reanimation, names[index]);
+        cache.definition = reanimation.mDefinition;
+    }
+    return cache.trackIndices;
+}
+
+Sexy::Image* GetRigImage(int part, FilterEffect filter)
+{
+    const auto& images = GetPartImages();
+    if (filter >= 0 && filter < NUM_FILTER_EFFECTS && CachedSprite().filtered[part][filter])
+        return CachedSprite().filtered[part][filter].get();
+    return images[part].get();
+}
+
+void DrawRigLayer(Sexy::Graphics* graphics, Reanimation& carrier, int part, float offsetX, float offsetY)
+{
+    Sexy::Image* image = GetRigImage(part, carrier.mFilterEffect);
+    SexyMatrix3 local;
+    local.LoadIdentity();
+    SexyMatrix3Translation(local, 40.0f + offsetX, 40.0f + offsetY);
+    SexyMatrix3 matrix;
+    SexyMatrix3Multiply(matrix, carrier.mOverlayMatrix, local);
+    SexyMatrix3Translation(matrix, graphics->mTransX, graphics->mTransY);
+    Sexy::Color color = carrier.mColorOverride;
+    if (graphics->GetColorizeImages()) color = ColorsMultiply(color, graphics->GetColor());
+    if (color.mAlpha <= 0) return;
+    const Sexy::Rect source(0, 0, image->GetWidth(), image->GetHeight());
+    carrier.ReanimBltMatrix(graphics, image, matrix, graphics->mClipRect, color, graphics->GetDrawMode(), source);
+    if (carrier.mEnableExtraAdditiveDraw)
+    {
+        Sexy::Color additive = carrier.mExtraAdditiveColor;
+        additive.mAlpha = ColorComponentMultiply(additive.mAlpha, color.mAlpha);
+        carrier.ReanimBltMatrix(graphics, image, matrix, graphics->mClipRect, additive, Sexy::Graphics::DRAWMODE_ADDITIVE, source);
+    }
+    if (carrier.mEnableExtraOverlayDraw)
+    {
+        Sexy::Color overlay = carrier.mExtraOverlayColor;
+        overlay.mAlpha = ColorComponentMultiply(overlay.mAlpha, color.mAlpha);
+        carrier.ReanimBltMatrix(graphics, GetRigImage(part, FILTER_EFFECT_WHITE), matrix, graphics->mClipRect,
+            overlay, Sexy::Graphics::DRAWMODE_NORMAL, source);
+    }
+}
+
+std::unique_ptr<Sexy::MemoryImage> MakeBlankImage(int width, int height)
+{
+    std::vector<uint32_t> pixels(width * height, 0);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), width, height);
+    return image;
+}
+
+Sexy::Rect GetVisibleBounds(Sexy::MemoryImage& image)
+{
+    const int width = image.GetWidth(), height = image.GetHeight();
+    const uint32_t* bits = image.GetBits();
+    int left = width, top = height, right = -1, bottom = -1;
+    for (int y = 0; y < height; ++y)
+        for (int x = 0; x < width; ++x)
+            if ((bits[y * width + x] >> 24) > 8)
+            {
+                left = std::min(left, x); top = std::min(top, y);
+                right = std::max(right, x); bottom = std::max(bottom, y);
+            }
+    return right < left || bottom < top ? Sexy::Rect(0, 0, 0, 0) :
+        Sexy::Rect(left, top, right - left + 1, bottom - top + 1);
+}
+
+struct PortraitPlacement
+{
+    float x = 0.0f;
+    float y = 0.0f;
+    float scale = 0.0f;
+};
+PortraitPlacement GetPortraitPlacement(const Sexy::Rect& bounds)
+{
+    PortraitPlacement placement;
+    if (bounds.mWidth <= 0 || bounds.mHeight <= 0) return placement;
+    placement.scale = std::min(68.0f / bounds.mWidth, 57.0f / bounds.mHeight);
+    placement.x = 40.0f - (bounds.mX + bounds.mWidth * 0.5f) * placement.scale;
+    placement.y = 32.5f - (bounds.mY + bounds.mHeight * 0.5f) * placement.scale;
+    return placement;
+}
+
+void DrawCenteredPortrait(Sexy::Graphics& graphics, Sexy::MemoryImage& image)
+{
+    const PortraitPlacement placement = GetPortraitPlacement(GetVisibleBounds(image));
+    if (placement.scale > 0.0f)
+        PvzpDrawImageScaledF(&graphics, &image, placement.x, placement.y, placement.scale, placement.scale);
+}
+
+std::unique_ptr<Sexy::MemoryImage> MakeNativePortrait(GameMode mode)
+{
+    const bool cone = mode == GAMEMODE_CHALLENGE_CONE_ZONE;
+    const bool garden = mode == GAMEMODE_CHALLENGE_GARDEN_SHUFFLE;
+    const bool swap = mode == GAMEMODE_CHALLENGE_SEED_SWAP;
+    auto image = MakeBlankImage(cone ? 200 : 120, cone ? 210 : 120);
+    Sexy::Graphics graphics(image.get());
+    graphics.SetLinearBlend(true);
+    Reanimation native;
+    native.ReanimationInitializeType(cone ? 40.0f : 20.0f, cone ? 40.0f : 20.0f,
+        cone ? REANIM_ZOMBIE : garden ? REANIM_PEASHOOTER : swap ? REANIM_WALLNUT :
+        mode == GAMEMODE_CHALLENGE_NIGHT_SHIFT ? REANIM_PUFFSHROOM : REANIM_ICESHROOM);
+    native.SetFramesForLayer("anim_idle");
+    if (cone)
+    {
+        Zombie::SetupReanimLayers(&native, ZOMBIE_TRAFFIC_CONE);
+        native.AssignRenderGroupToPrefix("", RENDER_GROUP_HIDDEN);
+        native.AssignRenderGroupToPrefix("anim_head", RENDER_GROUP_NORMAL);
+        native.AssignRenderGroupToPrefix("anim_cone", RENDER_GROUP_NORMAL);
+    }
+    else if (mode == GAMEMODE_CHALLENGE_LANTERN_GLOW)
+    {
+        BindParts(native);
+        DrawRig(&graphics, native);
+    }
+    native.Draw(&graphics);
+    if (garden)
+    {
+        // Peashooter uses the native body and head layers separately.
+        native.SetFramesForLayer("anim_head_idle");
+        native.Draw(&graphics);
+    }
+    if (garden && Sexy::IMAGE_ZEN_GARDENGLOVE)
+    {
+        // The original glove is a subordinate cue; the same bounds-based
+        // centering used by the other cards fits the complete composition.
+        PvzpDrawImageScaledF(&graphics, Sexy::IMAGE_ZEN_GARDENGLOVE, 73.0f, 68.0f, 0.55f, 0.55f);
+    }
+    if (swap)
+    {
+        // A native seed packet beside the Wall-nut shows the replacement choice.
+        // Fit the full composition through the same visible-bounds placement.
+        Sexy::Graphics packetGraphics(graphics);
+        packetGraphics.SetScale(0.55f, 0.55f, 0.0f, 0.0f);
+        DrawSeedPacket(&packetGraphics, 68.0f, 65.0f, SEED_REPEATER, SEED_NONE, 0.0f, 255, false, false);
+    }
+    return image;
+}
+}
+
+void DisposeImage()
+{
+    SpriteCache& cache = CachedSprite();
+    for (auto& image : cache.bonus) image.reset();
+    cache.preview.reset();
+    for (auto& part : cache.filtered)
+        for (auto& image : part) image.reset();
+    for (auto& image : cache.parts) image.reset();
+    cache.definition = nullptr;
+    cache.trackIndices.fill(-1);
+}
+
+void BindParts(Reanimation& reanimation)
+{
+    if (reanimation.mReanimationType != REANIM_ICESHROOM || !reanimation.mDefinition || !reanimation.mTrackInstances) return;
+    const auto& images = GetPartImages();
+    const auto& tracks = GetPartTrackIndices(reanimation);
+    for (int part = 0; part < 5; ++part)
+        if (tracks[part] >= 0)
+        {
+            Sexy::Image* image = images[5].get();
+            ReanimatorTrackInstance& track = reanimation.mTrackInstances[tracks[part]];
+            if (track.mImageOverride != image) track.mImageOverride = image;
+            if (track.mShakeOverride == 0.0f)
+                track.mShakeX = track.mShakeY = 0.0f;
+        }
+}
+
+void BindCap(Reanimation& reanimation, int glow)
+{
+    (void)glow;
+    BindParts(reanimation);
+}
+
+void BindPlantParts(Plant& plant)
+{
+    if (plant.mSeedType != kSeed || !plant.mApp || plant.mDead || plant.mSquished || plant.mPlantHealth < 0) return;
+    if (Reanimation* body = plant.mApp->ReanimationTryToGet(plant.mBodyReanimID)) BindParts(*body);
+    if (Reanimation* blink = plant.mApp->ReanimationTryToGet(plant.mBlinkReanimID)) BindParts(*blink);
+}
+
+BodyExpression GetPlantBodyExpression(const Plant& plant, Reanimation& carrier)
+{
+    if (plant.mIsAsleep || carrier.IsAnimPlaying("anim_sleep")) return BodyExpression::Closed;
+    if (!plant.mApp) return BodyExpression::Auto;
+    BodyExpression expression = BodyExpression::Auto;
+    Reanimation* blink = plant.mApp->ReanimationTryToGet(plant.mBlinkReanimID);
+    if (blink && !blink->mDead && blink->mLoopCount == 0)
+    {
+        ReanimatorFrameTime frame;
+        blink->GetFrameTime(&frame);
+        if (frame.mAnimFrameBeforeInt == 2) expression = BodyExpression::Closed;
+        else if (frame.mAnimFrameBeforeInt == 1 || frame.mAnimFrameBeforeInt == 3) expression = BodyExpression::Half;
+    }
+    return expression;
+}
+
+void DrawRig(Sexy::Graphics* graphics, Reanimation& carrier, BodyExpression expression, const PartMotion& motion)
+{
+    if (carrier.mDead) return;
+    const bool closed = expression == BodyExpression::Closed || carrier.IsAnimPlaying("anim_sleep");
+    const int body = closed ? 4 : expression == BodyExpression::Half ? 3 : 1;
+    DrawRigLayer(graphics, carrier, body, 0.0f, 0.0f);
+    DrawRigLayer(graphics, carrier, 0, motion.capX, motion.capY);
+}
+
+void DrawPlantRig(Sexy::Graphics* graphics, const Plant& plant, Reanimation& carrier)
+{
+    if (plant.mSeedType != kSeed || !plant.mApp || plant.mDead || plant.mSquished || plant.mPlantHealth < 0) return;
+    PartMotion motion;
+    if (!plant.mIsAsleep && plant.mOnBungeeState == NOT_ON_BUNGEE)
+    {
+        motion = GetPartMotion(plant.mStateCountdown, plant.mDoSpecialCountdown);
+        if (GetAttackPhase(plant.mStateCountdown, plant.mDoSpecialCountdown) == AttackPhase::Idle)
+            motion = GetIdlePartMotion(carrier.mAnimTime);
+    }
+    DrawRig(graphics, carrier, GetPlantBodyExpression(plant, carrier), motion);
+}
+
+void ConfigureAttackAnimation(Plant& plant)
+{
+    if (plant.mSeedType != kSeed || !plant.mApp || plant.mDead || plant.mSquished || plant.mPlantHealth < 0) return;
+    Reanimation* body = plant.mApp->ReanimationTryToGet(plant.mBodyReanimID);
+    if (!body) return;
+    const bool winding = !plant.mIsAsleep && plant.mOnBungeeState == NOT_ON_BUNGEE &&
+        GetAttackPhase(plant.mStateCountdown, plant.mDoSpecialCountdown) == AttackPhase::Windup;
+    const char* layer = plant.mIsAsleep || winding ? "anim_sleep" : "anim_idle";
+    if (!body->IsAnimPlaying(layer)) body->PlayReanim(layer, REANIM_LOOP, 6, 12.0f);
+    // The invisible carrier's native saved phase is also the breathing clock.
+    // Reanimation advances by seconds * rate / frameCount, giving a calm loop
+    // independent of how many frames the original idle layer contains.
+    const bool breathing = !plant.mIsAsleep && !winding && plant.mOnBungeeState == NOT_ON_BUNGEE;
+    body->mAnimRate = breathing ? std::max(1, body->mFrameCount) / kIdlePeriodSeconds : 12.0f;
+    if (winding)
+    {
+        plant.EndBlink();
+        plant.mBlinkCountdown = std::max(plant.mBlinkCountdown, kWindupTicks + 1);
+    }
+}
+
+void EnsurePlantReanimation(Plant& plant)
+{
+    if (plant.mSeedType != kSeed || !plant.mApp || plant.mDead || plant.mSquished || plant.mPlantHealth < 0) return;
+    Reanimation* body = plant.mApp->ReanimationTryToGet(plant.mBodyReanimID);
+    if (body && body->mReanimationType != REANIM_ICESHROOM)
+    {
+        // Upgrade the previous muzzle-bearing carrier, retaining the same plant.
+        plant.EndBlink();
+        plant.mApp->RemoveReanimation(plant.mBodyReanimID);
+        plant.mBodyReanimID = REANIMATIONID_NULL;
+        body = nullptr;
+    }
+    if (!body)
+    {
+        const float offsetY = PlantDrawHeightOffset(plant.mBoard, &plant, plant.mSeedType, plant.mPlantCol, plant.mRow);
+        body = plant.mApp->AddReanimation(0.0f, offsetY, plant.mRenderOrder + 1, REANIM_ICESHROOM);
+        body->SetFramesForLayer(plant.mIsAsleep ? "anim_sleep" : "anim_idle");
+        body->mLoopType = REANIM_LOOP;
+        body->mAnimRate = 12.0f;
+        body->mIsAttachment = true;
+        plant.mBodyReanimID = plant.mApp->ReanimationGetID(body);
+        if (plant.mBlinkCountdown <= 0) plant.mBlinkCountdown = 400;
+        if (!plant.mIsAsleep && plant.mOnBungeeState == NOT_ON_BUNGEE)
+        {
+            const AttackPose pose = GetPlantPose(plant.mStateCountdown, plant.mDoSpecialCountdown, body->mAnimTime);
+            body->SetPosition(pose.offsetX, offsetY + pose.offsetY);
+            body->OverrideScale(pose.scaleX, pose.scaleY);
+        }
+    }
+    ConfigureAttackAnimation(plant);
+    if (!plant.mIsAsleep && plant.mOnBungeeState == NOT_ON_BUNGEE &&
+        plant.mWakeUpCounter == 0 && plant.mPottedPlantIndex == -1)
+    {
+        // Refresh older saved squash poses before the first paused draw.
+        const float offsetY = PlantDrawHeightOffset(plant.mBoard, &plant, plant.mSeedType, plant.mPlantCol, plant.mRow);
+        const AttackPose pose = GetPlantPose(plant.mStateCountdown, plant.mDoSpecialCountdown, body->mAnimTime);
+        body->SetPosition(plant.mShakeOffsetX + pose.offsetX, offsetY + pose.offsetY);
+        body->OverrideScale(pose.scaleX, pose.scaleY);
+    }
+    BindPlantParts(plant);
+}
+
+Sexy::Image* GetImage()
+{
+    SpriteCache& cache = CachedSprite();
+    if (cache.preview) return cache.preview.get();
+    cache.preview = MakeNativePortrait(GAMEMODE_CHALLENGE_LANTERN_GLOW);
+    return cache.preview.get();
+}
+
+Sexy::Image* GetBonusImage(GameMode mode)
+{
+    const int index = mode == GAMEMODE_CHALLENGE_CONE_ZONE ? 0 : mode == GAMEMODE_CHALLENGE_NIGHT_SHIFT ? 1 :
+        mode == GAMEMODE_CHALLENGE_LANTERN_GLOW ? 2 : mode == GAMEMODE_CHALLENGE_GARDEN_SHUFFLE ? 3 :
+        mode == GAMEMODE_CHALLENGE_SEED_SWAP ? 4 : -1;
+    if (index < 0) return nullptr;
+    SpriteCache& cache = CachedSprite();
+    if (!cache.bonus[index])
+    {
+        const bool daytime = index == 0 || index == 3 || index == 4;
+        if (!PvzpLoadResources(daytime ? "DelayLoad_Background1" : "DelayLoad_Background2")) return nullptr;
+        Sexy::Image* background = daytime ? Sexy::IMAGE_BACKGROUND1 : Sexy::IMAGE_BACKGROUND2;
+        if (!background) return nullptr;
+        auto picture = MakeBlankImage(80, 65);
+        Sexy::Graphics graphics(picture.get());
+        graphics.SetLinearBlend(true);
+        graphics.DrawImage(background, Sexy::Rect(0, 0, 80, 65), Sexy::Rect(400, 140, 480, 390));
+        auto portrait = MakeNativePortrait(mode);
+        DrawCenteredPortrait(graphics, *portrait);
+        cache.bonus[index] = std::move(picture);
+    }
+    return cache.bonus[index].get();
+}
+
+void DrawSprite(Sexy::Graphics* graphics, float x, float y, float scaleX, float scaleY)
+{
+    if (Sexy::Image* preview = GetImage())
+        PvzpDrawImageScaledF(graphics, preview, x - 20.0f * scaleX, y - 20.0f * scaleY, scaleX, scaleY);
+}
+
+void DrawAttackPulse(Sexy::Graphics* graphics, const Plant& plant, float offsetY)
+{
+    if (plant.mDead || plant.mPlantHealth < 0 || plant.mSquished || plant.mIsAsleep || plant.mOnBungeeState != NOT_ON_BUNGEE) return;
+    const AttackPhase phase = GetAttackPhase(plant.mStateCountdown, plant.mDoSpecialCountdown);
+    if (phase != AttackPhase::Windup && plant.mDoSpecialCountdown <= 0) return;
+    Sexy::Graphics frost(*graphics);
+    // Keep transient frost on the lawn, clear of the seed bank and menu.
+    frost.ClipRect(-plant.mX, 80 - plant.mY, 800, 520);
+    frost.SetColorizeImages(true);
+    struct Direction { float x; float y; };
+    static constexpr Direction directions[12] = {
+        {1,0},{0.8660254f,0.5f},{0.5f,0.8660254f},{0,1},{-0.5f,0.8660254f},{-0.8660254f,0.5f},
+        {-1,0},{-0.8660254f,-0.5f},{-0.5f,-0.8660254f},{0,-1},{0.5f,-0.8660254f},{0.8660254f,-0.5f}
+    };
+    const auto drawCel = [&frost](Sexy::Image* image, float centerX, float centerY, int cel, float scale)
+    {
+        if (!image) return;
+        // This helper takes the unscaled cel's top-left even though its name
+        // contains Center. Anchor every tuft to the actual radial origin.
+        PvzpDrawImageCelCenterScaledF(&frost, image,
+            centerX - image->GetCelWidth() * 0.5f, centerY - image->GetCelHeight() * 0.5f,
+            cel, scale, scale);
+    };
+    if (phase == AttackPhase::Windup)
+    {
+        const float progress = (kWindupTicks - plant.mStateCountdown) / static_cast<float>(kWindupTicks);
+        const float radius = 20.0f - 14.0f * progress;
+        frost.SetColor(Sexy::Color(225, 245, 255, 50 + static_cast<int>(progress * 70.0f)));
+        if (Sexy::IMAGE_SNOWFLAKES)
+            for (int i = 0; i < 12; i += 3)
+                drawCel(Sexy::IMAGE_SNOWFLAKES, 40.0f + directions[i].x * radius,
+                    36.0f + offsetY + directions[i].y * radius * 0.65f, (i / 3) % 3, 0.35f);
+        return;
+    }
+    // Native snowpea clouds carry the plume. Staggered emission, slower eased
+    // travel and a long fade read as drifting frost rather than a fast ring of
+    // snowflake icons. The existing radial chill remains a release-time pulse.
+    for (int i = 0; i < 12; ++i)
+    {
+        const FrostTuft tuft = GetFrostTuft(plant.mDoSpecialCountdown, i);
+        if (tuft.alpha <= 0) continue;
+        const float centerX = 40.0f + directions[i].x * tuft.distance;
+        const float centerY = 40.0f + offsetY + directions[i].y * tuft.distance;
+        frost.SetColor(Sexy::Color(215, 240, 255, tuft.alpha));
+        drawCel(Sexy::IMAGE_SNOWPEA_PUFF, centerX, centerY, tuft.cel, tuft.scale);
+        if (i % 3 == 0)
+        {
+            frost.SetColor(Sexy::Color(230, 248, 255, tuft.alpha / 2));
+            drawCel(Sexy::IMAGE_SNOWFLAKES, centerX, centerY, (i / 3) % 3, 0.30f);
+        }
+    }
+}
+}
diff --git a/src/Lawn/System/LanternShroom.h b/src/Lawn/System/LanternShroom.h
new file mode 100644
index 0000000000000000000000000000000000000000..022de0835e423aa80123d50cf00693532105d0ac
--- /dev/null
+++ b/src/Lawn/System/LanternShroom.h
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include "../../ConstEnums.h"
+#include <algorithm>
+#include <cmath>
+
+namespace Sexy { class Image; class Graphics; }
+class Plant;
+class Reanimation;
+
+// Stored in existing Plant counters; native saved-object layouts stay unchanged.
+namespace LanternShroom
+{
+struct PartMotion
+{
+    float capX = 0.0f;
+    float capY = 0.0f;
+};
+enum class BodyExpression { Auto, Half, Closed };
+Sexy::Image* GetImage();
+void DisposeImage();
+void BindParts(Reanimation& reanimation);
+void BindPlantParts(Plant& plant);
+void BindCap(Reanimation& reanimation, int glow = 0);
+void EnsurePlantReanimation(Plant& plant);
+void ConfigureAttackAnimation(Plant& plant);
+Sexy::Image* GetBonusImage(GameMode mode);
+void DrawAttackPulse(Sexy::Graphics* graphics, const Plant& plant, float offsetY);
+void DrawSprite(Sexy::Graphics* graphics, float x, float y, float scaleX, float scaleY);
+BodyExpression GetPlantBodyExpression(const Plant& plant, Reanimation& carrier);
+void DrawRig(Sexy::Graphics* graphics, Reanimation& carrier, BodyExpression expression = BodyExpression::Auto, const PartMotion& motion = {});
+void DrawPlantRig(Sexy::Graphics* graphics, const Plant& plant, Reanimation& carrier);
+
+inline constexpr SeedType kSeed = SEED_LANTERNSHROOM;
+inline constexpr int kCost = 75;
+inline constexpr int kRecharge = 750;
+inline constexpr int kPulseInterval = 400;
+inline constexpr int kSlowDuration = 150;
+inline constexpr int kRadius = 150;
+inline constexpr int kPulseFrames = 100;
+inline constexpr int kRecoilTicks = 30;
+inline constexpr int kWindupTicks = 40;
+inline constexpr int kReadyCountdown = kWindupTicks + 1;
+inline constexpr float kIdlePeriodSeconds = 2.4f;
+
+enum class AttackPhase { Idle, Windup, Release };
+struct AttackPose
+{
+    float scaleX = 1.0f;
+    float scaleY = 1.0f;
+    float offsetX = 0.0f;
+    float offsetY = 0.0f;
+};
+constexpr AttackPhase GetAttackPhase(int cooldown, int glow)
+{
+    // The plume outlives the recoil; breathing resumes while the mist fades.
+    if (glow > kPulseFrames - kRecoilTicks) return AttackPhase::Release;
+    if (cooldown > 0 && cooldown <= kWindupTicks) return AttackPhase::Windup;
+    return AttackPhase::Idle;
+}
+constexpr float Ease(float value) { return value * value * (3.0f - 2.0f * value); }
+constexpr AttackPose GetAttackPose(int cooldown, int glow)
+{
+    AttackPose pose;
+    if (GetAttackPhase(cooldown, glow) == AttackPhase::Windup)
+    {
+        const float amount = Ease((kWindupTicks - cooldown) / static_cast<float>(kWindupTicks));
+        pose.scaleX = 1.0f + 0.08f * amount;
+        pose.scaleY = 1.0f - 0.17f * amount;
+    }
+    else if (GetAttackPhase(cooldown, glow) == AttackPhase::Release)
+    {
+        const float progress = std::clamp(kPulseFrames - glow, 0, kRecoilTicks) / static_cast<float>(kRecoilTicks);
+        if (progress < 1.0f / 3.0f)
+        {
+            const float amount = Ease(progress * 3.0f);
+            pose.scaleX = 1.08f - 0.10f * amount;
+            pose.scaleY = 0.83f + 0.21f * amount;
+        }
+        else
+        {
+            const float amount = Ease((progress - 1.0f / 3.0f) * 1.5f);
+            pose.scaleX = 0.98f + 0.02f * amount;
+            pose.scaleY = 1.04f - 0.04f * amount;
+        }
+    }
+    pose.offsetX = 40.0f * (1.0f - pose.scaleX);
+    pose.offsetY = 72.0f * (1.0f - pose.scaleY);
+    return pose;
+}
+
+inline AttackPose GetIdlePose(float animTime)
+{
+    AttackPose pose;
+    const float breath = 0.5f - 0.5f * std::cos(animTime * 6.28318530718f);
+    pose.scaleX = 1.0f + 0.012f * breath;
+    pose.scaleY = 1.0f - 0.020f * breath;
+    // Squash around the body's ground contact instead of bobbing off the lawn.
+    pose.offsetX = 40.0f * (1.0f - pose.scaleX);
+    pose.offsetY = 72.0f * (1.0f - pose.scaleY);
+    return pose;
+}
+
+inline AttackPose GetPlantPose(int cooldown, int glow, float animTime)
+{
+    return GetAttackPhase(cooldown, glow) == AttackPhase::Idle ? GetIdlePose(animTime) : GetAttackPose(cooldown, glow);
+}
+
+inline PartMotion GetIdlePartMotion(float animTime)
+{
+    PartMotion motion;
+    // A little cap compression is visible at native size and never opens a seam.
+    motion.capY = 0.4f * (1.0f - std::cos(animTime * 6.28318530718f));
+    return motion;
+}
+
+constexpr PartMotion GetPartMotion(int cooldown, int glow)
+{
+    PartMotion motion;
+    if (GetAttackPhase(cooldown, glow) == AttackPhase::Windup)
+    {
+        const float amount = Ease((kWindupTicks - cooldown) / static_cast<float>(kWindupTicks));
+        motion.capY = 1.2f * amount;
+    }
+    else if (GetAttackPhase(cooldown, glow) == AttackPhase::Release)
+    {
+        const float progress = std::clamp(kPulseFrames - glow, 0, kRecoilTicks) / static_cast<float>(kRecoilTicks);
+        if (progress < 0.4f)
+        {
+            const float amount = Ease(progress / 0.4f);
+            motion.capY = 1.2f + 0.8f * amount;
+        }
+        else
+        {
+            const float amount = 1.0f - Ease((progress - 0.4f) / 0.6f);
+            motion.capY = 2.0f * amount;
+        }
+    }
+    return motion;
+}
+
+constexpr bool AdvancePulse(int& cooldown, int& glow, bool hasTarget)
+{
+    if (glow > 0) --glow;
+    // Let the cooldown expire on an empty lawn, but reserve the wind-up for an
+    // actual target. Recheck each tick so a departing target cancels the shot.
+    if (!hasTarget && cooldown <= kReadyCountdown)
+    {
+        cooldown = kReadyCountdown;
+        return false;
+    }
+    if (cooldown > 0) --cooldown;
+    if (cooldown != 0) return false;
+    cooldown = kPulseInterval;
+    glow = kPulseFrames;
+    return true;
+}
+
+struct FrostTuft
+{
+    float distance = 0.0f;
+    float scale = 0.0f;
+    int alpha = 0;
+    int cel = 0;
+};
+
+constexpr FrostTuft GetFrostTuft(int glow, int index)
+{
+    FrostTuft tuft;
+    if (index < 0 || index >= 12 || glow <= 0) return tuft;
+    const int age = kPulseFrames - std::clamp(glow, 0, kPulseFrames);
+    const int delay = (index % 3) * 6;
+    const int localAge = age - delay;
+    const int life = kPulseFrames - delay;
+    if (localAge <= 0 || localAge >= life) return tuft;
+    const float travel = Ease(std::clamp(localAge / 55.0f, 0.0f, 1.0f));
+    const float fadeIn = std::clamp(localAge / 6.0f, 0.0f, 1.0f);
+    const float fadeOut = 1.0f - Ease(std::clamp((localAge - 45.0f) / (life - 45.0f), 0.0f, 1.0f));
+    tuft.distance = 12.0f + (kRadius - 12.0f) * travel;
+    tuft.scale = 0.35f + 0.25f * Ease(std::clamp(localAge / 55.0f, 0.0f, 1.0f));
+    tuft.alpha = static_cast<int>(160.0f * fadeIn * fadeOut);
+    tuft.cel = std::min(5, localAge / 16);
+    return tuft;
+}
+constexpr bool InRange(float dx, float dy)
+{
+    return dx * dx + dy * dy <= static_cast<float>(kRadius * kRadius);
+}
+static_assert(static_cast<int>(kSeed) == 75);
+}
diff --git a/src/Lawn/System/MenderBloom.cpp b/src/Lawn/System/MenderBloom.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e3a2ee285e2eb7a9d4836988d83008850acb1487
--- /dev/null
+++ b/src/Lawn/System/MenderBloom.cpp
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "MenderBloom.h"
+#include "MenderBloomArt.h"
+#include "../Board.h"
+#include "../Plant.h"
+#include "../../LawnApp.h"
+#include "../../SexyAppFramework/graphics/MemoryImage.h"
+#include "../../SexyAppFramework/graphics/Graphics.h"
+#include "../../PvzpLib/PvzpCommon.h"
+#include "../../PvzpLib/Reanimator.h"
+#include "../../PvzpLib/FilterEffect.h"
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace MenderBloom
+{
+bool IsEligibleTarget(const Plant& healer, const Plant& target)
+{
+    return &healer != &target && healer.mBoard && target.mBoard == healer.mBoard &&
+        target.mApp == healer.mApp && target.mIsOnBoard && !target.mDead &&
+        !target.mSquished && target.mOnBungeeState == NOT_ON_BUNGEE &&
+        target.mPlantHealth > 0 && target.mPlantMaxHealth > target.mPlantHealth &&
+        target.mState != STATE_DOINGSPECIAL && IsPersistentTargetSeed(target.mSeedType) &&
+        InRange(target.mPlantCol - healer.mPlantCol, target.mRow - healer.mRow);
+}
+
+void Update(Plant& healer)
+{
+    if (healer.mSeedType != kSeed || !healer.mBoard || !healer.mApp ||
+        !healer.IsInPlay() || healer.mApp->mGameScene != SCENE_PLAYING ||
+        healer.mBoard->mPaused || healer.mBoard->mTimeStopCounter > 0 ||
+        healer.mBoard->mLevelComplete || healer.mBoard->HasLevelAwardDropped() ||
+        healer.mDead || healer.mPlantHealth <= 0 || healer.mIsAsleep ||
+        healer.mSquished || healer.mOnBungeeState != NOT_ON_BUNGEE)
+        return;
+    if (healer.mDoSpecialCountdown > 0) --healer.mDoSpecialCountdown;
+    if (healer.mStateCountdown > 0) --healer.mStateCountdown;
+    if (healer.mStateCountdown > 0) return;
+
+    bool healed = false;
+    for (Plant* target : healer.mBoard->mPlants)
+    {
+        if (!IsEligibleTarget(healer, *target)) continue;
+        const int previous = target->mPlantHealth;
+        target->mPlantHealth = BoundedHeal(previous, target->mPlantMaxHealth);
+        if (target->mPlantHealth == previous) continue;
+        healed = true;
+        // Native sparkle particles are short-lived and occur only on an actual
+        // repair. They do not add persistent range circles or health labels.
+        healer.mApp->AddPvzpParticle(target->mX + 40, target->mY + 28,
+            target->mRenderOrder + 2, PARTICLE_TROPHY_SPARKLE);
+        if (target->mSeedType == SEED_GARLIC && previous < target->mPlantMaxHealth / 3 &&
+            target->mPlantHealth >= target->mPlantMaxHealth / 3)
+            if (Reanimation* body = healer.mApp->ReanimationTryToGet(target->mBodyReanimID))
+                body->AssignRenderGroupToPrefix("Garlic_stem", RENDER_GROUP_NORMAL);
+    }
+    if (healed)
+    {
+        healer.mStateCountdown = kPulseInterval;
+        healer.mDoSpecialCountdown = kHealingFrames;
+    }
+}
+
+namespace
+{
+struct SpriteCache
+{
+    std::array<std::unique_ptr<Sexy::MemoryImage>, 4> images;
+    std::array<std::array<std::unique_ptr<Sexy::MemoryImage>, NUM_FILTER_EFFECTS>, 3> filtered;
+};
+SpriteCache& Cache()
+{
+    static SpriteCache cache;
+    return cache;
+}
+
+std::unique_ptr<Sexy::MemoryImage> MakeImage(const uint32_t* argb)
+{
+    std::vector<uint32_t> pixels(argb, argb + MenderBloomArt::kWidth * MenderBloomArt::kHeight);
+    auto image = std::make_unique<Sexy::MemoryImage>();
+    image->SetBits(pixels.data(), MenderBloomArt::kWidth, MenderBloomArt::kHeight);
+    return image;
+}
+
+void EnsureImages()
+{
+    static_assert(MenderBloomArt::kWidth == 80 && MenderBloomArt::kHeight == 80,
+        "Mender-bloom layers share the registered native plant canvas");
+    SpriteCache& cache = Cache();
+    if (cache.images[0]) return;
+    cache.images[0] = MakeImage(MenderBloomArt::kHeadArgb);
+    cache.images[1] = MakeImage(MenderBloomArt::kStemArgb);
+    cache.images[2] = MakeImage(MenderBloomArt::kHeadBlinkArgb);
+    cache.images[3] = MakeImage(MenderBloomArt::kArgb);
+    for (int layer = 0; layer < 3; ++layer)
+        for (int filter = 0; filter < NUM_FILTER_EFFECTS; ++filter)
+            cache.filtered[layer][filter].reset(FilterEffectCreateImage(cache.images[layer].get(), static_cast<FilterEffect>(filter)));
+}
+
+Sexy::Image* GetLayerImage(int layer, FilterEffect filter)
+{
+    EnsureImages();
+    if (filter >= 0 && filter < NUM_FILTER_EFFECTS && Cache().filtered[layer][filter])
+        return Cache().filtered[layer][filter].get();
+    return Cache().images[layer].get();
+}
+
+void DrawLayer(Sexy::Graphics* graphics, Reanimation& carrier, int layer, const LayerPose& pose)
+{
+    Sexy::Image* image = GetLayerImage(layer, carrier.mFilterEffect);
+    SexyMatrix3 local;
+    PvzpScaleRotateTransformMatrix(local, pose.centerX, pose.centerY,
+        pose.angle, pose.scaleX, pose.scaleY);
+    SexyMatrix3 matrix;
+    SexyMatrix3Multiply(matrix, carrier.mOverlayMatrix, local);
+    SexyMatrix3Translation(matrix, graphics->mTransX, graphics->mTransY);
+    Sexy::Color color = carrier.mColorOverride;
+    if (graphics->GetColorizeImages()) color = ColorsMultiply(color, graphics->GetColor());
+    if (color.mAlpha <= 0) return;
+    const Sexy::Rect source(0, 0, image->GetWidth(), image->GetHeight());
+    carrier.ReanimBltMatrix(graphics, image, matrix, graphics->mClipRect, color, graphics->GetDrawMode(), source);
+    if (carrier.mEnableExtraAdditiveDraw)
+    {
+        Sexy::Color additive = carrier.mExtraAdditiveColor;
+        additive.mAlpha = ColorComponentMultiply(additive.mAlpha, color.mAlpha);
+        carrier.ReanimBltMatrix(graphics, image, matrix, graphics->mClipRect, additive,
+            Sexy::Graphics::DRAWMODE_ADDITIVE, source);
+    }
+    if (carrier.mEnableExtraOverlayDraw)
+    {
+        Sexy::Color overlay = carrier.mExtraOverlayColor;
+        overlay.mAlpha = ColorComponentMultiply(overlay.mAlpha, color.mAlpha);
+        carrier.ReanimBltMatrix(graphics, GetLayerImage(layer, FILTER_EFFECT_WHITE), matrix,
+            graphics->mClipRect, overlay, Sexy::Graphics::DRAWMODE_NORMAL, source);
+    }
+}
+
+void HideCarrier(Reanimation& carrier)
+{
+    if (carrier.mDefinition && carrier.mTrackInstances)
+        carrier.AssignRenderGroupToPrefix("", RENDER_GROUP_HIDDEN);
+}
+}
+
+void EnsurePlantReanimation(Plant& plant)
+{
+    if (plant.mSeedType != kSeed || !plant.mApp || plant.mDead || plant.mSquished || plant.mPlantHealth <= 0) return;
+    Reanimation* body = plant.mApp->ReanimationTryToGet(plant.mBodyReanimID);
+    if (body && body->mReanimationType != REANIM_SUNFLOWER)
+    {
+        plant.EndBlink();
+        plant.mApp->RemoveReanimation(plant.mBodyReanimID);
+        plant.mBodyReanimID = REANIMATIONID_NULL;
+        body = nullptr;
+    }
+    if (!body)
+    {
+        const float offsetY = PlantDrawHeightOffset(plant.mBoard, &plant, kSeed, plant.mPlantCol, plant.mRow);
+        body = plant.mApp->AddReanimation(0.0f, offsetY, plant.mRenderOrder + 1, REANIM_SUNFLOWER);
+        body->SetFramesForLayer("anim_idle");
+        body->mLoopType = REANIM_LOOP;
+        body->mIsAttachment = true;
+        plant.mBodyReanimID = plant.mApp->ReanimationGetID(body);
+        if (plant.mBlinkCountdown <= 0) plant.mBlinkCountdown = 400;
+    }
+    // Its native saved phase is an animation clock; none of the Sunflower's
+    // original images or production behavior are rendered or used here.
+    body->mAnimRate = std::max(1, body->mFrameCount) / kIdlePeriodSeconds;
+    HideCarrier(*body);
+    if (Reanimation* blink = plant.mApp->ReanimationTryToGet(plant.mBlinkReanimID)) HideCarrier(*blink);
+}
+
+void DrawPlantRig(Sexy::Graphics* graphics, const Plant& plant, Reanimation& carrier)
+{
+    if (plant.mSeedType != kSeed || carrier.mDead || plant.mDead || plant.mPlantHealth <= 0) return;
+    bool blink = plant.mIsAsleep;
+    if (plant.mApp)
+        if (Reanimation* expression = plant.mApp->ReanimationTryToGet(plant.mBlinkReanimID))
+            blink = blink || (!expression->mDead && expression->mLoopCount == 0 &&
+                expression->mAnimTime >= 0.2f && expression->mAnimTime <= 0.8f);
+    const int glow = plant.mIsAsleep || plant.mSquished || plant.mOnBungeeState != NOT_ON_BUNGEE ? 0 : plant.mDoSpecialCountdown;
+    blink = blink || (glow > kHealingFrames / 3 && glow < kHealingFrames * 4 / 5);
+    DrawLayer(graphics, carrier, 1, GetStemPose(carrier.mAnimTime));
+    DrawLayer(graphics, carrier, blink ? 2 : 0, GetHeadPose(carrier.mAnimTime, glow));
+}
+
+Sexy::Image* GetImage()
+{
+    EnsureImages();
+    return Cache().images[3].get();
+}
+
+void DrawSprite(Sexy::Graphics* graphics, float x, float y, float scaleX, float scaleY)
+{
+    PvzpDrawImageScaledF(graphics, GetImage(), x, y, scaleX, scaleY);
+}
+
+void DisposeImage()
+{
+    SpriteCache& cache = Cache();
+    for (auto& image : cache.images) image.reset();
+    for (auto& layer : cache.filtered)
+        for (auto& image : layer) image.reset();
+}
+}
