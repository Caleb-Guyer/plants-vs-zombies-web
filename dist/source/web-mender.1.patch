-static void CalculateFPS()
-{
-	gFrameCount++;
-
-	if (gFPSTimer.GetDuration() >= 1000 || gForceDisplay)
-	{
-		gFPSTimer.Stop();
-		if (!gForceDisplay)
-			gFPSDisplay = static_cast<int>(gFrameCount * 1000 / gFPSTimer.GetDuration() + 0.5f);
-		else
-		{
-			gForceDisplay = false;
-			gFPSDisplay = 0;
-		}
-
-		gFPSTimer.Start();
-		gFrameCount = 0;
-	}
