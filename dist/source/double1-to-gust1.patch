diff --git a/src/Lawn/System/GustChallenge.cpp b/src/Lawn/System/GustChallenge.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5005433f01b13f90f786b681ea8d97ed24654723
--- /dev/null
+++ b/src/Lawn/System/GustChallenge.cpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "GustChallenge.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../SeedPacket.h"
+#include "../Zombie.h"
+#include "../../LawnApp.h"
+#include <algorithm>
+
+namespace GustChallenge
+{
+bool Validate(const Board& board)
+{
+    if (!board.mApp || !board.mChallenge || !board.mSeedBank || !IsMode(board.mApp->mGameMode)) return false;
+    const Challenge& challenge = *board.mChallenge;
+    if (!IsCurrentRules(board.mApp->mGameMode,challenge.mChallengeState) || challenge.mChallengeGridY != kRulesVersion ||
+        challenge.mSurvivalStage < 0 || challenge.mSurvivalStage > kWaveCount || challenge.mChallengeScore < kOpeningPackets ||
+        challenge.mChallengeScore > kPacketCount || challenge.mChallengeStateCounter < 0 ||
+        challenge.mChallengeStateCounter > kFormationInterval || challenge.mConveyorBeltCounter < 0 ||
+        challenge.mConveyorBeltCounter > kSupplyInterval || board.mSeedBank->mNumPackets != kBankSize || board.mSunMoney != 0) return false;
+    for (const SeedPacket& packet : board.mSeedBank->mSeedPackets)
+    {
+        if (packet.mPacketType == SEED_NONE) continue;
+        if (std::find(kSeeds.begin(),kSeeds.end(),packet.mPacketType) == kSeeds.end()) return false;
+    }
+    return true;
+}
+void PreloadResources()
+{
+    for (SeedType seed : kSeeds) Plant::PreloadPlantResources(seed);
+    Plant::PreloadPlantResources(SEED_SPIKEWEED);
+    for (const Formation& wave : kFormations) for (const Spawn& spawn : wave)
+        if (spawn.mType != ZOMBIE_INVALID) Zombie::PreloadZombieResources(spawn.mType);
+}
+void Populate(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    challenge.mChallengeState = kActive;
+    challenge.mChallengeStateCounter = kOpeningDelay;
+    challenge.mChallengeScore = challenge.mSurvivalStage = 0;
+    challenge.mChallengeGridY = kRulesVersion;
+    challenge.mConveyorBeltCounter = kSupplyInterval;
+    board.mCurrentWave = board.mTotalSpawnedWaves = 0;
+    board.mZombieCountDown = board.mZombieCountDownStart = kOpeningDelay;
+    board.mZombieHealthToNextWave = -1;
+    board.mSunMoney = 0;
+    board.mShowShovel = true;
+    board.mBonusLawnMowersRemaining = 0;
+    board.ClearCursor();
+    FillSeedBank(*board.mSeedBank);
+    for (SeedPacket& packet : board.mSeedBank->mSeedPackets) packet.mPacketType = SEED_NONE;
+    for (int i = 0; i < kOpeningPackets; ++i)
+    {
+        const SeedType seed = SeedForSupply(challenge.mChallengeScore++);
+        board.mSeedBank->AddSeed(seed,true);
+        challenge.mLastConveyorSeedType = seed;
+    }
+    for (const StartingPlant& plant : kStartingPlants) board.AddPlant(plant.mCol,plant.mRow,plant.mSeed,SEED_NONE);
+}
+void Update(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (challenge.mChallengeState != kActive || board.mApp->mGameScene != SCENE_PLAYING || board.mPaused ||
+        board.mTimeStopCounter > 0 || board.mLevelComplete || board.HasLevelAwardDropped()) return;
+    board.mShowShovel = true;
+    board.mSeedBank->UpdateConveyorBelt();
+    if (challenge.mChallengeScore < kPacketCount &&
+        board.mSeedBank->GetNumSeedsOnConveyorBelt() < board.mSeedBank->mNumPackets)
+    {
+        if (challenge.mConveyorBeltCounter > 0) --challenge.mConveyorBeltCounter;
+        if (challenge.mConveyorBeltCounter == 0)
+        {
+            const SeedType seed = SeedForSupply(challenge.mChallengeScore++);
+            board.mSeedBank->AddSeed(seed);
+            challenge.mLastConveyorSeedType = seed;
+            challenge.mConveyorBeltCounter = kSupplyInterval;
+        }
+    }
+    const int next = std::clamp(challenge.mSurvivalStage,0,kWaveCount);
+    if (next < kWaveCount)
+    {
+        if (challenge.mChallengeStateCounter > 0) --challenge.mChallengeStateCounter;
+        board.mZombieCountDown = challenge.mChallengeStateCounter;
+        if (challenge.mChallengeStateCounter != 0) return;
+        board.NextWaveComing();
+        for (const Spawn& spawn : kFormations[next])
+        {
+            if (spawn.mType == ZOMBIE_INVALID) continue;
+            Zombie* zombie = board.AddZombieInRow(spawn.mType,spawn.mRow,next);
+            zombie->mPosX = static_cast<float>(spawn.mX);
+            zombie->mX = spawn.mX;
+            zombie->UpdateReanim();
+        }
+        challenge.mSurvivalStage = next + 1;
+        board.mCurrentWave = board.mTotalSpawnedWaves = next + 1;
+        board.mZombieHealthWaveStart = board.TotalZombiesHealthInWave(next);
+        board.mZombieHealthToNextWave = -1;
+        challenge.mChallengeStateCounter = kFormationInterval;
+        board.mZombieCountDown = board.mZombieCountDownStart = kFormationInterval;
+        return;
+    }
+    if (board.AreEnemyZombiesOnScreen()) return;
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    challenge.mChallengeState = kFinished;
+    challenge.SpawnLevelAward(4,2);
+}
+}
diff --git a/src/Lawn/System/GustChallenge.h b/src/Lawn/System/GustChallenge.h
new file mode 100644
index 0000000000000000000000000000000000000000..6d8be3045d08f8e04d215a29934f56bf8b57a73c
--- /dev/null
+++ b/src/Lawn/System/GustChallenge.h
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+
+class Board;
+
+// Headwind uses a fixed native Spikeweed course and a finite conveyor.
+// Short gusts recycle light crowds over spikes; stock heavy counters matter.
+namespace GustChallenge
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_HEADWIND;
+inline constexpr ChallengeState kActive = static_cast<ChallengeState>(144);
+inline constexpr ChallengeState kFinished = static_cast<ChallengeState>(145);
+inline constexpr int kProfileIndex = 91;
+inline constexpr int kRulesVersion = 1;
+inline constexpr int kStartingSun = 0;
+inline constexpr int kWaveCount = 6;
+inline constexpr int kLargestFormation = 8;
+inline constexpr int kOpeningDelay = 700;
+inline constexpr int kFormationInterval = 1800;
+inline constexpr int kBankSize = 10;
+inline constexpr int kOpeningPackets = 4;
+inline constexpr int kPacketCount = 32;
+inline constexpr int kSupplyInterval = 200;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{ return IsMode(mode) && (state == kActive || state == kFinished); }
+inline constexpr std::array<SeedType,6> kSeeds = {SEED_GUSTBLOOM,SEED_PEASHOOTER,
+    SEED_REPEATER,SEED_WALLNUT,SEED_CHERRYBOMB,SEED_SQUASH};
+inline constexpr std::array<SeedType,8> kSupplyCycle = {SEED_GUSTBLOOM,SEED_PEASHOOTER,
+    SEED_GUSTBLOOM,SEED_REPEATER,SEED_WALLNUT,SEED_GUSTBLOOM,SEED_CHERRYBOMB,SEED_SQUASH};
+constexpr SeedType SeedForSupply(int ordinal)
+{ return ordinal >= 0 && ordinal < kPacketCount ? kSupplyCycle[ordinal % kSupplyCycle.size()] : SEED_NONE; }
+struct StartingPlant { SeedType mSeed; int mCol; int mRow; };
+inline constexpr std::array<StartingPlant,15> kStartingPlants = {{{SEED_PEASHOOTER,0,0},
+    {SEED_PEASHOOTER,0,1},{SEED_PEASHOOTER,0,2},{SEED_PEASHOOTER,0,3},{SEED_PEASHOOTER,0,4},
+    {SEED_SPIKEWEED,5,0},{SEED_SPIKEWEED,5,1},{SEED_SPIKEWEED,5,2},{SEED_SPIKEWEED,5,3},{SEED_SPIKEWEED,5,4},
+    {SEED_SPIKEWEED,6,0},{SEED_SPIKEWEED,6,1},{SEED_SPIKEWEED,6,2},{SEED_SPIKEWEED,6,3},{SEED_SPIKEWEED,6,4}}};
+struct Spawn { ZombieType mType = ZOMBIE_INVALID; int mRow = 0; int mX = 0; };
+using Formation = std::array<Spawn,kLargestFormation>;
+inline constexpr std::array<Formation,kWaveCount> kFormations = {{
+    {{{ZOMBIE_NORMAL,1,760},{ZOMBIE_NORMAL,3,760}}},
+    {{{ZOMBIE_TRAFFIC_CONE,0,800},{ZOMBIE_TRAFFIC_CONE,2,800},{ZOMBIE_TRAFFIC_CONE,4,800}}},
+    {{{ZOMBIE_NORMAL,0,800},{ZOMBIE_DOOR,1,800},{ZOMBIE_NORMAL,2,840},{ZOMBIE_DOOR,3,800},{ZOMBIE_NORMAL,4,800}}},
+    {{{ZOMBIE_FOOTBALL,0,800},{ZOMBIE_PAIL,1,800},{ZOMBIE_TRAFFIC_CONE,2,800},{ZOMBIE_PAIL,3,800},{ZOMBIE_FOOTBALL,4,800}}},
+    {{{ZOMBIE_NORMAL,0,800},{ZOMBIE_NORMAL,1,800},{ZOMBIE_NORMAL,2,800},{ZOMBIE_NORMAL,3,800},{ZOMBIE_NORMAL,4,800},
+      {ZOMBIE_TRAFFIC_CONE,1,860},{ZOMBIE_TRAFFIC_CONE,3,860}}},
+    {{{ZOMBIE_PAIL,0,800},{ZOMBIE_FOOTBALL,1,800},{ZOMBIE_GARGANTUAR,2,850},{ZOMBIE_FOOTBALL,3,800},
+      {ZOMBIE_PAIL,4,800},{ZOMBIE_NORMAL,0,880},{ZOMBIE_NORMAL,4,880}}}
+}};
+constexpr int ZombieCount(int wave)
+{
+    if (wave < 0 || wave >= kWaveCount) return 0;
+    int count = 0; for (const Spawn& spawn : kFormations[wave]) count += spawn.mType != ZOMBIE_INVALID;
+    return count;
+}
+template<std::size_t Waves,std::size_t Slots> int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kWaveCount && Slots > kLargestFormation);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    for (int wave = 0; wave < kWaveCount; ++wave)
+        for (int i = 0; i < ZombieCount(wave); ++i) output[wave][i] = kFormations[wave][i].mType;
+    return kWaveCount;
+}
+template<std::size_t Count> void PopulateAllowedZombies(bool (&output)[Count])
+{
+    for (auto& allowed : output) allowed = false;
+    for (const Formation& wave : kFormations) for (const Spawn& spawn : wave)
+        if (spawn.mType != ZOMBIE_INVALID) output[spawn.mType] = true;
+}
+template<class Bank> void FillSeedBank(Bank& bank) { bank.mNumPackets = kBankSize; }
+bool Validate(const Board& board);
+void PreloadResources();
+void Populate(Board& board);
+void Update(Board& board);
+static_assert(static_cast<int>(kMode) == 92 && ZombieCount(0)+ZombieCount(1)+ZombieCount(2)+
+    ZombieCount(3)+ZombieCount(4)+ZombieCount(5) == 29);
+}
