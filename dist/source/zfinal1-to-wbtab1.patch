+
+int FamilySlot(ChallengePage page, const ChallengeDefinition& def)
+{
+	if (def.mPage == page) return def.mRow * 5 + def.mCol;
+	if (page == CHALLENGE_PAGE_BOWLING) {
+		if (def.mChallengeMode == GAMEMODE_CHALLENGE_WALLNUT_BOWLING) return 0;
+		if (def.mChallengeMode == GAMEMODE_CHALLENGE_WALLNUT_BOWLING_2) return 1;
+	}
+	if (page == CHALLENGE_PAGE_ZOMBOTANY) {
+		if (def.mChallengeMode == GAMEMODE_CHALLENGE_WAR_AND_PEAS) return 0;
+		if (def.mChallengeMode == GAMEMODE_CHALLENGE_WAR_AND_PEAS_2) return 1;
+	}
+	return -1;
+}
