diff --git a/src/Lawn/System/ZomBotanyBeghouled.cpp b/src/Lawn/System/ZomBotanyBeghouled.cpp
new file mode 100644
index 0000000..823f3e0
--- /dev/null
+++ b/src/Lawn/System/ZomBotanyBeghouled.cpp
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "ZomBotanyBeghouled.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include "../../LawnApp.h"
+#include <algorithm>
+#include <array>
+#include <span>
+
+namespace ZomBotanyBeghouled
+{
+namespace
+{
+constexpr ZombieType single[] = {ZOMBIE_PEA_HEAD};
+constexpr ZombieType peas[] = {ZOMBIE_PEA_HEAD, ZOMBIE_PEA_HEAD};
+constexpr ZombieType armor[] = {ZOMBIE_WALLNUT_HEAD, ZOMBIE_PEA_HEAD};
+constexpr ZombieType escort[] = {ZOMBIE_WALLNUT_HEAD, ZOMBIE_GATLING_HEAD};
+constexpr ZombieType mixed[] = {ZOMBIE_WALLNUT_HEAD, ZOMBIE_GATLING_HEAD, ZOMBIE_PEA_HEAD};
+constexpr ZombieType twoEscorts[] = {ZOMBIE_WALLNUT_HEAD, ZOMBIE_GATLING_HEAD,
+                                     ZOMBIE_WALLNUT_HEAD, ZOMBIE_GATLING_HEAD};
+struct Wave { int matches; int interval; std::span<const ZombieType> heads; };
+constexpr std::array<Wave, 7> waves = {{
+    {2, 800, single}, {9, 1450, peas}, {16, 1600, armor}, {23, 1650, escort},
+    {30, 1500, mixed}, {38, 1500, escort}, {45, 1700, twoEscorts}
+}};
+}
+
+void ConfigureWaves(Board& board)
+{
+    for (auto& bank : board.mZombiesInWave)
+        std::fill(std::begin(bank), std::end(bank), ZOMBIE_INVALID);
+    board.mNumWaves = static_cast<int>(waves.size());
+    for (int i = 0; i < board.mNumWaves; ++i)
+        std::copy(waves[i].heads.begin(), waves[i].heads.end(), board.mZombiesInWave[i]);
+}
+
+void UpdateSpawning(Board& board)
+{
+    // Time keeps pressure on idle lawns. Match milestones bring the same waves
+    // forward for quicker players, with space between consecutive entrances.
+    const int index = std::min(board.mCurrentWave, board.mNumWaves - 1);
+    const Wave& wave = waves[index];
+    --board.mZombieCountDown;
+    const bool reachedMilestone = board.mTotalSpawnedWaves < board.mNumWaves &&
+        board.mChallenge->mChallengeScore >= wave.matches &&
+        board.mZombieCountDownStart - board.mZombieCountDown >= 350;
+    if (board.mZombieCountDown > 0 && !reachedMilestone) return;
+    board.SpawnZombieWave();
+    const int next = std::min(board.mCurrentWave, board.mNumWaves - 1);
+    board.mZombieCountDown = board.mZombieCountDownStart = waves[next].interval;
+}
+
+void SpawnWave(Board& board)
+{
+    // The continuous-challenge handler rewinds the last wave before this call.
+    Zombie* shield = nullptr;
+    for (ZombieType type : board.mZombiesInWave[board.mCurrentWave])
+    {
+        if (type == ZOMBIE_INVALID) break;
+        if (type == ZOMBIE_GATLING_HEAD && shield)
+        {
+            if (Zombie* shooter = board.AddZombieInRow(type, shield->mRow, board.mCurrentWave))
+            {
+                shooter->mPosX = shield->mPosX + 65.0f;
+                shooter->mX = static_cast<int>(shooter->mPosX);
+            }
+            shield = nullptr;
+        }
+        else
+        {
+            Zombie* zombie = board.AddZombie(type, board.mCurrentWave);
+            shield = type == ZOMBIE_WALLNUT_HEAD ? zombie : nullptr;
+        }
+    }
+}
+
+void FireMatchedPlant(Plant& plant)
+{
+    switch (plant.mSeedType)
+    {
+    case SEED_FUMESHROOM:
+        // The normal wind-up attaches its cloud to the plant. A matched plant
+        // disappears this tick, so let the original cloud finish on the lawn.
+        plant.mApp->AddPvzpParticle(plant.mX + 85, plant.mY + 31,
+            Board::MakeRenderOrder(RENDER_LAYER_PARTICLE, plant.mRow, 0), PARTICLE_FUMECLOUD);
+        [[fallthrough]];
+    case SEED_PEASHOOTER:
+    case SEED_REPEATER:
+    case SEED_SNOWPEA:
+    case SEED_PUFFSHROOM:
+    case SEED_STARFRUIT:
+        plant.Fire(nullptr, plant.mRow, WEAPON_PRIMARY);
+        break;
+    default:
+        break;
+    }
+}
+}
