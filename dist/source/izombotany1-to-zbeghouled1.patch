--- /dev/null
+++ b/src/Lawn/System/ZomBotanyBeghouled.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include "../../ConstEnums.h"
+
+class Board;
+class Plant;
+
+namespace ZomBotanyBeghouled
+{
+constexpr GameMode kMode = GAMEMODE_CHALLENGE_ZOMBOTANY_BEGHOULED;
+constexpr int kGoal = 50;
+constexpr bool IsSwap(GameMode mode) { return mode == GAMEMODE_CHALLENGE_BEGHOULED || mode == kMode; }
+constexpr bool IsBoard(GameMode mode) { return IsSwap(mode) || mode == GAMEMODE_CHALLENGE_BEGHOULED_TWIST; }
+constexpr int MatchGoal(GameMode mode) { return mode == kMode ? kGoal : 75; }
+constexpr bool IsAttacker(ZombieType type)
+{
+    return type == ZOMBIE_PEA_HEAD || type == ZOMBIE_WALLNUT_HEAD || type == ZOMBIE_GATLING_HEAD;
+}
+void ConfigureWaves(Board& board);
+void UpdateSpawning(Board& board);
+void SpawnWave(Board& board);
+void FireMatchedPlant(Plant& plant);
+}
