diff --git a/src/Lawn/System/IZombotany.cpp b/src/Lawn/System/IZombotany.cpp
new file mode 100644
index 0000000..a1dd24a
--- /dev/null
+++ b/src/Lawn/System/IZombotany.cpp
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "IZombotany.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Coin.h"
+#include "../GridItem.h"
+#include "../Plant.h"
+#include "../Projectile.h"
+#include "../SeedPacket.h"
+#include "../Zombie.h"
+#include "../../LawnApp.h"
+#include <algorithm>
+#include <span>
+
+namespace IZombotany
+{
+namespace
+{
+struct Defender { SeedType seed; int col; int row; };
+struct Puzzle { int sun; std::span<const SeedType> packets; std::span<const Defender> defenders; };
+
+constexpr SeedType openingBank[] = {SEED_ZOMBOTANY_PEA, SEED_ZOMBOTANY_WALLNUT, SEED_ZOMBOTANY_SQUASH};
+constexpr SeedType escortBank[] = {SEED_ZOMBOTANY_PEA, SEED_ZOMBOTANY_WALLNUT, SEED_ZOMBOTANY_GATLING, SEED_ZOMBOTANY_TALLNUT};
+constexpr SeedType finalBank[] = {SEED_ZOMBOTANY_PEA, SEED_ZOMBOTANY_WALLNUT, SEED_ZOMBOTANY_SQUASH,
+                                 SEED_ZOMBOTANY_GATLING, SEED_ZOMBOTANY_TALLNUT, SEED_ZOMBOTANY_JALAPENO};
+
+constexpr Defender opening[] = {
+    {SEED_PEASHOOTER, 1, 0}, {SEED_SUNFLOWER, 3, 0},
+    {SEED_PUFFSHROOM, 0, 1}, {SEED_POTATOMINE, 3, 1},
+    {SEED_SUNFLOWER, 3, 2},
+    {SEED_PUFFSHROOM, 1, 3}, {SEED_PUFFSHROOM, 2, 3}, {SEED_SUNFLOWER, 3, 3},
+    {SEED_PEASHOOTER, 1, 4}
+};
+constexpr Defender escort[] = {
+    {SEED_PEASHOOTER, 0, 0}, {SEED_SUNFLOWER, 3, 0},
+    {SEED_PUFFSHROOM, 1, 1}, {SEED_PUFFSHROOM, 3, 1},
+    {SEED_REPEATER, 0, 2}, {SEED_REPEATER, 1, 2}, {SEED_PEASHOOTER, 2, 2},
+    {SEED_PEASHOOTER, 1, 3}, {SEED_SUNFLOWER, 3, 3},
+    {SEED_SNOWPEA, 1, 4}
+};
+constexpr Defender lastStand[] = {
+    {SEED_PUFFSHROOM, 3, 0},
+    {SEED_SNOWPEA, 0, 1}, {SEED_SUNFLOWER, 3, 1},
+    {SEED_PEASHOOTER, 1, 2}, {SEED_PUFFSHROOM, 2, 2},
+    {SEED_SQUASH, 0, 3}, {SEED_CHOMPER, 1, 3}, {SEED_POTATOMINE, 2, 3}, {SEED_TALLNUT, 3, 3},
+    {SEED_PUFFSHROOM, 1, 4}, {SEED_PUFFSHROOM, 2, 4}, {SEED_PUFFSHROOM, 3, 4}
+};
+constexpr std::array<Puzzle, kBoardCount> puzzles = {{
+    {50, openingBank, opening}, {350, escortBank, escort}, {425, finalBank, lastStand}
+}};
+}
+
+int BankSize(int stage)
+{
+    return static_cast<int>(puzzles[std::clamp(stage, 0, kBoardCount - 1)].packets.size());
+}
+
+void ConfigureWaves(Board& board)
+{
+    for (auto& wave : board.mZombiesInWave)
+        std::fill(std::begin(wave), std::end(wave), ZOMBIE_INVALID);
+    board.mNumWaves = kBoardCount;
+}
+
+void ConfigureRoster(Board& board)
+{
+    std::fill(std::begin(board.mZombieAllowed), std::end(board.mZombieAllowed), false);
+    const int stage = std::clamp(board.mChallenge->mSurvivalStage, 0, kBoardCount - 1);
+    for (SeedType seed : puzzles[stage].packets) board.mZombieAllowed[PacketFor(seed).zombie] = true;
+}
+
+void Preload()
+{
+    for (const auto& packet : kPackets) Zombie::PreloadZombieResources(packet.zombie);
+    for (const auto& puzzle : puzzles)
+        for (const auto& defender : puzzle.defenders) Plant::PreloadPlantResources(defender.seed);
+}
+
+void PopulateDefenders(Board& board)
+{
+    auto& challenge = *board.mChallenge;
+    const Puzzle& puzzle = puzzles[challenge.mSurvivalStage];
+    challenge.mChallengeState = kActive;
+    challenge.mChallengeStateCounter = 0;
+    challenge.mChallengeScore = 0;
+    board.mCurrentWave = board.mTotalSpawnedWaves = 0;
+    board.mProgressMeterWidth = 0;
+    board.mNextSurvivalStageCounter = board.mRiseFromGraveCounter = 0;
+    board.mEnableGraveStones = board.mShowShovel = board.mLevelAwardSpawned = false;
+    board.mSunMoney = puzzle.sun;
+    ConfigureRoster(board);
+    board.mSeedBank->UpdateWidth();
+    for (int i = 0; i < board.mSeedBank->mNumPackets; ++i)
+    {
+        SeedPacket& packet = board.mSeedBank->mSeedPackets[i];
+        packet.SetPacketType(puzzle.packets[i]);
+        packet.mTimesUsed = 0;
+    }
+    for (const auto& defender : puzzle.defenders)
+        challenge.IZombieSetupPlant(board.NewPlant(defender.col, defender.row, defender.seed));
+}
+
+bool CanDeploy(const Board& board, int col, int row, SeedType seed)
+{
+    if (board.mChallenge->mChallengeState != kActive || board.mLevelComplete ||
+        !IsPacket(seed) || col < kFirstDeploymentColumn || col >= 9 || row < 0 || row >= 5) return false;
+    for (int i = 0; i < board.mSeedBank->mNumPackets; ++i)
+    {
+        const auto& packet = board.mSeedBank->mSeedPackets[i];
+        if (packet.mPacketType == seed)
+            return seed != SEED_ZOMBOTANY_JALAPENO || packet.mTimesUsed == 0;
+    }
+    return false;
+}
+
+void OnBrainsCleared(Board& board, int row)
+{
+    auto& challenge = *board.mChallenge;
+    if (challenge.mChallengeState != kActive || board.HasLevelAwardDropped()) return;
+    board.RefreshSeedPacketFromCursor();
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    if (challenge.mSurvivalStage + 1 == kBoardCount)
+    {
+        challenge.mChallengeState = kFinished;
+        challenge.SpawnLevelAward(0, row);
+    }
+    else
+    {
+        challenge.mChallengeState = kTransition;
+        challenge.mChallengeStateCounter = kTransitionTicks;
+    }
+}
+
+void ResetStage(Board& board, int stage)
+{
+    auto& challenge = *board.mChallenge;
+    challenge.PuzzleNextStageClear();
+    for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+    for (Projectile* shot : board.mProjectiles) if (!shot->mDead) shot->Die();
+    challenge.mSurvivalStage = std::clamp(stage, 0, kBoardCount - 1);
+    board.mLevelComplete = false;
+    challenge.IZombieInitLevel();
+}
+
+void Advance(Board& board)
+{
+    auto& challenge = *board.mChallenge;
+    if (challenge.mChallengeState == kTransition && !board.mPaused && board.mTimeStopCounter == 0 &&
+        --challenge.mChallengeStateCounter == 0)
+        ResetStage(board, challenge.mSurvivalStage + 1);
+}
+
+bool ValidSave(const Board& board)
+{
+    if (!board.mChallenge || !board.mSeedBank || board.mBackground != BACKGROUND_2_NIGHT) return false;
+    const auto& challenge = *board.mChallenge;
+    const int stage = challenge.mSurvivalStage;
+    if (stage < 0 || stage >= kBoardCount || challenge.mChallengeState < kActive ||
+        challenge.mChallengeState > kFailed || board.mCurrentWave != 0 || board.mTotalSpawnedWaves != 0 ||
+        board.mNumWaves != kBoardCount || board.mSeedBank->mNumPackets != BankSize(stage)) return false;
+    for (int i = 0; i < BankSize(stage); ++i)
+    {
+        const auto& packet = board.mSeedBank->mSeedPackets[i];
+        if (packet.mPacketType != puzzles[stage].packets[i] ||
+            (packet.mPacketType == SEED_ZOMBOTANY_JALAPENO && (packet.mTimesUsed < 0 || packet.mTimesUsed > 1))) return false;
+    }
+    bool brainInRow[5]{};
+    int remaining = 0;
+    for (auto* item : board.mGridItems)
+    {
+        if (item->mDead) continue;
+        if (item->mGridItemType != GRIDITEM_IZOMBIE_BRAIN || item->mGridX != 0 ||
+            item->mGridY < 0 || item->mGridY >= 5 || brainInRow[item->mGridY] ||
+            item->mGridItemCounter < 1 || item->mGridItemCounter > 70) return false;
+        brainInRow[item->mGridY] = true;
+        ++remaining;
+    }
+    if (challenge.mChallengeScore != 5 - remaining) return false;
+    for (Zombie* zombie : board.mZombies)
+        if (!zombie->mDead && !IsHead(zombie->mZombieType)) return false;
+    if (challenge.mChallengeState == kTransition)
+        return !remaining && stage + 1 < kBoardCount && challenge.mChallengeStateCounter > 0 &&
+               challenge.mChallengeStateCounter <= kTransitionTicks;
+    if (challenge.mChallengeState == kFinished) return !remaining && stage + 1 == kBoardCount;
+    return remaining > 0;
+}
+}
