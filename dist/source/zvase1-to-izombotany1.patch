@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include "../../ConstEnums.h"
+#include <array>
+
+class Board;
+
+namespace IZombotany
+{
+inline constexpr GameMode kMode = GAMEMODE_PUZZLE_I_ZOMBOTANY;
+inline constexpr int kBoardCount = 3;
+inline constexpr int kFirstDeploymentColumn = 4;
+inline constexpr int kTransitionTicks = 120;
+inline constexpr auto kActive = static_cast<ChallengeState>(156);
+inline constexpr auto kTransition = static_cast<ChallengeState>(157);
+inline constexpr auto kFinished = static_cast<ChallengeState>(158);
+inline constexpr auto kFailed = static_cast<ChallengeState>(159);
+
+struct Packet
+{
+    ZombieType zombie;
+    int sun;
+    const char* name;
+    const char* tooltip;
+};
+
+// Seed IDs are appended after the playable plants and the original zombie
+// packets. They never enter the plant chooser or change a saved array size.
+inline constexpr std::array<Packet, 6> kPackets = {{
+    {ZOMBIE_PEA_HEAD,      50, "Peashooter Zombie", "Fires peas as it walks."},
+    {ZOMBIE_WALLNUT_HEAD, 100, "Wall-nut Zombie",   "Its shell shields the zombies behind it."},
+    {ZOMBIE_SQUASH_HEAD,   75, "Squash Zombie",     "Crushes the first plant it reaches."},
+    {ZOMBIE_GATLING_HEAD, 125, "Gatling Pea Zombie","Fires four peas at a time."},
+    {ZOMBIE_TALLNUT_HEAD, 175, "Tall-nut Zombie",   "Its thick shell absorbs heavy fire."},
+    {ZOMBIE_JALAPENO_HEAD,150, "Jalapeno Zombie",   "Burns its row. One per board."}
+}};
+constexpr bool IsPacket(SeedType seed) { return seed >= SEED_ZOMBOTANY_PEA && seed <= SEED_ZOMBOTANY_JALAPENO; }
+constexpr const Packet& PacketFor(SeedType seed) { return kPackets[seed - SEED_ZOMBOTANY_PEA]; }
+constexpr bool IsHead(ZombieType type) { return type >= ZOMBIE_PEA_HEAD && type <= ZOMBIE_TALLNUT_HEAD; }
+int BankSize(int stage);
+void PopulateDefenders(Board& board);
+void ConfigureWaves(Board& board);
+void ConfigureRoster(Board& board);
+void Preload();
+bool CanDeploy(const Board& board, int col, int row, SeedType seed);
+void OnBrainsCleared(Board& board, int row);
+void Advance(Board& board);
+void ResetStage(Board& board, int stage);
+bool ValidSave(const Board& board);
+}
