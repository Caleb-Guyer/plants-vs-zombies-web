diff --git a/artwork/mender-bloom/render.py b/artwork/mender-bloom/render.py
new file mode 100644
index 0000000000000000000000000000000000000000..756e69046d9ecf7255cf78c7f47657df58d12b02
--- /dev/null
+++ b/artwork/mender-bloom/render.py
@@ -0,0 +1,113 @@
+"""Pack the generated Mender-bloom into registered native sprite layers.
+
+This deterministic asset compiler makes no network or image-generation calls.
+It normalizes the supplied alpha sprite once, isolates its head and stem, and
+imports only the closed expression's eye pixels. All layers share one canvas.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+from PIL import Image, __version__ as PILLOW_VERSION
+
+ROOT = Path(__file__).resolve().parent
+VERSION = '0.2.6-web-mender.1'
+def sha(raw): return hashlib.sha256(raw).hexdigest()
+def read_image(name):
+    raw = (ROOT / name).read_bytes()
+    with Image.open(ROOT / name) as image:
+        return raw, image.convert('RGBA')
+
+def normalize(image, recipe):
+    image = image.copy()
+    for index, pixel in enumerate(image.get_flattened_data()):
+        if pixel[3] <= recipe['discardAlphaAtMost']:
+            image.putpixel((index % image.width, index // image.width), (0,0,0,0))
+    crop = image.crop(tuple(recipe['crop']))
+    width, height = recipe['normalizedSize']
+    crop = crop.resize((width,height), Image.Resampling.LANCZOS)
+    canvas = Image.new('RGBA', tuple(recipe['canvas']))
+    canvas.alpha_composite(crop, tuple(recipe['offset']))
+    for index, pixel in enumerate(canvas.get_flattened_data()):
+        if pixel[3] == 0: canvas.putpixel((index % canvas.width, index // canvas.width), (0,0,0,0))
+    return canvas
+
+def partition(image, recipe):
+    width, height = image.size
+    pixels = list(image.get_flattened_data())
+    greens = set()
+    for index, (r,g,b,a) in enumerate(pixels):
+        x,y = index % width, index // width
+        if a and y >= recipe['greenStartRow'] and g > r * 1.02 and g > b * 1.1:
+            greens.add((x,y))
+    head = Image.new('RGBA', image.size)
+    stem = Image.new('RGBA', image.size)
+    for index, pixel in enumerate(pixels):
+        if not pixel[3]: continue
+        x,y = index % width, index // width
+        dark = max(pixel[:2]) < 110 and pixel[2] < 80
+        near_green = any((x+dx,y+dy) in greens for dx in [-1,0,1] for dy in [-1,0,1])
+        body = y >= recipe['stemOnlyFromRow'] or (x,y) in greens or (y >= recipe['greenStartRow'] and dark and near_green)
+        (stem if body else head).putpixel((x,y), pixel)
+    assert Image.alpha_composite(stem,head).tobytes() == image.tobytes()
+    return head, stem
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output',type=Path,required=True)
+    parser.add_argument('--header',type=Path,required=True)
+    args = parser.parse_args()
+    recipe_raw = (ROOT / 'extraction.json').read_bytes()
+    recipe = json.loads(recipe_raw)
+    generation_raw = (ROOT / 'generation.json').read_bytes()
+    master_raw, master = read_image('master.png')
+    closed_raw, closed = read_image('closed.png')
+    assert master.size == closed.size == tuple(recipe['sourceCanvas'])
+    canonical = normalize(master, recipe)
+    expression = normalize(closed, recipe)
+    blink = canonical.copy()
+    for left,top,right,bottom in recipe['eyeRegions']:
+        for y in range(top,bottom):
+            for x in range(left,right):
+                original = canonical.getpixel((x,y))
+                assert original[3] > 240
+                blink.putpixel((x,y), expression.getpixel((x,y))[:3] + (original[3],))
+    assert blink.getchannel('A').tobytes() == canonical.getchannel('A').tobytes()
+    head, stem = partition(canonical, recipe)
+    head_blink = head.copy()
+    for y in range(80):
+        for x in range(80):
+            original = head.getpixel((x,y))
+            if original[3]: head_blink.putpixel((x,y), blink.getpixel((x,y))[:3] + (original[3],))
+    assert Image.alpha_composite(stem,head_blink).tobytes() == blink.tobytes()
+    images = {'canonical':canonical,'head':head,'stem':stem,'head-blink':head_blink,'blink':blink}
+    args.output.mkdir(parents=True,exist_ok=True)
+    records = {}
+    for name,image in images.items():
+        path = args.output / (name+'.png')
+        image.save(path,compress_level=9)
+        records[name] = {'pngSha256':sha(path.read_bytes()),'rgbaSha256':sha(image.tobytes()),'visibleBounds':image.getbbox(),'width':image.width,'height':image.height}
+    header = ['// Generated by artwork/mender-bloom/render.py. Straight-alpha ARGB.',
+              '#pragma once','#include <cstdint>','namespace MenderBloomArt {',
+              'inline constexpr int kWidth = 80;','inline constexpr int kHeight = 80;']
+    for name,image in [('kArgb',canonical),('kHeadArgb',head),('kStemArgb',stem),('kHeadBlinkArgb',head_blink)]:
+        raw = image.tobytes()
+        values = [(raw[i+3]<<24)|(raw[i]<<16)|(raw[i+1]<<8)|raw[i+2] for i in range(0,len(raw),4)]
+        header.append('inline constexpr uint32_t '+name+'[] = {')
+        for start in range(0,len(values),10): header.append('    '+', '.join(f'0x{pixel:08x}u' for pixel in values[start:start+10])+',')
+        header.append('};')
+    header.append('}')
+    args.header.parent.mkdir(parents=True,exist_ok=True)
+    args.header.write_text('\n'.join(header)+'\n',encoding='utf-8',newline='\n')
+    provenance = {'schema':1,'version':VERSION,'displayName':'Mender-bloom',
+        'imageGenerationUsed':True,'standaloneChallengeIllustrations':False,
+        'method':'Generated matte-painted flower; registered head/stem masks and eye-only blink expression',
+        'pillowVersion':PILLOW_VERSION,'sourceMasterSha256':sha(master_raw),'sourceClosedSha256':sha(closed_raw),
+        'generationSha256':sha(generation_raw),'extractionSha256':sha(recipe_raw),
+        'generatorSha256':sha(Path(__file__).read_bytes()),'headerSha256':sha(args.header.read_bytes()),
+        'canonicalRgbaSha256':sha(canonical.tobytes()),'parts':records}
+    for name,data in [('generation.json',generation_raw),('extraction.json',recipe_raw),('provenance.json',(json.dumps(provenance,indent=2)+'\n').encode('utf-8'))]:
+        (args.output / name).write_bytes(data)
+    print(json.dumps(provenance,indent=2))
+
+if __name__ == '__main__': main()
