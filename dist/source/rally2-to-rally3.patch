+// Reuse the original flag carrier's closed fingers, including its painted
+// outline and shading. The ordinary walk/eat hands are open palms; drawing a
+// handle behind them cannot turn either one into a gripping hand.
+Sexy::Image* Grip(Reanimation& carrier)
+{
+    Cache& cache=Images();
+    if (cache.grip) return cache.grip.get();
+    if (!carrier.TrackExists("Zombie_flaghand")) return nullptr;
+    const int index=carrier.FindTrackIndex("Zombie_flaghand");
+    Sexy::Image* source=carrier.mDefinition->mTracks.tracks[index].mTransforms.mTransforms[0].mImage;
+    Sexy::Rect rect(0,0,source ? 19 : 0,25);
+    if (auto* atlas=carrier.mDefinition->mReanimAtlas)
+    {
+        const auto* image=atlas->GetEncodedReanimAtlas(source);
+        if (!image) return nullptr;
+        rect=Sexy::Rect(image->mX,image->mY,image->mWidth,image->mHeight);
+        source=atlas->mMemoryImage.get();
+    }
+    else if (source) rect=Sexy::Rect(0,0,source->GetCelWidth(),source->GetCelHeight());
+    if (!source) return nullptr;
+    auto* pixels=dynamic_cast<Sexy::MemoryImage*>(source);
+    if (!pixels) return nullptr;
+    std::vector<uint32_t> copy(rect.mWidth*rect.mHeight);
+    const uint32_t* original=pixels->GetBits();
+    for (int y=0;y<rect.mHeight;++y)
+        std::copy_n(original+(rect.mY+y)*pixels->GetWidth()+rect.mX,
+            rect.mWidth,copy.data()+y*rect.mWidth);
+    cache.grip=std::make_unique<Sexy::MemoryImage>();
+    cache.grip->SetBits(copy.data(),rect.mWidth,rect.mHeight);
+    return cache.grip.get();
+}
