+
+std::unique_ptr<MemoryImage> ReanimatorCache::MakeVasebreakerPlantHeadFrame(ZombieType theZombieType)
+{
+	if (theZombieType < ZOMBIE_PEA_HEAD || theZombieType > ZOMBIE_TALLNUT_HEAD) return nullptr;
+	auto image = MakeBlankMemoryImage(200, 210);
+	Graphics graphics(image.get());
+	graphics.SetLinearBlend(true);
+	Reanimation body;
+	body.ReanimationInitializeType(40.0f, 40.0f, REANIM_ZOMBIE);
+	body.SetFramesForLayer("anim_idle");
+	Zombie::SetupReanimLayers(&body, theZombieType);
+	body.AssignRenderGroupToPrefix("anim_hair", RENDER_GROUP_HIDDEN);
+	const bool bodyMount = theZombieType == ZOMBIE_WALLNUT_HEAD ||
+		theZombieType == ZOMBIE_TALLNUT_HEAD || theZombieType == ZOMBIE_JALAPENO_HEAD;
+	if (bodyMount)
+	{
+		body.AssignRenderGroupToPrefix("anim_head", RENDER_GROUP_HIDDEN);
+		body.AssignRenderGroupToPrefix("Zombie_tie", RENDER_GROUP_HIDDEN);
+	}
+	else
+	{
+		body.AssignRenderGroupToPrefix("anim_head2", RENDER_GROUP_HIDDEN);
+		body.GetTrackInstanceByName("anim_head1")->mImageOverride = IMAGE_BLANK;
+	}
+	body.mFrameBasePose = 0;
+	body.Draw(&graphics);
+	ReanimationType headType = REANIM_PEASHOOTER;
+	float x = 65.0f, y = -5.0f, scaleX = -1.0f, scaleY = 1.0f;
+	switch (theZombieType)
+	{
+	case ZOMBIE_WALLNUT_HEAD: headType = REANIM_WALLNUT; x = 50.0f; y = 0; scaleX = -.8f; scaleY = .8f; break;
+	case ZOMBIE_TALLNUT_HEAD: headType = REANIM_TALLNUT; x = 37.0f; y = 0; scaleX = -.8f; scaleY = .8f; break;
+	case ZOMBIE_JALAPENO_HEAD: headType = REANIM_JALAPENO; x = 55.0f; break;
+	case ZOMBIE_GATLING_HEAD: headType = REANIM_GATLINGPEA; break;
+	case ZOMBIE_SQUASH_HEAD: headType = REANIM_SQUASH; x = 55.0f; y = -15.0f; scaleX = -.75f; scaleY = .75f; break;
+	default: break;
+	}
+	Reanimation head;
+	head.ReanimationInitializeType(0, 0, headType);
+	head.SetFramesForLayer(theZombieType == ZOMBIE_PEA_HEAD || theZombieType == ZOMBIE_GATLING_HEAD ? "anim_head_idle" : "anim_idle");
+	SexyTransform2D parent, offset;
+	body.GetAttachmentOverlayMatrix(body.FindTrackIndex(bodyMount ? "Zombie_body" : "anim_head1"), parent);
+	PvzpScaleRotateTransformMatrix(offset, x, y, .2f, scaleX, scaleY);
+	head.mOverlayMatrix = parent * offset;
+	head.Draw(&graphics);
+	return image;
+}
+
+MemoryImage* ReanimatorCache::GetVasebreakerPlantHeadImage(ZombieType theZombieType)
+{
+	if (theZombieType < ZOMBIE_PEA_HEAD || theZombieType > ZOMBIE_TALLNUT_HEAD) return nullptr;
+	auto& image = mVasebreakerPlantHeadImages[static_cast<int>(theZombieType) - static_cast<int>(ZOMBIE_PEA_HEAD)];
+	if (!image) image = MakeVasebreakerPlantHeadFrame(theZombieType);
+	return image.get();
+}
+
+void ReanimatorCache::DrawVasebreakerPlantHead(Graphics* g, float thePosX, float thePosY, ZombieType theZombieType)
+{
+	if (auto* image = GetVasebreakerPlantHeadImage(theZombieType))
+		PvzpDrawImageScaledF(g, image, thePosX, thePosY, g->mScaleX, g->mScaleY);
+}
