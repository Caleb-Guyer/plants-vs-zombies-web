+Image* ChallengeScreen::GetZombotanyVasebreakerImage()
+{
+	if (mZombotanyVasebreakerImage) return mZombotanyVasebreakerImage.get();
+	if (!mApp->mReanimatorCache || !Sexy::IMAGE_SCARY_POT) return nullptr;
+	const std::string backgroundGroup = "DelayLoad_Background2";
+	if (std::find(mLoadedResourceNames.begin(), mLoadedResourceNames.end(), backgroundGroup) == mLoadedResourceNames.end())
+	{
+		if (!PvzpLoadResources(backgroundGroup.c_str())) return nullptr;
+		mLoadedResourceNames.push_back(backgroundGroup);
+	}
+	if (!Sexy::IMAGE_BACKGROUND2) return nullptr;
+	auto* cache = mApp->mReanimatorCache.get();
+	if (!cache->GetVasebreakerPlantHeadImage(ZOMBIE_PEA_HEAD)) return nullptr;
+	const int width = Sexy::IMAGE_SCARY_POT->GetCelWidth(), height = Sexy::IMAGE_SCARY_POT->GetCelHeight();
+	if (width <= 0 || height <= 0) return nullptr;
+	auto leaf = cache->MakeBlankMemoryImage(width, height);
+	Graphics leafGraphics(leaf.get());
+	leafGraphics.DrawImageCel(Sexy::IMAGE_SCARY_POT, 0, 0, 1, 1);
+	auto revealed = cache->MakeBlankMemoryImage(width, height);
+	Graphics native(revealed.get());
+	native.SetLinearBlend(true);
+	native.DrawImageCel(Sexy::IMAGE_SCARY_POT, 0, 0, 0, 0);
+	Graphics inside(native);
+	inside.mScaleX = .4f; inside.mScaleY = .4f;
+	cache->DrawVasebreakerPlantHead(&inside, 6.0f, 19.0f, ZOMBIE_PEA_HEAD);
+	native.SetColorizeImages(true);
+	native.SetColor(Color(255, 255, 255, 58));
+	native.DrawImageCel(Sexy::IMAGE_SCARY_POT, 0, 0, 0, 1);
+	native.SetColorizeImages(false);
+	auto image = cache->MakeBlankMemoryImage(80, 65);
+	Graphics picture(image.get());
+	picture.SetLinearBlend(true);
+	picture.ClipRect(0, 0, 80, 65);
+	picture.DrawImage(Sexy::IMAGE_BACKGROUND2, Rect(0, 0, 80, 65), Rect(400, 140, 480, 390));
+	auto fit = [&](MemoryImage& sprite, float centerX, float baseline, float maxWidth, float maxHeight)
+	{
+		int left = sprite.GetWidth(), top = sprite.GetHeight(), right = -1, bottom = -1;
+		const auto* pixels = sprite.GetBits();
+		for (int y = 0; y < sprite.GetHeight(); ++y) for (int x = 0; x < sprite.GetWidth(); ++x)
+			if ((pixels[y * sprite.GetWidth() + x] >> 24) > 8)
+			{
+				left = std::min(left, x); top = std::min(top, y);
+				right = std::max(right, x); bottom = std::max(bottom, y);
+			}
+		if (right < left || bottom < top) return;
+		const float w = static_cast<float>(right - left + 1), h = static_cast<float>(bottom - top + 1);
+		const float scale = std::min(maxWidth / w, maxHeight / h);
+		PvzpDrawImageScaledF(&picture, &sprite, centerX - (left + w * .5f) * scale,
+			baseline - (top + h) * scale, scale, scale);
+	};
+	// Native guaranteed-plant shell and Plantern-revealed plant-headed vase.
+	fit(*leaf, 20, 62, 29, 44);
+	fit(*revealed, 52, 64, 43, 59);
+	mZombotanyVasebreakerImage = std::move(image);
+	return mZombotanyVasebreakerImage.get();
+}
