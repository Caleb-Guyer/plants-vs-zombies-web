diff --git a/src/Lawn/System/BungeeBusiness.cpp b/src/Lawn/System/BungeeBusiness.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..477da010f818bbcbcce4f29e883813dd64357b73
--- /dev/null
+++ b/src/Lawn/System/BungeeBusiness.cpp
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#include "BungeeBusiness.h"
+#include "../Board.h"
+#include "../Challenge.h"
+#include "../Plant.h"
+#include "../Zombie.h"
+#include "../Coin.h"
+#include "../GridItem.h"
+#include "../Projectile.h"
+#include "../SeedPacket.h"
+#include "../../LawnApp.h"
+#include <algorithm>
+#include <format>
+
+namespace BungeeBusiness
+{
+namespace
+{
+int TargetBit(const Board& board, int col, int row)
+{
+    const int stage = std::clamp(board.mChallenge->mSurvivalStage, 0, kBoardCount - 1);
+    int index = 0;
+    for (const Defender& defender : kBoards[stage].mPlants)
+    {
+        if (defender.mSeed != SEED_SUNFLOWER) continue;
+        if (defender.mCol == col && defender.mRow == row) return 1 << index;
+        ++index;
+    }
+    return 0;
+}
+void Fail(Board& board)
+{
+    board.mChallenge->mChallengeState = kFailed;
+    board.ClearCursor();
+    board.ClearAdviceImmediately();
+    board.ZombiesWon(nullptr);
+}
+}
+
+std::string LevelLabel(int stage)
+{
+    return std::format("Bungee Business - {}/{}", std::clamp(stage + 1, 1, kBoardCount), kBoardCount);
+}
+
+void Populate(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    const int stage = std::clamp(challenge.mSurvivalStage, 0, kBoardCount - 1);
+    challenge.mSurvivalStage = stage;
+    challenge.mChallengeState = kActive;
+    challenge.mChallengeStateCounter = 0;
+    challenge.mChallengeScore = 0;
+    // This existing saved field is the unique authored-target completion mask.
+    challenge.mScaryPotterPots = 0;
+    board.mSunMoney = kBoards[stage].mSun;
+    board.mCurrentWave = 0;
+    board.mProgressMeterWidth = 0;
+    board.mZombieCountDown = board.mZombieCountDownStart = 100000;
+    board.mNextSurvivalStageCounter = 0;
+    board.mShowShovel = false;
+    board.mBonusLawnMowersRemaining = 0;
+    board.ClearCursor();
+    FillSeedBank(*board.mSeedBank);
+    for (const Defender& defender : kBoards[stage].mPlants)
+    {
+        if (defender.mSeed == SEED_NONE) continue;
+        Plant* plant = board.NewPlant(defender.mCol, defender.mRow, defender.mSeed, SEED_NONE);
+        board.mChallenge->IZombieSetupPlant(plant);
+    }
+}
+
+void ResetStage(Board& board, int stage)
+{
+    for (Zombie* zombie : board.mZombies) if (!zombie->mDead) zombie->DieNoLoot();
+    for (Plant* plant : board.mPlants) if (!plant->mDead) plant->Die();
+    for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+    for (GridItem* item : board.mGridItems) if (!item->mDead) item->GridItemDie();
+    for (Projectile* projectile : board.mProjectiles) if (!projectile->mDead) projectile->Die();
+    board.mChallenge->mSurvivalStage = std::clamp(stage, 0, kBoardCount - 1);
+    board.mLevelAwardSpawned = false;
+    Populate(board);
+}
+
+bool CanDeploy(Board& board, int col, int row, SeedType seed)
+{
+    if (!board.mChallenge || board.mChallenge->mChallengeState != kActive ||
+        board.mLevelComplete || board.HasLevelAwardDropped() ||
+        col < 0 || col >= 9 || row < 0 || row >= 5 ||
+        std::find(kSeeds.begin(), kSeeds.end(), seed) == kSeeds.end()) return false;
+    if (seed != SEED_ZOMBIE_BUNGEE) return col >= kDeploymentColumn;
+    if (col >= kDeploymentColumn || board.BungeeIsTargetingCell(col, row)) return false;
+    Plant* plant = board.GetTopPlantAt(col, row, TOPPLANT_BUNGEE_ORDER);
+    return plant && !plant->mDead && !plant->NotOnGround();
+}
+
+void OnBungeeExit(Zombie& zombie)
+{
+    Board* board = zombie.mBoard;
+    if (!board || !board->mChallenge || !IsMode(board->mApp->mGameMode) ||
+        board->mChallenge->mChallengeState != kActive || zombie.mDead || zombie.IsDeadOrDying() ||
+        zombie.mZombieType != ZOMBIE_BUNGEE || zombie.mZombiePhase != PHASE_BUNGEE_RISING ||
+        zombie.mAltitude < 600.0f || zombie.mRelatedZombieID != ZOMBIEID_NULL) return;
+    Plant* plant = board->mPlants.DataArrayTryToGet(zombie.mTargetPlantID);
+    if (!plant || plant->mDead || plant->mSquished || plant->mPlantHealth <= 0 || plant->mSeedType != SEED_SUNFLOWER ||
+        plant->mPlantCol != zombie.mTargetCol || plant->mRow != zombie.mRow ||
+        plant->mOnBungeeState != RISING_WITH_BUNGEE) return;
+    const int bit = TargetBit(*board, plant->mPlantCol, plant->mRow);
+    if (bit == 0 || (board->mChallenge->mScaryPotterPots & bit) != 0) return;
+    board->mChallenge->mScaryPotterPots |= bit;
+    ++board->mChallenge->mChallengeScore;
+}
+
+void Update(Board& board)
+{
+    Challenge& challenge = *board.mChallenge;
+    if (!IsCurrentRules(board.mApp->mGameMode, challenge.mChallengeState) || board.mPaused ||
+        board.mApp->mGameScene != SCENE_PLAYING || board.HasLevelAwardDropped()) return;
+    board.mShowShovel = false;
+    if (challenge.mChallengeState == kTransition)
+    {
+        if (--challenge.mChallengeStateCounter > 0) return;
+        challenge.PuzzleNextStageClear();
+        for (Coin* coin : board.mCoins) if (!coin->mDead) coin->Die();
+        for (Projectile* projectile : board.mProjectiles) if (!projectile->mDead) projectile->Die();
+        Populate(board);
+        return;
+    }
+    if (challenge.mChallengeState != kActive) return;
+    const int stage = std::clamp(challenge.mSurvivalStage, 0, kBoardCount - 1);
+    int remaining = 0;
+    for (const Defender& target : kBoards[stage].mPlants)
+    {
+        if (target.mSeed != SEED_SUNFLOWER) continue;
+        const int bit = TargetBit(board, target.mCol, target.mRow);
+        if ((challenge.mScaryPotterPots & bit) != 0) continue;
+        bool present = false;
+        // A rising plant is still a live target until its carrier leaves.
+        for (Plant* plant : board.mPlants)
+            if (!plant->mDead && !plant->mSquished && plant->mPlantHealth > 0 && plant->mSeedType == SEED_SUNFLOWER &&
+                plant->mPlantCol == target.mCol && plant->mRow == target.mRow) present = true;
+        if (!present) { Fail(board); return; }
+        ++remaining;
+    }
+    if (remaining == 0 && challenge.mChallengeScore == TargetCount(stage))
+    {
+        board.ClearCursor();
+        board.ClearAdviceImmediately();
+        if (stage == kBoardCount - 1)
+        {
+            challenge.mChallengeState = kFinished;
+            challenge.SpawnLevelAward(2, 2);
+        }
+        else
+        {
+            challenge.mChallengeState = kTransition;
+            challenge.mChallengeStateCounter = kTransitionTicks;
+        }
+        return;
+    }
+    if (board.mSunMoney + board.CountSunBeingCollected() >= kBungeeCost) return;
+    for (Zombie* zombie : board.mZombies) if (!zombie->mDead) return;
+    Fail(board);
+}
+}
diff --git a/src/Lawn/System/BungeeBusiness.h b/src/Lawn/System/BungeeBusiness.h
new file mode 100644
index 0000000000000000000000000000000000000000..ea40c4e72e84cba081bd376a06457a0b310576f0
--- /dev/null
+++ b/src/Lawn/System/BungeeBusiness.h
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+
+#include "../../ConstEnums.h"
+#include <array>
+#include <cstddef>
+#include <initializer_list>
+#include <string>
+
+class Board;
+class Zombie;
+
+// Native I, Zombie input and combat with a finite heist objective. All progress
+// occupies existing serialized Challenge fields; original mode layouts stay exact.
+namespace BungeeBusiness
+{
+inline constexpr GameMode kMode = GAMEMODE_CHALLENGE_BUNGEE_BUSINESS;
+inline constexpr ChallengeState kActive = static_cast<ChallengeState>(119);
+inline constexpr ChallengeState kTransition = static_cast<ChallengeState>(120);
+inline constexpr ChallengeState kFinished = static_cast<ChallengeState>(121);
+inline constexpr ChallengeState kFailed = static_cast<ChallengeState>(122);
+inline constexpr int kBoardCount = 5;
+inline constexpr int kSeedCount = 5;
+inline constexpr int kDeploymentColumn = 5;
+inline constexpr int kBungeeCost = 125;
+inline constexpr int kTransitionTicks = 120;
+constexpr bool IsMode(GameMode mode) { return mode == kMode; }
+constexpr bool IsCurrentRules(GameMode mode, ChallengeState state)
+{ return IsMode(mode) && state >= kActive && state <= kFailed; }
+inline constexpr std::array<SeedType, kSeedCount> kSeeds = {
+    SEED_ZOMBIE_NORMAL, SEED_ZOMBIE_TRAFFIC_CONE, SEED_ZOMBIE_POLEVAULTER,
+    SEED_ZOMBIE_PAIL, SEED_ZOMBIE_BUNGEE
+};
+struct Defender { SeedType mSeed = SEED_NONE; int mCol = 0; int mRow = 0; };
+struct Puzzle { int mSun; std::array<Defender, 9> mPlants; };
+// Ground crews work in lanes separate from the Sunflowers. Clear the native
+// Umbrella-leaf coverage, then spend the remaining budget on targeted Bungees.
+inline constexpr std::array<Puzzle, kBoardCount> kBoards = {{
+    {225, {{{SEED_SUNFLOWER,0,1}, {SEED_UMBRELLA,1,2}}}},
+    {375, {{{SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,0,3},
+            {SEED_UMBRELLA,1,2}, {SEED_PEASHOOTER,0,2}}}},
+    {450, {{{SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,0,3},
+            {SEED_UMBRELLA,1,0}, {SEED_UMBRELLA,1,4},
+            {SEED_PEASHOOTER,0,0}, {SEED_PEASHOOTER,0,4}}}},
+    {375, {{{SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,0,3},
+            {SEED_UMBRELLA,1,2}, {SEED_WALLNUT,3,2}, {SEED_PEASHOOTER,0,2}}}},
+    {625, {{{SEED_SUNFLOWER,0,1}, {SEED_SUNFLOWER,3,1}, {SEED_SUNFLOWER,0,3},
+            {SEED_UMBRELLA,1,0}, {SEED_UMBRELLA,3,2}, {SEED_UMBRELLA,1,4},
+            {SEED_PEASHOOTER,0,0}, {SEED_PEASHOOTER,0,2}, {SEED_PEASHOOTER,0,4}}}}
+}};
+constexpr int PlantCount(int stage)
+{
+    if (stage < 0 || stage >= kBoardCount) return 0;
+    int count = 0;
+    for (const Defender& plant : kBoards[stage].mPlants) count += plant.mSeed != SEED_NONE;
+    return count;
+}
+constexpr int TargetCount(int stage)
+{
+    if (stage < 0 || stage >= kBoardCount) return 0;
+    int count = 0;
+    for (const Defender& plant : kBoards[stage].mPlants) count += plant.mSeed == SEED_SUNFLOWER;
+    return count;
+}
+template<std::size_t Waves, std::size_t Slots>
+int PopulateWaves(ZombieType (&output)[Waves][Slots])
+{
+    static_assert(Waves >= kBoardCount);
+    for (auto& wave : output) for (auto& zombie : wave) zombie = ZOMBIE_INVALID;
+    return kBoardCount;
+}
+template<std::size_t Count>
+void PopulateAllowedZombies(bool (&output)[Count])
+{
+    for (auto& allowed : output) allowed = false;
+    for (ZombieType type : {ZOMBIE_NORMAL, ZOMBIE_TRAFFIC_CONE, ZOMBIE_POLEVAULTER, ZOMBIE_PAIL, ZOMBIE_BUNGEE}) output[type] = true;
+}
+template<class Bank> void FillSeedBank(Bank& bank)
+{
+    bank.mNumPackets = kSeedCount;
+    for (int i = 0; i < kSeedCount; ++i) bank.mSeedPackets[i].SetPacketType(kSeeds[i]);
+    bank.RefreshAllPackets();
+}
+void Populate(Board& board);
+void ResetStage(Board& board, int stage);
+void Update(Board& board);
+bool CanDeploy(Board& board, int col, int row, SeedType seed);
+void OnBungeeExit(Zombie& zombie);
+std::string LevelLabel(int stage);
+static_assert(static_cast<int>(kMode) == 84);
+static_assert(TargetCount(0) + TargetCount(1) + TargetCount(2) + TargetCount(3) + TargetCount(4) == 10);
+}
