+def paint_on_shape(shape,paint):
+    """Transfer generated RGB while retaining all approved alpha bytes.
+
+    Keep the original antialiased contour, where generated alpha can differ by
+    a fraction of a native pixel. No generated geometry is used at runtime.
+    """
+    out=Image.new('RGBA',shape.size)
+    for y in range(shape.height):
+        for x in range(shape.width):
+            original=shape.getpixel((x,y));new=paint.getpixel((x,y))
+            if original[3]==0:continue
+            rgb=new[:3] if original[3]>=240 and new[3]>=240 else original[:3]
+            out.putpixel((x,y),rgb+(original[3],))
+    assert out.getchannel('A').tobytes()==shape.getchannel('A').tobytes()
