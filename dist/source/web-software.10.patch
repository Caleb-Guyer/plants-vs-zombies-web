-
-							mVSyncBrokenTestStartTick = aStartTime;
-							mVSyncBrokenTestUpdates = 0;
-						}
-					}
-
-					bool hadRealUpdate = DoUpdateFrames();
-					if (hadRealUpdate)
-						mUpdateAppState = UPDATESTATE_PROCESS_2;
-
-					mHasPendingDraw = true;
