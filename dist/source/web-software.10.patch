+struct GfxDrawState
+{
+	GLuint texture = 0;
+	GLenum blendSrc = GL_SRC_ALPHA;
+	GLenum blendDst = GL_ONE_MINUS_SRC_ALPHA;
+	GLint filter = GL_NEAREST;
+	GLint useTexture = 0;
+	GLint clampUv = 1;
+	GLint mixedBlend = 0;
+	float uvBounds[4] = {};
+};
+
+struct GfxDrawCommand
+{
+	GLenum mode;
+	GLint first;
+	GLsizei count;
+	GfxDrawState state;
+};
