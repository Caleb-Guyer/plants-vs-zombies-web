+struct ScreenRasterTarget
+{
+    const void* surface = nullptr;
+    unsigned int bytePitch = 0;
+};
+thread_local ScreenRasterTarget gScreenRasterTarget;
+
+class ScopedScreenRasterTarget
+{
+    ScreenRasterTarget mPrevious;
+public:
+    ScopedScreenRasterTarget(const void* surface, unsigned int bytePitch)
+        : mPrevious(gScreenRasterTarget)
+    {
+        gScreenRasterTarget = {surface, bytePitch};
+    }
+    ~ScopedScreenRasterTarget() { gScreenRasterTarget = mPrevious; }
+    ScopedScreenRasterTarget(const ScopedScreenRasterTarget&) = delete;
+    ScopedScreenRasterTarget& operator=(const ScopedScreenRasterTarget&) = delete;
+};
+}
+
+bool Sexy::NativeScreenRasterTargetMatches(const void* surface, unsigned int bytePitch)
+{
+    return surface != nullptr && surface == gScreenRasterTarget.surface &&
+        bytePitch != 0 && bytePitch == gScreenRasterTarget.bytePitch;
+}
