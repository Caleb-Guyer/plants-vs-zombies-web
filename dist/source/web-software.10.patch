+bool GLInterface::IsSoftwareRendering() const { return mSoftwareRendering; }
+
+bool GLInterface::SetSoftwareRendering(bool theEnable)
+{
+	if (!theEnable)
+	{
+		GfxFlush();
+		mSoftwareRendering = false;
+		return true;
+	}
+	if (mWidth <= 0 || mHeight <= 0 || gProgram == 0 ||
+		mWidth > MAX_TEXTURE_SIZE || mHeight > MAX_TEXTURE_SIZE)
+		return false;
+	if (mSoftwareScreenImage && mSoftwareTexture != 0 &&
+		mSoftwareScreenImage->mWidth == mWidth && mSoftwareScreenImage->mHeight == mHeight)
+	{
+		GfxFlush();
+		mSoftwareRendering = true;
+		return true;
+	}
+
+	std::unique_ptr<MemoryImage> aScreen;
+	std::vector<uint32_t> aPixels;
+	try
+	{
+		aScreen = std::make_unique<SoftwareScreenImage>(mApp);
+		aScreen->Create(mWidth, mHeight);
+		const size_t aCount = static_cast<size_t>(mWidth) * mHeight;
+		uint32_t* aBits = aScreen->GetBits();
+		if (!aBits)
+			return false;
+		std::fill_n(aBits, aCount, 0xff000000u);
+		aScreen->BitsChanged();
+		aScreen->SetImageMode(false, false);
+		aScreen->mPurgeBits = false;
+		aPixels.resize(aCount);
+	}
+	catch (const std::bad_alloc&)
+	{
+		return false;
+	}
+
+	// A dedicated presentation texture never purges the canonical CPU bitmap
+	// or inherits the source-image texture subdivision/format policy.
+	GfxFlush();
+	GLuint aTexture = 0;
+	glGenTextures(1, &aTexture);
+	if (aTexture == 0)
+		return false;
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, aTexture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, mWidth, mHeight, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+	gAppliedStateValid = false;
+	gAppliedTextureValid = false;
+	if (glGetError() != GL_NO_ERROR)
+	{
+		glDeleteTextures(1, &aTexture);
+		return false;
+	}
+	if (mSoftwareTexture != 0)
+		glDeleteTextures(1, &mSoftwareTexture);
+	mSoftwareTexture = aTexture;
+	mSoftwareScreenImage = std::move(aScreen);
+	mSoftwareFramePixels = std::move(aPixels);
+	mSoftwareRendering = true;
+	return true;
+}
+
+bool GLInterface::PresentSoftwareFrame()
+{
+	if (!mSoftwareScreenImage || mSoftwareTexture == 0)
+		return false;
+	const size_t aCount = static_cast<size_t>(mWidth) * mHeight;
+	if (mSoftwareScreenImage->mWidth != mWidth || mSoftwareScreenImage->mHeight != mHeight ||
+		mSoftwareFramePixels.size() != aCount)
+		return false;
+	const uint32_t* aBits = mSoftwareScreenImage->GetBits();
+	if (!aBits)
+		return false;
+	for (size_t i = 0; i < aCount; ++i)
+		mSoftwareFramePixels[i] = ArgbToRgba(aBits[i] | 0xff000000u);
+
+	// Only this final opaque bitmap transport draws through GL in CPU mode.
+	// Share the existing shader/VBO to preserve its vertex-attribute ownership.
+	GfxFlush();
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	glUseProgram(gProgram);
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, mSoftwareTexture);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+	glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, mWidth, mHeight, GL_RGBA, GL_UNSIGNED_BYTE, mSoftwareFramePixels.data());
+	glDisable(GL_SCISSOR_TEST);
+	glClearColor(0, 0, 0, 1);
+	glClear(GL_COLOR_BUFFER_BIT);
+	glViewport(mPresentationRect.mX, mPresentationRect.mY, mPresentationRect.mWidth, mPresentationRect.mHeight);
+	gAppliedStateValid = false;
+	gAppliedTextureValid = false;
+	SetMixedBlendMode(false);
+	SetBlendFunc(GL_ONE, GL_ZERO);
+	SetLinearFilter(false);
+	gDrawState.useTexture = 1;
+	GfxBindTexture(mSoftwareTexture, kDefaultUvBounds, false);
+	const float aWidth = static_cast<float>(mWidth);
+	const float aHeight = static_cast<float>(mHeight);
+	GLVertex aVertices[4] =
+	{
+		{0, 0, 0, 0xffffffffu, 0, 0},
+		{0, aHeight, 0, 0xffffffffu, 0, 1},
+		{aWidth, 0, 0, 0xffffffffu, 1, 0},
+		{aWidth, aHeight, 0, 0xffffffffu, 1, 1}
+	};
+	GfxBegin(GL_TRIANGLE_STRIP);
+	GfxAddVertices(aVertices, 4);
+	GfxEnd();
+	return true;
+}
+
+void GLInterface::UpdateViewport()
+{
+	GfxFlush();
+	int vx = 0, vy = 0, vw, vh;
+
+#ifdef __SWITCH__
+	int width = 1280, height = 720;
+#else
+	int width, height;
+	SDL_GL_GetDrawableSize((SDL_Window*)mApp->mWindow, &width, &height);
+#endif
+
+	vw = width; vh = height;
+
+	// Letterbox to 4:3
+	if (width * 3 > height * 4)
+	{
+		vw = height * 4 / 3;
+		vx = (width - vw) / 2;
+	}
+	else if (width * 3 < height * 4)
+	{
+		vh = width * 3 / 4;
+		vy = (height - vh) / 2;
+	}
+
+	glViewport(vx, vy, vw, vh);
+	mPresentationRect = Rect(vx, vy, vw, vh);
+}
+
+int GLInterface::Init(bool IsWindowed)
+{
+	GfxFlush();
+	static bool inited = false;
+	if (!inited)
+	{
+		inited = true;
+		PlatformGLInit();
+
+		gProgram = shaderLoad(SHADER_CODE);
+		if (gProgram == 0)
+			return 0;
+		gUfViewProjMtx = glGetUniformLocation(gProgram, "u_viewProj");
+		gUfTexture     = glGetUniformLocation(gProgram, "u_texture");
+		gUfUseTexture  = glGetUniformLocation(gProgram, "u_useTexture");
+		gUfUvBounds    = glGetUniformLocation(gProgram, "u_uvBounds");
+		gUfClampUvEnabled = glGetUniformLocation(gProgram, "u_clampUvEnabled");
+		gUfMixedBlend  = glGetUniformLocation(gProgram, "u_mixedBlend");
+
+		glGenBuffers(1, &gVbo);
+		glBindBuffer(GL_ARRAY_BUFFER, gVbo);
+		glBufferData(GL_ARRAY_BUFFER, sizeof(GLVertex) * MAX_VERTICES, nullptr, GL_DYNAMIC_DRAW);
+
+		glVertexAttribPointer(0, 3, GL_FLOAT,         GL_FALSE, sizeof(GLVertex), (const void*)0);
+		glEnableVertexAttribArray(0);
+		glVertexAttribPointer(1, 4, GL_UNSIGNED_BYTE,  GL_TRUE,  sizeof(GLVertex), (const void*)(sizeof(float)*3));
+		glEnableVertexAttribArray(1);
+		glVertexAttribPointer(2, 2, GL_FLOAT,         GL_FALSE, sizeof(GLVertex), (const void*)(sizeof(float)*3 + sizeof(uint32_t)));
+		glEnableVertexAttribArray(2);
+	}
+
+	int aMaxSize;
+	glGetIntegerv(GL_MAX_TEXTURE_SIZE, &aMaxSize);
+	MAX_TEXTURE_SIZE = aMaxSize;
+
+	glClearColor(0, 0, 0, 1);
+	glClear(GL_COLOR_BUFFER_BIT);
+
+	gTextureSizeMustBePow2 = false;
+	gMinTextureWidth  = 8;
+	gMinTextureHeight = 8;
+	gMaxTextureWidth  = aMaxSize;
+	gMaxTextureHeight = aMaxSize;
+	gSupportedPixelFormats = PixelFormat_A8R8G8B8 | PixelFormat_A4R4G4B4 | PixelFormat_R5G6B5 | PixelFormat_Palette8;
+	gLinearFilter = false;
+
+	glUseProgram(gProgram);
+	float ortho[16];
+	MakeOrthoMatrix(0, (float)mWidth, (float)mHeight, 0, -10, 10, ortho);
+	glUniformMatrix4fv(gUfViewProjMtx, 1, GL_FALSE, ortho);
+	glUniform1i(gUfTexture, 0);
+	glUniform1i(gUfClampUvEnabled, 1);
+	glUniform1i(gUfMixedBlend, 0);
+	gDrawState = {};
+	gAppliedStateValid = false;
+	gAppliedTextureValid = false;
+
+	glEnable(GL_BLEND);
+	glDisable(GL_DITHER);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_CULL_FACE);
+	glDisable(GL_FRAMEBUFFER_SRGB); // Prevent double gamma correction (already sRGB passthrough)
+	glGetError(); // clear GL_INVALID_ENUM on pure GLES implementations
+
+	mRGBBits   = 32;
+	mRedBits   = 8; mGreenBits = 8; mBlueBits  = 8;
+	mRedShift  = 0; mGreenShift = 8; mBlueShift = 16;
+	mRedMask   = 0xFFu << mRedShift;
+	mGreenMask = 0xFFu << mGreenShift;
+	mBlueMask  = 0xFFu << mBlueShift;
+
+	SetVideoOnlyDraw(false);
+	return 1;
+}
+
+bool GLInterface::Redraw(Rect*)
+{
+	if (mSoftwareRendering && !PresentSoftwareFrame())
+		return false;
+	Flush();
+	return true;
+}
