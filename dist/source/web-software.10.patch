+	if (!mApp->Is3DAccelerated())
+		return MemoryImage::StretchBltMirror(theImage, theDestRectOrig, theSrcRect, theClipRect, theColor, theDrawMode, fastStretch);
+
+	theImage->mDrawn = true;
+
+	CommitBits();
+
+	mGLInterface->StretchBlt(theImage,theDestRectOrig,theSrcRect,&theClipRect,theColor,theDrawMode,fastStretch,true);
+}
