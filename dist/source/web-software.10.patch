-void SexyAppBase::DoMainLoop()
-{
-#ifdef __EMSCRIPTEN__
-	emscripten_set_main_loop(SexyAppBase::EmscriptenMainLoopCallback, 0, 1);
-#else
-	while (!mShutdown)
-	{
-		if (mExitToTop)
-			mExitToTop = false;
-		UpdateApp();
-	}
-#endif
-}
