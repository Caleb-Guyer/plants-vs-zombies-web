+        int drawMode, bool linearFilter = true) override;
+    void BltMirror(Image* image, int x, int y, const Rect& sourceRect, const Color& color,
+        int drawMode, bool linearFilter = true) override;
+    void StretchBlt(Image* image, const Rect& destinationRect, const Rect& sourceRect,
+        const Rect& clipRect, const Color& color, int drawMode, bool fastStretch) override;
+    void StretchBltMirror(Image* image, const Rect& destinationRect, const Rect& sourceRect,
+        const Rect& clipRect, const Color& color, int drawMode, bool fastStretch) override;
+    void BltMatrix(Image* image, float x, float y, const SexyMatrix3& matrix,
+        const Rect& clipRect, const Color& color, int drawMode, const Rect& sourceRect, bool blend) override;
+    void BltTrianglesTex(Image* texture, const TriVertex vertices[][3], int triangleCount,
+        const Rect& clipRect, const Color& color, int drawMode, float x, float y, bool blend) override;
+};
