+
+bool SexyAppBase::ApplyRequestedRenderMode()
+{
+	if (!mRendererSwitchPending)
+		return true;
+	if (!mGLInterface || !IsOnPrimaryThread() || mIsDrawing || (mLoadingThreadStarted && !mLoadingThreadCompleted))
+		return false;
+	if (!mRequested3DAcceleration)
+	{
+		// Materialize canonical source pixels while the hardware context can still recover them.
+		try
+		{
+			std::vector<MemoryImage*> images;
+			{
+				std::scoped_lock lock(mGLInterface->mCritSect);
+				images.assign(mMemoryImageSet.begin(), mMemoryImageSet.end());
+			}
+			for (MemoryImage* image : images)
+				if (image != mWidgetManager->mImage)
+				{
+					image->GetBits();
+					image->CommitBits();
+				}
+		}
+		catch (const std::bad_alloc&)
+		{
+			mRequested3DAcceleration = mIs3DAccelerated;
+			mRendererSwitchPending = false;
+			Sexy::LogErrorLn("Insufficient memory for CPU source pixels; previous compositor retained.");
+			return false;
+		}
+	}
+	if (!mGLInterface->SetSoftwareRendering(!mRequested3DAcceleration))
+	{
+		mRequested3DAcceleration = mIs3DAccelerated;
+		mRendererSwitchPending = false;
+		Sexy::LogErrorLn("Failed to apply rendering mode; previous compositor retained.");
+		return false;
+	}
+	mIs3DAccelerated = !mGLInterface->IsSoftwareRendering();
+	mRendererSwitchPending = false;
+	RegistryWriteBoolean("Is3D", mIs3DAccelerated);
+	mWidgetManager->mImage = mGLInterface->GetScreenImage();
+	mWidgetManager->MarkAllDirty();
+	mCustomCursorDirty = true;
+	return true;
+}
