+    const Rect& clipRect, const Color& color, int drawMode, const Rect& sourceRect, bool blend)
+{
+    ScopedScreenRasterTarget target(GetBits(), static_cast<unsigned int>(mWidth) * 4u);
+    MemoryImage::BltMatrix(image, x, y, matrix, clipRect, color, drawMode, sourceRect, blend);
+}
