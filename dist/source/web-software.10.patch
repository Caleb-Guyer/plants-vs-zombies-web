+				dest = *aDestPixels;
+
+				r = aMaxTable[((dest & aRMask) >> aRedShift) + rc];
+				g = aMaxTable[((dest & aGMask) >> aGreenShift) + gc];
+				b = aMaxTable[((dest & aBMask) >> aBlueShift) + bc];
+
+				*aDestPixels =
+					0xFF000000 |
