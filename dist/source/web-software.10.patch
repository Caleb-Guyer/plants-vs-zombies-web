+void MemoryImage::BltMirror(Image* theImage, int theX, int theY, const Rect& theSrcRect, const Color& theColor, int theDrawMode, bool linearFilter)
+{
+	auto* source = dynamic_cast<MemoryImage*>(theImage);
+	if (!source || theSrcRect.mWidth <= 0 || theSrcRect.mHeight <= 0 || theSrcRect.mX < 0 || theSrcRect.mY < 0 || theSrcRect.mX + theSrcRect.mWidth > source->mWidth || theSrcRect.mY + theSrcRect.mHeight > source->mHeight)
+		return;
+	theImage->mDrawn = true;
+	MemoryImage mirrored(mApp);
+	mirrored.Create(theSrcRect.mWidth, theSrcRect.mHeight);
+	uint32_t* dest = mirrored.GetBits();
+	const uint32_t* sourceBits = source->GetBits();
+	for (int y = 0; y < mirrored.mHeight; ++y)
+		for (int x = 0; x < mirrored.mWidth; ++x)
+			dest[y * mirrored.mWidth + x] = sourceBits[(theSrcRect.mY + y) * source->mWidth + theSrcRect.mX + mirrored.mWidth - 1 - x];
+	mirrored.BitsChanged();
+	mirrored.SetImageMode(source->mHasTrans, source->mHasAlpha);
+	const Rect clipped = Rect(theX, theY, mirrored.mWidth, mirrored.mHeight).Intersection(Rect(0, 0, mWidth, mHeight));
+	if (clipped.mWidth > 0 && clipped.mHeight > 0)
+		Blt(&mirrored, clipped.mX, clipped.mY, Rect(clipped.mX - theX, clipped.mY - theY, clipped.mWidth, clipped.mHeight), theColor, theDrawMode, linearFilter);
+}
