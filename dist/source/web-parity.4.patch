+// Browser adaptation of the original standalone Zombatar JPEG export. Reuse
+// the native compositor and saved record, never a reset draft or canvas crop.
+bool ZombatarWidget::WriteCurrentPortraitImage(std::string& thePath)
+{
+	PlayerInfo* aPlayer = mApp->mPlayerInfo;
+	if (!aPlayer || mCurrentIndex < 0)
+		return false;
+	const size_t aOffset = static_cast<size_t>(mCurrentIndex) * ZOMBATAR_RECORD_SIZE;
+	if (aOffset + ZOMBATAR_RECORD_SIZE > aPlayer->mZombatarData.size())
+		return false;
+	std::array<uint8_t, ZOMBATAR_RECORD_SIZE> aRecord;
+	memcpy(aRecord.data(), aPlayer->mZombatarData.data() + aOffset, aRecord.size());
+	int aPart[NUM_ZOMBATAR_PAGES];
+	int aColor[NUM_ZOMBATAR_PAGES];
+	DecodeRecord(aRecord.data(), aPart, aColor);
+	Image* aBackground = GetBackgroundImage(aPart[ZOMBATAR_PAGE_BACKDROPS]);
+	if (!aBackground || aBackground->mWidth <= 0 || aBackground->mHeight <= 0)
+		return false;
+
+	MemoryImage aPortrait(mApp);
+	aPortrait.Create(aBackground->mWidth, aBackground->mHeight);
+	const size_t aPixelCount = static_cast<size_t>(aPortrait.mWidth) * aPortrait.mHeight;
+	uint32_t* aPixels = aPortrait.GetBits();
+	// Match the original export's zero ARGB buffer and alpha/transparency-aware
+	// MemoryImage destination; the JPEG writer discards the final alpha.
+	std::fill_n(aPixels, aPixelCount, 0u);
+	aPortrait.BitsChanged();
+	Graphics aGraphics(&aPortrait);
+	DrawAvatar(&aGraphics, 0, 0, aRecord.data());
+
+	ImageLib::Image aEncoded;
+	aEncoded.mWidth = aPortrait.mWidth;
+	aEncoded.mHeight = aPortrait.mHeight;
+	aEncoded.mBits = std::make_unique<uint32_t[]>(aPixelCount);
+	memcpy(aEncoded.mBits.get(), aPortrait.GetBits(), aPixelCount * sizeof(uint32_t));
+	const std::string aDirectory = GetAppDataPath(std::format("userdata/zombatars/user{}", aPlayer->mId));
+	MkDir(aDirectory);
+	for (int aNumber = 1; aNumber < std::numeric_limits<int>::max(); aNumber++)
+	{
+		const std::string aPath = aDirectory + std::format("/Zombatar_{}.jpg", aNumber);
+		if (FileExists(aPath))
+			continue;
+		if (!ImageLib::WriteZombatarJPEGImage(aPath, &aEncoded))
+		{
+			// This name did not exist before the attempted encoder write.
+			mApp->EraseFile(aPath);
+			return false;
+		}
+		thePath = aPath;
+		return true;
+	}
+	return false;
+}
+
+static bool RequestZombatarDownload(const std::string& thePath)
+{
+	return EM_ASM_INT({
+		let requested = 0;
+		let url;
+		let anchor;
+		try {
+			const path = UTF8ToString($0);
+			const bytes = new Uint8Array(FS.readFile(path));
+			const filename = path.slice(path.lastIndexOf('/') + 1);
+			const blob = new Blob([bytes], {type: 'image/jpeg'});
+			url = URL.createObjectURL(blob);
+			anchor = document.createElement('a');
+			anchor.href = url;
+			anchor.download = filename;
+			anchor.hidden = true;
+			document.body.appendChild(anchor);
+			anchor.click();
+			requested = 1;
+		} catch (error) {
+			console.warn('Zombatar download request failed:', error);
+		} finally {
+			if (anchor) anchor.remove();
+			if (url) setTimeout(() => URL.revokeObjectURL(url), 60000);
+		}
+		// Request the download before asynchronous persistence can lose the
+		// player's transient activation. The shell serializes these FS syncs.
+		try {
+			if (typeof FS.syncfs === 'function') FS.syncfs(false, function(error) {
+				if (error) console.warn('Zombatar image persist failed:', error);
+			});
+		} catch (error) {
+			console.warn('Zombatar image persist failed:', error);
+		}
+		return requested;
+	}, thePath.c_str()) != 0;
+}
+
+void ZombatarWidget::ExportCurrentPortrait()
+{
+	std::string aPath;
+	while (!mApp->mShutdown)
+	{
+		if (aPath.empty() && !WriteCurrentPortraitImage(aPath))
+		{
+			int aResult = mApp->LawnMessageBox(DIALOG_MESSAGE, "Save Zombatar",
+				"Your Zombatar is saved in your profile, but its image could not be created. Try again?",
+				"Retry", "Done", Dialog::BUTTONS_YES_NO);
+			if (aResult != Dialog::ID_YES)
+				return;
+			continue;
+		}
+		bool aRequested = RequestZombatarDownload(aPath);
+		int aResult = mApp->LawnMessageBox(DIALOG_MESSAGE, "Zombatar saved",
+			aRequested ? "Your Zombatar portrait is saved. Check your downloads for the JPG."
+				: "Your Zombatar image is saved, but the browser download could not start.",
+			"Done", "Download JPG", Dialog::BUTTONS_YES_NO);
+		if (aResult != Dialog::ID_NO)
+			return;
+		// Retry the same image file; never create a second profile record.
+	}
+}
+#endif
